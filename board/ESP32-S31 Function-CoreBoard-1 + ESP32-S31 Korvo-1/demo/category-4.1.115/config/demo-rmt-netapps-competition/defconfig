#include "../demo-rmt-netapps-iperf/defconfig"

# Combined competition demo and original network tools, without crypto test apps.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SW_AES=y
CONFIG_CRYPTO_RANDOM_POOL=y
CONFIG_CRYPTO_CRYPTODEV=y
CONFIG_CRYPTO_CRYPTODEV_SOFTWARE_CRYPTO=y
CONFIG_ESP32S31_CRYPTO_AES_CBC=y
CONFIG_ESP32S31_CRYPTO_AES_MODES=y
CONFIG_ESP32S31_CRYPTO_SHA=y
CONFIG_ESP32S31_CRYPTO_HMAC=y
CONFIG_ESP32S31_CRYPTO_ECDSA_VERIFY=y
CONFIG_ESP32S31_CRYPTO_ECC_POINT_MULT=y

# Original WAPI save_config/reconnect cases use the existing writable volume.
CONFIG_NETUTILS_CJSON=y
CONFIG_WIRELESS_WAPI_INITCONF=y
CONFIG_WIRELESS_WAPI_CONFIG_PATH="/apps/s31-wapi-xts.conf"
# Original saved-profile reboot/reconnect case uses the existing board reset.
CONFIG_BOARDCTL_RESET=y
# Keep association explicit for unassociated scans and reconnect acceptance.
CONFIG_NETINIT_NETLOCAL=y

# curl and scp retain their original 16 KiB task stacks (see xts678).
CONFIG_TLS_LOG2_MAXSTACK=14

# The existing curl asynchronous resolver wakes through AF_UNIX socketpair.
CONFIG_NET_LOCAL=y
CONFIG_NET_LOCAL_STREAM=y
# CONFIG_NET_LOCAL_DGRAM is not set

# Enable socket send backpressure with the original iperf 16 KiB buffer.
CONFIG_NET_SEND_BUFSIZE=16384

# Original UDP iperf command has 12 arguments including the executable.
CONFIG_NSH_MAXARGUMENTS=16

CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_PTHREAD=y

#include "../demo-rmt-xts-core/defconfig"

# Published syscall-suite prerequisites (FS_LINKS replaces old
# PSEUDOFS_SOFTLINKS in this tree). No persistent FAT volume is formatted.
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_NAME_MAX=255
CONFIG_IOB_NBUFFERS=128
CONFIG_IOB_NCHAINS=4
CONFIG_NET_LOCAL=y

# Published common cases 1.1.5, 1.1.7 and 1.1.8.
CONFIG_TESTING_GETPRIME=y
CONFIG_LIBC_SCANSET=y
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIBC_LONG_LONG=y
CONFIG_TESTING_SCANFTEST=y
CONFIG_EXAMPLES_HELLO=y

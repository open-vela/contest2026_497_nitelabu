# Korvo-1 SUB3 RGB565 test using the project's openvela/NuttX S31 port.
# Reuse the SoC boot/UART implementation, with explicitly separate LCD pins.
#include "../nsh/defconfig"

CONFIG_BUILD_FLAT=y
CONFIG_RAM_START=0x2f000000
CONFIG_RAM_SIZE=524288
CONFIG_ARCH_FPU=y
CONFIG_ARCH_SETJMP_H=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ASSERTIONS=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_GRAPHICS_ERROR=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_INITTHREAD_STACKSIZE=8192
CONFIG_BOARDCTL_RESET=y
CONFIG_DEFAULT_TASK_STACKSIZE=8192
CONFIG_INIT_STACKSIZE=8192
CONFIG_INIT_ENTRYPOINT="s31rgb565_start_main"
CONFIG_TLS_LOG2_MAXSTACK=14
CONFIG_ESPRESSIF_FLASH_MODE_DIO=y
CONFIG_ESPRESSIF_SPIRAM=y
CONFIG_ESPRESSIF_SPIRAM_BOOT_INIT=y
CONFIG_ESPRESSIF_SPIRAM_USE_8LINE_MODE=y
CONFIG_ESPRESSIF_SPIRAM_SPEED_80M=y
CONFIG_ESPRESSIF_SPIRAM_USER_HEAP=y
CONFIG_MM_REGIONS=2
CONFIG_ESP32S31_KORVO_RGB565=y
CONFIG_DRIVERS_VIDEO=y
CONFIG_VIDEO_FB=y
CONFIG_FB_UPDATE=y
CONFIG_EXAMPLES_S31RGB565=y
CONFIG_EXAMPLES_S31RGB565_STACKSIZE=8192
CONFIG_NSH_DISABLE_MOUNT=n
CONFIG_FS_PROCFS=y
CONFIG_NSH_ARCHINIT=y

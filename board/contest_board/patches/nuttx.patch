+ */
+
+#define ESP32S31_TXFIFO_SIZE \
+  (ESP32S31_FIFO_SIZE / 2 / ESP32S31_ENDPOINT_NUM * ESP32S31_ENDPOINT_NUM)
+
+#define ESP32S31_EP_TXFIFO_SIZE \
+  (ESP32S31_TXFIFO_SIZE / ESP32S31_ENDPOINT_NUM)
+
+/* EP0 must exist */
+
+#ifdef CONFIG_USBDEV_EP0_TXFIFO_SIZE
+#  define ESP32S31_EP0_TXFIFO_SIZE CONFIG_USBDEV_EP0_TXFIFO_SIZE
+#else
+#  define ESP32S31_EP0_TXFIFO_SIZE ESP32S31_EP_TXFIFO_SIZE

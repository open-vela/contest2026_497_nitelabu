+#ifndef __ARCH_RISCV_SRC_ESP32S31_HARDWARE_ESP32S31_OTG_H
+#define __ARCH_RISCV_SRC_ESP32S31_HARDWARE_ESP32S31_OTG_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <stdint.h>
+
+#define DR_REG_USB_BASE 0x20300000u
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* General definitions */
+
+#define OTG_EPTYPE_CTRL               (0) /* Control */
+#define OTG_EPTYPE_ISOC               (1) /* Isochronous */
+#define OTG_EPTYPE_BULK               (2) /* Bulk */
+#define OTG_EPTYPE_INTR               (3) /* Interrupt */
+
+#define OTG_PID_DATA0                 (0)
+#define OTG_PID_DATA2                 (1)
+#define OTG_PID_DATA1                 (2)
+#define OTG_PID_MDATA                 (3) /* Non-control */
+#define OTG_PID_SETUP                 (3) /* Control */
+
+/* Register Offsets *********************************************************/
+
+/* Core global control and status registers */
+
+#define ESP32S31_OTG_GOTGCTL_OFFSET      0x0000 /* Control and status register */
+#define ESP32S31_OTG_GOTGINT_OFFSET      0x0004 /* Interrupt register */
+#define ESP32S31_OTG_GAHBCFG_OFFSET      0x0008 /* AHB configuration register */
+#define ESP32S31_OTG_GUSBCFG_OFFSET      0x000c /* USB configuration register */
+#define ESP32S31_OTG_GRSTCTL_OFFSET      0x0010 /* Reset register */
+#define ESP32S31_OTG_GINTSTS_OFFSET      0x0014 /* Core interrupt register */
+#define ESP32S31_OTG_GINTMSK_OFFSET      0x0018 /* Interrupt mask register */
+#define ESP32S31_OTG_GRXSTSR_OFFSET      0x001c /* Receive status debug read/OTG status read register */
+#define ESP32S31_OTG_GRXSTSP_OFFSET      0x0020 /* Receive status debug read/OTG status pop register */
+#define ESP32S31_OTG_GRXFSIZ_OFFSET      0x0024 /* Receive FIFO size register */
+#define ESP32S31_OTG_HNPTXFSIZ_OFFSET    0x0028 /* Host non-periodic transmit FIFO size register */
+#define ESP32S31_OTG_DIEPTXF0_OFFSET     0x0028 /* Endpoint 0 Transmit FIFO size */
+#define ESP32S31_OTG_HNPTXSTS_OFFSET     0x002c /* Non-periodic transmit FIFO/queue status register */
+#define ESP32S31_OTG_GCCFG_OFFSET        0x0038 /* General core configuration register */
+#define ESP32S31_OTG_GSNPSID_OFFSET      0x0040 /* Synopsys core ID */
+#define ESP32S31_OTG_CID_OFFSET          ESP32S31_OTG_GSNPSID_OFFSET /* Legacy alias */
+#define ESP32S31_OTG_HPTXFSIZ_OFFSET     0x0100 /* Host periodic transmit FIFO size register */
+
+#define ESP32S31_OTG_DIEPTXF_OFFSET(n)   (0x0104+(((n)-1) << 2))
+
+/* Host-mode control and status registers */
+
+#define ESP32S31_OTG_HCFG_OFFSET         0x0400 /* Host configuration register */
+#define ESP32S31_OTG_HFIR_OFFSET         0x0404 /* Host frame interval register */
+#define ESP32S31_OTG_HFNUM_OFFSET        0x0408 /* Host frame number/frame time remaining register */
+#define ESP32S31_OTG_HPTXSTS_OFFSET      0x0410 /* Host periodic transmit FIFO/queue status register */
+#define ESP32S31_OTG_HAINT_OFFSET        0x0414 /* Host all channels interrupt register */
+#define ESP32S31_OTG_HAINTMSK_OFFSET     0x0418 /* Host all channels interrupt mask register */
+#define ESP32S31_OTG_HPRT_OFFSET         0x0440 /* Host port control and status register */
+
+#define ESP32S31_OTG_CHAN_OFFSET(n)      (0x500 + ((n) << 5))
+#define ESP32S31_OTG_HCCHAR_CHOFFSET     0x0000 /* Host channel characteristics register */
+#define ESP32S31_OTG_HCINT_CHOFFSET      0x0008 /* Host channel interrupt register */
+#define ESP32S31_OTG_HCINTMSK_CHOFFSET   0x000c /* Host channel interrupt mask register */
+#define ESP32S31_OTG_HCTSIZ_CHOFFSET     0x0010 /* Host channel interrupt register */
+
+#define ESP32S31_OTG_HCCHAR_OFFSET(n)    (0x500 + ((n) << 5))
+
+#define ESP32S31_OTG_HCINT_OFFSET(n)     (0x508 + ((n) << 5))
+
+#define ESP32S31_OTG_HCINTMSK_OFFSET(n)  (0x50c + ((n) << 5))
+
+#define ESP32S31_OTG_HCTSIZ_OFFSET(n)    (0x510 + ((n) << 5))
+
+/* Device-mode control and status registers */
+
+#define ESP32S31_OTG_DCFG_OFFSET         0x0800 /* Device configuration register */
+#define ESP32S31_OTG_DCTL_OFFSET         0x0804 /* Device control register */
+#define ESP32S31_OTG_DSTS_OFFSET         0x0808 /* Device status register */
+#define ESP32S31_OTG_DIEPMSK_OFFSET      0x0810 /* Device IN endpoint common interrupt mask register */
+#define ESP32S31_OTG_DOEPMSK_OFFSET      0x0814 /* Device OUT endpoint common interrupt mask register */
+#define ESP32S31_OTG_DAINT_OFFSET        0x0818 /* Device all endpoints interrupt register */
+#define ESP32S31_OTG_DAINTMSK_OFFSET     0x081c /* All endpoints interrupt mask register */
+#define ESP32S31_OTG_DVBUSDIS_OFFSET     0x0828 /* Device VBUS discharge time register */
+#define ESP32S31_OTG_DVBUSPULSE_OFFSET   0x082c /* Device VBUS pulsing time register */
+#define ESP32S31_OTG_DIEPEMPMSK_OFFSET   0x0834 /* Device IN endpoint FIFO empty interrupt mask register */
+
+#define ESP32S31_OTG_DIEP_OFFSET(n)      (0x0900 + ((n) << 5))
+#define ESP32S31_OTG_DIEPCTL_EPOFFSET    0x0000 /* Device endpoint control register */
+#define ESP32S31_OTG_DIEPINT_EPOFFSET    0x0008 /* Device endpoint interrupt register */
+#define ESP32S31_OTG_DIEPTSIZ_EPOFFSET   0x0010 /* Device IN endpoint transfer size register */
+#define ESP32S31_OTG_DTXFSTS_EPOFFSET    0x0018 /* Device IN endpoint transmit FIFO status register */
+
+#define ESP32S31_OTG_DIEPCTL_OFFSET(n)   (0x0900 + ((n) << 5))
+
+#define ESP32S31_OTG_DIEPINT_OFFSET(n)   (0x0908 + ((n) << 5))
+
+#define ESP32S31_OTG_DIEPTSIZ_OFFSET(n)  (0x910 + ((n) << 5))
+
+#define ESP32S31_OTG_DTXFSTS_OFFSET(n)   (0x0918 + ((n) << 5))
+
+#define ESP32S31_OTG_DOEP_OFFSET(n)      (0x0b00 + ((n) << 5))
+#define ESP32S31_OTG_DOEPCTL_EPOFFSET    0x0000 /* Device control OUT endpoint 0 control register */
+#define ESP32S31_OTG_DOEPINT_EPOFFSET    0x0008 /* Device endpoint-x interrupt register */
+
+#define ESP32S31_OTG_DOEPCTL_OFFSET(n)   (0x0b00 + ((n) << 5))
+
+#define ESP32S31_OTG_DOEPINT_OFFSET(n)   (0x0b08 + ((n) << 5))
+
+#define ESP32S31_OTG_DOEPTSIZ_OFFSET(n)  (0x0b10 + ((n) << 5))
+
+/* Power and clock gating registers */
+
+#define ESP32S31_OTG_PCGCCTL_OFFSET      0x0e00 /* Power and clock gating control register */
+
+/* Data FIFO (DFIFO) access registers */
+
+#define ESP32S31_OTG_DFIFO_DEP_OFFSET(n) (0x1000 + ((n) << 12))
+#define ESP32S31_OTG_DFIFO_HCH_OFFSET(n) (0x1000 + ((n) << 12))
+

+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t0, mcause
+  andi    t0, t0, 0x3f
+  li      t1, 17                /* Input 1 + external cause base 16. */
+  bne     t0, t1, 90f
+  la      t0, g_esp32s31_machine_monlat
+  csrr    t1, mhartid
+  slli    t1, t1, 6
+  add     t0, t0, t1
+  sw      zero, 32(t0)
+  csrr    t1, mcycle
+  sw      t1, 0(t0)
+90:
+#endif
+  .endm

+/****************************************************************************
+ * Name: esp32s31_ep_configure
+ *
+ * Description:
+ *   Configure endpoint, making it usable
+ *
+ * Input Parameters:
+ *   ep   - the struct usbdev_ep_s instance obtained from allocep()
+ *   desc - A struct usb_epdesc_s instance describing the endpoint
+ *   last - true if this this last endpoint to be configured.  Some hardware
+ *          needs to take special action when all of the endpoints have been
+ *          configured.
+ *
+ ****************************************************************************/
+
+static int esp32s31_ep_configure(struct usbdev_ep_s *ep,
+                                const struct usb_epdesc_s *desc,
+                                bool last)
+{
+  struct esp32s31_ep_s *privep = (struct esp32s31_ep_s *)ep;
+  uint16_t maxpacket;
+  uint8_t eptype;
+  int ret;
+
+  usbtrace(TRACE_EPCONFIGURE, privep->epphy);
+  DEBUGASSERT(desc->addr == ep->eplog);
+
+  /* Initialize EP capabilities */
+
+  maxpacket = GETUINT16(desc->mxpacketsize);
+  eptype = desc->attr & USB_EP_ATTR_XFERTYPE_MASK;
+
+  /* Setup Endpoint Control Register */
+
+  if (privep->isin)
+    {
+      ret = esp32s31_epin_configure(privep, eptype, maxpacket);
+    }
+  else
+    {
+      ret = esp32s31_epout_configure(privep, eptype, maxpacket);
+    }
+
+  return ret;
+}

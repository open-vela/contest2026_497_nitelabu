+#ifdef CONFIG_BUILD_KERNEL
+/* The task owns its TCB/stack until normal task exit.  The completion token
+ * means all codec state, queues and callbacks have finished; no driver state
+ * is accessed after the post.  START/STOP are serialized by the audio upper
+ * half, and every successful create has exactly one completion consumer.
+ */
+
+static int es8311_kernel_worker(int argc, FAR char *argv[])
+{
+  FAR struct es8311_dev_s *priv =
+    (FAR struct es8311_dev_s *)(uintptr_t)strtoull(argv[1], NULL, 16);
+
+#ifdef CONFIG_ARCH_ADDRENV
+  FAR struct addrenv_s *oldenv;
+
+  DEBUGVERIFY(addrenv_select(priv->addrenv, &oldenv));
+#endif
+  es8311_workerthread(priv);
+#ifdef CONFIG_ARCH_ADDRENV
+  DEBUGVERIFY(addrenv_restore(oldenv));
+#endif
+  nxsem_post(&priv->worker_done);
+  return OK;
+}

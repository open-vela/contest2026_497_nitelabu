+/****************************************************************************
+ * Name: esp32s31_getreg
+ *
+ * Description:
+ *   Get the contents of an ESP32-S3 register
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_ESP32S31_OTG_DEBUG_REGISTER
+static uint32_t esp32s31_getreg(uint32_t addr)
+{
+  static uint32_t prevaddr = 0;
+  static uint32_t preval = 0;
+  static uint32_t count = 0;
+
+  /* Read the value from the register */
+
+  uint32_t val = getreg32(addr);
+
+  /* Is this the same value that we read from the same register last time?
+   * Are we polling the register? If so, suppress some of the output.
+   */
+
+  if (addr == prevaddr && val == preval)
+    {
+      if (count == 0xffffffff || ++count > 3)
+        {
+          if (count == 4)
+            {
+              uinfo("...\n");
+            }
+
+          return val;
+        }
+    }
+
+  /* No this is a new address or value */
+
+  else
+    {
+      /* Did we print "..." for the previous value? */
+
+      if (count > 3)
+        {
+          /* Yes.. then show how many times the value repeated */
+
+          uinfo("[repeats %d more times]\n", count - 3);
+        }
+
+      /* Save the new address, value, and count */
+
+      prevaddr = addr;
+      preval = val;
+      count = 1;
+    }
+
+  /* Show the register value read */
+
+  uinfo("%08x->%08x\n", addr, val);
+  return val;
+}
+#endif
+
+/****************************************************************************
+ * Name: esp32s31_putreg
+ *
+ * Description:
+ *   Set the contents of an ESP32-S3 register to a value
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_ESP32S31_OTG_DEBUG_REGISTER
+static void esp32s31_putreg(uint32_t val, uint32_t addr)
+{
+  /* Show the register value being written */
+
+  uinfo("%08x<-%08x\n", addr, val);
+
+  /* Write the value */
+
+  putreg32(val, addr);
+}
+#endif

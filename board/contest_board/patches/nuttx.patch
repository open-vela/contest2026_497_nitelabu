+  .macro esp32s31_monlat_defer
+#ifdef CONFIG_ESP32S31_SMP
+  li      t0, 2                 /* t2 is the external-input bit mask. */
+  bne     t2, t0, 90f
+  la      t0, g_esp32s31_machine_monlat
+  csrr    t1, mhartid
+  slli    t1, t1, 6
+  add     t0, t0, t1
+  li      t1, 1
+  sw      t1, 32(t0)
+90:
+#endif
+  .endm

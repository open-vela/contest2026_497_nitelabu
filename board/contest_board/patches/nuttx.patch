+
+/* Endpoints ****************************************************************/
+
+/* Odd physical endpoint numbers are IN; even are OUT */
+
+#define ESP32S31_EPPHYIN2LOG(epphy)    ((uint8_t)(epphy) | USB_DIR_IN)
+#define ESP32S31_EPPHYOUT2LOG(epphy)   ((uint8_t)(epphy) | USB_DIR_OUT)

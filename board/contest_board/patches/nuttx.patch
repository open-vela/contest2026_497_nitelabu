+/****************************************************************************
+ * Name: esp32s31_ep0_configure
+ *
+ * Description:
+ *   Reset Usb engine
+ *
+ ****************************************************************************/
+
+static void esp32s31_ep0_configure(struct esp32s31_usbdev_s *priv)
+{
+  /* Enable EP0 IN and OUT */
+
+  esp32s31_epin_configure(&priv->epin[EP0], USB_EP_ATTR_XFER_CONTROL,
+                         ESP32S31_CDCACM_EP0MAXPACKET);
+  esp32s31_epout_configure(&priv->epout[EP0], USB_EP_ATTR_XFER_CONTROL,
+                          ESP32S31_CDCACM_EP0MAXPACKET);
+}

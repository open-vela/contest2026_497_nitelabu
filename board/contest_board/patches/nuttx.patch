+/****************************************************************************
+ * Name: esp32s31_epout_disable
+ *
+ * Description:
+ *   Disable an OUT endpoint will no longer be used
+ *
+ ****************************************************************************/
+
+static void esp32s31_epout_disable(struct esp32s31_ep_s *privep)
+{
+  uint32_t regaddr;
+  uint32_t regval;
+  irqstate_t flags;
+
+  usbtrace(TRACE_EPDISABLE, privep->epphy);
+
+  /* Is this an IN or an OUT endpoint */
+
+  /* Before disabling any OUT endpoint, the application must enable Global
+   * OUT NAK mode in the core.
+   */
+
+  flags = enter_critical_section();
+  esp32s31_enablegonak(privep);
+
+  /* Disable the required OUT endpoint by setting the EPDIS and SNAK bits int
+   * DOECPTL register.
+   */
+
+  regaddr = ESP32S31_OTG_DOEPCTL(privep->epphy);
+  regval = esp32s31_getreg(regaddr);
+  regval &= ~OTG_DOEPCTL_USBAEP;
+  regval |= (OTG_DOEPCTL_EPDIS | OTG_DOEPCTL_SNAK);
+  esp32s31_putreg(regval, regaddr);
+
+  /* Wait for the EPDISD interrupt which indicates that the OUT endpoint is
+   * completely disabled.
+   */
+
+#if 0    /* Doesn't happen */
+  regaddr = ESP32S31_OTG_DOEPINT(privep->epphy);
+  while ((esp32s31_getreg(regaddr) & OTG_DOEPINT_EPDISD) == 0);
+#else
+  /* REVISIT: */
+
+  up_udelay(10);
+#endif
+
+  /* Clear the EPDISD interrupt indication */
+
+  esp32s31_putreg(OTG_DOEPINT_EPDISD, ESP32S31_OTG_DOEPINT(privep->epphy));
+
+  /* Then disable the Global OUT NAK mode to continue receiving data from
+   * other non-disabled OUT endpoints.
+   */
+
+  esp32s31_disablegonak(privep);
+
+  /* Disable endpoint interrupts */
+
+  regval = esp32s31_getreg(ESP32S31_OTG_DAINTMSK);
+  regval &= ~OTG_DAINT_OEP(privep->epphy);
+  esp32s31_putreg(regval, ESP32S31_OTG_DAINTMSK);
+
+  /* Cancel any queued read requests */
+
+  esp32s31_req_cancel(privep, -ESHUTDOWN);
+
+  leave_critical_section(flags);
+}
+
+/****************************************************************************
+ * Name: esp32s31_epin_disable
+ *
+ * Description:
+ *   Disable an IN endpoint when it will no longer be used
+ *
+ ****************************************************************************/
+
+static void esp32s31_epin_disable(struct esp32s31_ep_s *privep)
+{
+  uint32_t regaddr;
+  uint32_t regval;
+  irqstate_t flags;
+
+  usbtrace(TRACE_EPDISABLE, privep->epphy);
+
+  /* After USB reset, the endpoint will already be deactivated by the
+   * hardware.
+   * Trying to disable again will just hang in the wait.
+   */
+
+  regaddr = ESP32S31_OTG_DIEPCTL(privep->epphy);
+  regval = esp32s31_getreg(regaddr);
+  if ((regval & OTG_DIEPCTL_USBAEP) == 0)
+    {
+      return;
+    }
+
+  /* This INEPNE wait logic is suggested by reference manual, but seems to
+   * get stuck to infinite loop.
+   */
+
+#if 0
+  /* Make sure that there is no pending IPEPNE interrupt (because we are to
+   * poll this bit below).
+   */
+
+  esp32s31_putreg(OTG_DIEPINT_INEPNE, ESP32S31_OTG_DIEPINT(privep->epphy));
+
+  /* Set the endpoint in NAK mode */
+
+  regaddr = ESP32S31_OTG_DIEPCTL(privep->epphy);
+  regval = esp32s31_getreg(regaddr);
+  regval &= ~OTG_DIEPCTL_USBAEP;
+  regval |= (OTG_DIEPCTL_EPDIS | OTG_DIEPCTL_SNAK);
+  esp32s31_putreg(regval, regaddr);
+
+  /* Wait for the INEPNE interrupt that indicates that we are now in NAK
+   * mode
+   */
+
+  regaddr = ESP32S31_OTG_DIEPINT(privep->epphy);
+  while ((esp32s31_getreg(regaddr) & OTG_DIEPINT_INEPNE) == 0);
+
+  /* Clear the INEPNE interrupt indication */
+
+  esp32s31_putreg(OTG_DIEPINT_INEPNE, regaddr);
+#endif
+
+  /* Deactivate and disable the endpoint by setting the EPDIS and SNAK bits
+   * the DIEPCTLx register.
+   */
+
+  flags = enter_critical_section();
+  regaddr = ESP32S31_OTG_DIEPCTL(privep->epphy);
+  regval = esp32s31_getreg(regaddr);
+  regval &= ~OTG_DIEPCTL_USBAEP;
+  regval |= (OTG_DIEPCTL_EPDIS | OTG_DIEPCTL_SNAK);
+  esp32s31_putreg(regval, regaddr);
+
+  /* Wait for the EPDISD interrupt which indicates that the IN endpoint is
+   * completely disabled.
+   */
+
+  regaddr = ESP32S31_OTG_DIEPINT(privep->epphy);
+  while ((esp32s31_getreg(regaddr) & OTG_DIEPINT_EPDISD) == 0);
+
+  /* Clear the EPDISD interrupt indication */
+
+  regval = esp32s31_getreg(regaddr);
+  regval |= OTG_DIEPINT_EPDISD;
+  esp32s31_putreg(regval, regaddr);
+
+  /* Flush any data remaining in the TxFIFO */
+
+  esp32s31_txfifo_flush(OTG_GRSTCTL_TXFNUM_D(privep->epphy));
+
+  /* Disable endpoint interrupts */
+
+  regval = esp32s31_getreg(ESP32S31_OTG_DAINTMSK);
+  regval &= ~OTG_DAINT_IEP(privep->epphy);
+  esp32s31_putreg(regval, ESP32S31_OTG_DAINTMSK);
+
+  /* Cancel any queued write requests */
+
+  esp32s31_req_cancel(privep, -ESHUTDOWN);
+  leave_critical_section(flags);
+}
+
+/****************************************************************************
+ * Name: esp32s31_ep_disable
+ *
+ * Description:
+ *   The endpoint will no longer be used
+ *
+ ****************************************************************************/
+
+static int esp32s31_ep_disable(struct usbdev_ep_s *ep)
+{
+  struct esp32s31_ep_s *privep = (struct esp32s31_ep_s *)ep;
+
+#ifdef CONFIG_DEBUG_FEATURES
+  if (!ep)
+    {
+      usbtrace(TRACE_DEVERROR(ESP32S31_TRACEERR_INVALIDPARMS), 0);
+      return -EINVAL;
+    }
+#endif
+
+  usbtrace(TRACE_EPDISABLE, privep->epphy);
+
+  /* Is this an IN or an OUT endpoint */
+
+  if (privep->isin)
+    {
+      /* Disable the IN endpoint */
+
+      esp32s31_epin_disable(privep);
+    }
+  else
+    {
+      /* Disable the OUT endpoint */
+
+      esp32s31_epout_disable(privep);
+    }
+
+  return OK;
+}

@@ -0,0 +1,29 @@
+#include "../demo-rmt-bttool-coex-pie/defconfig"
+
+# Integrated fixed 44.1 kHz PCM capture/playback with private user heaps.
+CONFIG_AUDIO=y
+CONFIG_AUDIO_PROCESS_OWNERSHIP=y
+CONFIG_AUDIO_FORMAT_PCM=y
+CONFIG_AUDIO_FORMAT_RAW=y
+CONFIG_AUDIO_DRIVER_SPECIFIC_BUFFERS=y
+CONFIG_ESP32S31_I2S=y
+CONFIG_ESP32S31_I2S_DUPLEX=y
+CONFIG_ESP32S31_I2S_DUPLEX_44K=y
+CONFIG_ESP32S31_AUDIO=y
+CONFIG_ES8311_SRC_MCLK=y
+CONFIG_ES8311_RATE_DEPENDENT_MCLK=y
+CONFIG_ES8311_SHARED_DUPLEX=y
+CONFIG_ES8311_BUFFER_SIZE=4096
+CONFIG_ES8311_NUM_BUFFERS=4
+CONFIG_ES8311_WORKER_STACKSIZE=4096
+CONFIG_SYSTEM_NXPLAYER=y
+CONFIG_NXPLAYER_COMMAND_LINE=m
+CONFIG_NXPLAYER_MAINTHREAD_STACKSIZE=8192
+CONFIG_NXPLAYER_PLAYTHREAD_STACKSIZE=8192
+CONFIG_SYSTEM_NXRECORDER=y
+CONFIG_NXRECORDER_COMMAND_LINE=m
+CONFIG_NXRECORDER_MAINTHREAD_STACKSIZE=8192
+CONFIG_NXRECORDER_RECORDTHREAD_STACKSIZE=8192

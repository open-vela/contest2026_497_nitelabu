 /****************************************************************************
  * Pre-processor Definitions
@@ -117,6 +132,249 @@ static const struct esp_mtd_dev_s g_esp_spiflash =
  * Private Functions
  ****************************************************************************/
 
+#ifdef CONFIG_ESP32S31_SPIFLASH_PSRAM_STACK
+enum esp_flash_op_e
+{
+  ESP_FLASH_READ,
+  ESP_FLASH_WRITE,
+  ESP_FLASH_ERASE
+};
+
+struct esp_flash_request_s
+{
+  struct work_s work;
+  sem_t done;
+  enum esp_flash_op_e op;
+  uint32_t address;
+  uint32_t size;
+  void *buffer;
+  int result;
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  bool trace;
+#endif
+};
+
+static int esp_flash_execute(enum esp_flash_op_e op, uint32_t address,
+                             void *buffer, uint32_t size)
+{
+  /* Do not enter the cache-off path if LPWORK was configured with a stack
+   * outside internal SRAM. The caller's buffer may still reside in PSRAM:
+   * the S31 SPI layer copies it only while the external cache is enabled.
+   */
+
+  if (!esp_ptr_internal((void *)up_getsp()))
+    {
+      return -EFAULT;
+    }
+
+  switch (op)
+    {
+      case ESP_FLASH_READ:
+        return spi_flash_read(address, buffer, size);
+      case ESP_FLASH_WRITE:
+        return spi_flash_write(address, buffer, size);
+      case ESP_FLASH_ERASE:
+        return spi_flash_erase_range(address, size);
+      default:
+        return -EINVAL;
+    }
+}
+
+static void esp_flash_work(void *arg)
+{
+  struct esp_flash_request_s *request = arg;
+  int result;
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  /* Caller may return immediately when done is posted. Keep no request
+   * dereference after that post, including for diagnostic output.
+   */
+  bool trace = request->trace;
+#endif
+
+  /* Read request arguments before the cache-off operation. Publish its
+   * result and completion only after the cache has been restored.
+   */
+
+  result = esp_flash_execute(request->op, request->address,
+                             request->buffer, request->size);
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  if (trace)
+    {
+      esp_rom_uart_tx_one_char('X');
+    }
+#endif
+  request->result = result;
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  if (trace)
+    {
+      esp_rom_uart_tx_one_char('H');
+    }
+#endif
+  nxsem_post(&request->done);
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  if (trace)
+    {
+      uintptr_t status = READ_CSR(CSR_MSTATUS);
+      uintptr_t threshold = READ_CSR(CSR_INTTHRESH);
+      unsigned int locks = this_task()->lockcount;
+      const char *hex = "0123456789abcdef";
+
+      esp_rom_uart_tx_one_char('J');
+      esp_rom_uart_tx_one_char('[');
+      for (int shift = 28; shift >= 0; shift -= 4)
+        {
+          esp_rom_uart_tx_one_char(hex[(status >> shift) & 15]);
+        }
+
+      esp_rom_uart_tx_one_char(':');
+      esp_rom_uart_tx_one_char(hex[(threshold >> 4) & 15]);
+      esp_rom_uart_tx_one_char(hex[threshold & 15]);
+      esp_rom_uart_tx_one_char(':');
+      esp_rom_uart_tx_one_char(hex[(locks >> 4) & 15]);
+      esp_rom_uart_tx_one_char(hex[locks & 15]);
+      esp_rom_uart_tx_one_char(']');
+    }
+#endif
+}
+
+#ifdef CONFIG_ESP32S31_FLASH_DIRECT_WORKER
+static mutex_t g_flash_dispatch_lock = NXMUTEX_INITIALIZER;
+static sem_t g_flash_wakeup = SEM_INITIALIZER(0);
+static pid_t g_flash_worker = -1;
+static struct esp_flash_request_s *g_flash_pending;
+static DRAM_ATTR uint32_t g_flash_stack[1024] aligned_data(16);
+
+static int esp_flash_worker_main(int argc, char **argv)
+{
+  for (;;)
+    {
+      while (nxsem_wait_uninterruptible(&g_flash_wakeup) < 0);
+      esp_flash_work(g_flash_pending);
+    }
+
+  return 0;
+}
+
+static int esp_flash_submit_worker(struct esp_flash_request_s *request)
+{
+  int ret = nxmutex_lock(&g_flash_dispatch_lock);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  /* Serialize publication and completion. The caller's stack and buffer
+   * remain alive until the worker has restored the external cache.
+   */
+
+  if (g_flash_worker < 0)
+    {
+      if (!esp_ptr_internal(g_flash_stack))
+        {
+          ret = -EFAULT;
+          goto out;
+        }
+
+      nxsem_set_protocol(&g_flash_wakeup, SEM_PRIO_NONE);
+      g_flash_worker = kthread_create_with_stack("flash_io",
+                          CONFIG_SCHED_LPWORKPRIORITY, g_flash_stack,
+                          sizeof(g_flash_stack), esp_flash_worker_main, NULL);
+      if (g_flash_worker < 0)
+        {
+          ret = g_flash_worker;
+          goto out;
+        }
+    }
+
+  g_flash_pending = request;
+  ret = nxsem_post(&g_flash_wakeup);
+  if (ret == OK)
+    {
+      while (nxsem_wait_uninterruptible(&request->done) < 0);
+      ret = request->result;
+    }
+
+out:
+  nxmutex_unlock(&g_flash_dispatch_lock);
+  return ret;
+}
+#endif
+
+static int esp_flash_dispatch(enum esp_flash_op_e op, uint32_t address,
+                              void *buffer, uint32_t size)
+{
+  struct esp_flash_request_s request =
+  {
+    .op = op,
+    .address = address,
+    .size = size,
+    .buffer = buffer
+  };
+  int oldstate;
+  int ret;
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  request.trace = g_esp32s31_audio_trace_active &&
+                  op == ESP_FLASH_READ && g_audio_dispatch_traced < 128;
+  if (request.trace)
+    {
+      g_audio_dispatch_traced++;
+      esp_rom_uart_tx_one_char('D');
+    }
+#endif
+
+  if (esp_ptr_internal((void *)up_getsp()))
+    {
+      return esp_flash_execute(op, address, buffer, size);
+    }
+
+  /* Each caller owns its work item. The SPI guard serializes actual Flash
+   * access; no Flash lock is held while waiting for LPWORK. Cancellation
+   * must not release this stack or the caller's buffer before completion.
+   */
+
+  task_setcancelstate(TASK_CANCEL_DISABLE, &oldstate);
+  nxsem_init(&request.done, 0, 0);
+  nxsem_set_protocol(&request.done, SEM_PRIO_NONE);
+#ifdef CONFIG_ESP32S31_FLASH_DIRECT_WORKER
+  ret = esp_flash_submit_worker(&request);
+#else
+  ret = work_queue(LPWORK, &request.work, esp_flash_work, &request, 0);
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  if (request.trace)
+    {
+      esp_rom_uart_tx_one_char('Q');
+    }
+#endif
+  if (ret == OK)
+    {
+      while (nxsem_wait_uninterruptible(&request.done) < 0)
+        {
+          /* The initialized semaphore stays valid until completion. */
+        }
+
+      ret = request.result;
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+      if (request.trace)
+        {
+          esp_rom_uart_tx_one_char('W');
+        }
+#endif
+    }
+
+#endif /* CONFIG_ESP32S31_FLASH_DIRECT_WORKER */
+  nxsem_destroy(&request.done);
+  task_setcancelstate(oldstate, NULL);
+#ifdef CONFIG_ESP32S31_FLASH_AUDIO_TRACE
+  if (request.trace)
+    {
+      esp_rom_uart_tx_one_char('Z');
+    }
+#endif
+  return ret;
+}
+#endif

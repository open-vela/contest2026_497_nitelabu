#
# Initial ESP32-S31 Core Function Board bring-up configuration.
#
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
CONFIG_ARCH="risc-v"
CONFIG_ARCH_BOARD="esp32s31-core-function-board"
CONFIG_ARCH_BOARD_ESP32S31_CORE_FUNCTION_BOARD=y
CONFIG_ARCH_CHIP="esp32s31"
CONFIG_ARCH_CHIP_ESP32S31=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_RISCV=y
CONFIG_BOARD_LOOPSPERMSEC=15000
CONFIG_BUILTIN=y
CONFIG_ESPRESSIF_CPU_FREQ_320=y
CONFIG_ESPRESSIF_ESP32S31=y
CONFIG_ESPRESSIF_FLASH_16M=y
CONFIG_ESPRESSIF_FLASH_FREQ_80M=y
CONFIG_ESPRESSIF_SIMPLE_BOOT=y
CONFIG_EXPERIMENTAL=y
CONFIG_FS_PROCFS=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INTELHEX_BINARY=y
CONFIG_LIBC_PERROR_STDOUT=y
CONFIG_LIBC_STRERROR=y
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK=6
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_NSH_STRERROR=y
CONFIG_PREALLOC_TIMERS=0
CONFIG_RISCV_TOOLCHAIN_GNU_RV32=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_START_DAY=11
CONFIG_START_MONTH=8
CONFIG_START_YEAR=2026
CONFIG_SYSTEM_NSH=y
CONFIG_ESPRESSIF_UART0_RXPIN=59
CONFIG_ESPRESSIF_UART0_TXPIN=58
CONFIG_UART0_SERIAL_CONSOLE=y
# CONFIG_ESPRESSIF_BROWNOUT_DET is not set


# Original mm and block tests call internal kernel APIs and require FLAT.
# This is a separate test image, not a replacement for the SMP/MMU demo.
CONFIG_BUILD_FLAT=y
CONFIG_RAM_START=0x2f000000
CONFIG_RAM_SIZE=524288
CONFIG_ARCH_FPU=y
CONFIG_ARCH_SETJMP_H=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ASSERTIONS=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_INITTHREAD_STACKSIZE=8192
CONFIG_BOARDCTL_RESET=y
CONFIG_DEFAULT_TASK_STACKSIZE=8192
CONFIG_INIT_STACKSIZE=8192
CONFIG_TLS_LOG2_MAXSTACK=14
CONFIG_LIBC_REGEX=y
CONFIG_LIBC_EXECFUNCS=y
CONFIG_TESTING_CMOCKA=y
CONFIG_TESTING_CMOCKA_STACKSIZE=16384
CONFIG_TESTING_DRIVER_TEST=y
CONFIG_TESTING_DRIVER_TEST_STACKSIZE=8192
CONFIG_TESTING_MM=y
CONFIG_TESTING_MM_STACKSIZE=16384
CONFIG_FS_TMPFS=y
CONFIG_FS_WRITABLE=y
CONFIG_BCH=y
CONFIG_DRVR_WRITEBUFFER=y
CONFIG_DRVR_READAHEAD=y
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_HPWORKSTACKSIZE=4096
CONFIG_ESPRESSIF_FLASH_MODE_DIO=y
CONFIG_ESPRESSIF_SPIRAM=y
CONFIG_ESPRESSIF_SPIRAM_BOOT_INIT=y
CONFIG_ESPRESSIF_SPIRAM_USE_8LINE_MODE=y
CONFIG_ESPRESSIF_SPIRAM_USER_HEAP=y
CONFIG_MM_REGIONS=2
# CONFIG_NSH_DISABLE_MKRD is not set
# CONFIG_NSH_DISABLE_REBOOT is not set


# All three original RTC tests, including SIGEV_THREAD periodic delivery.
CONFIG_RTC=y
CONFIG_RTC_DRIVER=y
CONFIG_RTC_ALARM=y
CONFIG_RTC_PERIODIC=y
CONFIG_RTC_IOCTL=y
CONFIG_SIG_EVTHREAD=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_LPWORKSTACKSIZE=4096
CONFIG_ESPRESSIF_HR_TIMER_TASK_STACK_SIZE=4096
# CONFIG_RTC_ARCH is not set
# CONFIG_RTC_DATETIME is not set
# CONFIG_TIMER_ARCH is not set


# Isolated half-duplex raw PCM profile for original audio xTS.
CONFIG_ESPRESSIF_I2C0=y
CONFIG_ESPRESSIF_I2C0_SCLPIN=50
CONFIG_ESPRESSIF_I2C0_SDAPIN=51
CONFIG_I2C_RESET=y
CONFIG_AUDIO=y
CONFIG_AUDIO_FORMAT_PCM=y
CONFIG_AUDIO_FORMAT_RAW=y
CONFIG_AUDIO_DRIVER_SPECIFIC_BUFFERS=y
CONFIG_ESP32S31_I2S=y
CONFIG_ESP32S31_AUDIO=y
CONFIG_ES8311_SRC_MCLK=y
CONFIG_ES8311_BUFFER_SIZE=4096
CONFIG_ES8311_NUM_BUFFERS=4
CONFIG_ES8311_WORKER_STACKSIZE=4096
CONFIG_PTHREAD_STACK_MIN=4096


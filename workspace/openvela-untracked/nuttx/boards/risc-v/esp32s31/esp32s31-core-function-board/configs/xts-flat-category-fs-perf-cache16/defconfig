# and copy-on-write semantics while doubling the default 256-byte cache.
# A 1024-byte cache reduces partial-cache churn without approaching the
# LittleFS erase-block limit.
#include "../xts-flat-category-fs-large/defconfig"
CONFIG_FS_LITTLEFS_CACHE_SIZE_FACTOR=16

# Isolated performance candidate. Keep the original 3 MiB scratch layout and
# LittleFS copy-on-write semantics while caching half of one 4 KiB erase block.
# The 2048-byte cache remains strictly below the erase block size accepted by
# the vendored LittleFS implementation and reduces partial-cache churn.
#include "../xts-flat-category-fs-large/defconfig"
CONFIG_FS_LITTLEFS_CACHE_SIZE_FACTOR=32

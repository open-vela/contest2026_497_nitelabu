#include "../xts-flat-rtc/defconfig"

# USB device registration is lazy, initiated by the original adbd application.
# CONFIG_ESPRESSIF_SPIRAM_USER_HEAP is not set
CONFIG_MM_REGIONS=1
CONFIG_USBDEV=y
CONFIG_ESP32S31_USBDEV=y
CONFIG_USBDEV_SELFPOWERED=y
CONFIG_USBDEV_MAXPOWER=0
CONFIG_USBADB=y
CONFIG_LIBUV=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_EPOLL=y
CONFIG_PIPES=y
CONFIG_NET=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NET_LOCAL=y
CONFIG_NET_LOCAL_STREAM=y
CONFIG_NET_SOCKOPTS=y
CONFIG_SYSTEM_ADBD=y
CONFIG_ADBD_USB_SERVER=y
CONFIG_ADBD_USB_BOARDCTL=y
CONFIG_ADBD_STACKSIZE=8192
CONFIG_ADBD_PRODUCT_NAME="ESP32-S31 Function-CoreBoard-1"
CONFIG_ADBD_PRODUCT_MODEL="openvela S31"
CONFIG_TLS_TASK_NELEM=4
CONFIG_SCHED_HAVE_PARENT=y
CONFIG_SCHED_CHILD_STATUS=y
CONFIG_PSEUDOTERM=y
CONFIG_PSEUDOTERM_SUSV1=y
CONFIG_FS_BINFS=y
CONFIG_ADBD_SHELL_SERVICE=y
CONFIG_ADBD_SHELL_SERVICE_CMD="nsh"
CONFIG_ADBD_SHELL_SERVICE_PATH="/bin/nsh"

+#ifdef CONFIG_ESP32S31_SPIRAM_SEPARATE_HEAP
+/* S31 FLAT uses non-overlapping SRAM kernel and PSRAM user heaps. Explicit
+ * internal requests must never fall back to PSRAM. The caller still owns
+ * cache synchronization for external DMA buffers.
+ */
+
+static bool esp_heap_caps_conflict(uint32_t caps)
+{
+  return (caps & (MALLOC_CAP_INTERNAL | MALLOC_CAP_SPIRAM)) ==
+         (MALLOC_CAP_INTERNAL | MALLOC_CAP_SPIRAM);
+}
+
+static void *esp_heap_caps_s31_alloc(size_t alignment, size_t size,
+                                    uint32_t caps)
+{
+  if (esp_heap_caps_conflict(caps))
+    {
+      return NULL;
+    }
+
+  alignment = esp_heap_caps_effective_alignment(alignment, caps);
+  return (caps & MALLOC_CAP_SPIRAM) ? kumm_memalign(alignment, size) :
+                                    kmm_memalign(alignment, size);
+}
+
+static struct mallinfo esp_heap_caps_s31_info(uint32_t caps)
+{
+  struct mallinfo empty = {0};
+
+  if (esp_heap_caps_conflict(caps))
+    {
+      return empty;
+    }
+
+  return (caps & MALLOC_CAP_SPIRAM) ? kumm_mallinfo() : kmm_mallinfo();
+}
+#endif
+

diff --git a/testcases/CMakeLists.txt b/testcases/CMakeLists.txt
new file mode 100644
index 0000000..9e7c0d5
--- /dev/null
+++ b/testcases/CMakeLists.txt
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# Register the existing filesystem cases without changing their test bodies.
+# Other testcase families still use their existing Make integration.
+if(CONFIG_TESTS_TESTCASES)
+  macro(testcase_incdirs)
+    list(APPEND TESTCASE_INCDIRS ${ARGN})
+  endmacro()
+
+  macro(testcase_srcs)
+    list(APPEND TESTCASE_SRCS ${ARGN})
+  endmacro()
+
+  function(testcase_app name source)
+    nuttx_add_application(
+      NAME ${name}
+      MODULE ${CONFIG_TESTS_TESTCASES}
+      PRIORITY ${CONFIG_TESTING_TESTCASES_PRIORITY}
+      STACKSIZE ${CONFIG_TESTING_TESTCASES_STACKSIZE}
+      SRCS ${source} ${TESTCASE_SRCS}
+      INCLUDE_DIRECTORIES ${TESTCASE_INCDIRS}
+      COMPILE_FLAGS -Werror -Wno-unused-function)
+  endfunction()
+
+  add_subdirectory(vela_fs_test)
+  add_subdirectory(kvtest)
+endif()

diff --git a/ffmpeg/Kconfig b/ffmpeg/Kconfig
index a9ab598..b74fe80 100644
--- a/ffmpeg/Kconfig
+++ b/ffmpeg/Kconfig
@@ -28,6 +28,13 @@ config LIB_FFMPEG_CONFIGURATION
 	---help---
 		FFmpeg configuration which pass to configure
 
+config LIB_FFMPEG_AUDIO_TABLEGEN
+	bool "Generate hardcoded AAC, MP3 and PCM tables on the host"
+	default n
+	help
+		Run the existing FFmpeg host generators before compiling audio codecs.
+		Use with --enable-hardcoded-tables to reduce target static RAM usage.
+
 config LIB_FFMPEG_TEST
 	bool "enable ffmpeg test"
 	default n
diff --git a/ffmpeg/Makefile b/ffmpeg/Makefile
index 04bceb3..a713234 100644
--- a/ffmpeg/Makefile
+++ b/ffmpeg/Makefile
@@ -44,6 +44,9 @@ NASRCS    :=
 SRC_PATH  := ffmpeg
 
 CFG_ARCH  := $(CONFIG_ARCH)
+ifeq ($(CONFIG_ARCH),risc-v)
+  CFG_ARCH = riscv
+endif
 ifeq ($(CONFIG_ARCH),avr)
   CFG_ARCH = avr32
 endif
@@ -295,6 +298,19 @@ $(DST_PATH)/ffbuild/config.mak:
 		--ld=echo --pkg-config=: assert_level=3 $(CFG_CMDS)                          \
 		"$(CONFIG_LIB_FFMPEG_CONFIGURATION)"
 
+ifeq ($(CONFIG_LIB_FFMPEG_AUDIO_TABLEGEN),y)
+AUDIO_TABLE_NAMES := aacps cbrt sinewin mpegaudio mpegaudiodec_common pcm
+AUDIO_TABLE_HEADERS := $(addprefix $(DST_PATH)/libavcodec/,$(addsuffix _tables.h,$(AUDIO_TABLE_NAMES)))
+
+$(DST_PATH)/libavcodec/%_tables.h: $(SRC_PATH)/libavcodec/%_tablegen.c $(wildcard $(SRC_PATH)/libavcodec/*tablegen*.h) $(DST_PATH)/ffbuild/config.mak
+	$(Q)mkdir -p $(DST_PATH)/libavcodec
+	$(Q)$(HOSTCC) -O2 -DCONFIG_SMALL=1 -I$(DST_PATH) -I$(SRC_PATH) $< -lm -o $(@:_tables.h=_tablegen_host)
+	$(Q)$(@:_tables.h=_tablegen_host) > $@.tmp
+	$(Q)mv $@.tmp $@
+
+context:: $(AUDIO_TABLE_HEADERS)
+endif
+
 context:: $(DST_PATH)/ffbuild/config.mak $(DST_PATH)/libavutil/ffversion.h
 ifneq ($(DST_PATH),)
 	@$(eval ALL_SRCS = $(ASRCS) $(CSRCS) $(MAINSRC) $(NASRCS))

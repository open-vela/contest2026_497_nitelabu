+static int h4_close(const struct device* dev)
+{
+    struct h4_data* h4 = dev->data;
+    service_loop_t* loop = get_service_uv_loop()->data;
+    uv_thread_t current = uv_thread_self();
+    int ret = 0;
+
+    /* Stop receiving on the service loop before the host frees its state. */
+    if (uv_thread_equal(&current, &loop->thread))
+        hci_remove_recv(NULL);
+    else
+        do_in_service_loop_sync(hci_remove_recv, NULL);
+
+    pthread_mutex_lock(&h4->mutex);
+    if (h4->fd >= 0 && close(h4->fd) < 0)
+        ret = -errno;
+    h4->fd = -1;
+    h4->recv = NULL;
+    h4->hci_data = NULL;
+    h4->frame_size = 0;
+    pthread_mutex_unlock(&h4->mutex);
+    return ret;
+}

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Run the actual bounded LED application's control flow with fake file I/O."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    source = Path(__file__).with_name("s31led_main.c")
+    root = source.parents[2]
+    for enabled in ("", "y", "m"):
+        makefile = (f"APPDIR := {root}\nCONFIG_EXAMPLES_S31LED := {enabled}\n"
+                    f"include {source.with_name('Make.defs')}\n"
+                    "$(info REGISTERED=$(CONFIGURED_APPS))\n"
+                    ".PHONY: check\ncheck:;@:\n")
+        result = subprocess.run(["make", "-sf", "-", "--no-print-directory"],
+                                input=makefile, capture_output=True, text=True,
+                                check=True)
+        expected = str(source.parent) if enabled else ""
+        assert result.stdout.strip() == "REGISTERED=" + expected, result.stdout
+    print("S31_LED_MAKE_REGISTRATION=PASS disabled/builtin/module")
+    fixture = r'''
+#define _DEFAULT_SOURCE
+#include <assert.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+static unsigned opens, closes, writes, delays, fail_open, fail_write;
+static int alive[2];
+static int fake_open(const char *path, int flags, ...)
+{
+  assert(strcmp(path, "/dev/leds0") == 0 && flags == O_WRONLY);
+  opens++;
+  if (opens == fail_open) { return -1; }
+  assert(opens <= 2);
+  alive[opens - 1] = 1;
+  return 9 + opens;
+}
+static int fake_close(int fd)
+{
+  assert(fd >= 10 && fd <= 11 && alive[fd - 10]);
+  alive[fd - 10] = 0;
+  closes++;
+  return 0;
+}
+static off_t fake_lseek(int fd, off_t offset, int whence)
+{
+  assert(fd == 11 && alive[1] && !alive[0] && offset == 0 && whence == SEEK_SET);
+  return 0;
+}
+static ssize_t fake_write(int fd, const void *data, size_t size)
+{
+  const uint32_t colors[] = {0x80000, 0x800, 8, 0};
+  assert(fd == 11 && alive[1] && size == 4);
+  assert(*(const uint32_t *)data == colors[writes % 4]);
+  writes++;
+  return writes == fail_write ? -1 : (ssize_t)size;
+}
+static int fake_usleep(useconds_t usec)
+{
+  assert(usec == 250000);
+  delays++;
+  return 0;
+}
+static void fake_perror(const char *text) { (void)text; }
+#define main led_main
+#define open fake_open
+#define close fake_close
+#define write fake_write
+#define lseek fake_lseek
+#define usleep fake_usleep
+#define perror fake_perror
+'''
+    fixture += f'#include "{source}"\n#undef main\n'
+    fixture += r'''
+static void reset(void)
+{
+  assert(!alive[0] && !alive[1]);
+  opens = closes = writes = delays = fail_open = fail_write = 0;
+}
+int main(void)
+{
+  char *args[] = {"s31led", "2", "extra", NULL};
+  const char *bad[] = {"0", "11", "bad", "", "999999999999999999999"};
+  for (unsigned i = 0; i < sizeof(bad) / sizeof(bad[0]); i++) {
+    args[1] = (char *)bad[i];
+    assert(led_main(2, args) != 0 && opens == 0);
+  }
+  assert(led_main(3, args) != 0 && opens == 0);
+  args[1] = "2";
+  assert(led_main(2, args) == 0);
+  assert(opens == 2 && closes == 2 && writes == 8 && delays == 8);
+  reset();
+  fail_open = 1;
+  assert(led_main(1, args) != 0 && closes == 0 && writes == 0);
+  reset();
+  fail_open = 2;
+  assert(led_main(1, args) != 0 && closes == 1 && writes == 0);
+  reset();
+  fail_write = 3;
+  assert(led_main(1, args) != 0 && closes == 2 && writes == 3 && delays == 2);
+  reset();
+  puts("S31_LED_APP=PASS bounded low brightness/multi-open/failure cleanup");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-led-app-") as directory:
+        path = Path(directory)
+        (path / "nuttx").mkdir()
+        (path / "nuttx/config.h").write_text("")
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        "-I", str(path), str(path / "test.c"),
+                        "-o", str(path / "test")], check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

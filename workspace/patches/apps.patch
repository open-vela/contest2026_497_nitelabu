+++ b/examples/s31demo/README.md
@@ -0,0 +1,57 @@
+# S31 basic LAN demo
+
+A small, read-only HTTP application for the ESP32-S31 bring-up demo.
+It serves `/` and `/status.json` on TCP port 8080, showing the board's IPv4
+address, monotonic uptime and request count. The page refreshes every five
+seconds and loads no external resources. No credentials or files are served.
+
+For an offline console snapshot, without provisioning or starting HTTP:
+
+```text
+prlimit -s 8192 s31demo --status
+```
+
+An optional interface argument selects the queried interface; the default is
+`wlan0`. This mode reports monotonic uptime, interface UP state, IPv4 address,
+and the presence of the RGB, button, I2C, PCM and HCI device nodes. It uses a
+datagram socket only for read-only interface ioctls, sends no traffic, opens no
+devices and exits immediately. `STATE=PRESENT` means the device node exists,
+not that playback, capture, Bluetooth or any xTS case passed. Absent nodes are
+reported as `STATE=ABSENT`. Successful queries end with `S31_DEMO_STATUS=OK`;
+query errors are reported explicitly with a nonzero exit status. This mode
+does not start DHCP, associate Wi-Fi or change the interface state.
+
+Build the NuttX board's `demo` configuration and flash its matching kernel
+and AppFS together. This configuration uses the validated b/g/n station path;
+it is not an HE, Bluetooth, Zigbee, performance or long-duration certification.
+
+After associating with Wi-Fi and obtaining DHCP, start it from NSH:
+
+```text
+prlimit -s 8192 s31demo &
+```
+
+Open `http://<board-ip>:8080/` from a device on the same trusted LAN.
+The explicit stack limit is required when AppFS stripping removes the ELF's
+`nx_stacksize` symbol; otherwise the loader falls back to a 2 KiB stack.
+Stop the reported process with `kill <pid>` or reset the board. The application
+does not configure Wi-Fi or save credentials. The host-side
+`nuttx/tools/espressif/esp32s31_demo.py` can perform interactive, redacted setup
+and leave the demo running.
+
+This is an unauthenticated, single-client demonstration, not an Internet-facing
+web server. Only GET is accepted; headers are capped at 2047 bytes and socket
+reads/writes have five-second timeouts. Oversized or malformed requests close
+the connection. There are no upload, shell-command or storage-write endpoints.
+
+Host regression: `python3 examples/s31demo/test_host.py` from the Apps tree.
+It compiles the actual C source and tests HTML/JSON, repeated requests, method
+and path rejection, and the header bound. Real board validation is separate.
+
+LAN validation: `python3 examples/s31demo/test_http.py <board-ip>`.
+This checks the HTML and ten successive JSON responses using a direct HTTP
+client, without reading HTTP proxy environment settings.
+Add `--samples 100 --boundaries` to also check a longer sequence, rejected
+methods/paths, browser-sized headers, oversized headers and recovery after an
+idle partial request. The timeout check occupies this single-client server
+for approximately five seconds; use it only on an authorized test board.
diff --git a/examples/s31demo/s31demo_main.c b/examples/s31demo/s31demo_main.c
new file mode 100644
index 000000000..c0c02b33e
--- /dev/null
+++ b/examples/s31demo/s31demo_main.c
@@ -0,0 +1,353 @@
+/****************************************************************************
+ * apps/examples/s31demo/s31demo_main.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <arpa/inet.h>
+#include <net/if.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static int print_status(const char *interface)
+{
+  static const char *const devices[] =
+  {
+    "/dev/leds0", "/dev/buttons", "/dev/i2c0",
+    "/dev/audio/pcm0p", "/dev/audio/pcm0c", "/dev/ttyHCI0"
+  };
+  struct timespec uptime;
+  struct ifreq req;
+  struct sockaddr_in *address;
+  struct stat st;
+  char ip[INET_ADDRSTRLEN];
+  int fd;
+  int result = 0;
+  int flags;
+  size_t i;
+
+  if (clock_gettime(CLOCK_MONOTONIC, &uptime) < 0)
+    {
+      perror("s31demo status clock_gettime");
+      printf("S31_DEMO_STATUS=ERROR\n");
+      return 1;
+    }
+
+  /* This socket is only an ioctl handle. No network traffic or listener
+   * is created, and no interface settings are changed.
+   */
+
+  fd = socket(AF_INET, SOCK_DGRAM, 0);
+  if (fd < 0)
+    {
+      perror("s31demo status socket");
+      printf("S31_DEMO_STATUS=ERROR\n");
+      return 1;
+    }
+
+  memset(&req, 0, sizeof(req));
+  snprintf(req.ifr_name, sizeof(req.ifr_name), "%s", interface);
+  if (ioctl(fd, SIOCGIFFLAGS, (unsigned long)&req) < 0)
+    {
+      perror("s31demo status SIOCGIFFLAGS");
+      close(fd);
+      printf("S31_DEMO_STATUS=ERROR\n");
+      return 1;
+    }
+
+  flags = req.ifr_flags;
+  memset(&req, 0, sizeof(req));
+  snprintf(req.ifr_name, sizeof(req.ifr_name), "%s", interface);
+  if (ioctl(fd, SIOCGIFADDR, (unsigned long)&req) < 0)
+    {
+      perror("s31demo status SIOCGIFADDR");
+      close(fd);
+      printf("S31_DEMO_STATUS=ERROR\n");
+      return 1;
+    }
+
+  address = (struct sockaddr_in *)&req.ifr_addr;
+  if (inet_ntop(AF_INET, &address->sin_addr, ip, sizeof(ip)) == NULL)
+    {
+      perror("s31demo status inet_ntop");
+      close(fd);
+      printf("S31_DEMO_STATUS=ERROR\n");
+      return 1;
+    }
+
+  close(fd);
+  printf("S31_DEMO_INTERFACE=%s\n", interface);
+  printf("S31_DEMO_UPTIME_SECONDS=%lu\n", (unsigned long)uptime.tv_sec);
+  printf("S31_DEMO_INTERFACE_UP=%d\n", (flags & IFF_UP) != 0);
+  printf("S31_DEMO_IPV4=%s\n", ip);
+
+  /* Presence is not a functional test. Do not open devices here: opening
+   * a device may initialize hardware or alter an ongoing operation.
+   */
+
+  for (i = 0; i < sizeof(devices) / sizeof(devices[0]); i++)
+    {
+      if (stat(devices[i], &st) == 0)
+        {
+          printf("S31_DEMO_DEVICE=%s STATE=PRESENT\n", devices[i]);
+        }
+      else if (errno == ENOENT)
+        {
+          printf("S31_DEMO_DEVICE=%s STATE=ABSENT\n", devices[i]);
+        }
+      else
+        {
+          fprintf(stderr, "s31demo status stat %s: %s\n",
+                  devices[i], strerror(errno));
+          printf("S31_DEMO_DEVICE=%s STATE=ERROR\n", devices[i]);
+          result = 1;
+        }
+    }
+
+  printf("S31_DEMO_STATUS=%s\n", result == 0 ? "OK" : "ERROR");
+  return result;
+}
+
+static int send_all(int fd, const char *buffer, size_t length)
+{
+  while (length > 0)
+    {
+      ssize_t sent = send(fd, buffer, length, 0);
+      if (sent < 0 && errno == EINTR)
+        {
+          continue;
+        }
+
+      if (sent <= 0)
+        {
+          return -1;
+        }
+
+      buffer += sent;
+      length -= sent;
+    }
+
+  return 0;
+}
+
+static void serve_client(int fd, const char *interface, uint32_t requests)
+{
+  struct timeval timeout;
+  struct timespec uptime;
+  struct ifreq req;
+  struct sockaddr_in *address;
+  char input[2048];
+  char body[1536];
+  char header[192];
+  char method[8];
+  char path[64];
+  char version[16];
+  char ip[INET_ADDRSTRLEN] = "0.0.0.0";
+  const char *status = "200 OK";
+  const char *type = "text/html; charset=utf-8";
+  size_t used = 0;
+  int length;
+  int headlen;
+
+  timeout.tv_sec = 5;
+  timeout.tv_usec = 0;
+
+  if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout,
+                 sizeof(timeout)) < 0 ||
+      setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout,
+                 sizeof(timeout)) < 0)
+    {
+      return;
+    }
+
+  /* Bounded headers, no body processing, and no reflected request data. */
+
+  input[0] = '\0';
+  while (strstr(input, "\r\n\r\n") == NULL)
+    {
+      ssize_t received = recv(fd, input + used, sizeof(input) - used - 1, 0);
+      if (received < 0 && errno == EINTR)
+        {
+          continue;
+        }
+
+      if (received <= 0)
+        {
+          return;
+        }
+
+      used += received;
+      input[used] = '\0';
+      if (used == sizeof(input) - 1)
+        {
+          return;
+        }
+    }
+
+  if (sscanf(input, "%7s %63s %15s", method, path, version) != 3 ||
+      (strcmp(version, "HTTP/1.0") != 0 &&
+       strcmp(version, "HTTP/1.1") != 0))
+    {
+      return;
+    }
+
+  memset(&req, 0, sizeof(req));
+  snprintf(req.ifr_name, sizeof(req.ifr_name), "%s", interface);
+  if (ioctl(fd, SIOCGIFADDR, (unsigned long)&req) == 0)
+    {
+      address = (struct sockaddr_in *)&req.ifr_addr;
+      inet_ntop(AF_INET, &address->sin_addr, ip, sizeof(ip));
+    }
+
+  memset(&uptime, 0, sizeof(uptime));
+  clock_gettime(CLOCK_MONOTONIC, &uptime);
+
+  if (strcmp(method, "GET") != 0)
+    {
+      status = "405 Method Not Allowed";
+      type = "text/plain";
+      length = snprintf(body, sizeof(body), "GET only\n");
+    }
+  else if (strcmp(path, "/status.json") == 0)
+    {
+      type = "application/json";
+      length = snprintf(body, sizeof(body),
+                        "{\"board\":\"ESP32-S31\",\"ipv4\":\"%s\","
+                        "\"uptime_seconds\":%lu,\"requests\":%"
+                        PRIu32 "}\n",
+                        ip, (unsigned long)uptime.tv_sec, requests);
+    }
+  else if (strcmp(path, "/") == 0)
+    {
+      length = snprintf(body, sizeof(body),
+                        "<!doctype html><html lang=en><meta charset=utf-8>"
+                        "<meta name=viewport content='width=device-width'>"
+                        "<meta http-equiv=refresh content=5>"
+                        "<title>openvela S31 demo</title>"
+                        "<style>body{font:18px system-ui;background:#102024;"
+                        "color:#edf8f0;max-width:640px;margin:10vh auto;"
+                        "padding:24px}h1{color:#7de6ad}dt{margin-top:20px;"
+                        "color:#aac2be}dd{margin:6px 0}"
+                        "a{color:#7de6ad}</style>"
+                        "<h1>Board is running</h1>"
+                        "<p>openvela / NuttX &middot; ESP32-S31</p>"
+                        "<p>Function-CoreBoard-1 &middot; basic LAN demo</p>"
+                        "<dl><dt>Wi-Fi IPv4</dt><dd>%s</dd>"
+                        "<dt>Uptime</dt><dd>%lu seconds</dd>"
+                        "<dt>HTTP requests</dt><dd>%" PRIu32 "</dd></dl>"
+                        "<p>Read-only status. Refreshes every 5 seconds.</p>"
+                        "<p><a href=/status.json>JSON status</a></p></html>",
+                        ip, (unsigned long)uptime.tv_sec, requests);
+    }
+  else
+    {
+      status = "404 Not Found";
+      type = "text/plain";
+      length = snprintf(body, sizeof(body), "Not found\n");
+    }
+
+  if (length < 0 || (size_t)length >= sizeof(body))
+    {
+      return;
+    }
+
+  headlen = snprintf(header, sizeof(header),
+                     "HTTP/1.1 %s\r\nContent-Type: %s\r\n"
+                     "Content-Length: %d\r\nCache-Control: no-store\r\n"
+                     "Connection: close\r\n\r\n", status, type, length);
+  if (headlen > 0 && (size_t)headlen < sizeof(header) &&
+      send_all(fd, header, headlen) == 0)
+    {
+      send_all(fd, body, length);
+    }
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int main(int argc, char **argv)
+{
+  struct sockaddr_in address;
+  bool status_only = argc > 1 && strcmp(argv[1], "--status") == 0;
+  const char *interface = status_only ? (argc > 2 ? argv[2] : "wlan0") :
+                                      (argc > 1 ? argv[1] : "wlan0");
+  uint32_t requests = 0;
+  int reuse = 1;
+  int server;
+
+  if (argc > (status_only ? 3 : 2) || interface[0] == '\0' ||
+      strlen(interface) >= IFNAMSIZ)
+    {
+      fprintf(stderr, "Usage: s31demo [--status] [interface]\n");
+      return 1;
+    }
+
+  if (status_only)
+    {
+      return print_status(interface);
+    }
+
+  signal(SIGPIPE, SIG_IGN);
+  server = socket(AF_INET, SOCK_STREAM, 0);
+  if (server < 0)
+    {
+      perror("s31demo socket");
+      return 1;
+    }
+
+  setsockopt(server, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+  memset(&address, 0, sizeof(address));
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_ANY);
+  address.sin_port = htons(CONFIG_EXAMPLES_S31DEMO_PORT);
+  if (bind(server, (struct sockaddr *)&address, sizeof(address)) < 0 ||
+      listen(server, 2) < 0)
+    {
+      perror("s31demo listen");
+      close(server);
+      return 1;
+    }
+
+  printf("S31_DEMO_READY port=%d interface=%s\n",
+         CONFIG_EXAMPLES_S31DEMO_PORT, interface);
+  fflush(stdout);
+  for (; ; )
+    {
+      int client = accept(server, NULL, NULL);
+      if (client < 0)
+        {
+          if (errno == EINTR)
+            {
+              continue;
+            }
+
+          perror("s31demo accept");
+          close(server);
+          return 1;
+        }
+
+      serve_client(client, interface, ++requests);
+      close(client);
+    }
+}
diff --git a/examples/s31demo/test_host.py b/examples/s31demo/test_host.py
new file mode 100644
index 000000000..2f1863bf4
--- /dev/null
+++ b/examples/s31demo/test_host.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Build the actual demo with host libc and check its bounded HTTP surface."""
+
+import http.client
+import json
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import time
+
+
+def main():
+    source = Path(__file__).with_name("s31demo_main.c")
+    with tempfile.TemporaryDirectory(prefix="s31demo-host-") as directory:
+        base = Path(directory)
+        (base / "nuttx").mkdir()
+        with socket.socket() as listener:
+            listener.bind(("127.0.0.1", 0))
+            port = listener.getsockname()[1]
+        (base / "nuttx/config.h").write_text(
+            f"#define CONFIG_EXAMPLES_S31DEMO_PORT {port}\n")
+        subprocess.run(["cc", "-std=c11", "-D_DEFAULT_SOURCE", "-Wall",
+                        "-Wextra", "-Werror", "-I", str(base), str(source),
+                        "-o", str(base / "demo")], check=True)
+        process = subprocess.Popen([str(base / "demo"), "lo"],
+                                   stdout=subprocess.PIPE,
+                                   stderr=subprocess.STDOUT, text=True)
+        try:
+            deadline = time.monotonic() + 5
+            while True:
+                try:
+                    with socket.create_connection(("127.0.0.1", port), 1):
+                        break
+                except OSError:
+                    assert process.poll() is None, "demo exited at startup"
+                    assert time.monotonic() < deadline, "demo startup timed out"
+                    time.sleep(0.05)
+
+            def request(method, path):
+                client = http.client.HTTPConnection("127.0.0.1", port, timeout=8)
+                try:
+                    client.request(method, path)
+                    response = client.getresponse()
+                    body = response.read()
+                    assert int(response.getheader("Content-Length")) == len(body)
+                    assert response.getheader("Cache-Control") == "no-store"
+                    return response.status, body
+                finally:
+                    client.close()
+
+            status, body = request("GET", "/")
+            assert status == 200 and b"Board is running" in body
+            first = None
+            for _ in range(20):
+                status, body = request("GET", "/status.json")
+                item = json.loads(body)
+                assert status == 200 and item["board"] == "ESP32-S31"
+                assert item["ipv4"] == "127.0.0.1" and item["uptime_seconds"] > 0
+                if first is not None:
+                    assert item["requests"] == first["requests"] + 1
+                first = item
+            assert request("POST", "/")[0] == 405
+            assert request("GET", "/../../etc/passwd")[0] == 404
+            client = http.client.HTTPConnection("127.0.0.1", port, timeout=8)
+            try:
+                client.request("GET", "/", headers={"User-Agent": "Browser " + "x" * 1024})
+                response = client.getresponse()
+                assert response.status == 200 and b"Board is running" in response.read()
+            finally:
+                client.close()
+            with socket.create_connection(("127.0.0.1", port), 2) as client:
+                client.sendall(b"GET / HTTP/1.1\r\nX: " + b"x" * 2500)
+                try:
+                    assert client.recv(1) == b""
+                except ConnectionResetError:
+                    pass
+            assert request("GET", "/")[0] == 200
+            print("S31_DEMO_HOST=PASS html/json/repeat/method/path/browser-headers/header-limit")
+        finally:
+            process.terminate()
+            try:
+                output = process.communicate(timeout=3)[0]
+            except subprocess.TimeoutExpired:
+                process.kill()
+                output = process.communicate()[0]
+            print(output, end="")
+
+
+if __name__ == "__main__":
+    main()

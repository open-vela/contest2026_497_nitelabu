+++ b/examples/buttons/test_entry.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check user-ELF foreground entry and the existing flat-build daemon entry."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    source = Path(__file__).with_name("buttons_main.c").read_text()
+    entry = source[source.index("\nint main("):].replace(
+        "int main(", "int buttons_test_entry(", 1)
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <errno.h>
+#define FAR
+#define CONFIG_EXAMPLES_BUTTONS_PRIORITY 100
+#define CONFIG_EXAMPLES_BUTTONS_STACKSIZE 2048
+static bool g_button_daemon_started;
+static int runs;
+static int button_daemon(int argc, char **argv) {
+  assert(argc == 0 && argv == NULL); runs++; return 23;
+}
+#ifndef CONFIG_BUILD_KERNEL
+static int create_result = 12;
+static int task_create(const char *name, int priority, int stack,
+                       int (*entry)(int, char **), char **argv) {
+  assert(priority == 100 && stack == 2048 && entry == button_daemon);
+  assert(name && argv == NULL); runs++; errno = ENOMEM; return create_result;
+}
+#endif
+'''
+    fixture += entry
+    fixture += r'''
+int main(void) {
+#ifdef CONFIG_BUILD_KERNEL
+  assert(buttons_test_entry(0, NULL) == 23 && runs == 1);
+  g_button_daemon_started = true;
+  assert(buttons_test_entry(0, NULL) == 23 && runs == 2);
+#else
+  assert(buttons_test_entry(0, NULL) == EXIT_SUCCESS && runs == 1);
+  g_button_daemon_started = true;
+  assert(buttons_test_entry(0, NULL) == EXIT_SUCCESS && runs == 1);
+  g_button_daemon_started = false; create_result = -1;
+  assert(buttons_test_entry(0, NULL) == EXIT_FAILURE && runs == 2);
+#endif
+  puts("BUTTONS_ENTRY=PASS");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="buttons-entry-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        for flags in ([], ["-DCONFIG_BUILD_KERNEL=1"]):
+            subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                            "-Wno-unused-parameter", *flags, str(path / "test.c"),
+                            "-o", str(path / "test")], check=True)
+            subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/examples/buttons/test_poll.py b/examples/buttons/test_poll.py
new file mode 100644
index 000000000..b2000098c
--- /dev/null
+++ b/examples/buttons/test_poll.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Test bounded reads against the button driver's current-state semantics."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    source = Path(__file__).with_name("buttons_main.c").read_text()
+    start = source.index("\nstatic int button_poll_sample(")
+    end = source.index("\n}\n", start) + 3
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/types.h>
+#define FAR
+#define CONFIG_INPUT_BUTTONS_POLL_DELAY 1000
+typedef uint32_t btn_buttonset_t;
+static int poll_result, poll_error, read_error, reads, interrupted;
+static short events;
+static ssize_t read_size;
+static int test_poll(struct pollfd *fd, nfds_t count, int timeout) {
+  assert(count == 1 && fd->fd == 7 && fd->events == POLLIN && timeout == 1000);
+  fd->revents = events; errno = poll_error; return poll_result;
+}
+static ssize_t test_read(int fd, void *buffer, size_t length) {
+  assert(fd == 7 && length == sizeof(btn_buttonset_t));
+  assert(++reads <= 2); /* A current-state device never becomes empty. */
+  if (interrupted) { interrupted = 0; errno = EINTR; return -1; }
+  *(btn_buttonset_t *)buffer = 1;
+  errno = read_error; return read_size;
+}
+#define poll test_poll
+#define read test_read
+'''
+    fixture += source[start:end]
+    fixture += r'''
+int main(void) {
+  btn_buttonset_t sample = 99;
+  assert(button_poll_sample(7, &sample) == 0 && reads == 0 && sample == 99);
+  poll_result = -1; poll_error = EINTR;
+  assert(button_poll_sample(7, &sample) == -EINTR && reads == 0);
+  poll_result = 1; events = POLLHUP | POLLIN;
+  assert(button_poll_sample(7, &sample) == -EIO && reads == 0);
+  events = 0;
+  assert(button_poll_sample(7, &sample) == -EIO && reads == 0);
+  events = POLLIN; read_size = sizeof(sample);
+  assert(button_poll_sample(7, &sample) == 1 && reads == 1 && sample == 1);
+  reads = 0; interrupted = 1;
+  assert(button_poll_sample(7, &sample) == 1 && reads == 2);
+  reads = 0; read_size = -1; read_error = EAGAIN;
+  assert(button_poll_sample(7, &sample) == -EAGAIN && reads == 1);
+  reads = 0; read_size = 1;
+  assert(button_poll_sample(7, &sample) == -EIO && reads == 1);
+  puts("BUTTONS_POLL=PASS bounded-current-state/timeout/events/EINTR/EAGAIN/short-read");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="buttons-poll-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        str(path / "test.c"), "-o", str(path / "test")], check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check actual nettest host startup/address parsing without opening sockets."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parent
+    root = source.parents[1]
+    with tempfile.TemporaryDirectory(prefix='nettest-cmdline-') as directory:
+        path = Path(directory)
+        for name in ('nettest_host.c', 'nettest_cmdline.c', 'nettest.h'):
+            contents = (subprocess.check_output(
+                ['git', 'show', f'{args.revision}:examples/nettest/{name}'],
+                cwd=root, text=True) if args.revision else (source / name).read_text())
+            (path / name).write_text(contents)
+        (path / 'endpoint.c').write_text(r'''
+#include "config.h"
+#include "nettest.h"
+#include <assert.h>
+#include <stdio.h>
+static void endpoint(void)
+{
+  char buffer[INET6_ADDRSTRLEN];
+#ifdef CONFIG_EXAMPLES_NETTEST_IPv6
+  const void *address = g_nettestserver_ipv6;
+#else
+  const void *address = &g_nettestserver_ipv4;
+#endif
+  assert(inet_ntop(AF_INETX, address, buffer, sizeof(buffer)));
+  puts(buffer);
+}
+void nettest_client(void) { endpoint(); }
+void nettest_server(void) { endpoint(); }
+''')
+        for ipv6 in (False, True):
+            for loopback in (False, True):
+                for server in (False, True):
+                    config = ''
+                    if ipv6:
+                        config += '#define CONFIG_EXAMPLES_NETTEST_IPv6 1\n'
+                        parts = (0x2001, 0xdb8, 0, 0, 0, 0, 0, 1)
+                        for index, value in enumerate(parts, 1):
+                            config += (f'#define CONFIG_EXAMPLES_NETTEST_SERVERIPv6ADDR_'
+                                       f'{index} {value}\n')
+                        expected = '::1' if loopback else '2001:db8::1'
+                        override = '2001:db8::7'
+                    else:
+                        config += '#define CONFIG_EXAMPLES_NETTEST_SERVERIP 0xc0000201\n'
+                        expected = '127.0.0.1' if loopback else '192.0.2.1'
+                        override = '198.51.100.7'
+                    if loopback:
+                        config += ('#define CONFIG_EXAMPLES_NETTEST_LOOPBACK 1\n'
+                                   '#define CONFIG_NET_LOOPBACK 1\n')
+                    if server:
+                        config += '#define CONFIG_EXAMPLES_NETTEST_SERVER 1\n'
+                    (path / 'config.h').write_text(config)
+                    executable = str(path / 'test')
+                    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                                    '-Wno-unused-parameter', '-DNETTEST_HOST=1',
+                                    '-I', directory, str(path / 'nettest_host.c'),
+                                    str(path / 'nettest_cmdline.c'), str(path / 'endpoint.c'),
+                                    '-o', executable], check=True)
+                    for extra, wanted in (([], expected), ([override], override)):
+                        result = subprocess.run([executable, *extra], check=True,
+                                                capture_output=True, text=True)
+                        assert result.stdout.strip() == wanted, result.stdout
+                    for extra in (['invalid-address'], [override, override]):
+                        result = subprocess.run([executable, *extra],
+                                                capture_output=True, text=True)
+                        assert result.returncode != 0 and 'USAGE:' in result.stderr
+    print('NETTEST_CMDLINE=PASS IPv4/IPv6, client/server, defaults/loopback/override/errors')
+
+
+if __name__ == '__main__':
+    main()

new file mode 100644
index 000000000..8267650a3
--- /dev/null
+++ b/examples/s31demo/test_http.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check an authorized board's read-only LAN demo without HTTP proxy settings."""
+
+import argparse
+import http.client
+import ipaddress
+import json
+import socket
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("address", type=ipaddress.IPv4Address)
+    parser.add_argument("--port", type=int, default=8080)
+    parser.add_argument("--samples", type=int, default=10)
+    parser.add_argument("--boundaries", action="store_true",
+                        help="also check rejection, browser headers and idle timeout")
+    args = parser.parse_args()
+    if not 1 <= args.port <= 65535 or not 2 <= args.samples <= 100:
+        parser.error("invalid port or sample count")
+
+    def get(path):
+        client = http.client.HTTPConnection(str(args.address), args.port, timeout=8)
+        try:
+            client.request("GET", path, headers={"User-Agent": "S31 demo check"})
+            response = client.getresponse()
+            body = response.read()
+            assert response.status == 200, f"HTTP {response.status}"
+            assert int(response.getheader("Content-Length")) == len(body)
+            return body
+        finally:
+            client.close()
+
+    assert b"Board is running" in get("/")
+    first = previous = None
+    for index in range(args.samples):
+        item = json.loads(get("/status.json"))
+        assert item["board"] == "ESP32-S31"
+        assert item["ipv4"] == str(args.address)
+        assert isinstance(item["uptime_seconds"], int)
+        assert isinstance(item["requests"], int)
+        if previous is not None:
+            assert item["uptime_seconds"] >= previous["uptime_seconds"]
+            assert item["requests"] > previous["requests"]
+        else:
+            first = item
+        previous = item
+        print(f"HTTP_SAMPLE={index + 1} uptime={item['uptime_seconds']} "
+              f"requests={item['requests']}", flush=True)
+        if index + 1 < args.samples:
+            time.sleep(1.1)
+    assert previous["uptime_seconds"] > first["uptime_seconds"]
+    if args.boundaries:
+        for method, path, expected in (("POST", "/", 405),
+                                       ("GET", "/../../etc/passwd", 404)):
+            client = http.client.HTTPConnection(str(args.address), args.port, timeout=8)
+            try:
+                client.request(method, path)
+                response = client.getresponse()
+                body = response.read()
+                assert response.status == expected
+                assert int(response.getheader("Content-Length")) == len(body)
+            finally:
+                client.close()
+        client = http.client.HTTPConnection(str(args.address), args.port, timeout=8)
+        try:
+            client.request("GET", "/", headers={"User-Agent": "Browser " + "x" * 1024})
+            response = client.getresponse()
+            assert response.status == 200 and b"Board is running" in response.read()
+        finally:
+            client.close()
+        for payload in (b"GET / HTTP/1.1\r\nX: " + b"x" * 2500,
+                        b"GET / HTTP/1.1\r\n"):
+            with socket.create_connection((str(args.address), args.port), 8) as client:
+                client.sendall(payload)
+                started = time.monotonic()
+                try:
+                    assert client.recv(1) == b""
+                except ConnectionResetError:
+                    pass
+                assert time.monotonic() - started < 8
+            assert b"Board is running" in get("/")
+        print("S31_DEMO_BOUNDARIES=PASS method/path/browser-headers/header-limit/idle-recovery",
+              flush=True)
+    print(f"S31_DEMO_HTTP=PASS samples={args.samples} direct_http_client=1", flush=True)
+
+
+if __name__ == "__main__":
+    main()

index 000000000..32a128ac1
--- /dev/null
+++ b/examples/s31led/s31led_main.c
@@ -0,0 +1,96 @@
+/****************************************************************************
+ * apps/examples/s31led/s31led_main.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int main(int argc, char **argv)
+{
+  static const uint32_t pixels[] =
+    {
+      0x00080000, 0x00000800, 0x00000008, 0
+    };
+
+  char *end;
+  long cycles = 1;
+  int first;
+  int second;
+  int ret = EXIT_FAILURE;
+
+  if (argc > 2)
+    {
+      fprintf(stderr, "Usage: s31led [cycles:1..10]\n");
+      return EXIT_FAILURE;
+    }
+
+  if (argc == 2)
+    {
+      cycles = strtol(argv[1], &end, 10);
+      if (*argv[1] == '\0' || *end != '\0' || cycles < 1 || cycles > 10)
+        {
+          fprintf(stderr, "s31led: cycles must be 1..10\n");
+          return EXIT_FAILURE;
+        }
+    }
+
+  first = open("/dev/leds0", O_WRONLY);
+  if (first < 0)
+    {
+      perror("s31led open");
+      return EXIT_FAILURE;
+    }
+
+  /* Exercise the driver's shared-buffer reference count as well as TX.
+   * Closing one descriptor must not invalidate the remaining descriptor.
+   */
+
+  second = open("/dev/leds0", O_WRONLY);
+  if (second < 0)
+    {
+      perror("s31led second open");
+      close(first);
+      return EXIT_FAILURE;
+    }
+
+  close(first);
+
+  for (long cycle = 0; cycle < cycles; cycle++)
+    {
+      for (unsigned int color = 0; color < 4; color++)
+        {
+          if (lseek(second, 0, SEEK_SET) != 0 ||
+              write(second, &pixels[color], sizeof(pixels[color])) !=
+              sizeof(pixels[color]))
+            {
+              perror("s31led write");
+              goto out;
+            }
+
+          usleep(250000);
+        }
+    }
+
+  printf("S31_LED=PASS frames=%ld brightness=8 final=off "
+         "optical=unverified\n",
+         cycles * 4);
+  ret = EXIT_SUCCESS;
+out:
+  close(second);
+  return ret;
+}

+/* Keep the queued object alive independently of the Bluetooth work item.
+ * Cancellation may race a user worker which has dequeued its callback but
+ * has not yet acquired the host lock. Such a callback sees a NULL owner.
+ */
+struct z_nuttx_timeout {
+	struct work_s work;
+	struct _timeout *owner;
+	_timeout_func_t function;
+	int64_t deadline;
+};
+
+static pthread_once_t timer_once = PTHREAD_ONCE_INIT;
+
+static void timer_init(void)
+{
+	int ret = work_usrstart();
+	__ASSERT_NO_MSG(ret >= 0);
+}
+
+static void timer_expire(void *arg)
+{
+	struct z_nuttx_timeout *timer = arg;
+	unsigned int key = arch_irq_lock();
+	if (timer->owner != NULL) {
+		struct k_work_delayable *dwork = CONTAINER_OF(timer->owner,
+				struct k_work_delayable, timeout);
+		dwork->work.user_timeout = NULL;
+		timer->function(timer->owner);
+	}
+	arch_irq_unlock(key);
+	free(timer);
+}
+
+k_ticks_t z_timeout_remaining(const struct _timeout *timeout)
+{
+	const struct k_work_delayable *dwork = CONTAINER_OF(timeout,
+			struct k_work_delayable, timeout);
+	unsigned int key = arch_irq_lock();
+	struct z_nuttx_timeout *timer = dwork->work.user_timeout;
+	int64_t remaining = timer ? MAX(0, timer->deadline - sys_clock_tick_get()) : 0;
+	arch_irq_unlock(key);
+	return remaining;
+}
+
+int z_abort_timeout(struct _timeout *to)
+{
+	struct k_work_delayable *dwork = CONTAINER_OF(to,
+			struct k_work_delayable, timeout);
+	unsigned int key = arch_irq_lock();
+	struct z_nuttx_timeout *timer = dwork->work.user_timeout;
+	if (timer == NULL) {
+		arch_irq_unlock(key);
+		return -ENOENT;
+	}
+
+	dwork->work.user_timeout = NULL;
+	timer->owner = NULL;
+	if (work_cancel(USRWORK, &timer->work) == 0) {
+		free(timer);
+	}
+	arch_irq_unlock(key);
+	return 0;
+}
+
+void z_add_timeout(struct _timeout *to, _timeout_func_t fn, k_timeout_t timeout)
+{
+	struct k_work_delayable *dwork = CONTAINER_OF(to,
+			struct k_work_delayable, timeout);
+	struct z_nuttx_timeout *timer;
+	unsigned int key;
+	int ret;
+
+	pthread_once(&timer_once, timer_init);
+	key = arch_irq_lock();
+	z_abort_timeout(to);
+	if (K_TIMEOUT_EQ(timeout, K_FOREVER)) {
+		arch_irq_unlock(key);
+		return;
+	}
+
+	timer = calloc(1, sizeof(*timer));
+	__ASSERT_NO_MSG(timer != NULL);
+	timer->owner = to;
+	timer->function = fn;
+	timer->deadline = sys_clock_tick_get() + MAX(1, timeout.ticks);
+	dwork->work.user_timeout = timer;
+	ret = work_queue(USRWORK, &timer->work, timer_expire, timer,
+			MAX(1, timeout.ticks));
+	__ASSERT_NO_MSG(ret == 0);
+	arch_irq_unlock(key);
+}
+#else
 k_ticks_t z_timeout_remaining(const struct _timeout *timeout)
 {
 	clock_t qtime, curr, elapsed;

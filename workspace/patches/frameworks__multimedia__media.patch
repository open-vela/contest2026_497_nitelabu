diff --git a/server/media_player.c b/server/media_player.c
index 54f9f05..4b6cef1 100644
--- a/server/media_player.c
+++ b/server/media_player.c
@@ -986,24 +986,26 @@ static int media_player_proc_dat(MediaPlayerContext* ctx)
         return ret;
     else if (ret == AVERROR_EOF) {
         if (!media_player_is_queue_empty(ctx)) {
+            int output_ret = 0;
 
+            /* Keep decoder EOF separate from an optional output restart. */
             pthread_mutex_lock(&ctx->mutex);
             if (ctx->audio_output_state & MEDIA_AUDIO_OUTPUT_STARTING) {

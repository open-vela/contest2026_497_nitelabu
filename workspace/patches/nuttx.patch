+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <errno.h>
+#include <sys/types.h>
+#define OK 0
+#define I2C_M_READ 1
+struct i2c_master_s { int unused; };
+struct i2c_msg_s {
+  uint32_t frequency;
+  uint16_t addr, flags;
+  uint8_t *buffer;
+  ssize_t length;
+};
+static unsigned allocations, fail_at, live, transfers;
+static int transfer_result;
+static struct i2c_msg_s *user_msgs;
+static uint8_t *user_write, *user_read;
+static void *kmm_malloc(size_t size)
+{
+  allocations++;
+  if (allocations == fail_at) { return NULL; }
+  assert(size < 100000);
+  void *p = malloc(size);
+  assert(p);
+  live++;
+  return p;
+}
+static void *kmm_zalloc(size_t size)
+{
+  void *p = kmm_malloc(size);
+  if (p) { memset(p, 0, size); }
+  return p;
+}
+static void kmm_free(void *p)
+{
+  assert(p && live);
+  live--;
+  free(p);
+}
+static int esp_i2c_transfer(struct i2c_master_s *dev,
+                            struct i2c_msg_s *msgs, int count)
+{
+  assert(dev && msgs != user_msgs && count == 2);
+  assert(msgs[0].buffer != user_write && msgs[1].buffer != user_read);
+  assert(msgs[0].length == 1 && msgs[0].buffer[0] == 0xfd);
+  assert(msgs[1].length == 2 && msgs[1].buffer[0] == 0);
+  /* Simulate a different user mapping or concurrent descriptor mutation.
+   * The interrupt-driven lower half must use only its kernel snapshot.
+   */
+  memset(user_msgs, 0xa5, 2 * sizeof(*user_msgs));
+  user_write[0] = 0;
+  assert(msgs[0].buffer[0] == 0xfd && msgs[0].flags == 0x40);
+  msgs[1].buffer[0] = 0x83;
+  msgs[1].buffer[1] = 0x11;
+  transfers++;
+  return transfer_result;
+}
+'''
+    fixture += definition(source, "esp_i2c_transfer_buffered")
+    fixture += r'''
+int main(void)
+{
+  struct i2c_master_s dev = {0};
+  uint8_t write = 0xfd, read[2] = {0xaa, 0xbb};
+  struct i2c_msg_s initial[2] = {{100000, 0x18, 0x40, &write, 1},
+                               {400000, 0x18, 1, read, 2}};
+  struct i2c_msg_s msgs[3];
+  user_msgs = msgs;
+  user_write = &write;
+  user_read = read;
+  for (int mode = 0; mode < 4; mode++) {
+    memcpy(msgs, initial, sizeof(initial));
+    write = 0xfd;
+    read[0] = 0xaa;
+    read[1] = 0xbb;
+    allocations = 0;
+    fail_at = mode < 2 ? mode + 1 : 0;
+    transfer_result = mode == 3 ? -ETIMEDOUT : 0;
+    int expected = mode < 2 ? -ENOMEM : transfer_result;
+    assert(esp_i2c_transfer_buffered(&dev, msgs, 2) == expected);
+    assert(!live);
+    if (mode == 2) { assert(read[0] == 0x83 && read[1] == 0x11); }
+    else { assert(read[0] == 0xaa && read[1] == 0xbb); }
+  }
+  assert(transfers == 2);
+  assert(esp_i2c_transfer_buffered(&dev, NULL, 2) == -EINVAL);
+  assert(esp_i2c_transfer_buffered(&dev, msgs, 0) == -EINVAL);
+  assert(esp_i2c_transfer_buffered(&dev, msgs, 257) == -EINVAL);
+  for (int mode = 0; mode < 3; mode++) {
+    memcpy(msgs, initial, sizeof(initial));
+    if (mode == 0) { msgs[0].length = -1; }
+    if (mode == 1) { msgs[0].frequency = 0; }
+    if (mode == 2) { msgs[0].buffer = NULL; }
+    assert(esp_i2c_transfer_buffered(&dev, msgs, 2) == -EINVAL);
+    assert(!live && transfers == 2);
+  }
+  for (int i = 0; i < 3; i++) {
+    msgs[i] = initial[0];
+    msgs[i].length = (ssize_t)(SIZE_MAX >> 1);
+  }
+  assert(esp_i2c_transfer_buffered(&dev, msgs, 3) == -EOVERFLOW);
+  assert(!live && transfers == 2);
+  puts("S31_I2C_KERNEL_BUFFERS=PASS isolated descriptors/payloads; bounded cleanup");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-i2c-buffer-") as directory:
+        path = Path(directory)

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Verify ESP RX dequeue serialization and allocator-wakeup safety."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'arch/risc-v/src/common/espressif/esp_wlan.c'
+    source = (subprocess.check_output(
+        ['git', 'show', f'{args.revision}:{filename}'], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+typedef unsigned int irqstate_t;
+typedef int spinlock_t;
+struct iob_s { int id; };
+struct iob_queue_s { struct iob_s *head; };
+struct wlan_priv_s { spinlock_t lock; struct iob_queue_s rxb; };
+static struct wlan_priv_s device;
+static int held, locks, unlocks, removes, preempt_disabled, pending, wakeups;
+static irqstate_t spin_lock_irqsave(spinlock_t *lock)
+{ assert(lock == &device.lock && !held); held = 1; locks++; return 0x1357; }
+static void spin_unlock_irqrestore(spinlock_t *lock, irqstate_t flags)
+{ assert(lock == &device.lock && held && flags == 0x1357);
+  held = 0; unlocks++; }
+static irqstate_t spin_lock_irqsave_nopreempt(spinlock_t *lock)
+{ irqstate_t flags = spin_lock_irqsave(lock);
+  preempt_disabled++; return flags; }
+static void spin_unlock_irqrestore_nopreempt(spinlock_t *lock,
+                                            irqstate_t flags)
+{ spin_unlock_irqrestore(lock, flags);
+  assert(preempt_disabled == 1); preempt_disabled--;
+  if (pending) { assert(!held); wakeups++; pending = 0; } }
+static struct iob_s *iob_remove_queue(struct iob_queue_s *q)
+{ struct iob_s *item = q->head;
+  assert(q == &device.rxb && held); removes++; q->head = NULL;
+  /* iob_free_qentry can nxsem_post a waiting allocator.  Without sched_lock,
+   * it may preempt this task while the private spinlock is still held. */
+  if (item) { assert(preempt_disabled); pending = 1; }
+  return item; }
+'''
+    fixture += definition(source, 'wlan_recvframe')
+    fixture += r'''
+int main(void)
+{
+  struct iob_s packet = {42};
+  assert(wlan_recvframe(&device) == NULL);
+  assert(!held && locks == 1 && unlocks == 1 && removes == 1);
+  device.rxb.head = &packet;
+  assert(wlan_recvframe(&device) == &packet);
+  assert(!held && locks == 2 && unlocks == 2 && removes == 2);
+  assert(!device.rxb.head && packet.id == 42);
+  assert(!preempt_disabled && !pending && wakeups == 1);
+  puts("ESP_WIFI_RX_QUEUE=PASS empty/packet serialized, wakeup deferred until unlock");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='esp-wifi-rx-queue-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-unused-function', '-fsanitize=undefined',
+                        '-fno-sanitize-recover=all', str(path / 'test.c'),
+                        '-o', str(path / 'test')], check=True)
+        subprocess.run([str(path / 'test')], check=True)
+
+
+if __name__ == '__main__':
+    main()

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check actual ARP callback-failure branch and waiter-list ownership."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'net/arp/arp_send.c'
+    source = (subprocess.check_output(['git', 'show', f'{args.revision}:{filename}'],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    notify_source = (root / 'net/arp/arp_notify.c').read_text()
+    start = source.index('      if (state->snd_cb == NULL)',
+                         source.index('int arp_send('))
+    end = source.index('      /* Arm/re-arm the callback */', start)
+    branch = source[start:end]
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define FAR
+#define OK 0
+#define DEBUGASSERT assert
+#define nerr(...) ((void)0)
+typedef uint32_t in_addr_t;
+typedef int irqstate_t;
+struct sem { int live, value; };
+struct arp_notify_s {
+  struct arp_notify_s *nt_flink;
+  in_addr_t nt_ipaddr;
+  int nt_result;
+  struct sem nt_sem;
+};
+static struct arp_notify_s *g_arp_waiters;
+static int g_arp_notify_lock, sems, allocations;
+static bool oom = true;
+static int spin_lock_irqsave(int *l) { assert(!*l); *l = 1; return 0; }
+static void spin_unlock_irqrestore(int *l, int f)
+{ (void)f; assert(*l); *l = 0; }
+#define spin_lock_irqsave_nopreempt spin_lock_irqsave
+#define spin_unlock_irqrestore_nopreempt spin_unlock_irqrestore
+static void nxsem_init(struct sem *s, int p, int n)
+{ assert(!s->live && !p); s->live = 1; s->value = n; sems++; }
+static void nxsem_destroy(struct sem *s)
+{ assert(s->live); s->live = 0; sems--; }
+static void nxsem_post(struct sem *s) { assert(s->live); s->value++; }
+static void *arp_callback_alloc(void *dev)
+{ (void)dev; allocations++; return oom ? NULL : &allocations; }
+'''
+    for name in ('arp_wait_setup', 'arp_wait_cancel', 'arp_notify'):
+        fixture += definition(notify_source, name) + '\n'
+    fixture += r'''
+static int send_failure_path(struct arp_notify_s *notify)
+{
+  struct { void *snd_cb; } object = {0}, *state = &object;
+  void *dev = NULL;
+  int ret = 0;
+  arp_wait_setup(123, notify);
+  do {
+'''
+    fixture += branch
+    fixture += r'''
+    /* Successful allocation continues to arp_wait(), which cancels itself.
+     * Model that later cancellation; the failure break must not reach here.
+     */
+    arp_wait_cancel(notify);
+  } while (0);
+  return ret;
+}
+int main(void)
+{
+  struct arp_notify_s other = {0};
+  arp_wait_setup(456, &other);
+  struct arp_notify_s *failed = calloc(1, sizeof(*failed));
+  assert(failed && send_failure_path(failed) == -ENOMEM);
+  free(failed);
+  /* Old code leaves the freed waiter linked; ASan catches this traversal. */
+  arp_notify(123);
+  assert(g_arp_waiters == &other && sems == 1);
+  arp_notify(456);
+  assert(other.nt_result == 0 && other.nt_sem.value == 1);
+  arp_wait_cancel(&other);
+  assert(!g_arp_waiters && sems == 0);
+  oom = false;
+  struct arp_notify_s retried = {0};
+  assert(send_failure_path(&retried) == 0);
+  assert(!g_arp_waiters && sems == 0 && allocations == 2);
+  puts("ARP_CALLBACK_FAILURE=PASS unlink before free/other waiter/retry");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='arp-callback-failure-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                        '-fsanitize=address,undefined', '-fno-sanitize-recover=all',
+                        str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+        subprocess.run([str(path / 'test')], check=True)
+
+
+if __name__ == '__main__':
+    main()

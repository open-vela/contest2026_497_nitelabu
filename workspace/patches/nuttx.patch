@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Verify allocated Wi-Fi IRAM sections in an S31 GNU linker map.
+
+This checks placement, not Wi-Fi functionality.  Discarded input sections
+must not be counted; the map must come from a Wi-Fi-enabled S31 build.
+"""
+
+import argparse
+from pathlib import Path
+import re
+import unittest
+
+
+GROUPS = ("wifi0iram", "wifirxiram", "wifiorslpiram",
+          "wifislprxiram", "wifiextrairam")
+INPUT = re.compile(
+    r"^ (\.(?:" + "|".join(GROUPS) + r")(?:\.[^\s]+)?)"
+    r"\s+(0x[0-9a-fA-F]+)\s+(0x[0-9a-fA-F]+)\s+([^\n]+)",
+    re.MULTILINE)
+
+
+def check_map(source):
+    if "Linker script and memory map" not in source:
+        raise ValueError("Not a GNU linker map")
+    allocated = source.split("Linker script and memory map", 1)[1]
+
+    def symbol(name):
+        match = re.search(r"^\s*(0x[0-9a-fA-F]+)\s+" + name +
+                          r"\s+=", allocated, re.MULTILINE)
+        if not match:
+            raise ValueError(f"Missing {name}")
+        return int(match[1], 16)
+
+    start, end = symbol("_iram_start"), symbol("_iram_end")
+    if not 0x2f000000 <= start < end <= 0x2f080000:
+        raise ValueError("Unexpected S31 internal SRAM bounds")
+    totals = dict.fromkeys(GROUPS, 0)
+    for match in INPUT.finditer(allocated):
+        section, address, length, owner = match.groups()
+        address, length = int(address, 16), int(length, 16)
+        if not length:
+            continue
+        if not start <= address < address + length <= end:
+            raise ValueError(f"{section} outside IRAM: {address:#x} "
+                             f"size={length:#x} owner={owner}")
+        totals[section.split(".")[1]] += length
+    # wifiorslpiram may be absent in the locked S31 archive.
+    if any(not totals[name] for name in GROUPS if name != "wifiorslpiram"):
+        raise ValueError(f"Missing allocated Wi-Fi groups: {totals}")
+    return totals
+
+
+class ParserTests(unittest.TestCase):
+    def fixture(self):
+        discarded = "Discarded input sections\n .wifiextrairam.0\n 0x0 0x10 old.o\n"
+        header = ("Linker script and memory map\n"
+                  " 0x2f000000 _iram_start = ABSOLUTE (.)\n"
+                  " 0x2f010000 _iram_end = ABSOLUTE (.)\n")
+        sections = "".join(f" .{name}.1\n 0x2f000100 0x10 libpp.a(pm.o)\n"
+                           for name in GROUPS if name != "wifiorslpiram")
+        return discarded + header + sections
+
+    def test_discarded_and_optional(self):
+        totals = check_map(self.fixture())
+        self.assertEqual(totals["wifiextrairam"], 16)
+        self.assertEqual(totals["wifiorslpiram"], 0)
+
+    def test_flash_rejected(self):
+        with self.assertRaisesRegex(ValueError, "outside IRAM"):
+            check_map(self.fixture().replace("0x2f000100", "0x40001000", 1))
+
+    def test_missing_group_rejected(self):
+        with self.assertRaisesRegex(ValueError, "Missing allocated"):
+            check_map(self.fixture().replace(".wifirxiram.1", ".other.1"))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--map", type=Path)
+    args = parser.parse_args()
+    suite = unittest.defaultTestLoader.loadTestsFromTestCase(ParserTests)
+    if not unittest.TextTestRunner().run(suite).wasSuccessful():
+        raise SystemExit(1)
+    if args.map:
+        totals = check_map(args.map.read_text())
+        print("S31_WIFI_IRAM=PASS", " ".join(f"{k}={v}" for k, v in totals.items()))
+
+
+if __name__ == "__main__":
+    main()

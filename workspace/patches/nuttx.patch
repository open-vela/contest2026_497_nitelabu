+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise actual WS2812 write offsets and lower-half error propagation."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "arch/risc-v/src/common/espressif/esp_ws2812.c"
+    source = (subprocess.check_output(["git", "show", f"{args.revision}:{filename}"],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <errno.h>
+#include <sys/types.h>
+#define WS2812_RW_PIXEL_SIZE 4
+#define lederr(...) ((void)0)
+#define ledwarn(...) ((void)0)
+#define set_errno(n) (errno = (n))
+typedef uint32_t rmt_item32_t;
+struct rgbw_led_s { uint32_t val; };
+struct rmt_dev_s;
+struct rmt_ops_s {
+  ssize_t (*write)(struct rmt_dev_s *, const char *, size_t);
+};
+struct rmt_dev_s { const struct rmt_ops_s *ops; };
+struct esp_ws2812_dev_s {
+  uint8_t *buf;
+  size_t buflen;
+  struct rmt_dev_s *rmt;
+};
+struct ws2812_dev_s { void *private; int lock; uint16_t nleds; bool has_white; };
+struct inode { void *i_private; };
+struct file { struct inode *f_inode; off_t f_pos; };
+static int locked, fail_lock, fail_map, calls;
+static ssize_t tx_result;
+static uint32_t words[97];
+static size_t expected_offset, expected_count;
+static int nxmutex_lock(int *lock)
+{
+  assert(lock && !locked);
+  if (fail_lock) { return -EINTR; }
+  locked = 1;
+  return 0;
+}
+static void nxmutex_unlock(int *lock)
+{
+  assert(lock && locked);
+  locked = 0;
+}
+static int map_leds_to_words(struct esp_ws2812_dev_s *priv,
+                            struct rgbw_led_s *data, uint32_t count,
+                            uint32_t *dst, bool white)
+{
+  assert(locked && priv && data);
+  assert(dst == words + expected_offset && count == expected_count);
+  if (fail_map) { return -EINVAL; }
+  for (unsigned i = 0; i < count * (white ? 32 : 24); i++) { dst[i] = 7; }
+  return count * (white ? 32 : 24);
+}
+static ssize_t tx(struct rmt_dev_s *dev, const char *data, size_t len)
+{
+  assert(locked && dev && data == (const char *)words && len == sizeof(words));
+  calls++;
+  return tx_result;
+}
+'''
+    fixture += definition(source, "esp_write")
+    fixture += r'''
+int main(void)
+{
+  const struct rmt_ops_s ops = {tx};
+  struct rmt_dev_s rmt = {&ops};
+  struct esp_ws2812_dev_s priv = {(uint8_t *)words, sizeof(words), &rmt};
+  struct ws2812_dev_s dev = {&priv, 0, 4, false};
+  struct inode inode = {&dev};
+  struct file file = {&inode, 4};
+  uint32_t data[4] = {0};
+  tx_result = sizeof(words);
+  expected_offset = 24;
+  expected_count = 1;
+  assert(esp_write(&file, (const char *)data, 4) == 4);
+  assert(file.f_pos == 8 && !locked && calls == 1);
+  assert(words[23] == 0 && words[24] == 7 && words[47] == 7 && words[48] == 0);
+  file.f_pos = 12;
+  expected_offset = 72;
+  assert(esp_write(&file, (const char *)data, 8) == 4);
+  assert(file.f_pos == 16 && !locked);
+  assert(esp_write(&file, NULL, 0) == 0 && file.f_pos == 16);
+  int before = calls;
+  assert(esp_write(&file, (const char *)data, 4) == 0 && calls == before);
+  file.f_pos = -4;
+  assert(esp_write(&file, (const char *)data, 4) == -EINVAL);
+  file.f_pos = 2;
+  assert(esp_write(&file, (const char *)data, 4) == -EINVAL);
+  file.f_pos = 20;
+  assert(esp_write(&file, (const char *)data, 4) == -EINVAL);
+  file.f_pos = 0;
+  assert(esp_write(&file, NULL, 4) == -EINVAL);
+  assert(esp_write(&file, (const char *)data, 3) == -EINVAL);
+  assert(esp_write(&file, (const char *)data, 20) == -EINVAL);
+  fail_lock = 1;
+  assert(esp_write(&file, (const char *)data, 4) == -EINTR && !locked);
+  fail_lock = 0;
+  expected_offset = 0;
+  tx_result = -ETIMEDOUT;
+  assert(esp_write(&file, (const char *)data, 4) == -ETIMEDOUT);
+  assert(file.f_pos == 0 && !locked);
+  tx_result = sizeof(words) - 4;
+  assert(esp_write(&file, (const char *)data, 4) == -EIO);
+  assert(file.f_pos == 0 && !locked);
+  fail_map = 1;
+  assert(esp_write(&file, (const char *)data, 4) == -EINVAL && !locked);
+  fail_map = 0;
+  dev.has_white = true;
+  dev.nleds = 3;
+  file.f_pos = 4;
+  expected_offset = 32;
+  tx_result = sizeof(words);
+  assert(esp_write(&file, (const char *)data, 4) == 4 && file.f_pos == 8);
+  priv.buf = NULL;
+  assert(esp_write(&file, (const char *)data, 4) == -ENODEV && !locked);
+  puts("ESP_WS2812_WRITE=PASS RGB/RGBW offsets, bounds, retries and errors");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="esp-ws2812-write-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        str(path / "test.c"), "-o", str(path / "test")],
+                       check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

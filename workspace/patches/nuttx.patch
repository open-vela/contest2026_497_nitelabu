+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Peer address output must be written by the accepting task, not a callback."""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "net/tcp/tcp_accept.c"
+    source = (subprocess.check_output(["git", "show", f"{args.revision}:{filename}"],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    state = re.search(r"struct accept_s\s*\{.*?\n\};", source, re.S)
+    assert state
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#define FAR
+#define OK 0
+#define DEBUGASSERT assert
+#define ninfo(...) ((void)0)
+#define _SS_ISNONBLOCK(flags) ((flags) != 0)
+typedef unsigned socklen_t;
+typedef int sem_t;
+struct sockaddr { int value; };
+struct socket_conn_s { int s_flags; };
+struct tcp_conn_s {
+  struct socket_conn_s sconn;
+  void *accept_private;
+  int (*accept)(struct tcp_conn_s *, struct tcp_conn_s *);
+  unsigned crefs;
+};
+struct socket { struct tcp_conn_s *s_conn; };
+static struct tcp_conn_s listener, accepted;
+static int visible, copies, waits, locked, cancelled, backlog;
+static void accept_tcpsender(struct tcp_conn_s *a, struct tcp_conn_s *b,
+                             struct sockaddr *addr, socklen_t *len)
+{
+  assert(visible && locked && a == &listener && b == &accepted);
+  if (addr) { assert(len); addr->value = 42; *len = sizeof(*addr); copies++; }
+}
+static void conn_lock(struct socket_conn_s *conn)
+{ assert(conn == &listener.sconn && !locked); locked = 1; }
+static void conn_unlock(struct socket_conn_s *conn)
+{ assert(conn == &listener.sconn && locked); locked = 0; }
+#ifdef CONFIG_NET_TCPBACKLOG
+static struct tcp_conn_s *tcp_backlogremove(struct tcp_conn_s *conn)
+{ assert(conn == &listener && locked); return backlog ? &accepted : NULL; }
+#endif
+static void nxsem_init(sem_t *sem, int shared, int value)
+{ assert(!shared && !value && locked); *sem = 0; }
+static void nxsem_post(sem_t *sem)
+{ assert(!visible && locked); (*sem)++; }
+static void nxsem_destroy(sem_t *sem)
+{ assert(sem && locked && visible); }
+static int conn_dev_sem_timedwait(sem_t *sem, bool intr, unsigned timeout,
+                                 struct socket_conn_s *conn, void *unused)
+{
+  assert(locked && visible && intr && timeout == UINT_MAX && !unused);
+  assert(conn == &listener.sconn && listener.accept && listener.accept_private);
+  waits++;
+  if (cancelled) { return -EINTR; }
+  visible = 0;
+  assert(listener.accept(&listener, &accepted) == 0);
+  assert(*sem == 1 && !listener.accept_private && !listener.accept);
+  visible = 1;
+  return 0;
+}
+'''
+    fixture += state[0] + '\n'
+    fixture += definition(source, "accept_eventhandler")
+    fixture += definition(source, "psock_tcp_accept")
+    fixture += r'''
+int main(void)
+{
+  struct socket sock = {&listener};
+  struct sockaddr addr = {0};
+  socklen_t len = sizeof(addr);
+  void *result = NULL;
+  visible = 1;
+  accepted.crefs = 1;
+  assert(psock_tcp_accept(&sock, &addr, &len, &result) == 0);
+  assert(result == &accepted && addr.value == 42 && copies == 1 && waits == 1);
+  assert(!locked && !listener.accept_private && !listener.accept);
+  assert(psock_tcp_accept(&sock, NULL, NULL, &result) == 0);
+  assert(copies == 1 && waits == 2 && !locked);
+  cancelled = 1;
+  addr.value = 0;
+  result = NULL;
+  assert(psock_tcp_accept(&sock, &addr, &len, &result) == -EINTR);
+  assert(!result && !addr.value && copies == 1 && !locked);
+  assert(!listener.accept_private && !listener.accept);
+  cancelled = 0;
+#ifdef CONFIG_NET_TCPBACKLOG
+  backlog = 1;
+  assert(psock_tcp_accept(&sock, &addr, &len, &result) == 0);
+  assert(addr.value == 42 && copies == 2 && waits == 3 && !locked);
+  backlog = 0;
+  listener.sconn.s_flags = 1;
+  assert(psock_tcp_accept(&sock, &addr, &len, &result) == -EAGAIN);
+  assert(copies == 2 && waits == 3 && !locked);
+#else
+  (void)backlog;
+#endif
+  assert(accept_eventhandler(&listener, &accepted) == -EINVAL);
+  puts("TCP_ACCEPT_ADDRESS_CONTEXT=PASS deferred/null/cancel/backlog/nonblock");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="tcp-accept-context-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        for options in ([], ["-DCONFIG_NET_TCPBACKLOG"]):
+            subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                            "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                            *options, str(path / "test.c"), "-o", str(path / "test")],
+                           check=True)
+            subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

+static void esp_cpuint_unmap(int source)
+{
+#if defined(CONFIG_ARCH_CHIP_ESP32S31) && defined(CONFIG_ARCH_USE_S_MODE)
+  /* The S31 monitor HAL encodes logical inputs 0..31 as CLIC inputs 16..47.
+   * Passing ETS_INVALID_INUM (0) through that API would route the source to
+   * live CPU input 0, not disconnect it.  Write the raw disabled selector
+   * while preserving the other interrupt-matrix fields.

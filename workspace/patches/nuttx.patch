+++ b/arch/risc-v/src/esp32s31/include/platform/os.h
@@ -0,0 +1,22 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/include/platform/os.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#ifndef __ARCH_RISCV_SRC_ESP32S31_INCLUDE_PLATFORM_OS_H
+#define __ARCH_RISCV_SRC_ESP32S31_INCLUDE_PLATFORM_OS_H
+
+/* The pinned ESP HAL targets the newer nxsched_usleep() interface.  The
+ * current openvela tree provides the same scheduler-aware service as
+ * nxsig_usleep().  Keep this compatibility local to ESP32-S31 instead of
+ * changing the pinned dependency or the public scheduler API.
+ */
+
+#include <nuttx/signal.h>
+
+#define nxsched_usleep nxsig_usleep
+#include_next "platform/os.h"
+#undef nxsched_usleep
+
+#endif
diff --git a/arch/risc-v/src/esp32s31/include/riscv/csr.h b/arch/risc-v/src/esp32s31/include/riscv/csr.h
new file mode 100644
index 00000000000..dc23f3dada7
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/include/riscv/csr.h
@@ -0,0 +1,146 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/include/riscv/csr.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#ifndef __ARCH_RISCV_SRC_ESP32S31_INCLUDE_RISCV_CSR_H
+#define __ARCH_RISCV_SRC_ESP32S31_INCLUDE_RISCV_CSR_H
+
+/* NuttX and the Espressif HAL both publish the standard RISC-V status,
+ * interrupt-pending, and PMP CSR constants.  NuttX headers are normally
+ * included first, while esp_cpu.h later includes the HAL CSR interface.
+ *
+ * Verify that every overlapping definition has the value expected by the
+ * locked HAL before making the HAL copy authoritative for the remainder of
+ * the translation unit.  A future incompatible definition therefore fails
+ * explicitly instead of being hidden by a warning suppression option.
+ */
+
+#if defined(MSTATUS_UIE) && MSTATUS_UIE != 0x00000001
+#  error "MSTATUS_UIE differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_SIE) && MSTATUS_SIE != 0x00000002
+#  error "MSTATUS_SIE differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_MIE) && MSTATUS_MIE != 0x00000008
+#  error "MSTATUS_MIE differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_SPIE) && MSTATUS_SPIE != 0x00000020
+#  error "MSTATUS_SPIE differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_MPIE) && MSTATUS_MPIE != 0x00000080
+#  error "MSTATUS_MPIE differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_VS) && MSTATUS_VS != 0x00000600
+#  error "MSTATUS_VS differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_FS) && MSTATUS_FS != 0x00006000
+#  error "MSTATUS_FS differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_XS) && MSTATUS_XS != 0x00018000
+#  error "MSTATUS_XS differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_MPRV) && MSTATUS_MPRV != 0x00020000
+#  error "MSTATUS_MPRV differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_SUM) && MSTATUS_SUM != 0x00040000
+#  error "MSTATUS_SUM differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_MXR) && MSTATUS_MXR != 0x00080000
+#  error "MSTATUS_MXR differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_TVM) && MSTATUS_TVM != 0x00100000
+#  error "MSTATUS_TVM differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_TW) && MSTATUS_TW != 0x00200000
+#  error "MSTATUS_TW differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(MSTATUS_TSR) && MSTATUS_TSR != 0x00400000
+#  error "MSTATUS_TSR differs between NuttX and the ESP32-S31 HAL"
+#endif
+
+#if defined(SSTATUS_SIE) && SSTATUS_SIE != 0x00000002
+#  error "SSTATUS_SIE differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(SSTATUS_SPIE) && SSTATUS_SPIE != 0x00000020
+#  error "SSTATUS_SPIE differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(SSTATUS_VS) && SSTATUS_VS != 0x00000600
+#  error "SSTATUS_VS differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(SSTATUS_FS) && SSTATUS_FS != 0x00006000
+#  error "SSTATUS_FS differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(SSTATUS_XS) && SSTATUS_XS != 0x00018000
+#  error "SSTATUS_XS differs between NuttX and the ESP32-S31 HAL"
+#endif
+#if defined(SSTATUS_SUM) && SSTATUS_SUM != 0x00040000

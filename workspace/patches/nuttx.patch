+#endif
diff --git a/arch/risc-v/src/esp32s31/hal_backports/include/hal/rmt_ll_compat.h b/arch/risc-v/src/esp32s31/hal_backports/include/hal/rmt_ll_compat.h
new file mode 100644
index 00000000000..86702dd2608
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/hal_backports/include/hal/rmt_ll_compat.h
@@ -0,0 +1,121 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/hal_backports/include/hal/rmt_ll_compat.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#ifndef __ARCH_RISCV_SRC_ESP32S31_HAL_BACKPORTS_RMT_LL_COMPAT_H
+#define __ARCH_RISCV_SRC_ESP32S31_HAL_BACKPORTS_RMT_LL_COMPAT_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include "hal/rmt_ll.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define SOC_RMT_CHANNELS_PER_GROUP RMT_LL_GET(CHANS_PER_INST)
+#define SOC_RMT_TX_CANDIDATES_PER_GROUP RMT_LL_GET(TX_CANDIDATES_PER_INST)
+#define SOC_RMT_CHANNEL_CLK_INDEPENDENT 0
+#define SOC_RMT_SUPPORT_RX_DEMODULATION RMT_LL_SUPPORT(RX_DEMODULATION)
+#define SOC_RMT_SUPPORT_XTAL 1
+#define RMT_BASECLK_XTAL RMT_CLK_SRC_XTAL
+#define RMT_BASECLK_DEFAULT RMT_CLK_SRC_DEFAULT
+
+/****************************************************************************
+ * Inline Functions
+ ****************************************************************************/
+
+/* Read-side helpers used by the current NuttX driver but removed from the
+ * locked HAL.  Channel arguments are local TX/RX indices (0..3), matching
+ * the corresponding S31 LL setters.  Interrupt getters return channel masks,
+ * not raw peripheral interrupt bit positions.
+ */
+
+static inline uint32_t rmt_ll_rx_get_mem_blocks(rmt_dev_t *dev,
+                                               uint32_t channel)
+{
+  return dev->chmconf[channel].conf0.mem_size_chm;
+}
+
+static inline uint32_t rmt_ll_tx_get_mem_blocks(rmt_dev_t *dev,
+                                               uint32_t channel)
+{
+  return dev->chnconf0[channel].mem_size_chn;
+}
+
+static inline bool rmt_ll_tx_is_loop_enabled(rmt_dev_t *dev,
+                                            uint32_t channel)
+{
+  return dev->chnconf0[channel].tx_conti_mode_chn;
+}
+
+static inline uint32_t rmt_ll_rx_get_channel_clock_div(rmt_dev_t *dev,
+                                                     uint32_t channel)
+{
+  uint32_t div = dev->chmconf[channel].conf0.div_cnt_chm;
+  return div == 0 ? 256 : div;
+}
+
+static inline uint32_t rmt_ll_tx_get_idle_level(rmt_dev_t *dev,
+                                               uint32_t channel)
+{
+  return dev->chnconf0[channel].idle_out_lv_chn;
+}
+
+static inline uint32_t rmt_ll_rx_get_limit(rmt_dev_t *dev, uint32_t channel)
+{
+  return dev->chm_rx_lim[channel].rx_lim_chm;
+}
+
+static inline uint32_t rmt_ll_rx_get_status_word(rmt_dev_t *dev,
+                                                uint32_t channel)
+{
+  return dev->chmstatus[channel].val;
+}
+
+static inline uint32_t rmt_ll_tx_get_status_word(rmt_dev_t *dev,
+                                                uint32_t channel)
+{
+  return dev->chnstatus[channel].val;
+}
+
+static inline uint32_t rmt_ll_get_tx_end_interrupt_status(rmt_dev_t *dev)
+{
+  return dev->int_st.val & 0x0f;
+}
+
+static inline uint32_t rmt_ll_get_tx_err_interrupt_status(rmt_dev_t *dev)
+{
+  return (dev->int_st.val >> 4) & 0x0f;
+}
+
+static inline uint32_t rmt_ll_get_tx_thres_interrupt_status(rmt_dev_t *dev)
+{
+  return (dev->int_st.val >> 8) & 0x0f;
+}
+
+static inline uint32_t rmt_ll_get_tx_loop_interrupt_status(rmt_dev_t *dev)
+{
+  return (dev->int_st.val >> 12) & 0x0f;
+}
+
+static inline uint32_t rmt_ll_get_rx_end_interrupt_status(rmt_dev_t *dev)
+{
+  return (dev->int_st.val >> 16) & 0x0f;
+}
+
+static inline uint32_t rmt_ll_get_rx_err_interrupt_status(rmt_dev_t *dev)
+{
+  return (dev->int_st.val >> 20) & 0x0f;
+}
+
+static inline uint32_t rmt_ll_get_rx_thres_interrupt_status(rmt_dev_t *dev)
+{
+  return (dev->int_st.val >> 24) & 0x0f;
+}
+
+#endif

@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Verify that a stripped AppFS ELF preserves its runtime loader metadata."""
+
+import argparse
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+NAMES = {"nx_stacksize", "nx_priority", "nx_heapsize", "nx_uid", "nx_gid", "nx_mode"}
+
+
+def symbols(nm, path):
+    result = subprocess.run([nm, str(path)], text=True, capture_output=True, check=True)
+    found = {}
+    for line in result.stdout.splitlines():
+        fields = line.split()
+        if len(fields) == 3 and fields[2] in NAMES:
+            assert fields[1].upper() == "A", f"non-absolute metadata: {line}"
+            found[fields[2]] = int(fields[0], 16)
+    return found
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--nm", default="riscv32-esp-elf-nm")
+    parser.add_argument("--elf", type=Path, required=True)
+    parser.add_argument("--reference", type=Path, required=True)
+    parser.add_argument("--check-make", action="store_true")
+    args = parser.parse_args()
+    expected = symbols(args.nm, args.reference)
+    assert expected.get("nx_stacksize", 0) > 0, "reference has no stack limit"
+    actual = symbols(args.nm, args.elf)
+    assert actual == expected, f"runtime metadata changed: expected={expected}, actual={actual}"
+    if args.check_make:
+        root = Path(__file__).resolve().parents[1]
+        for enabled in ("y", "n"):
+            makefile = (f"TOPDIR := {root}\nCONFIG_ARCH_CHIP_ESP32S31={enabled}\n"
+                        "CONFIG_ARCH_RISCV=y\nCONFIG_RISCV_TOOLCHAIN_GNU_RV32=y\n"
+                        "include $(TOPDIR)/arch/risc-v/src/common/Toolchain.defs\n"
+                        "$(info METADATA_STRIP=$(STRIP))\n.PHONY: check\ncheck:;@:\n")
+            result = subprocess.run(["make", "-sf", "-", "--no-print-directory"],
+                                    input=makefile, text=True, capture_output=True, check=True)
+            lines = [line for line in result.stdout.splitlines()
+                     if line.startswith("METADATA_STRIP=")]
+            assert len(lines) == 1, result.stdout
+            command = shlex.split(lines[0].split("=", 1)[1])
+            flags = {"--keep-symbol=" + name for name in NAMES}
+            assert flags.issubset(command) if enabled == "y" else flags.isdisjoint(command)
+            if enabled == "y":
+                with tempfile.TemporaryDirectory(prefix="s31-elf-metadata-") as directory:
+                    candidate = Path(directory) / "app"
+                    shutil.copy2(args.reference, candidate)
+                    assert args.nm.endswith("nm"), "use the matching cross-toolchain nm"
+                    subprocess.run([args.nm[:-2] + "strip", *command[1:], str(candidate)],
+                                   check=True)
+                    assert symbols(args.nm, candidate) == expected
+        print("S31_ELF_MAKE_POLICY=PASS s31-preserved/other-chips-unchanged")
+    print(f"S31_ELF_METADATA=PASS {actual}")
+
+
+if __name__ == "__main__":
+    main()

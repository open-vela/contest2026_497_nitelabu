+        ['git', 'show', f'{args.revision}:{filename}'], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#define wlinfo(...) ((void)0)
+#define wlerr(...) ((void)0)
+static uint32_t enabled, disabled, lookups;
+static int esp_get_irq(int cpuint)
+{
+  assert(cpuint >= 0 && cpuint < 32);
+  uint32_t bit = UINT32_C(1) << cpuint;
+  assert((lookups & bit) == 0);
+  lookups |= bit;
+  return 100 + cpuint;
+}
+static void up_enable_irq(int irq)
+{
+  assert(irq >= 100 && irq < 132);
+  uint32_t bit = UINT32_C(1) << (irq - 100);
+  assert((enabled & bit) == 0);
+  enabled |= bit;
+}
+static void up_disable_irq(int irq)
+{
+  assert(irq >= 100 && irq < 132);
+  uint32_t bit = UINT32_C(1) << (irq - 100);
+  assert((disabled & bit) == 0);
+  disabled |= bit;
+}
+'''
+    fixture += definition(source, 'enable_intr_wrapper')
+    fixture += definition(source, 'disable_intr_wrapper')
+    fixture += r'''
+static void check(uint32_t mask)
+{
+  enabled = disabled = lookups = 0;
+  enable_intr_wrapper(mask);
+  assert(enabled == mask && disabled == 0 && lookups == mask);
+  lookups = 0;
+  disable_intr_wrapper(mask);
+  assert(enabled == mask && disabled == mask && lookups == mask);
+}
+int main(void)
+{
+  check(0);
+  for (unsigned first = 0; first < 32; first++) {
+    check(UINT32_C(1) << first);
+    for (unsigned second = first + 1; second < 32; second++) {
+      check((UINT32_C(1) << first) | (UINT32_C(1) << second));
+    }
+  }
+  check(UINT32_MAX);
+  check(UINT32_C(0xaaaaaaaa));
+  check(UINT32_C(0x55555555));
+  uint32_t state = 1;
+  for (unsigned index = 0; index < 10000; index++) {
+    state = state * UINT32_C(1664525) + UINT32_C(1013904223);
+    check(state);
+  }
+  puts("WIFI_IRQ_MASK=PASS zero/single/pairs/all/random/exactly-once");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='esp-wifi-irq-mask-') as directory:

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check the actual PHY-enable wrapper's S31 clock/calibration ordering.
+
+Host mocks validate ordering and chip isolation, not RF calibration accuracy.
+"""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "arch/risc-v/src/esp32c6/esp_wifi_adapter.c"
+    source = (subprocess.check_output(
+        ["git", "show", f"{args.revision}:{filename}"], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdio.h>
+#define PHY_MODEM_WIFI 1
+static int step;
+#ifdef CONFIG_IDF_TARGET_ESP32S31
+static int locked;
+void regi2c_enter_critical(void)
+{ assert(step++ == 0 && !locked); locked = 1; }
+void regi2c_ctrl_ll_master_configure_clock(void)
+{ assert(step++ == 1 && locked); }
+void _regi2c_ctrl_ll_master_reset(void)
+{ assert(step++ == 2 && locked); }
+void regi2c_exit_critical(void)
+{ assert(step++ == 3 && locked); locked = 0; }
+void include_esp_phy_override(void)
+{ assert(step++ == 4 && !locked); }
+#endif
+static void esp_phy_enable(int modem)
+{
+  assert(modem == PHY_MODEM_WIFI);
+#ifdef CONFIG_IDF_TARGET_ESP32S31
+  assert(step++ == 5 && !locked);
+#else
+  assert(step++ == 0);
+#endif
+}
+static void phy_wifi_enable_set(int enabled)
+{
+  assert(enabled == 1);
+#ifdef CONFIG_IDF_TARGET_ESP32S31
+  assert(step++ == 6 && !locked);
+#else
+  assert(step++ == 1);
+#endif
+}
+'''

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Regress config.h generation across an A -> B -> A configuration change."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "cmake/nuttx_mkconfig.cmake"
+    source = (subprocess.check_output(["git", "show", f"{args.revision}:{filename}"],
+                                     cwd=root, text=True) if args.revision
+              else (root / filename).read_text())
+    with tempfile.TemporaryDirectory(prefix="nuttx-config-header-") as directory:
+        base = Path(directory)
+        (base / "include/nuttx").mkdir(parents=True)
+        (base / "mkconfig.cmake").write_text(source)
+        (base / "run.cmake").write_text(
+            f'include("{root / "cmake/nuttx_kconfig.cmake"}")\n'
+            f'set(CMAKE_BINARY_DIR "{base}")\n'
+            'set(NUTTX_BOARD test-board)\nset(NUTTX_CONFIG test-config)\n'
+            f'include("{base / "mkconfig.cmake"}")\n')
+        off = "# CONFIG_ESPRESSIF_WIFI_STA_11AX is not set\n"
+        on = "CONFIG_ESPRESSIF_WIFI_STA_11AX=y\n"
+        header = base / "include/nuttx/config.h"
+        failures = []
+        for value in (off, on, off, on):
+            (base / ".config").write_text(value)
+            (base / ".config.orig").write_text(value)
+            subprocess.run(["cmake", "-P", str(base / "run.cmake")], check=True)
+            enabled = "#define CONFIG_ESPRESSIF_WIFI_STA_11AX 1" in header.read_text()
+            if enabled != (value == on):
+                failures.append("config.h retained the previous configuration")
+            if (base / ".config.prev").read_text() != value:
+                failures.append("checkpoint is stale")
+            before = header.stat().st_mtime_ns
+            subprocess.run(["cmake", "-P", str(base / "run.cmake")], check=True)
+            if header.stat().st_mtime_ns != before:
+                failures.append("unchanged header was rewritten")
+        assert not failures, failures
+        print("CMAKE_CONFIG_HEADER=PASS off/on/off/on and unchanged fast path")
+
+
+if __name__ == "__main__":
+    main()

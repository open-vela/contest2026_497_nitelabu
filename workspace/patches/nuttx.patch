+
+/* Use the per-hart interrupt stack recorded in the scratch area.  The
+ * global interrupt-stack top covers the complete SMP allocation and cannot
+ * be shared by all harts.
+ */
+
+.macro  esp_setintstack_bounds high, low
+  blt   sp, \low, 1f
+  bgt   sp, \high, 1f
+  j     2f
+1:
+  mv    sp, \high
+2:

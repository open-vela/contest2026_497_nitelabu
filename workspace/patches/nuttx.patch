diff --git a/arch/risc-v/src/esp32s31/esp32s31_smode_libc.c b/arch/risc-v/src/esp32s31/esp32s31_smode_libc.c
new file mode 100644
index 00000000000..f79697d4389
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_smode_libc.c
@@ -0,0 +1,319 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_smode_libc.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <nuttx/compiler.h>
+
+#define S31_SMODE_LIBC locate_code(".iram1")
+
+/* The ESP32-S31 ROM implementations use a machine-only optimized memory
+ * access path.  Keep the kernel variants in IRAM so they are usable both
+ * during early M-mode startup and later from the S-mode kernel.  U-mode ELF
+ * applications continue to link the normal portable NuttX libc variants.
+ */
+
+void S31_SMODE_LIBC esp32s31_smode_libc_keep(void)
+{
+}
+
+#undef memset
+no_builtin("memset")
+void *S31_SMODE_LIBC memset(void *dest, int value, size_t n)
+{
+  uint8_t *out = dest;
+
+  /* The Wi-Fi key table only accepts naturally aligned 32-bit accesses.
+   * Use word stores whenever the destination range permits it; in
+   * particular, do not clear an aligned key slot with byte stores.
+   */
+
+  if ((((uintptr_t)out | n) & 3u) == 0)
+    {
+      uint32_t byte = (uint8_t)value;
+      uint32_t fill = byte | byte << 8 | byte << 16 | byte << 24;
+      uint32_t *out32 = (uint32_t *)out;
+
+      while (n > 0)
+        {
+          *out32++ = fill;
+          n -= sizeof(uint32_t);
+        }
+
+      return dest;
+    }
+
+  while (n-- > 0)
+    {
+      *out++ = (uint8_t)value;
+    }
+
+  return dest;
+}
+
+#undef memcpy
+no_builtin("memcpy")
+void *S31_SMODE_LIBC memcpy(void *dest, const void *src, size_t n)
+{
+  uint8_t *out = dest;
+  const uint8_t *in = src;
+
+  /* Some S31 memory-mapped blocks, including the Wi-Fi key table, require
+   * naturally aligned 32-bit accesses.  The ROM memcpy uses word accesses
+   * for aligned buffers, but it is not callable after entering S-mode.
+   * Preserve that behavior in the S-mode replacement.
+   */
+
+  if ((((uintptr_t)out | n) & 3u) == 0)
+    {
+      uint32_t *out32 = (uint32_t *)out;
+
+      if (((uintptr_t)in & 3u) == 0)
+        {
+          const uint32_t *in32 = (const uint32_t *)in;
+
+          while (n > 0)
+            {
+              *out32++ = *in32++;
+              n -= sizeof(uint32_t);
+            }
+        }
+      else
+        {
+          /* An unaligned RAM source must not force byte stores to an
+           * aligned MMIO destination.  Assemble each little-endian word
+           * from the source bytes, then issue one aligned store.
+           */
+
+          while (n > 0)
+            {
+              uint32_t word = (uint32_t)in[0] |
+                              (uint32_t)in[1] << 8 |
+                              (uint32_t)in[2] << 16 |
+                              (uint32_t)in[3] << 24;
+
+              *out32++ = word;
+              in += sizeof(uint32_t);
+              n -= sizeof(uint32_t);
+            }
+        }
+
+      return dest;
+    }
+
+  if ((((uintptr_t)in | n) & 3u) == 0)
+    {
+      const uint32_t *in32 = (const uint32_t *)in;
+
+      /* Likewise, never turn an aligned MMIO source into byte reads just
+       * because the RAM destination is unaligned.
+       */
+
+      while (n > 0)
+        {
+          uint32_t word = *in32++;
+
+          out[0] = (uint8_t)word;
+          out[1] = (uint8_t)(word >> 8);
+          out[2] = (uint8_t)(word >> 16);
+          out[3] = (uint8_t)(word >> 24);
+          out += sizeof(uint32_t);
+          n -= sizeof(uint32_t);
+        }
+
+      return dest;
+    }
+
+  while (n-- > 0)
+    {
+      *out++ = *in++;
+    }
+
+  return dest;
+}
+
+#undef memmove
+no_builtin("memmove")
+void *S31_SMODE_LIBC memmove(void *dest, const void *src, size_t n)
+{
+  uint8_t *out = dest;
+  const uint8_t *in = src;
+
+  if (out < in)
+    {
+      while (n-- > 0)
+        {
+          *out++ = *in++;
+        }
+    }
+  else if (out > in)
+    {
+      while (n-- > 0)
+        {
+          out[n] = in[n];
+        }
+    }
+
+  return dest;
+}
+
+#undef memcmp
+int S31_SMODE_LIBC memcmp(const void *lhs, const void *rhs, size_t n)
+{
+  const uint8_t *a = lhs;
+  const uint8_t *b = rhs;
+
+  while (n-- > 0)
+    {
+      if (*a != *b)
+        {
+          return (int)*a - (int)*b;
+        }
+
+      a++;
+      b++;
+    }
+
+  return 0;
+}
+
+#undef memchr
+void *S31_SMODE_LIBC memchr(const void *src, int value, size_t n)
+{
+  const uint8_t *in = src;
+
+  while (n-- > 0)
+    {
+      if (*in == (uint8_t)value)
+        {
+          return (void *)in;
+        }
+
+      in++;
+    }
+
+  return NULL;
+}
+
+#undef strlen
+size_t S31_SMODE_LIBC strlen(const char *s)
+{
+  const char *end = s;
+
+  while (*end != '\0')
+    {
+      end++;
+    }
+
+  return (size_t)(end - s);
+}
+
+#undef strnlen
+size_t S31_SMODE_LIBC strnlen(const char *s, size_t maxlen)
+{
+  size_t len = 0;
+
+  while (len < maxlen && s[len] != '\0')
+    {
+      len++;
+    }
+
+  return len;
+}
+
+#undef strcmp
+int S31_SMODE_LIBC strcmp(const char *lhs, const char *rhs)
+{
+  while (*lhs != '\0' && *lhs == *rhs)
+    {
+      lhs++;
+      rhs++;
+    }
+
+  return (int)(uint8_t)*lhs - (int)(uint8_t)*rhs;
+}
+
+#undef strchr
+char *S31_SMODE_LIBC strchr(const char *s, int value)
+{
+  char c = (char)value;
+
+  do
+    {
+      if (*s == c)
+        {
+          return (char *)s;
+        }
+    }
+  while (*s++ != '\0');
+
+  return NULL;
+}
+
+#undef strcpy
+char *S31_SMODE_LIBC strcpy(char *dest, const char *src)
+{
+  char *out = dest;
+
+  do
+    {
+      *out++ = *src;
+    }
+  while (*src++ != '\0');
+
+  return dest;
+}
+
+#undef strncpy
+char *S31_SMODE_LIBC strncpy(char *dest, const char *src, size_t n)
+{
+  char *out = dest;
+
+  while (n > 0 && *src != '\0')
+    {
+      *out++ = *src++;
+      n--;
+    }
+
+  while (n-- > 0)
+    {
+      *out++ = '\0';
+    }
+
+  return dest;
+}
+
+#undef strlcpy
+size_t S31_SMODE_LIBC strlcpy(char *dest, const char *src, size_t size)
+{
+  const char *start = src;
+
+  if (size > 0)
+    {
+      while (--size > 0 && *src != '\0')
+        {
+          *dest++ = *src++;
+        }
+
+      *dest = '\0';
+    }
+
+  while (*src++ != '\0')
+    {
+    }
+
+  return (size_t)(src - start - 1);
+}
+
+#undef bzero
+void S31_SMODE_LIBC bzero(void *dest, size_t n)
+{
+  memset(dest, 0, n);
+}
diff --git a/arch/risc-v/src/esp32s31/esp32s31_smp.c b/arch/risc-v/src/esp32s31/esp32s31_smp.c
new file mode 100644
index 00000000000..11c8234a0ab
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_smp.c
@@ -0,0 +1,583 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_smp.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <assert.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <strings.h>
+#include <syslog.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/clock.h>
+#include <nuttx/compiler.h>
+#include <nuttx/irq.h>
+#include <nuttx/sched_note.h>
+
+#include "sched/sched.h"
+#include "init/init.h"
+#include "riscv_internal.h"
+#include "riscv_mmu.h"
+#include "riscv_percpu.h"
+
+#include "esp_attr.h"
+#include "esp_err.h"
+#include "esp_intr_alloc.h"
+#include "esp_ipc.h"
+#include "esp_irq.h"
+#include "esp_private/esp_ipc.h"
+#include "esp_private/systimer.h"
+#include "hal/crosscore_int_ll.h"
+#include "hal/systimer_ll.h"
+#include "riscv/csr_clic.h"
+#include "soc/clic_reg.h"
+#include "soc/interrupts.h"
+#include "soc/soc.h"
+
+#include "esp32s31_cpu1_boot.h"
+#include "esp32s31_monitor.h"
+#include "esp32s31_tlb.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define ESP32S31_SMP_CPU0              0
+#define ESP32S31_SMP_CPU1              1
+#define ESP32S31_SMP_CPU1_TIMER_ALARM  SYSTIMER_ALARM_OS_TICK_CORE1
+#define ESP32S31_SMP_RV_INT_MASK       63
+#define ESP32S31_SMP_CLIC_PRIORITY     2
+
+static_assert(CLIC_INT_CTRL_REG(CLIC_EXT_INTR_NUM_OFFSET) ==
+              ESP32S31_MCALL_CLIC_CTRL_BASE,
+              "monitor CLIC base does not match the HAL");
+static_assert((CLIC_INT_IP_M | CLIC_INT_IE_M | CLIC_INT_ATTR_TRIG_M |
+               CLIC_INT_ATTR_SHV_M | CLIC_INT_CTL_M) ==
+              ESP32S31_MCALL_CLIC_WRITABLE_MASK,
+              "monitor CLIC mask does not match the HAL");
+
+/****************************************************************************
+ * Public Data
+ ****************************************************************************/
+
+volatile uint32_t g_esp32s31_smp_ipi_send[CONFIG_SMP_NCPUS];
+volatile uint32_t g_esp32s31_smp_ipi_receive[CONFIG_SMP_NCPUS];
+volatile uint32_t g_esp32s31_smp_timer_count[CONFIG_SMP_NCPUS];
+volatile uint32_t g_esp32s31_smp_cpu1_stage;
+volatile uint32_t g_esp32s31_smp_cpu1_cpuint;
+volatile uint32_t g_esp32s31_smp_cpu1_timer_cpuint;
+volatile uint32_t g_esp32s31_smp_cpu1_sstatus;
+volatile uint32_t g_esp32s31_smp_cpu1_sintthresh;
+
+static void IRAM_ATTR esp32s31_smp_process_pending(int irq, void *context);
+
+uint32_t esp32s31_smp_cpu1_ipi_state(void)
+{
+  return crosscore_int_ll_get_state(ESP32S31_SMP_CPU1);
+}
+
+uint32_t esp32s31_smp_cpu1_ipi_route(void)
+{
+  return REG_READ(DR_REG_INTERRUPT_CORE1_BASE +
+                  4 * ETS_CPU_INTR_FROM_CPU_1_SOURCE);
+}
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct esp32s31_ipc_call_s
+{
+  struct smp_call_data_s call;
+  esp_ipc_func_t         func;
+  FAR void              *arg;
+  volatile bool          busy;
+};
+
+struct esp32s31_ipc_blocking_s
+{
+  esp_ipc_func_t func;
+  FAR void      *arg;
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static struct esp32s31_ipc_call_s
+  g_esp32s31_ipc_call[CONFIG_SMP_NCPUS];
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static inline void esp32s31_smp_fence(void)
+{
+  __asm__ volatile ("fence rw, rw" ::: "memory");
+}
+
+static int IRAM_ATTR esp32s31_smp_configure_cpuint(uint32_t cpuint)
+{
+  const uintptr_t config_mask =
+    CLIC_INT_IE_M | CLIC_INT_ATTR_TRIG_M |
+    CLIC_INT_ATTR_SHV_M | CLIC_INT_CTL_M;
+  register uintptr_t error __asm__("a0") =
+    ESP32S31_MCALL_CLIC_CONFIG;
+  register uintptr_t result __asm__("a1") = cpuint;
+  register uintptr_t clear __asm__("a2") =
+    CLIC_INT_IP_M | config_mask;
+  register uintptr_t value __asm__("a3") =
+    CLIC_INT_IE_M |
+    (NLBITS_TO_BYTE(ESP32S31_SMP_CLIC_PRIORITY) << CLIC_INT_CTL_S);
+
+  __asm__ volatile
+    (
+      "ecall\n"
+      : "+r"(error), "+r"(result), "+r"(clear), "+r"(value)
+      :
+      : "a4", "a5", "a6", "a7", "t0", "t1", "t2", "t3", "t4",
+        "t5", "t6", "memory"
+    );
+
+  if ((intptr_t)error != 0 || (result & config_mask) != value)
+    {
+      return -EIO;
+    }
+
+  return OK;
+}
+
+static int IRAM_ATTR esp32s31_ipc_async_handler(FAR void *arg)
+{
+  FAR struct esp32s31_ipc_call_s *ipc = arg;
+
+  ipc->func(ipc->arg);
+  __atomic_store_n(&ipc->busy, false, __ATOMIC_RELEASE);
+  return OK;
+}
+
+static int esp32s31_ipc_blocking_handler(FAR void *arg)
+{
+  FAR struct esp32s31_ipc_blocking_s *ipc = arg;
+
+  ipc->func(ipc->arg);
+  return OK;
+}
+
+static int IRAM_ATTR esp32s31_smp_ipi_handler(int irq, void *context,
+                                               void *arg)
+{
+  int cpu = this_cpu();
+
+  (void)arg;
+  crosscore_int_ll_clear_interrupt(cpu);
+  g_esp32s31_smp_ipi_receive[cpu]++;
+  esp32s31_smp_fence();
+
+  /* Complete TLB shootdowns before scheduler work so a remote hart waiting
+   * with interrupts masked observes the ack promptly.
+   */
+
+  esp32s31_tlb_shootdown_process();
+
+  esp32s31_smp_process_pending(irq, context);
+
+  return OK;
+}
+
+#ifdef CONFIG_ESP32S31_SMP_TEST
+static int IRAM_ATTR esp32s31_smp_timer1_handler(int irq, void *context,
+                                                 void *arg)
+{
+  systimer_ll_clear_alarm_int(&SYSTIMER,
+                              ESP32S31_SMP_CPU1_TIMER_ALARM);
+  g_esp32s31_smp_timer_count[ESP32S31_SMP_CPU1]++;
+  esp32s31_smp_fence();
+
+  /* CPU0 owns the NuttX global tick.  nxsched_process_timer() accounts for
+   * every configured CPU, so calling it here would double wall time and all
+   * timeout accounting.  Target1 is a private local interrupt source; task
+   * delivery remains owned exclusively by the cross-core scheduler IPI.
+   */
+
+  return OK;
+}
+#endif
+
+static int esp32s31_smp_setup_ipi(int cpu)
+{
+  int source = cpu == ESP32S31_SMP_CPU0 ?
+               ETS_CPU_INTR_FROM_CPU_0_SOURCE :
+               ETS_CPU_INTR_FROM_CPU_1_SOURCE;
+  int cpuint;
+
+  crosscore_int_ll_clear_interrupt(cpu);
+  cpuint = esp_setup_irq(source, ESP_IRQ_PRIORITY_2,
+                         ESP_IRQ_TRIGGER_LEVEL | ESP_IRQ_IRAM);
+  if (cpuint < 0)
+    {
+      return cpuint;
+    }
+
+  if (irq_attach(ESP_SOURCE2IRQ(source), esp32s31_smp_ipi_handler,
+                 NULL) < 0)
+    {
+      esp_teardown_irq(source, cpuint);
+      return -EIO;
+    }
+
+  if (cpu == ESP32S31_SMP_CPU1)
+    {
+      /* The IDF allocator derives the interrupt-matrix core from its own
+       * runtime core-id helper.  S31 runs NuttX in S-mode, where the port's
+       * sscratch hart mapping is authoritative.  Program the proven G.1
+       * core1 matrix path explicitly so the scheduler IPI cannot be left on
+       * core0 by an M-mode-centric helper. */
+
+      uintptr_t reg = DR_REG_INTERRUPT_CORE1_BASE + 4 * source;
+
+      REG_SET_BITS(reg, cpuint + RV_EXTERNAL_INT_OFFSET,
+                   ESP32S31_SMP_RV_INT_MASK);
+      REG_SET_BITS(reg, 0, 3U << 8);
+    }
+
+  up_enable_irq(ESP_SOURCE2IRQ(source));
+  if (cpu == ESP32S31_SMP_CPU1)
+    {
+      g_esp32s31_smp_cpu1_cpuint = cpuint;
+      if (esp32s31_smp_configure_cpuint(cpuint) < 0)
+        {
+          return -EIO;
+        }
+    }
+
+  return OK;
+}
+
+#ifdef CONFIG_ESP32S31_SMP_TEST
+static int esp32s31_smp_setup_timer1(void)
+{
+  uintptr_t reg;
+  int cpuint;
+
+  cpuint = esp_setup_irq(ETS_SYSTIMER_TARGET1_INTR_SOURCE,
+                         ESP_IRQ_PRIORITY_2,
+                         ESP_IRQ_TRIGGER_LEVEL | ESP_IRQ_IRAM);
+  if (cpuint < 0)
+    {
+      return cpuint;
+    }
+
+  if (irq_attach(ESP_SOURCE2IRQ(ETS_SYSTIMER_TARGET1_INTR_SOURCE),
+                 esp32s31_smp_timer1_handler, NULL) < 0)
+    {
+      esp_teardown_irq(ETS_SYSTIMER_TARGET1_INTR_SOURCE, cpuint);
+      return -EIO;
+    }
+
+  /* Keep the target1 route and local CLIC input explicit.  The allocator
+   * already sees the NuttX per-CPU hart ID, but these two writes preserve
+   * the G.1.2-proven ownership rule and ensure the S-mode monitor can
+   * forward this input before the periodic alarm is enabled. */
+
+  reg = DR_REG_INTERRUPT_CORE1_BASE +
+        4 * ETS_SYSTIMER_TARGET1_INTR_SOURCE;
+  REG_SET_BITS(reg, cpuint + RV_EXTERNAL_INT_OFFSET,
+               ESP32S31_SMP_RV_INT_MASK);
+  REG_SET_BITS(reg, 0, 3U << 8);
+  g_esp32s31_smp_cpu1_timer_cpuint = cpuint;
+  if (esp32s31_smp_configure_cpuint(cpuint) < 0)
+    {
+      return -EIO;
+    }
+
+  systimer_ll_enable_alarm(&SYSTIMER,
+                           ESP32S31_SMP_CPU1_TIMER_ALARM, false);
+  systimer_ll_enable_alarm_int(&SYSTIMER,
+                               ESP32S31_SMP_CPU1_TIMER_ALARM, false);
+  systimer_ll_clear_alarm_int(&SYSTIMER,
+                              ESP32S31_SMP_CPU1_TIMER_ALARM);
+  systimer_ll_connect_alarm_counter(&SYSTIMER,
+                                    ESP32S31_SMP_CPU1_TIMER_ALARM,
+                                    SYSTIMER_COUNTER_OS_TICK);
+  systimer_ll_set_alarm_period(&SYSTIMER,
+                               ESP32S31_SMP_CPU1_TIMER_ALARM,
+                               systimer_us_to_ticks(CONFIG_USEC_PER_TICK));
+  systimer_ll_enable_alarm_period(&SYSTIMER,
+                                  ESP32S31_SMP_CPU1_TIMER_ALARM);
+  systimer_ll_apply_alarm_value(&SYSTIMER,
+                                ESP32S31_SMP_CPU1_TIMER_ALARM);
+  systimer_ll_enable_alarm_int(&SYSTIMER,
+                               ESP32S31_SMP_CPU1_TIMER_ALARM, true);
+  systimer_ll_enable_alarm(&SYSTIMER,
+                           ESP32S31_SMP_CPU1_TIMER_ALARM, true);
+  up_enable_irq(ESP_SOURCE2IRQ(ETS_SYSTIMER_TARGET1_INTR_SOURCE));
+  return OK;
+}
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+static void IRAM_ATTR esp32s31_smp_process_pending(int irq, void *context)
+{
+  struct tcb_s *tcb;
+  int cpu = this_cpu();
+
+  nxsched_smp_call_handler(irq, context, NULL);
+
+  tcb = current_task(cpu);
+  riscv_savecontext(tcb);
+  nxsched_process_delivered(cpu);
+  tcb = current_task(cpu);
+  riscv_restorecontext(tcb);
+}
+
+int riscv_smp_call_handler(int irq, void *context, void *arg)
+{
+  return esp32s31_smp_ipi_handler(irq, context, arg);
+}
+
+esp_err_t esp_ipc_call_blocking(uint32_t cpu, esp_ipc_func_t func,
+                                FAR void *arg)
+{
+  struct esp32s31_ipc_blocking_s ipc;
+  int ret;
+
+  if (cpu >= CONFIG_SMP_NCPUS || func == NULL)
+    {
+      return ESP_ERR_INVALID_ARG;
+    }
+
+  if (cpu == ESP32S31_SMP_CPU1 &&
+      g_esp32s31_cpu1_boot_state != ESP32S31_CPU1_SMP_ONLINE)
+    {
+      return ESP_ERR_INVALID_STATE;
+    }
+
+  ipc.func = func;
+  ipc.arg  = arg;
+  ret = nxsched_smp_call_single(cpu, esp32s31_ipc_blocking_handler, &ipc);
+  return ret < 0 ? ESP_FAIL : ESP_OK;
+}
+
+esp_err_t esp_ipc_call(uint32_t cpu, esp_ipc_func_t func, FAR void *arg)
+{
+  /* NuttX's synchronous SMP call has the stronger completion guarantee.
+   * None of the S31 HAL call sites require the weaker "callback started"
+   * return point used by the IDF IPC task implementation. */
+
+  return esp_ipc_call_blocking(cpu, func, arg);
+}
+
+esp_err_t IRAM_ATTR esp_ipc_call_nonblocking(uint32_t cpu,
+                                             esp_ipc_func_t func,
+                                             FAR void *arg)
+{
+  FAR struct esp32s31_ipc_call_s *ipc;
+  bool expected = false;
+  int ret;
+
+  if (cpu >= CONFIG_SMP_NCPUS || func == NULL)
+    {
+      return ESP_ERR_INVALID_ARG;
+    }
+
+  if (cpu == ESP32S31_SMP_CPU1 &&
+      g_esp32s31_cpu1_boot_state != ESP32S31_CPU1_SMP_ONLINE)
+    {
+      return ESP_ERR_INVALID_STATE;
+    }
+
+  ipc = &g_esp32s31_ipc_call[cpu];
+  if (!__atomic_compare_exchange_n(&ipc->busy, &expected, true, false,
+                                   __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+    {
+      return ESP_FAIL;
+    }
+
+  ipc->func = func;
+  ipc->arg  = arg;
+  nxsched_smp_call_init(&ipc->call, esp32s31_ipc_async_handler, ipc);
+  ret = nxsched_smp_call_single_async(cpu, &ipc->call);
+  if (ret < 0)
+    {
+      __atomic_store_n(&ipc->busy, false, __ATOMIC_RELEASE);
+      return ESP_FAIL;
+    }
+
+  return ESP_OK;
+}
+
+noreturn_function void IRAM_ATTR esp32s31_cpu1_smp_entry(void)
+{
+  struct tcb_s *tcb;
+  int ret;
+
+  /* Installing the per-CPU area also arms the trap shim: it treats a
+   * non-zero sscratch as "the full NuttX trap path is usable now".
+   */
+
+  riscv_percpu_add_hart(ESP32S31_SMP_CPU1);
+  esp32s31_smp_fence();
+  tcb = current_task(ESP32S31_SMP_CPU1);
+  riscv_percpu_set_thread(tcb);
+  __asm__ volatile ("mv tp, %0" : : "r"(tcb) : "memory");
+
+  mmu_enable(g_kernel_pgt_pbase, 0);
+  riscv_fpuconfig();
+
+  ret = esp32s31_smp_setup_ipi(ESP32S31_SMP_CPU1);
+  g_esp32s31_smp_cpu1_stage = 1;
+  esp32s31_smp_fence();
+
+  if (ret < 0)
+    {
+      g_esp32s31_cpu1_boot_state = ESP32S31_CPU1_BOOT_SMODE_FAULT;
+      esp32s31_smp_fence();
+      for (; ; )
+        {
+          __asm__ volatile ("wfi");
+        }
+    }
+
+#ifdef CONFIG_ESP32S31_SMP_TEST
+  /* CPU0 owns the global NuttX tick and accounts for every configured CPU.
+   * Target1 is only needed by the explicit SMP interrupt-routing test; do
+   * not inject an otherwise unused periodic interrupt into a minimal boot.
+   */
+
+  ret = esp32s31_smp_setup_timer1();
+#else
+  ret = OK;
+#endif
+  g_esp32s31_smp_cpu1_stage = 2;
+  esp32s31_smp_fence();
+
+  if (ret < 0)
+    {
+      g_esp32s31_cpu1_boot_state = ESP32S31_CPU1_BOOT_SMODE_FAULT;
+      esp32s31_smp_fence();
+      for (; ; )
+        {
+          __asm__ volatile ("wfi");
+        }
+    }
+
+#ifdef CONFIG_STACK_COLORATION
+  riscv_stack_color(tcb->stack_alloc_ptr, 0);
+#endif
+
+#ifdef CONFIG_SCHED_INSTRUMENTATION
+  sched_note_cpu_started(tcb);
+#endif
+
+  g_esp32s31_smp_cpu1_stage = 3;
+  esp32s31_smp_fence();
+
+  up_irq_enable();
+  g_esp32s31_smp_cpu1_sstatus = READ_CSR(CSR_STATUS);
+  g_esp32s31_smp_cpu1_sintthresh = READ_CSR(CSR_SINTTHRESH);
+  g_esp32s31_smp_cpu1_stage = 4;
+  g_esp32s31_cpu1_boot_state = ESP32S31_CPU1_SMP_ONLINE;
+  esp32s31_smp_fence();
+
+  nx_idle_trampoline();
+
+  for (; ; )
+    {
+      __asm__ volatile ("wfi");
+    }
+}
+
+int up_cpu_start(int cpu)
+{
+  uint32_t timeout;
+  int ret;
+
+  DEBUGASSERT(cpu == ESP32S31_SMP_CPU1 && this_cpu() == ESP32S31_SMP_CPU0);
+
+#ifdef CONFIG_SCHED_INSTRUMENTATION
+  sched_note_cpu_start(this_task(), cpu);
+#endif
+
+  if (g_esp32s31_cpu1_boot_state != ESP32S31_CPU1_SMP_READY)
+    {
+      return -EHOSTDOWN;
+    }
+
+  ret = esp32s31_smp_setup_ipi(ESP32S31_SMP_CPU0);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  g_esp32s31_cpu1_smp_release = 1;
+  esp32s31_smp_fence();
+
+  for (timeout = CONFIG_ESP32S31_CPU1_BOOT_TIMEOUT_US;
+       timeout > 0; timeout--)
+    {
+      esp32s31_smp_fence();
+      if (g_esp32s31_cpu1_boot_state == ESP32S31_CPU1_SMP_ONLINE)
+        {
+          syslog(LOG_INFO,
+                 "CPU1 SMP online: ipi0=%" PRIu32 " timer1=%" PRIu32 "\n",
+                 g_esp32s31_smp_ipi_receive[0],
+                 g_esp32s31_smp_timer_count[1]);
+          return OK;
+        }
+
+      if (g_esp32s31_cpu1_boot_state ==
+          ESP32S31_CPU1_BOOT_SMODE_FAULT)
+        {
+          return -EIO;
+        }
+
+      up_udelay(1);
+    }
+
+  g_esp32s31_cpu1_boot_state = ESP32S31_CPU1_SMP_TIMEOUT;
+  esp32s31_smp_fence();
+  return -ETIMEDOUT;
+}
+
+int up_send_smp_sched(int cpu)
+{
+  if (cpu < 0 || cpu >= CONFIG_SMP_NCPUS)
+    {
+      return -EINVAL;
+    }
+
+  if (cpu == ESP32S31_SMP_CPU1 &&
+      g_esp32s31_cpu1_boot_state != ESP32S31_CPU1_SMP_ONLINE)
+    {
+      return -EHOSTDOWN;
+    }
+
+  g_esp32s31_smp_ipi_send[cpu]++;
+  esp32s31_smp_fence();
+  crosscore_int_ll_trigger_interrupt(cpu);
+  return OK;
+}
+
+void up_send_smp_call(cpu_set_t cpuset)
+{
+  int cpu;
+
+  for (; cpuset != 0; cpuset &= ~(1 << cpu))
+    {
+      cpu = ffs(cpuset) - 1;
+      up_send_smp_sched(cpu);
+    }
+}
diff --git a/arch/risc-v/src/esp32s31/esp32s31_supervisor.S b/arch/risc-v/src/esp32s31/esp32s31_supervisor.S
new file mode 100644
index 00000000000..ba5e88dcc27
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_supervisor.S
@@ -0,0 +1,1119 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_supervisor.S
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <arch/irq.h>
+
+#include "esp32s31_monitor.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define ESP32S31_PMP_ALL_RWX       0x1f
+#define ESP32S31_MEDELEG_NUTTX     0xb1ff
+#define ESP32S31_MIDELEG_STANDARD  0x0222
+#define ESP32S31_SINTTHRESH_ENABLE 0x001f
+#define ESP32S31_MINTTHRESH_MONITOR 0x00ff
+#define ESP32S31_MHCR_BRANCH_MASK  0x1030
+#define ESP32S31_MCAUSE_XPPS       0x10000000
+#define ESP32S31_CPU_CORES          2
+#define ESP32S31_MSTACK_SIZE        1024
+
+/* Per-core monitor instrumentation.  The deferral path is the only place that
+ * can observe a forwarded CLIC input being withheld from S-mode, and the
+ * replay paths are the only places that can observe it being handed over, so
+ * the conservation check between them has to be counted here rather than in
+ * the kernel.  Eight words per core keeps the index scaling a single shift.
+ */
+
+#define ESP32S31_MONSTAT_SHIFT      5
+#define ESP32S31_MONSTAT_DEFER      0
+#define ESP32S31_MONSTAT_REPLAY     1
+#define ESP32S31_MONSTAT_ACK        2
+#define ESP32S31_MONSTAT_DROP       3
+#define ESP32S31_MONSTAT_SREPLAY    4
+
+/****************************************************************************
+ * Public Symbols
+ ****************************************************************************/
+
+  .global esp32s31_start_smode
+  .type   esp32s31_start_smode, function
+
+  .global esp32s31_machine_trap
+  .type   esp32s31_machine_trap, function
+
+  .global esp32s31_supervisor_trap
+  .type   esp32s31_supervisor_trap, function
+
+  .extern _vector_table
+  .extern _mtvt_table
+  .extern esp32s31_mmode_fault
+  .extern esp32s31_supervisor_return_ecall
+  .extern esp32s31_user_return_ecall
+  .extern g_interrupt_context
+#ifdef CONFIG_ESP32S31_SMP
+  .extern esp32s31_cpu1_supervisor_trap
+#endif
+
+/****************************************************************************
+ * Assembly Macros
+ ****************************************************************************/
+
+  .macro esp32s31_percore_address destination, scratch, symbol
+  la      \destination, \symbol
+  csrr    \scratch, mhartid
+  slli    \scratch, \scratch, 2
+  add     \destination, \destination, \scratch
+  .endm
+
+/* Increment one per-core monitor counter.  Both operands are clobbered.  Every
+ * use site sits where t0-t2 are already dead, so no counter update can perturb
+ * the interrupted context.
+ */
+
+  .macro esp32s31_monstat_bump index, address, scratch
+  la      \address, g_esp32s31_machine_monstat
+  csrr    \scratch, mhartid
+  slli    \scratch, \scratch, ESP32S31_MONSTAT_SHIFT
+  add     \address, \address, \scratch
+  lw      \scratch, ((\index) * 4)(\address)
+  addi    \scratch, \scratch, 1
+  sw      \scratch, ((\index) * 4)(\address)
+  .endm
+
+/* Temporary input-1 monitor-to-Wi-Fi-callback timing. The interrupted
+ * registers have already been saved, so this excludes hardware entry and
+ * monitor register-save time. Both direct and deferred delivery are sampled.
+ * C records completion at esp_int_adpt_cb, after the S-mode trap prologue.
+ * Layout: start, last, max, samples, >32us, >100us, >1ms, sum, deferred,
+ * direct-max, deferred-max, direct-count, deferred-count, reserved[3].
+ */
+
+  .macro esp32s31_monlat_start
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t0, mcause
+  andi    t0, t0, 0x3f
+  li      t1, 17                /* Input 1 + external cause base 16. */
+  bne     t0, t1, 90f
+  la      t0, g_esp32s31_machine_monlat
+  csrr    t1, mhartid
+  slli    t1, t1, 6
+  add     t0, t0, t1
+  sw      zero, 32(t0)
+  csrr    t1, mcycle
+  sw      t1, 0(t0)
+90:
+#endif
+  .endm
+
+  .macro esp32s31_monlat_defer
+#ifdef CONFIG_ESP32S31_SMP
+  li      t0, 2                 /* t2 is the external-input bit mask. */
+  bne     t2, t0, 90f
+  la      t0, g_esp32s31_machine_monlat
+  csrr    t1, mhartid
+  slli    t1, t1, 6
+  add     t0, t0, t1
+  li      t1, 1
+  sw      t1, 32(t0)
+90:
+#endif
+  .endm
+
+/****************************************************************************
+ * Machine-mode monitor stack
+ ****************************************************************************/
+
+  .section .bss.esp32s31_mstack, "aw", @nobits
+  .balign 16
+  .global g_esp32s31_machine_stacks
+  .type   g_esp32s31_machine_stacks, object
+g_esp32s31_machine_stacks:
+.Lmachine_stacks:
+  .space (ESP32S31_MSTACK_SIZE * ESP32S31_CPU_CORES)
+  .size   g_esp32s31_machine_stacks, \
+          (ESP32S31_MSTACK_SIZE * ESP32S31_CPU_CORES)
+  .global g_esp32s31_machine_forward_mask
+  .type   g_esp32s31_machine_forward_mask, object
+g_esp32s31_machine_forward_mask:
+  .space (4 * ESP32S31_CPU_CORES)
+  .size   g_esp32s31_machine_forward_mask, (4 * ESP32S31_CPU_CORES)
+  .global g_esp32s31_machine_flash_mask
+  .type   g_esp32s31_machine_flash_mask, object
+g_esp32s31_machine_flash_mask:
+  .space (4 * ESP32S31_CPU_CORES)
+  .size   g_esp32s31_machine_flash_mask, (4 * ESP32S31_CPU_CORES)
+  .global g_esp32s31_machine_monstat
+  .type   g_esp32s31_machine_monstat, object
+g_esp32s31_machine_monstat:
+  .space ((1 << ESP32S31_MONSTAT_SHIFT) * ESP32S31_CPU_CORES)
+  .size   g_esp32s31_machine_monstat, \
+          ((1 << ESP32S31_MONSTAT_SHIFT) * ESP32S31_CPU_CORES)
+  .global g_esp32s31_machine_monlat
+  .type   g_esp32s31_machine_monlat, object
+g_esp32s31_machine_monlat:
+  .space (64 * ESP32S31_CPU_CORES)
+  .size   g_esp32s31_machine_monlat, (64 * ESP32S31_CPU_CORES)
+/****************************************************************************
+ * Machine-mode startup trampoline
+ ****************************************************************************/
+
+  .section .iram1, "ax", @progbits
+  .balign 4
+
+/****************************************************************************
+ * Name: esp32s31_start_smode
+ *
+ * Input Parameters:
+ *   a0 - Supervisor-mode entry point.  This function does not return.
+ ****************************************************************************/
+
+esp32s31_start_smode:
+  mv      t6, a0
+
+  /* Install the small M-mode monitor before changing delegation state. */
+
+  la      t0, esp32s31_machine_trap
+  ori     t0, t0, 3
+  csrw    mtvec, t0
+  la      t0, .Lmachine_stacks
+  csrr    t1, mhartid
+  addi    t1, t1, 1
+  slli    t1, t1, 10
+  add     t0, t0, t1
+  csrw    mscratch, t0
+
+  /* A vertical S-to-M exception enters CLIC M-mode at interrupt level zero.
+   * Keep the monitor itself non-preemptible so a newly enabled CLIC input
+   * cannot overwrite mepc/mcause in the middle of an ecall service.  The
+   * machine threshold is ignored while executing in S-mode, so pending
+   * M-mode inputs become eligible atomically with mret.
+   */
+
+  li      t0, ESP32S31_MINTTHRESH_MONITOR
+  csrw    CSR_MINTTHRESH, t0
+
+  /* S-mode is allowed to address the SoC physical map.  Sv32 page tables
+   * provide the fine-grained kernel/user permissions after MMU bring-up.
+   */
+
+  li      t0, -1
+  csrw    pmpaddr0, t0
+  li      t0, ESP32S31_PMP_ALL_RWX
+  csrw    pmpcfg0, t0
+
+  /* Permit S/U reads of cycle/time/instret counters. */
+
+  li      t0, -1
+  csrw    mcounteren, t0
+
+  /* Do not inherit ROM/IDF CLIC enables into the S-mode kernel.  A pending
+   * source could otherwise trap before NuttX has installed its handlers.
+   * External CLIC inputs occupy IDs 16-47 and each byte IE register is four
+   * bytes apart.  NuttX re-enables allocated sources through the M-call ABI.
+   */
+
+  li      t0, 0x10801041
+  li      t1, 32
+.Ldisable_external_clic:
+  sb      zero, 0(t0)
+  addi    t0, t0, 4
+  addi    t1, t1, -1
+  bnez    t1, .Ldisable_external_clic
+
+  /* Delegate synchronous faults and U-mode ecall to the S-mode kernel.
+   * S-mode ecall deliberately remains in M-mode for monitor diagnostics.
+   */
+
+  li      t0, ESP32S31_MEDELEG_NUTTX
+  csrw    medeleg, t0
+  li      t0, ESP32S31_MIDELEG_STANDARD
+  csrw    mideleg, t0
+
+  /* Configure the supervisor CLIC exception and hardware-vector tables. */
+
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t1, mhartid
+  beqz    t1, 1f
+  la      t0, esp32s31_cpu1_supervisor_trap
+  j       2f
+1:
+#endif
+  la      t0, _vector_table
+#ifdef CONFIG_ESP32S31_SMP
+2:
+#endif
+  ori     t0, t0, 3
+  csrw    stvec, t0
+  la      t0, _mtvt_table
+  csrw    CSR_STVT, t0
+  li      t0, ESP32S31_SINTTHRESH_ENABLE
+  csrw    CSR_SINTTHRESH, t0
+
+  /* ESP32-S31's CLIC does not implement the standard sie CSR (0x104).
+   * Per-source enables live in clicintie and the global S-mode gate is
+   * sstatus.SIE, so no sie write is needed here.
+   */
+
+  csrc    sstatus, SSTATUS_SIE
+  li      t0, SSTATUS_SUM
+  csrs    sstatus, t0
+
+  /* Start with address translation disabled.  The later Kernel Build stage
+   * installs the kernel root table and changes satp to Sv32 in S-mode.
+   */
+
+  csrw    satp, zero
+  sfence.vma zero, zero
+
+  /* mstatus.MPP = S, with M/S interrupts disabled until NuttX initializes
+   * its interrupt subsystem.
+   */
+
+  csrr    t0, mstatus
+  li      t1, 0xffffe777
+  and     t0, t0, t1
+  /* Official S31 wireless blobs use ilp32f.  Enable the F extension before
+   * the first S-mode context frame is created; riscv_fpuconfig() will clear
+   * fcsr and finish initialization later in normal NuttX startup. */
+  li      t1, 0x00002800
+  or      t0, t0, t1
+  csrw    mstatus, t0
+  csrw    mepc, t6
+  mret
+
+  .size esp32s31_start_smode, .-esp32s31_start_smode
+
+/****************************************************************************
+ * Name: esp32s31_supervisor_trap
+ *
+ * Description:
+ *   Enter NuttX's normal S-mode exception vector after the M-mode monitor
+ *   has recreated the architectural supervisor trap state.
+ ****************************************************************************/
+
+  .balign 4
+esp32s31_supervisor_trap:
+  j       _vector_table
+
+  .size esp32s31_supervisor_trap, .-esp32s31_supervisor_trap
+
+/****************************************************************************
+ * Name: esp32s31_machine_trap
+ *
+ * Description:
+ *   Provide three narrow M-mode services:
+ *
+ *   1. Proxy CLIC configuration accesses made by the S-mode HAL.
+ *   2. Forward the M-only CLIC interrupt into NuttX as a synthetic S-mode
+ *      trap.  ESP32-S31 hardwires clicintattr.mode to M, so an architectural
+ *      mideleg write cannot move these interrupt causes to S-mode.
+ *   3. Forward synchronous exceptions originating in U-mode when the S31's
+ *      WARL medeleg implementation cannot delegate their cause directly.
+ *
+ *   Any other M-mode trap is diagnosed and stops the core.
+ ****************************************************************************/
+
+  .balign 0x40
+esp32s31_machine_trap:
+  /* Preserve every S/U-mode register touched by the shim.  mscratch holds
+   * the private M-mode stack while normal execution uses the NuttX stack.
+   */
+
+  csrrw   sp, mscratch, sp
+  addi    sp, sp, -16
+  sw      t0, 0(sp)
+  sw      t1, 4(sp)
+  sw      t2, 8(sp)
+
+  csrr    t0, mcause
+  bltz    t0, .Lmachine_forward_interrupt
+
+  /* S31 implements only a subset of medeleg (U-ecall and page faults on the
+   * tested revision).  Forward any other synchronous exception taken from
+   * U-mode so NuttX can apply its normal per-process fault policy.  Faults
+   * from S/M-mode still indicate a monitor or kernel failure and are fatal.
+   */
+
+  csrr    t1, mstatus
+  li      t2, MSTATUS_MPP_MASK
+  and     t1, t1, t2
+  beqz    t1, .Lmachine_forward_exception
+
+  andi    t1, t0, 0x3f
+  li      t2, 9
+  bne     t1, t2, .Lmachine_trap_fault
+
+  /* return_from_exception enters this service only after it has restored
+   * every U-mode general register and installed the user EPC/status.  The
+   * call therefore cannot use a0 as an ABI selector.  Recognize its unique
+   * PC before dispatching the ordinary monitor services.
+   */
+
+  csrr    t1, mepc
+  la      t2, esp32s31_user_return_ecall
+  beq     t1, t2, .Lmachine_user_return
+  la      t2, esp32s31_supervisor_return_ecall
+  beq     t1, t2, .Lmachine_supervisor_return
+
+  /* S-mode ecall is the narrow monitor ABI used for CLIC registers that are
+   * physically M-mode-only on ESP32-S31:
+   *
+   *   a0 = 2: configure local CLIC source a1, clearing fields a2 and setting
+   *           fields a3; return status in a0 and the register value in a1
+   *   a0 = 3: hand one deferred input back to S-mode as a supervisor trap
+   *   a0 = 4: forget deferred CLIC input a1, leaving it masked
+   *   a0 = 5: mask external CLIC inputs and disable branch prediction while
+   *           the Flash cache is off
+   *   a0 = 6: re-enable branch prediction and restore the external CLIC mask
+   *           after restoring the Flash cache
+   *   a0 = 7: acknowledge and re-enable CLIC input a1 after its S-mode ISR
+   *   a0 = 9: confirm that the caller entered the monitor from S-mode
+   */
+
+  li      t1, 3
+  beq     a0, t1, .Lmachine_irq_reenable
+  li      t1, 4
+  beq     a0, t1, .Lmachine_irq_drop
+  li      t1, ESP32S31_MCALL_FLASH_GUARD_ENTER
+  beq     a0, t1, .Lmachine_branch_disable
+  li      t1, ESP32S31_MCALL_FLASH_GUARD_LEAVE
+  beq     a0, t1, .Lmachine_branch_enable
+  li      t1, 7
+  beq     a0, t1, .Lmachine_irq_ack
+  li      t1, 9
+  beq     a0, t1, .Lmachine_confirm_smode
+  li      t1, ESP32S31_MCALL_CLIC_CONFIG
+  bne     a0, t1, .Lmachine_ecall_unknown
+
+.Lmachine_clic_config:
+  /* Only the 32 external inputs owned by the local hart may be addressed.
+   * Reject attempts to modify the hardwired privilege mode or reserved bits.
+   * A zero clear/set mask is a side-effect-free query for the HAL getters.
+   */
+
+  li      t0, ESP32S31_MCALL_CLIC_SOURCE_COUNT
+  bgeu    a1, t0, .Lmachine_ecall_invalid
+  or      t0, a2, a3
+  li      t1, ESP32S31_MCALL_CLIC_RESERVED_MASK
+  and     t0, t0, t1
+  bnez    t0, .Lmachine_ecall_invalid
+
+  slli    t0, a1, 2
+  li      t1, ESP32S31_MCALL_CLIC_CTRL_BASE
+  add     t0, t0, t1
+  lw      t1, 0(t0)
+  or      t2, a2, a3
+  beqz    t2, 1f
+  not     t2, a2
+  and     t1, t1, t2
+  or      t1, t1, a3
+  sw      t1, 0(t0)
+  lw      t1, 0(t0)
+1:
+  mv      a1, t1
+  li      a0, 0
+  j       .Lmachine_ecall_return
+
+.Lmachine_confirm_smode:
+  li      a0, 1
+  j       .Lmachine_ecall_return
+
+.Lmachine_irq_reenable:
+  /* Re-enable CLIC inputs that were masked while their interrupt was being
+   * serviced in S-mode.  Callers use this after the peripheral ISR has
+   * cleared or re-armed its source.
+   */
+
+  esp32s31_percore_address t0, t2, g_esp32s31_machine_forward_mask
+  lw      t1, 0(t0)
+#ifdef CONFIG_ESP32S31_SMP
+  /* SIE can be restored while riscv_doirq() is still dispatching the outer
+   * interrupt.  NuttX does not support nested interrupts, so do not
+   * synthesize another S trap until its per-CPU interrupt-context flag is
+   * clear.  Reading the byte directly also keeps this M-mode path free from
+   * scheduler/helper calls. */
+
+  la      t0, g_interrupt_context
+  csrr    t2, mhartid
+  add     t0, t0, t2
+  lbu     t0, 0(t0)
+  bnez    t0, .Lmachine_irq_reenable_empty
+
+  /* Do not expose an asserted M-mode CLIC input at an ecall-return boundary.
+   * S31 can tail-chain it before mret has committed the S-mode return state,
+   * replacing mepc with an intermediate monitor value.  Instead, consume
+   * the ecall and recreate the architectural state of an S-mode interrupt.
+   * The S-mode handler clears the peripheral source and service 7 re-enables
+   * the hardware input afterwards.
+   */
+
+  beqz    t1, .Lmachine_irq_reenable_empty
+  li      a1, 0
+  mv      t2, t1
+.Lmachine_irq_deferred_find:
+  andi    t0, t2, 1
+  bnez    t0, .Lmachine_irq_deferred_found
+  srli    t2, t2, 1
+  addi    a1, a1, 1
+  j       .Lmachine_irq_deferred_find
+
+.Lmachine_irq_deferred_found:
+  /* Remove this input from the deferred mask.  Any other pending input stays
+   * masked until a later task-context service-3 call. */
+
+  li      t0, 1
+  sll     t0, t0, a1
+  not     t0, t0
+  and     t1, t1, t0
+  esp32s31_percore_address t0, t2, g_esp32s31_machine_forward_mask
+  sw      t1, 0(t0)
+  esp32s31_monstat_bump ESP32S31_MONSTAT_REPLAY, t0, t1
+
+  addi    t2, a1, 16
+  li      t0, 0x80000000
+  or      t2, t2, t0
+  csrw    scause, t2
+
+  csrr    t0, mepc
+  addi    t0, t0, 4
+  csrw    sepc, t0
+  csrw    stval, zero
+
+  /* Model a supervisor trap taken from the currently executing S-mode
+   * monitor caller.  Preserve its SIE state in SPIE and force SPP=S so sret
+   * resumes the interrupted exception-exit or task-context code.
+   */
+
+  csrr    t1, sstatus
+  andi    t1, t1, SSTATUS_SIE
+  li      t0, (SSTATUS_SIE | SSTATUS_SPIE | SSTATUS_SPPS)
+  csrc    sstatus, t0
+  beqz    t1, 5f
+  li      t0, SSTATUS_SPIE
+  csrs    sstatus, t0
+5:
+  li      t0, SSTATUS_SPPS
+  csrs    sstatus, t0
+
+  li      t0, MSTATUS_MPP_MASK
+  csrc    mstatus, t0
+  li      t0, MSTATUS_MPPS
+  csrs    mstatus, t0
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t0, mhartid
+  bnez    t0, 6f
+#endif
+  la      t0, esp32s31_supervisor_trap
+#ifdef CONFIG_ESP32S31_SMP
+  j       7f
+6:
+  la      t0, esp32s31_cpu1_supervisor_trap
+7:
+#endif
+  csrw    mepc, t0
+  j       .Lmachine_trap_return
+
+.Lmachine_irq_reenable_empty:
+  li      a0, 0
+  j       .Lmachine_ecall_return
+#else
+  /* The established single-core path can safely restore all deferred inputs
+   * after clearing the mask.  Keep the SMP-only synthetic trap replay out of
+   * production: it changes the ecall return state and can corrupt a U-mode
+   * syscall frame even though no second scheduler CPU exists.
+   */
+
+  sw      zero, 0(t0)
+  li      t0, 0x10801041
+  li      t2, 32
+.Lmachine_irq_reenable_loop:
+  andi    a1, t1, 1
+  beqz    a1, 1f
+  li      a1, 1
+  sb      a1, 0(t0)
+1:
+  srli    t1, t1, 1
+  addi    t0, t0, 4
+  addi    t2, t2, -1
+  bnez    t2, .Lmachine_irq_reenable_loop
+  li      a0, 0
+  j       .Lmachine_ecall_return
+#endif
+
+.Lmachine_irq_drop:
+  /* Keep the unclaimed/stale CLIC input in a1 disabled.  A later NuttX
+   * interrupt allocation will explicitly enable the line if it becomes
+   * valid.
+   *
+   * Only that one input may be forgotten.  Every other bit in the deferred
+   * set names an input whose hardware enable this monitor has already
+   * cleared, so dropping the whole word would leave those inputs masked
+   * with nothing left to re-enable them -- and the set routinely holds the
+   * scheduler tick, the cross-core IPI and the console.
+   */
+
+  li      t0, 32
+  bgeu    a1, t0, .Lmachine_ecall_unknown
+  li      t0, 1
+  sll     t0, t0, a1
+  not     t0, t0
+  esp32s31_percore_address t1, t2, g_esp32s31_machine_forward_mask
+  lw      t2, 0(t1)
+  and     t2, t2, t0
+  sw      t2, 0(t1)
+  esp32s31_monstat_bump ESP32S31_MONSTAT_DROP, t0, t1
+  li      a0, 0
+  j       .Lmachine_ecall_return
+
+.Lmachine_irq_ack:
+  /* Remove one completed interrupt from the deferred set and re-enable only
+   * that CLIC input.  Re-enabling all deferred inputs from inside an ISR can
+   * immediately retrigger an unrelated level source while sstatus.SIE is
+   * still clear.
+   */
+
+  li      t0, 32
+  bgeu    a1, t0, .Lmachine_ecall_unknown
+  li      t0, 1
+  sll     t0, t0, a1
+  esp32s31_percore_address t1, t2, g_esp32s31_machine_forward_mask
+  lw      t2, 0(t1)
+  not     t0, t0
+  and     t2, t2, t0
+  sw      t2, 0(t1)
+
+  slli    t0, a1, 2
+  li      t1, 0x10801041
+  add     t0, t0, t1
+  /* The S31 CLIC keeps the forwarded pending bit latched after its input
+   * has been masked.  The S-mode peripheral handler has already cleared
+   * the device source, so drop that stale pending state before re-enabling
+   * the input.  A still-asserted level source will set it again.
+   */
+  sb      zero, -1(t0)
+
+  /* t0 still carries the clicintie address for the single-core return path
+   * below, so account this acknowledgement using t1/t2 only.
+   */
+
+  esp32s31_monstat_bump ESP32S31_MONSTAT_ACK, t1, t2
+
+#ifdef CONFIG_ESP32S31_SMP
+  /* As with deferred service 3, exposing the CLIC input before the M-call
+   * frame is fully restored permits hardware tail-chaining to overwrite
+   * mepc/mcause.  Complete the ecall return first and make the IE store the
+   * final instruction before mret.  a0/a1 are caller-clobbered by the
+   * service-7 ABI. */
+
+  csrr    t0, mepc
+  addi    t0, t0, 4
+  csrw    mepc, t0
+
+  lw      t0, 0(sp)
+  lw      t1, 4(sp)
+  lw      t2, 8(sp)
+  addi    sp, sp, 16
+  csrrw   sp, mscratch, sp
+
+  slli    a1, a1, 2
+  li      a0, 0x10801041
+  add     a1, a1, a0
+  li      a0, 1
+  sb      a0, 0(a1)
+  mret
+#else
+  /* Preserve the established single-core ecall ABI.  With no peer scheduler
+   * CPU, the ordinary monitor return is the validated path and keeps the
+   * caller's complete register frame intact.
+   */
+
+  li      t1, 1
+  sb      t1, 0(t0)
+  li      a0, 0
+  j       .Lmachine_ecall_return
+#endif
+
+.Lmachine_branch_disable:
+  /* CLIC inputs are fixed to M-mode on S31 and therefore are not blocked by
+   * sstatus.SIE.  Save and clear every external source before cache-off code
+   * begins so the monitor cannot forward an interrupt into cached S-mode
+   * code.  Each byte-wide IE register is four bytes apart.
+   */
+
+  li      t0, 0x10801041
+  li      t1, 32
+  li      t2, 0
+.Lmachine_flash_mask_loop:
+  lbu     a1, 0(t0)
+  andi    a1, a1, 1
+  srli    t2, t2, 1
+  beqz    a1, 1f
+  li      a1, 0x80000000
+  or      t2, t2, a1
+1:
+  sb      zero, 0(t0)
+  addi    t0, t0, 4
+  addi    t1, t1, -1
+  bnez    t1, .Lmachine_flash_mask_loop
+  esp32s31_percore_address t0, t1, g_esp32s31_machine_flash_mask
+  sw      t2, 0(t0)
+  li      t0, ESP32S31_MHCR_BRANCH_MASK
+  csrrc   zero, 0x7c1, t0
+  li      a0, 0
+  j       .Lmachine_ecall_return
+
+.Lmachine_branch_enable:
+  li      t0, ESP32S31_MHCR_BRANCH_MASK
+  csrrs   zero, 0x7c1, t0
+  esp32s31_percore_address t0, t1, g_esp32s31_machine_flash_mask
+  lw      t2, 0(t0)
+  sw      zero, 0(t0)
+  li      t0, 0x10801041
+  li      t1, 32
+.Lmachine_flash_restore_loop:
+  andi    a1, t2, 1
+  sb      a1, 0(t0)
+  srli    t2, t2, 1
+  addi    t0, t0, 4
+  addi    t1, t1, -1
+  bnez    t1, .Lmachine_flash_restore_loop
+  li      a0, 0
+  j       .Lmachine_ecall_return
+
+.Lmachine_ecall_unknown:
+.Lmachine_ecall_invalid:
+  li      a0, -1
+
+.Lmachine_ecall_return:
+  csrr    t0, mepc
+  addi    t0, t0, 4
+  csrw    mepc, t0
+  j       .Lmachine_trap_return
+
+.Lmachine_supervisor_return:
+  /* Complete an S-to-S exception return atomically.  If the selected frame
+   * restores SIE, consume one deferred input and model an interrupt taken
+   * immediately after sret entered S-mode.  If the frame intentionally keeps
+   * SIE clear, leave the input deferred for its eventual up_irq_restore().
+   */
+
+  csrr    t1, sstatus
+  andi    t1, t1, SSTATUS_SPIE
+  beqz    t1, .Lmachine_supervisor_return_direct
+
+  esp32s31_percore_address t0, t2, g_esp32s31_machine_forward_mask
+  lw      t1, 0(t0)
+  beqz    t1, .Lmachine_supervisor_return_direct
+
+  li      t2, 0
+.Lmachine_supervisor_return_find:
+  andi    t0, t1, 1
+  bnez    t0, .Lmachine_supervisor_return_found
+  srli    t1, t1, 1
+  addi    t2, t2, 1
+  j       .Lmachine_supervisor_return_find
+
+.Lmachine_supervisor_return_found:
+  /* Publish the synthetic cause while t2 still holds the input index. */
+
+  addi    t2, t2, 16
+  li      t0, 0x80000000
+  or      t2, t2, t0
+  csrw    scause, t2
+  csrw    stval, zero
+
+  andi    t2, t2, 0x3f
+  addi    t2, t2, -16
+  li      t0, 1
+  sll     t0, t0, t2
+  not     t0, t0
+  esp32s31_percore_address t1, t2, g_esp32s31_machine_forward_mask
+  lw      t2, 0(t1)
+  and     t2, t2, t0
+  sw      t2, 0(t1)
+  esp32s31_monstat_bump ESP32S31_MONSTAT_REPLAY, t0, t1
+  esp32s31_monstat_bump ESP32S31_MONSTAT_SREPLAY, t0, t1
+
+  /* sret would first copy SPIE to SIE.  The synthetic trap then copies that
+   * value back to SPIE, clears SIE and records an S-mode origin in SPP.
+   */
+
+  csrr    t1, sstatus
+  andi    t1, t1, SSTATUS_SPIE
+  li      t0, (SSTATUS_SIE | SSTATUS_SPIE | SSTATUS_SPPS)
+  csrc    sstatus, t0
+  beqz    t1, 1f
+  li      t0, SSTATUS_SPIE
+  csrs    sstatus, t0
+1:
+  li      t0, SSTATUS_SPPS
+  csrs    sstatus, t0
+
+  li      t0, MSTATUS_MPP_MASK
+  csrc    mstatus, t0
+  li      t0, MSTATUS_MPPS
+  csrs    mstatus, t0
+  li      t0, MSTATUS_MPIE
+  csrs    mstatus, t0
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t0, mhartid
+  bnez    t0, 2f
+#endif
+  la      t0, esp32s31_supervisor_trap
+#ifdef CONFIG_ESP32S31_SMP
+  j       3f
+2:
+  la      t0, esp32s31_cpu1_supervisor_trap
+3:
+#endif
+  csrw    mepc, t0
+  j       .Lmachine_trap_return
+
+.Lmachine_supervisor_return_direct:
+  /* No eligible deferred input remains.  Reproduce sret's status effects and
+   * use mret for the final transition so a tail-chained CLIC input observes a
+   * complete S-mode return state rather than the monitor ecall frame.
+   */
+
+  csrr    t0, sepc
+  csrw    mepc, t0
+
+  csrr    t0, sstatus
+  andi    t1, t0, SSTATUS_SPIE
+  li      t0, (SSTATUS_SIE | SSTATUS_SPIE | SSTATUS_SPPS)
+  csrc    sstatus, t0
+  beqz    t1, 4f
+  li      t0, SSTATUS_SIE
+  csrs    sstatus, t0
+4:
+  li      t0, SSTATUS_SPIE
+  csrs    sstatus, t0
+
+  li      t0, MSTATUS_MPP_MASK
+  csrc    mstatus, t0
+  li      t0, MSTATUS_MPPS
+  csrs    mstatus, t0
+  li      t0, MSTATUS_MPIE
+  csrs    mstatus, t0
+  csrr    t0, mcause
+  li      t1, 0xc7ffffff
+  and     t0, t0, t1
+  li      t1, 0x18000000
+  or      t0, t0, t1
+  csrw    mcause, t0
+  j       .Lmachine_trap_return
+
+.Lmachine_user_return:
+  /* If an external source was deferred while S-mode had SIE clear, consume
+   * exactly one source and enter the normal S-mode vector as a trap from U.
+   * The ISR return reaches this gate again and drains the next source.  All
+   * user registers remain untouched because the monitor uses only t0-t2,
+   * which were saved on its private stack at entry.
+   */
+
+  esp32s31_percore_address t0, t2, g_esp32s31_machine_forward_mask
+  lw      t1, 0(t0)
+  beqz    t1, .Lmachine_user_return_direct
+
+  li      t2, 0
+.Lmachine_user_return_find:
+  andi    t0, t1, 1
+  bnez    t0, .Lmachine_user_return_found
+  srli    t1, t1, 1
+  addi    t2, t2, 1
+  j       .Lmachine_user_return_find
+
+.Lmachine_user_return_found:
+  /* Publish the synthetic supervisor cause while t2 still contains the
+   * selected external-input index.
+   */
+
+  addi    t2, t2, 16
+  li      t0, 0x80000000
+  or      t2, t2, t0
+  csrw    scause, t2
+  csrw    stval, zero
+
+  andi    t2, t2, 0x3f
+  addi    t2, t2, -16
+  li      t0, 1
+  sll     t0, t0, t2
+  not     t0, t0
+  esp32s31_percore_address t1, t2, g_esp32s31_machine_forward_mask
+  lw      t2, 0(t1)
+  and     t2, t2, t0
+  sw      t2, 0(t1)
+  esp32s31_monstat_bump ESP32S31_MONSTAT_REPLAY, t0, t1
+
+  /* Model an interrupt immediately after the pending sret would have
+   * entered U-mode.  sret first copies SPIE to SIE; the subsequent trap
+   * copies that value back to SPIE and clears SIE.  Therefore the synthetic
+   * trap's SPIE comes from the saved return state's SPIE, not its SIE.
+   */
+
+  csrr    t1, sstatus
+  andi    t1, t1, SSTATUS_SPIE
+  li      t0, (SSTATUS_SIE | SSTATUS_SPIE | SSTATUS_SPPS)
+  csrc    sstatus, t0
+  beqz    t1, 1f
+  li      t0, SSTATUS_SPIE
+  csrs    sstatus, t0
+1:
+  li      t0, MSTATUS_MPP_MASK
+  csrc    mstatus, t0
+  li      t0, MSTATUS_MPPS
+  csrs    mstatus, t0
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t0, mhartid
+  bnez    t0, 2f
+#endif
+  la      t0, esp32s31_supervisor_trap
+#ifdef CONFIG_ESP32S31_SMP
+  j       3f
+2:
+  la      t0, esp32s31_cpu1_supervisor_trap
+3:
+#endif
+  csrw    mepc, t0
+  j       .Lmachine_trap_return
+
+.Lmachine_user_return_direct:
+  /* sepc and sstatus already hold the selected user's architectural return
+   * state.  Make the M-level return target U explicitly in both mstatus and
+   * the S31 CLIC extension fields carried by mcause, then jump straight to
+   * the user EPC.  A CLIC input tail-chained at this mret consequently sees
+   * a complete U-mode frame and is safe to forward immediately.
+   */
+
+  csrr    t0, sepc
+  csrw    mepc, t0
+
+  /* This path replaces the final sret, so reproduce all of its supervisor
+   * status effects before mret enters U-mode: SIE=SPIE, SPIE=1 and SPP=U.
+   * Leaving SIE cleared slowly corrupts the saved return state under a high
+   * rate of scheduler ticks even though higher-privilege interrupts can
+   * still arrive while U-mode is running.
+   */
+
+  csrr    t0, sstatus
+  andi    t1, t0, SSTATUS_SPIE
+  li      t0, (SSTATUS_SIE | SSTATUS_SPIE | SSTATUS_SPPS)
+  csrc    sstatus, t0
+  beqz    t1, 4f
+  li      t0, SSTATUS_SIE
+  csrs    sstatus, t0
+4:
+  li      t0, SSTATUS_SPIE
+  csrs    sstatus, t0
+
+  li      t0, MSTATUS_MPP_MASK
+  csrc    mstatus, t0
+  li      t0, MSTATUS_MPIE
+  csrs    mstatus, t0
+  csrr    t0, mcause
+  li      t1, 0xc7ffffff
+  and     t0, t0, t1
+  li      t1, 0x08000000
+  or      t0, t0, t1
+  csrw    mcause, t0
+  j       .Lmachine_trap_return
+
+.Lmachine_forward_exception:
+  /* Recreate an S-mode trap whose previous privilege is U. */
+
+  csrw    scause, t0
+  csrr    t1, mepc
+  csrw    sepc, t1
+  csrr    t1, mtval
+  csrw    stval, t1
+
+  csrr    t1, sstatus
+  andi    t1, t1, SSTATUS_SIE
+  li      t0, (SSTATUS_SIE | SSTATUS_SPIE | SSTATUS_SPPS)
+  csrc    sstatus, t0
+  beqz    t1, 1f
+  li      t0, SSTATUS_SPIE
+  csrs    sstatus, t0
+1:
+  li      t0, MSTATUS_MPP_MASK
+  csrc    mstatus, t0
+  li      t0, MSTATUS_MPPS
+  csrs    mstatus, t0
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t0, mhartid
+  bnez    t0, 3f
+#endif
+  la      t0, esp32s31_supervisor_trap
+#ifdef CONFIG_ESP32S31_SMP
+  j       4f
+3:
+  la      t0, esp32s31_cpu1_supervisor_trap
+4:
+#endif
+  csrw    mepc, t0
+  j       .Lmachine_trap_return
+
+.Lmachine_forward_interrupt:
+  esp32s31_monlat_start
+  csrr    t0, mcause
+
+  /* Recreate the architectural state of a trap taken by S-mode.  NuttX's
+   * normal exception entry then saves the untouched interrupted context and
+   * returns with sret.  Preserve whether the interrupted context was S or U
+   * in sstatus.SPP so this also works once U-mode applications are enabled.
+   */
+
+  /* Mask this CLIC input before returning to S-mode.  Otherwise the still
+   * asserted M-level input retraps before the first S-mode instruction can
+   * execute.  Record it for service 3 at S-mode exception return.
+   */
+
+  andi    t1, t0, 0x3f
+  li      t2, 16
+  bltu    t1, t2, .Lmachine_trap_fault
+  li      t2, 48
+  bgeu    t1, t2, .Lmachine_trap_fault
+  addi    t1, t1, -16
+
+  slli    t2, t1, 2
+  li      t0, 0x10801041
+  add     t2, t2, t0
+  sb      zero, 0(t2)
+
+  li      t2, 1
+  sll     t2, t2, t1
+  esp32s31_percore_address t0, t1, g_esp32s31_machine_forward_mask
+  lw      t1, 0(t0)
+  or      t1, t1, t2
+  sw      t1, 0(t0)
+
+  /* M-level CLIC delivery is not automatically gated by sstatus.SIE.  If
+   * the interrupted S-mode context has interrupts masked, defer rather than
+   * synthesizing an unmaskable S trap.  Supervisor interrupts remain enabled
+   * while executing below S privilege irrespective of SIE, so a U-mode
+   * origin must be forwarded directly.
+   *
+   * Do not infer the interrupted privilege from mepc.  A CLIC input can
+   * tail-chain while return_from_exception is executing its final monitor
+   * ecall: mepc then points into the kernel even though the architectural
+   * return target is U-mode.  CLIC snapshots MPP in mcause[29:28]; XPPS is
+   * therefore the authoritative S-versus-U origin bit for this interrupt.
+   */
+
+  csrr    t1, sstatus
+  andi    t1, t1, SSTATUS_SIE
+  bnez    t1, .Lmachine_forward_direct
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t1, mcause
+  li      t0, ESP32S31_MCAUSE_XPPS
+  and     t1, t1, t0
+  beqz    t1, .Lmachine_forward_direct
+#endif
+.Lmachine_forward_deferred:
+  esp32s31_monlat_defer
+  esp32s31_monstat_bump ESP32S31_MONSTAT_DEFER, t0, t1
+  j       .Lmachine_trap_return
+.Lmachine_forward_direct:
+  csrr    t0, mcause
+  csrw    scause, t0
+
+  csrr    t1, mepc
+  csrw    sepc, t1
+  csrr    t1, mtval
+  csrw    stval, t1
+
+  csrr    t1, sstatus
+  li      t0, SSTATUS_SIE
+  and     t1, t1, t0
+
+  li      t0, (SSTATUS_SIE | SSTATUS_SPIE | SSTATUS_SPPS)
+  csrc    sstatus, t0
+  beqz    t1, 1f
+  li      t0, SSTATUS_SPIE
+  csrs    sstatus, t0
+1:
+  /* Recreate sstatus.SPP from the privilege snapshot carried by this CLIC
+   * mcause, not from live mstatus or mepc.  This remains correct both for an
+   * ordinary U-mode interrupt and for tail-chaining at the final S-to-U
+   * exception-return monitor call.
+   */
+
+  csrr    t1, mcause
+  li      t0, ESP32S31_MCAUSE_XPPS
+  and     t1, t1, t0
+  beqz    t1, 2f
+  li      t0, SSTATUS_SPPS
+  csrs    sstatus, t0
+2:
+
+  /* mret must enter the S-mode exception vector, irrespective of whether
+   * the interrupted context was S or U.
+   */
+
+  li      t0, MSTATUS_MPP_MASK
+  csrc    mstatus, t0
+  li      t0, MSTATUS_MPPS
+  csrs    mstatus, t0
+#ifdef CONFIG_ESP32S31_SMP
+  csrr    t0, mhartid
+  bnez    t0, 3f
+#endif
+  la      t0, esp32s31_supervisor_trap
+#ifdef CONFIG_ESP32S31_SMP
+  j       4f
+3:
+  la      t0, esp32s31_cpu1_supervisor_trap
+4:
+#endif
+  csrw    mepc, t0
+
+.Lmachine_trap_return:
+  lw      t0, 0(sp)
+  lw      t1, 4(sp)
+  lw      t2, 8(sp)
+  addi    sp, sp, 16
+  csrrw   sp, mscratch, sp
+  mret
+
+.Lmachine_trap_fault:
+  /* Preserve the live argument, return and supervisor stack registers before
+   * preparing the C ABI.  A fatal S-mode access fault can otherwise report
+   * only the instruction inside a low-level routine such as memset(), while
+   * losing both its caller and destination.  This extra frame is used only
+   * on the non-returning fatal path and keeps the normal monitor fast path
+   * unchanged.
+   */
+
+  addi    sp, sp, -48
+  sw      a0, 0(sp)
+  sw      a1, 4(sp)
+  sw      a2, 8(sp)
+  sw      a3, 12(sp)
+  sw      a4, 16(sp)
+  sw      a5, 20(sp)
+  sw      a6, 24(sp)
+  sw      a7, 28(sp)
+  sw      ra, 32(sp)
+  csrr    t1, mscratch
+  sw      t1, 36(sp)
+
+  mv      a3, sp
+  mv      a0, t0
+  csrr    a1, mepc
+  csrr    a2, mtval
+  call    esp32s31_mmode_fault
+
+.Lmachine_trap_hang:
+  wfi
+  j       .Lmachine_trap_hang
+
+  .size esp32s31_machine_trap, .-esp32s31_machine_trap
+
+  .section .note.GNU-stack, "", @progbits
diff --git a/arch/risc-v/src/esp32s31/esp32s31_tlb.c b/arch/risc-v/src/esp32s31/esp32s31_tlb.c
new file mode 100644
index 00000000000..d72cd0fbb05
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_tlb.c
@@ -0,0 +1,343 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_tlb.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Production SMP TLB shootdown.  G.1.3 proved generation/ack + sfence.vma on
+ * an isolated CPU1 trap path; this module rebuilds that protocol on top of
+ * the NuttX SMP IPI so mapping-side callers can wait with interrupts masked.
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/fs/fs.h>
+#include <nuttx/irq.h>
+#include <nuttx/spinlock.h>
+
+#include "esp_attr.h"
+#include "hal/crosscore_int_ll.h"
+
+#include "esp32s31_cpu1_boot.h"
+#include "esp32s31_tlb.h"
+#include "riscv_mmu.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define ESP32S31_TLB_OP_RANGE   1u
+#define ESP32S31_TLB_OP_GLOBAL  2u
+#define ESP32S31_TLB_STATS_LEN  128
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct esp32s31_tlb_mailbox_s
+{
+  volatile uint32_t request_generation;
+  volatile uint32_t ack_generation;
+  volatile uint32_t operation;
+  volatile uintptr_t vaddr;
+  volatile size_t size;
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static struct esp32s31_tlb_mailbox_s g_esp32s31_tlb_mbox[CONFIG_SMP_NCPUS];
+static spinlock_t g_esp32s31_tlb_lock[CONFIG_SMP_NCPUS];
+static volatile uint32_t g_esp32s31_tlb_send_count;
+static volatile uint32_t g_esp32s31_tlb_ack_count;
+static volatile uint32_t g_esp32s31_tlb_timeout_count;
+static volatile uint32_t g_esp32s31_tlb_range_count;
+static volatile uint32_t g_esp32s31_tlb_global_count;
+
+/****************************************************************************
+ * Private Function Prototypes
+ ****************************************************************************/
+
+static ssize_t esp32s31_tlb_stats_read(FAR struct file *filep,
+                                       FAR char *buffer, size_t buflen);
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static inline void esp32s31_tlb_fence(void)
+{
+  __asm__ volatile ("fence rw, rw" ::: "memory");
+}
+
+static inline void IRAM_ATTR esp32s31_tlb_sfence_vaddr(uintptr_t vaddr)
+{
+  /* rs1 = vaddr, rs2 = x0: invalidate translations for vaddr in all ASIDs.
+   * Do not reuse mmu_invalidate_tlb_by_vaddr(); that helper currently puts
+   * the address in the ASID operand.
+   */
+
+  __asm__ volatile
+    (
+      "sfence.vma %0, x0\n"
+      :
+      : "r" (vaddr)
+      : "memory"
+    );
+}
+
+static inline void IRAM_ATTR esp32s31_tlb_sfence_global(void)
+{
+  __asm__ volatile ("sfence.vma x0, x0" ::: "memory");
+}
+
+static bool esp32s31_tlb_remote_online(int cpu)
+{
+  if (cpu == 0)
+    {
+      return true;
+    }
+
+  return g_esp32s31_cpu1_boot_state == ESP32S31_CPU1_SMP_ONLINE;
+}
+
+static void IRAM_ATTR esp32s31_tlb_apply(uint32_t operation,
+                                         uintptr_t vaddr, size_t size)
+{
+  if (operation == ESP32S31_TLB_OP_GLOBAL)
+    {
+      esp32s31_tlb_sfence_global();
+      g_esp32s31_tlb_global_count++;
+    }
+  else
+    {
+      uintptr_t end = vaddr + size;
+
+      for (vaddr &= ~((uintptr_t)RV_MMU_PAGE_MASK); vaddr < end;
+           vaddr += RV_MMU_PAGE_SIZE)
+        {
+          esp32s31_tlb_sfence_vaddr(vaddr);
+        }
+
+      g_esp32s31_tlb_range_count++;
+    }
+}
+
+static void IRAM_ATTR esp32s31_tlb_process_cpu(int cpu)
+{
+  FAR struct esp32s31_tlb_mailbox_s *mbox = &g_esp32s31_tlb_mbox[cpu];
+  uint32_t generation;
+  uint32_t operation;
+  uintptr_t vaddr;
+  size_t size;
+
+  esp32s31_tlb_fence();
+  generation = mbox->request_generation;
+  if (generation == 0 || generation == mbox->ack_generation)
+    {
+      return;
+    }
+
+  operation = mbox->operation;
+  vaddr = mbox->vaddr;
+  size = mbox->size;
+  esp32s31_tlb_apply(operation, vaddr, size);
+
+  mbox->ack_generation = generation;
+  esp32s31_tlb_fence();
+  g_esp32s31_tlb_ack_count++;
+}
+
+static int IRAM_ATTR esp32s31_tlb_wait_ack(int target, uint32_t generation,
+                                           uint32_t timeout_us)
+{
+  FAR struct esp32s31_tlb_mailbox_s *mbox = &g_esp32s31_tlb_mbox[target];
+  int self = this_cpu();
+
+  while (timeout_us-- > 0)
+    {
+      /* Serve any request aimed at this hart so two CPUs cannot deadlock
+       * while each waits for the other with interrupts masked.
+       */
+
+      esp32s31_tlb_process_cpu(self);
+      esp32s31_tlb_fence();
+      if (mbox->ack_generation == generation)
+        {
+          return OK;
+        }
+
+      up_udelay(1);
+    }
+
+  return -ETIMEDOUT;
+}
+
+static int esp32s31_tlb_submit(int target, uint32_t operation,
+                               uintptr_t vaddr, size_t size)
+{
+  FAR struct esp32s31_tlb_mailbox_s *mbox;
+  irqstate_t flags;
+  uint32_t generation;
+  int ret;
+
+  if (target == this_cpu())
+    {
+      /* sfence.vma is hart local and idempotent, so the local half needs no
+       * mailbox.  Callers rely on it: the page table helpers do not fence.
+       */
+
+      esp32s31_tlb_apply(operation, vaddr, size);
+      return OK;
+    }
+
+  if (!esp32s31_tlb_remote_online(target))
+    {
+      return OK;
+    }
+
+  mbox = &g_esp32s31_tlb_mbox[target];
+  flags = spin_lock_irqsave_nopreempt(&g_esp32s31_tlb_lock[target]);
+
+  generation = mbox->request_generation + 1;
+  if (generation == 0)
+    {
+      generation = 1;
+    }
+
+  mbox->operation = operation;
+  mbox->vaddr = vaddr;
+  mbox->size = size;
+  mbox->request_generation = generation;
+  esp32s31_tlb_fence();
+  g_esp32s31_tlb_send_count++;
+
+  crosscore_int_ll_trigger_interrupt(target);
+  ret = esp32s31_tlb_wait_ack(target, generation,
+                              CONFIG_ESP32S31_SMP_TLB_SHOOTDOWN_TIMEOUT_US);
+  if (ret == -ETIMEDOUT)
+    {
+      g_esp32s31_tlb_timeout_count++;
+      esp32s31_tlb_sfence_global();
+    }
+
+  spin_unlock_irqrestore_nopreempt(&g_esp32s31_tlb_lock[target], flags);
+  return ret;
+}
+
+static ssize_t esp32s31_tlb_stats_read(FAR struct file *filep,
+                                       FAR char *buffer, size_t buflen)
+{
+  char line[ESP32S31_TLB_STATS_LEN];
+  size_t len;
+  size_t ncopy;
+
+  len = snprintf(line, sizeof(line),
+                 "TLBSHOOT: send=%" PRIu32 " ack=%" PRIu32
+                 " timeout=%" PRIu32 " range=%" PRIu32
+                 " global=%" PRIu32 "\n",
+                 g_esp32s31_tlb_send_count,
+                 g_esp32s31_tlb_ack_count,
+                 g_esp32s31_tlb_timeout_count,
+                 g_esp32s31_tlb_range_count,
+                 g_esp32s31_tlb_global_count);
+
+  if (filep->f_pos >= (off_t)len)
+    {
+      return 0;
+    }
+
+  ncopy = len - (size_t)filep->f_pos;
+  if (ncopy > buflen)
+    {
+      ncopy = buflen;
+    }
+
+  memcpy(buffer, line + filep->f_pos, ncopy);
+  filep->f_pos += (off_t)ncopy;
+  return (ssize_t)ncopy;
+}
+
+static const struct file_operations g_esp32s31_tlb_stats_ops =
+{
+  NULL,                    /* open */
+  NULL,                    /* close */
+  esp32s31_tlb_stats_read, /* read */
+  NULL,                    /* write */
+  NULL,                    /* seek */
+  NULL,                    /* ioctl */
+  NULL,                    /* mmap */
+  NULL,                    /* truncate */
+  NULL,                    /* poll */
+  NULL,                    /* readv */
+  NULL                     /* writev */
+};
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void IRAM_ATTR esp32s31_tlb_shootdown_process(void)
+{
+  esp32s31_tlb_process_cpu(this_cpu());
+}
+
+int riscv_tlb_shootdown_range(uintptr_t vaddr, size_t size)
+{
+  int cpu;
+  int ret = OK;
+  int rc;
+
+  if (size == 0)
+    {
+      return riscv_tlb_shootdown_all();
+    }
+
+  for (cpu = 0; cpu < CONFIG_SMP_NCPUS; cpu++)
+    {
+      rc = esp32s31_tlb_submit(cpu, ESP32S31_TLB_OP_RANGE, vaddr, size);
+      if (rc < 0 && ret >= 0)
+        {
+          ret = rc;
+        }
+    }
+
+  return ret;
+}
+
+int riscv_tlb_shootdown_all(void)
+{
+  int cpu;
+  int ret = OK;
+  int rc;
+
+  for (cpu = 0; cpu < CONFIG_SMP_NCPUS; cpu++)
+    {
+      rc = esp32s31_tlb_submit(cpu, ESP32S31_TLB_OP_GLOBAL, 0, 0);
+      if (rc < 0 && ret >= 0)
+        {
+          ret = rc;
+        }
+    }
+
+  return ret;
+}
+
+int esp32s31_tlb_register_stats_device(void)
+{
+  return register_driver("/dev/tlbshoot", &g_esp32s31_tlb_stats_ops,
+                         0444, NULL);
+}
diff --git a/arch/risc-v/src/esp32s31/esp32s31_tlb.h b/arch/risc-v/src/esp32s31/esp32s31_tlb.h

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise actual ELF name lookup with unnamed symbol and I/O error mocks."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'libs/libc/elf/elf_symbols.c'
+    source = (subprocess.check_output(
+        ['git', 'show', f'{args.revision}:{filename}'], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#define FAR
+#define berr(...) ((void)0)
+typedef struct { unsigned st_name, st_value; } Elf_Sym;
+struct section { size_t sh_size, sh_offset; };
+struct mod_loadinfo_s {
+  int symtabidx, strtabidx;
+  struct section shdr[3];
+  const char *iobuffer;
+};
+static const Elf_Sym symbols[] = {{0, 0}, {1, 11}, {0, 22}, {2, 33}};
+static const char *names[] = {NULL, "other", "wanted"};
+static int comparisons, reads, find_error, read_error, name_error;
+static int libelf_findsymtab(struct mod_loadinfo_s *info)
+{ info->symtabidx = 1; info->strtabidx = 2; return find_error; }
+static int libelf_readsym(struct mod_loadinfo_s *info, int index,
+                         Elf_Sym *sym, struct section *section)
+{
+  (void)info; (void)section; reads++;
+  if (read_error) return read_error;
+  *sym = symbols[index]; return 0;
+}
+static int libelf_symname(struct mod_loadinfo_s *info, const Elf_Sym *sym,
+                         size_t offset)
+{
+  (void)offset;
+  if (!sym->st_name) return -ESRCH;
+  if (name_error) return name_error;
+  info->iobuffer = names[sym->st_name]; return 0;
+}
+static int checked_strcmp(const char *left, const char *right)
+{ assert(left != NULL); comparisons++; return strcmp(left, right); }
+#define strcmp checked_strcmp
+'''
+    fixture += definition(source, 'libelf_findsymbol')
+    fixture += r'''
+int main(void)
+{
+  struct mod_loadinfo_s info = {0};
+  Elf_Sym symbol = {0};
+  info.shdr[1].sh_size = sizeof(symbols);
+  assert(libelf_findsymbol(NULL, "wanted", &symbol) == -EINVAL);
+  assert(libelf_findsymbol(&info, NULL, &symbol) == -EINVAL);
+  assert(libelf_findsymbol(&info, "wanted", &symbol) == 0);
+  assert(symbol.st_value == 33 && reads == 4 && comparisons == 2);
+  /* Unnamed entries must not compare a stale, otherwise matching buffer. */
+  info.iobuffer = "wanted"; reads = comparisons = 0;
+  assert(libelf_findsymbol(&info, "wanted", &symbol) == 0);
+  assert(symbol.st_value == 33 && reads == 4 && comparisons == 2);
+  reads = comparisons = 0;
+  assert(libelf_findsymbol(&info, "missing", &symbol) == -ENOENT);
+  assert(reads == 4 && comparisons == 2);
+  info.shdr[1].sh_size = sizeof(Elf_Sym);
+  info.iobuffer = NULL; comparisons = 0;
+  assert(libelf_findsymbol(&info, "wanted", &symbol) == -ENOENT);
+  assert(comparisons == 0);
+  info.shdr[1].sh_size = 0;
+  assert(libelf_findsymbol(&info, "wanted", &symbol) == -ENOENT);
+  info.shdr[1].sh_size = sizeof(symbols);
+  read_error = -EIO;
+  assert(libelf_findsymbol(&info, "wanted", &symbol) == -EIO);
+  read_error = 0; name_error = -ENOMEM;
+  assert(libelf_findsymbol(&info, "wanted", &symbol) == -ENOMEM);
+  name_error = 0; info.symtabidx = 0; find_error = -EINVAL;
+  assert(libelf_findsymbol(&info, "wanted", &symbol) == -EINVAL);
+  puts("ELF_UNNAMED_SYMBOLS=PASS null/stale/empty/found/missing/io-errors");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='elf-unnamed-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-sign-compare', '-fsanitize=undefined',
+                        '-fno-sanitize-recover=all', str(path / 'test.c'),

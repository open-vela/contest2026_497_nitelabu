+/* The S31 CLIC and branch-predictor controls are M-mode-only.  The NuttX
+ * cache-off adapter redirects the interrupt guard to the monitor, which
+ * handles both operations atomically.  Suppress the HAL's direct MHCR access
+ * in cache_utils.c so S-mode never executes a machine-CSR instruction.
+ */
+
+#include "soc/soc_caps.h"
+
+#undef SOC_BRANCH_PREDICTOR_SUPPORTED
+#define SOC_BRANCH_PREDICTOR_SUPPORTED 0

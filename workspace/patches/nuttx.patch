+}
+static void kmm_free(void *p) { assert(p && live == 1); live--; free(p); }
+static int rmt_config(struct rmt_channel_config_s *c)
+{ assert(c->channel == 0); configs++; return config_result; }
+static int rmt_driver_install(int channel, size_t size, int flags)

+static uint32_t wlan_tcp_diag_sum(const uint8_t *p, size_t n, uint32_t sum)
+{
+  while (n >= 2)
+    {
+      sum += ((uint32_t)p[0] << 8) | p[1];
+      p += 2;
+      n -= 2;
+    }
+
+  if (n != 0)

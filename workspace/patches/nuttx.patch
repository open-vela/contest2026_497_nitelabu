+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check actual RX start/helper lock discipline; not an RX waveform test."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'arch/risc-v/src/common/espressif/esp_rmt.c'
+    source = (subprocess.check_output(['git', 'show', f'{args.revision}:{filename}'],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    helper = ('rmt_set_rx_thr_intr_en_nolock'
+              if 'rmt_set_rx_thr_intr_en_nolock' in source
+              else 'rmt_set_rx_thr_intr_en')
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#define DEBUGASSERT assert
+#define OK 0
+#define RMT_CHANNEL_MAX 4
+#define RMT_MEM_ITEM_NUM 48
+#define RMT_IS_RX_CHANNEL(c) ((c) >= 2 && (c) < 4)
+#define RMT_DECODE_RX_CHANNEL(c) ((c) - 2)
+#define RMT_LL_EVENT_RX_DONE(c) (1u << (c))
+#define RMT_LL_EVENT_RX_THRES(c) (1u << ((c) + 8))
+#define rmterr(...) ((void)0)
+typedef int irqstate_t;
+typedef int rmt_channel_t;
+static struct { int rx_item_start_idx, rx_item_len; } object;
+static __typeof__(object) *p_rmt_obj[4] = {0, 0, &object, &object};
+static struct { int rmt_spinlock; struct { void *regs; } hal; } g_rmtdev_common;
+static int locked, locks, releases, resets, enables, disables, limits;
+static uint32_t events;
+static int spin_lock_irqsave(int *lock)
+{ assert(lock == &g_rmtdev_common.rmt_spinlock); assert(!locked);
+  locked = 1; locks++; return 123; }
+static void spin_unlock_irqrestore(int *lock, int flags)
+{ assert(lock == &g_rmtdev_common.rmt_spinlock && flags == 123 && locked);
+  locked = 0; releases++; }
+static int rmt_ll_rx_get_mem_blocks(void *r, int c)
+{ (void)r; assert(c == 0 || c == 1); return 1; }
+static void rmt_ll_rx_set_limit(void *r, int c, int n)
+{ (void)r; assert(locked && (c == 0 || c == 1) && n == 24); limits++; }
+static void rmt_ll_enable_interrupt(void *r, uint32_t mask, bool enable)
+{ (void)r; assert(locked); if (enable) events |= mask; else events &= ~mask; }
+static void rmt_ll_rx_enable(void *r, int c, bool enable)
+{ (void)r; assert(locked && (c == 0 || c == 1));
+  if (enable) enables++; else disables++; }
+static void rmt_ll_rx_reset_pointer(void *r, int c)
+{ (void)r; assert(locked && (c == 0 || c == 1)); resets++; }
+static void rmt_ll_clear_interrupt_status(void *r, uint32_t mask)
+{ (void)r; (void)mask; assert(locked); }
+'''
+    fixture += '#ifdef SOC_RMT_SUPPORT_RX_PINGPONG\n'
+    fixture += definition(source, helper)
+    fixture += '\n#endif\n'
+    fixture += definition(source, 'rmt_rx_start')
+    fixture += r'''
+int main(void)
+{
+  for (int c = 2; c < 4; c++) {
+    for (int reset = 0; reset < 2; reset++) {
+      locks = releases = resets = enables = disables = limits = 0; events = 0;
+      object.rx_item_start_idx = object.rx_item_len = 17;
+      assert(rmt_rx_start(c, reset) == OK);
+      assert(!locked && locks == 1 && releases == 1);
+      assert(resets == reset && enables == 1 && disables == 1);
+      assert(events & RMT_LL_EVENT_RX_DONE(c - 2));
+#ifdef SOC_RMT_SUPPORT_RX_PINGPONG
+      assert(limits == 1 && !object.rx_item_start_idx && !object.rx_item_len);
+      assert(events & RMT_LL_EVENT_RX_THRES(c - 2));
+#else
+      assert(!limits);
+#endif
+    }
+  }
+  puts("ESP_RMT_RX_START=PASS single lock/channel decode/reset/threshold");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='esp-rmt-rx-start-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        for pingpong in (True, False):
+            options = ['-DSOC_RMT_SUPPORT_RX_PINGPONG=1'] if pingpong else []
+            print(f'VARIANT pingpong={pingpong}', flush=True)
+            subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                            '-Wno-unused-function', '-Wno-unused-variable',
+                            '-fsanitize=undefined', '-fno-sanitize-recover=all',
+                            *options, str(path / 'test.c'), '-o', str(path / 'test')],
+                           check=True)
+            subprocess.run([str(path / 'test')], check=True)
+
+
+if __name__ == '__main__':
+    main()

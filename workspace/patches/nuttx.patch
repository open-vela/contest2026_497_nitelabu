+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Host checks for demo credential redaction and leave-running/cleanup policy."""
+
+import contextlib
+import io
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / "espressif"))
+import esp32s31_demo as demo
+
+
+class DemoTests(unittest.TestCase):
+    def run_setup(self, success):
+        commands = []
+
+        def command(port, text, **kwargs):
+            commands.append(text)
+            if text.startswith("ls "):
+                return "s31demo"
+            if "scan" in text:
+                return "bssid / frequency"
+            if text.startswith("ping "):
+                return ("4 packets transmitted, 4 received, 0% packet loss\n"
+                        if success else "4 packets transmitted, 0 received, 100% packet loss\n")
+            return "OK"
+
+        def connect(*args):
+            print("net'work private-pass")
+            return "ok", "bitmap=7", "DRaddr:192.168.1.1", "192.168.1.60"
+
+        with tempfile.TemporaryDirectory(prefix="s31-demo-policy-") as directory:
+            log = Path(directory) / "run.log"
+            with contextlib.ExitStack() as stack:
+                stack.enter_context(patch.object(sys, "argv", ["demo", "--port", "fake",
+                                                               "--log", str(log)]))
+                stack.enter_context(patch.object(demo.getpass, "getpass",
+                                                side_effect=["net'work", "private-pass"]))
+                stack.enter_context(patch.object(demo.serial, "Serial"))
+                stack.enter_context(patch.object(demo.production, "boot"))
+                stack.enter_context(patch.object(demo.production, "command", side_effect=command))
+                stack.enter_context(patch.object(demo.transport, "run_command", side_effect=command))
+                stack.enter_context(patch.object(demo.transport, "connect_sta", side_effect=connect))
+                launch = stack.enter_context(patch.object(
+                    demo.transport, "launch_background", return_value=12))
+                stack.enter_context(patch.object(demo.transport, "read_task_pids", return_value={12}))
+                reset = stack.enter_context(patch.object(demo.transport, "hard_reset"))
+                output = stack.enter_context(contextlib.redirect_stdout(io.StringIO()))
+                result = demo.main()
+            transcript = log.read_text() + output.getvalue()
+            self.assertNotIn("net'work", transcript)
+            self.assertNotIn("private-pass", transcript)
+            self.assertIn("<redacted>", transcript)
+            self.assertEqual(result, 0 if success else 1)
+            self.assertEqual(reset.call_count, 0 if success else 1)
+            self.assertEqual("ifdown wlan0" in commands, not success)
+            if success:
+                self.assertEqual(launch.call_args.args[1],
+                                 "prlimit -s 8192 s31demo")
+                self.assertIn("http://192.168.1.60:8080/", transcript)
+
+    def test_success_leaves_demo_running(self):
+        self.run_setup(True)
+
+    def test_failure_cleans_up(self):
+        self.run_setup(False)
+
+    def test_escaped_secret_redaction(self):
+        stream = io.StringIO()
+        secret = "secret' value"
+        escaped = demo.transport.nsh_escape(secret)
+        writer = demo.Redacted(stream, (secret, escaped))
+        writer.write(secret + " " + escaped)
+        self.assertEqual(stream.getvalue(), "<redacted> <redacted>")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)

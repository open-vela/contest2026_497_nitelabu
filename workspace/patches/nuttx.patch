+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise S31 station-IP notification and link cancellation on the host."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'arch/risc-v/src/common/espressif/esp_wlan.c'
+    source = (subprocess.check_output(
+        ['git', 'show', f'{args.revision}:{filename}'], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#define CONFIG_ARCH_CHIP_ESP32S31 1
+#define CONFIG_NET_IPv4 1
+#define ESP_WLAN_STA_DEVNO 0
+#define INADDR_ANY 0
+#define IFF_IS_RUNNING(x) ((x) & 1)
+#define WLAN_WORK 1
+#define MSEC2TICK(x) (x)
+#define OK 0
+#define wlinfo(...) ((void)0)
+#define wlerr(...) ((void)0)
+struct net_driver_s { uint32_t d_ipaddr; unsigned d_flags; };
+struct wlan_priv_s { struct net_driver_s dev; bool ifup; };
+struct work_s { int pending; };
+static struct wlan_priv_s g_wlan_priv[1];
+static struct work_s g_sta_ip_work;
+static int locked, vendor_calls, vendor_result, queued, cancelled;
+static void netdev_lock(struct net_driver_s *d)
+{ assert(d == &g_wlan_priv[0].dev && !locked); locked = 1; }
+static void netdev_unlock(struct net_driver_s *d)
+{ assert(d == &g_wlan_priv[0].dev && locked); locked = 0; }
+static int esp_wifi_internal_set_sta_ip(void)
+{ assert(!locked); vendor_calls++; return vendor_result; }
+static int work_queue(int q, struct work_s *w, void (*cb)(void *),
+                      void *arg, int ticks)

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Fault-inject the actual RMT install function, not a replacement model.
+
+Checks allocator pairing, semaphore lifetime, IRQ/lock errors and retry.
+This sequential host test does not prove concurrent initialization or ISR
+timing. Hardware IRQ allocation is mocked; board regression is separate.
+"""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'arch/risc-v/src/common/espressif/esp_rmt.c'
+    source = (subprocess.check_output(['git', 'show', f'{args.revision}:{filename}'],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define DEBUGASSERT assert
+#define OK 0
+#define ERROR (-1)
+#define RMT_CHANNEL_MAX 2
+#define ESP_INTR_FLAG_IRAM 1
+#define spin_lock_init(p) (*(p) = 0)
+#define BIT(x) (1u << (x))
+#define RMT_IS_RX_CHANNEL(x) ((x) == 1)
+#define RMT_DECODE_RX_CHANNEL(x) (x)
+#define rmtwarn(...) ((void)0)
+#define rmterr(...) ((void)0)
+typedef int rmt_channel_t;
+struct sem { int init, value; };
+struct circ { void *base; };
+typedef struct {
+  int tx_len_rem, channel, tx_offset, tx_sub_len;
+  void *tx_data;
+  bool wait_done, loop_autostop;
+  int intr_alloc_flags;
+  int tx_lock, tx_state_lock;
+  struct sem tx_sem, rx_sem;
+  struct circ rx_buf;
+  void *rx_item_buf;
+  size_t rx_item_buf_size;
+} rmt_obj_t;
+static rmt_obj_t *p_rmt_obj[2];
+static struct { unsigned rmt_driver_channels; int rmt_driver_isr_lock, hal; }
+  g_rmtdev_common;
+static struct { void *ptr; int heap; } allocations[16];
+static int live, sems, allocation_count, fail_allocation;
+static int irq_result, lock_result, locked, irq_calls, resets, enables;
+static int mutexes;
+static int nxmutex_init(int *m)
+{ assert(!*m); *m = 1; mutexes++; return 0; }
+static int nxmutex_destroy(int *m)
+{ assert(*m); *m = 0; mutexes--; return 0; }
+static void *allocate(size_t n, size_t size, int heap)
+{
+  if (++allocation_count == fail_allocation) return NULL;
+  void *p = calloc(n, size);
+  assert(p);
+  for (int i = 0; i < 16; i++) if (!allocations[i].ptr) {
+    allocations[i].ptr = p; allocations[i].heap = heap; live++; return p;
+  }
+  abort();
+}
+static void release(void *p, int heap)
+{
+  if (!p) return;
+  for (int i = 0; i < 16; i++) if (allocations[i].ptr == p) {
+    assert(allocations[i].heap == heap);
+    allocations[i].ptr = NULL; live--; free(p); return;
+  }
+  abort();
+}
+#define kmm_calloc(n,s) allocate(n,s,1)
+#define calloc(n,s) allocate(n,s,2)
+#define kmm_free(p) release(p,1)
+#define free(p) release(p,2)
+static int nxsem_init(struct sem *s, int shared, int value)
+{ assert(!s->init && !shared); s->init = 1; s->value = value; sems++; return 0; }
+static int nxsem_post(struct sem *s)
+{ assert(s->init); s->value++; return 0; }
+static int nxsem_destroy(struct sem *s)
+{ assert(s->init); s->init = 0; sems--; return 0; }
+static bool circbuf_is_init(struct circ *c) { return c->base != NULL; }
+static int circbuf_init(struct circ *c, void *base, size_t size)
+{ assert(!base && !c->base); c->base = allocate(1, size, 3);
+  return c->base ? 0 : -ENOMEM; }
+static void circbuf_uninit(struct circ *c)
+{ release(c->base, 3); c->base = NULL; }
+static int nxrmutex_lock(int *m)
+{ (void)m; assert(!locked); if (lock_result) return lock_result;
+  locked = 1; return 0; }
+static int nxrmutex_unlock(int *m)
+{ (void)m; assert(locked); locked = 0; return 0; }
+static int rmt_driver_isr_default;
+static int rmt_isr_register(int fn, void *arg, int flags)
+{ (void)fn; (void)arg; (void)flags; assert(locked); irq_calls++; return irq_result; }
+static void rmt_module_enable(void) { enables++; }
+static void rmt_hal_rx_channel_reset(void *h, int ch)
+{ (void)h; (void)ch; resets++; }
+#define rmt_hal_tx_channel_reset rmt_hal_rx_channel_reset
+'''
+    fixture += definition(source, 'rmt_driver_install')
+    fixture += r'''
+static void clear_channel(int channel, int flags)
+{
+  rmt_obj_t *p = p_rmt_obj[channel];
+  int heap = 1;
+#ifdef CONFIG_SPIRAM_USE_MALLOC
+  if (!(flags & ESP_INTR_FLAG_IRAM)) heap = 2;
+#else
+  (void)flags;
+#endif
+  nxsem_destroy(&p->rx_sem); nxsem_destroy(&p->tx_sem);
+  nxmutex_destroy(&p->tx_lock);
+  circbuf_uninit(&p->rx_buf);
+  release(p->rx_item_buf, heap); release(p, heap);
+  p_rmt_obj[channel] = NULL;
+  g_rmtdev_common.rmt_driver_channels &= ~BIT(channel);
+}
+static void pristine(void)
+{
+  assert(!live && !sems && !mutexes && !locked && !p_rmt_obj[0] && !p_rmt_obj[1]);
+  assert(!g_rmtdev_common.rmt_driver_channels);
+  allocation_count = fail_allocation = irq_result = lock_result = 0;
+  irq_calls = resets = enables = 0;
+}
+int main(void)
+{
+  for (int flags = 0; flags <= 1; flags++) {
+    for (int mode = 0; mode <= 1; mode++) {
+      size_t size = mode ? 64 : 0;
+      int count = mode ? 2 : 1;
+#ifdef SOC_RMT_SUPPORT_RX_PINGPONG
+      if (mode) count++;
+#endif
+      for (int fail = 1; fail <= count; fail++) {
+        pristine(); fail_allocation = fail;
+        assert(rmt_driver_install(mode, size, flags) == -ENOMEM);
+        assert(!irq_calls && !resets && !enables);
+        pristine();
+        assert(rmt_driver_install(mode, size, flags) == 0);
+        assert(g_rmtdev_common.rmt_driver_channels == BIT(mode));
+        clear_channel(mode, flags);
+      }
+      for (int failure = 0; failure < 2; failure++) {
+        pristine();
+        if (failure) lock_result = -ECANCELED; else irq_result = -EIO;
+        assert(rmt_driver_install(mode, size, flags) ==
+               (failure ? -ECANCELED : -EIO));
+        assert(!resets && !enables);
+        pristine();
+        assert(rmt_driver_install(mode, size, flags) == 0);
+        assert(irq_calls == 1 && resets == 1 && enables == 1);
+        rmt_obj_t *p = p_rmt_obj[mode];
+        assert(rmt_driver_install(mode, size, flags) < 0);
+        assert(p_rmt_obj[mode] == p && irq_calls == 1);
+        clear_channel(mode, flags);
+      }
+    }
+    pristine();
+    assert(rmt_driver_install(0, 0, flags) == 0);
+    rmt_obj_t *first = p_rmt_obj[0];
+    lock_result = -ECANCELED;
+    assert(rmt_driver_install(1, 64, flags) == -ECANCELED);
+    assert(p_rmt_obj[0] == first && !p_rmt_obj[1]);
+    assert(g_rmtdev_common.rmt_driver_channels == 1 && live == 1 && sems == 2);
+    lock_result = 0;
+    assert(rmt_driver_install(1, 64, flags) == 0);
+    assert(irq_calls == 1 && g_rmtdev_common.rmt_driver_channels == 3);
+    clear_channel(1, flags); clear_channel(0, flags); pristine();
+  }
+  puts("ESP_RMT_INSTALL=PASS OOM/IRQ/lock cleanup, retry, existing channel");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='esp-rmt-install-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        for spiram in (False, True):
+            for pingpong in (False, True):
+                options = []
+                if spiram:

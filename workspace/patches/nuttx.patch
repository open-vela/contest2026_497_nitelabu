+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define CONFIG_RMT_DEFAULT_RX_BUFFER_SIZE 64
+#define RMT_MODE_RX 0
+#define RMT_MODE_TX 1

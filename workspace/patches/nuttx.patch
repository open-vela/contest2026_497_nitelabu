+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the actual S31 IRQ completion block with a monitor-state model.
+
+Checks replay-token consumption and enable/disable policy, not hardware CLIC
+timing.  --revision allows the previous implementation to be tested too.
+"""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "arch/risc-v/src/common/espressif/esp_irq.c"
+    source = (subprocess.check_output(
+        ["git", "show", f"{args.revision}:{filename}"], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    completion = source.split("regs = riscv_doirq(irq, regs);", 1)[1]
+    block = re.search(r"  if \(is_irq[^#]+", completion).group(0)
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+struct map_entry { bool enabled; };
+static struct map_entry g_cpuint_map[32];
+#define CPUINT_ISENABLED(entry) ((entry).enabled)
+static uint32_t pending, enabled;
+static unsigned acknowledgements, drops;
+static void esp32s31_smode_irq_drop(int input)
+{
+  pending &= ~(UINT32_C(1) << input);
+  drops++;
+}
+static void esp32s31_smode_irq_ack(int input)
+{
+  pending &= ~(UINT32_C(1) << input);
+  enabled |= UINT32_C(1) << input;
+  acknowledgements++;
+}
+static void complete(bool is_irq, int cpuint)
+{
+'''
+    fixture += block
+    fixture += r'''
+}
+int main(void)
+{
+  for (int input = 0; input < 32; input++) {
+    for (int active = 0; active < 2; active++) {
+      uint32_t bit = UINT32_C(1) << input;
+      uint32_t other = UINT32_C(1) << ((input + 1) % 32);
+      bool release = active;
+      pending = bit | other;
+      enabled = other; /* M-mode masked the input before forwarding it. */
+      acknowledgements = drops = 0;
+      g_cpuint_map[input].enabled = active;
+      complete(true, input);
+      assert(pending == other); /* Consume only the dispatched token. */
+      assert(enabled == (other | (release ? bit : 0)));
+      assert(acknowledgements == release && drops == !release);
+    }
+  }
+  pending = UINT32_C(0x81234567);
+  enabled = UINT32_C(0x76543210);
+  acknowledgements = drops = 0;
+  complete(false, -1); /* A synchronous exception has no CPU input. */
+  assert(pending == UINT32_C(0x81234567));
+  assert(enabled == UINT32_C(0x76543210));
+  assert(acknowledgements == 0 && drops == 0);
+  puts("S31_IRQ_COMPLETION=PASS 65 cases; hardware timing not modeled");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-irq-completion-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-Wno-unused-function", "-fsanitize=undefined",
+                        "-fno-sanitize-recover=all", str(path / "test.c"),
+                        "-o", str(path / "test")], check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Run actual S31 event-group code with pthread-backed OS primitives."""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--without-exit-cleanup', action='store_true')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    source = (root / 'arch/risc-v/src/esp32s31/esp32s31_wifi_event.c').read_text()
+    source = re.sub(r'^#include[^\n]*\n', '', source, flags=re.M)
+    task = (root / 'arch/risc-v/src/esp32s31/esp32s31_wifi_task.c').read_text()
+    task = re.sub(r'^#include[^\n]*\n', '', task, flags=re.M)
+    if args.without_exit_cleanup:
+        call = 'esp32s31_wifi_event_task_delete(tcb);'
+        assert task.count(call) == 1
+        task = task.replace(call, '(void)tcb;')
+    fixture = r'''
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+#define DEBUGASSERT assert
+typedef int irqstate_t;
+typedef pthread_mutex_t spinlock_t;
+#define SP_UNLOCKED PTHREAD_MUTEX_INITIALIZER
+struct tcb_s { int unused; };
+static _Thread_local struct tcb_s current_tcb;
+static struct tcb_s *this_task(void) { return &current_tcb; }
+void esp32s31_wifi_event_task_delete(struct tcb_s *tcb);
+void __wrap_up_release_stack(struct tcb_s *tcb, int type);
+static atomic_int task_releases;
+void __real_up_release_stack(struct tcb_s *tcb, int type) {
+  assert(tcb == this_task() && type == 7); task_releases++;
+}
+typedef struct entry { struct entry *flink; } sq_entry_t;
+typedef struct { sq_entry_t *head, *tail; } sq_queue_t;
+static void sq_init(sq_queue_t *q) { q->head = q->tail = NULL; }
+static sq_entry_t *sq_peek(sq_queue_t *q) { return q->head; }
+static sq_entry_t *sq_next(sq_entry_t *e) { return e->flink; }
+static void sq_addlast(sq_entry_t *e, sq_queue_t *q) {
+  e->flink = NULL;
+  if (q->tail) q->tail->flink = e; else q->head = e;
+  q->tail = e;
+}
+static void sq_rem(sq_entry_t *e, sq_queue_t *q) {
+  sq_entry_t *prev = NULL, *cur = q->head;
+  while (cur && cur != e) { prev = cur; cur = cur->flink; }
+  assert(cur == e);
+  if (prev) prev->flink = e->flink; else q->head = e->flink;
+  if (q->tail == e) q->tail = prev;
+  e->flink = NULL;
+}
+static sq_entry_t *sq_remfirst(sq_queue_t *q) {
+  sq_entry_t *e = q->head;
+  if (e) sq_rem(e, q);
+  return e;
+}
+static int spin_lock_irqsave(spinlock_t *s) { assert(!pthread_mutex_lock(s)); return 0; }
+static void spin_unlock_irqrestore(spinlock_t *s, int flags) {
+  (void)flags; assert(!pthread_mutex_unlock(s));
+}
+#define spin_lock_irqsave_nopreempt spin_lock_irqsave
+#define spin_unlock_irqrestore_nopreempt spin_unlock_irqrestore
+static bool up_interrupt_context(void) { return false; }
+static atomic_int allocations, semaphores, waits, posts;
+static bool fail_alloc, fail_sem;
+static void *kmm_zalloc(size_t n) {
+  if (fail_alloc) return NULL;
+  void *p = calloc(1, n); assert(p); allocations++; return p;
+}
+static void kmm_delayfree(void *p) {
+  allocations--; free(p);
+}
+static void kmm_free(void *p) { kmm_delayfree(p); }
+typedef struct { pthread_mutex_t lock; pthread_cond_t cond; unsigned count; } event_sem_t;
+#define sem_t event_sem_t
+static pthread_mutex_t gate_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t gate_cond = PTHREAD_COND_INITIALIZER;
+static bool gate_closed;
+static atomic_int gated;
+/* Model task-stop after removing the native semaphore waiter, while the
+ * event API frame is still live, as NuttX's pre-stack-release hook requires.
+ */
+static void stopped_waiter(void *mutex) {
+  assert(!pthread_mutex_unlock(mutex));
+  __wrap_up_release_stack(this_task(), 7);
+}
+static int nxsem_init(sem_t *s, int shared, unsigned count) {
+  (void)shared;
+  if (fail_sem) return -ENOMEM;
+  assert(!pthread_mutex_init(&s->lock, NULL));
+  assert(!pthread_cond_init(&s->cond, NULL));
+  s->count = count; semaphores++; return 0;
+}
+static int nxsem_post(sem_t *s) {
+  assert(!pthread_mutex_lock(&s->lock)); s->count++; posts++;
+  assert(!pthread_cond_signal(&s->cond));
+  assert(!pthread_mutex_unlock(&s->lock)); return 0;
+}
+static int nxsem_tickwait_uninterruptible(sem_t *s, uint32_t ticks) {
+  struct timespec deadline;
+  assert(!clock_gettime(CLOCK_REALTIME, &deadline));
+  deadline.tv_sec += ticks / 1000;
+  deadline.tv_nsec += (long)(ticks % 1000) * 1000000;
+  if (deadline.tv_nsec >= 1000000000) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000; }
+  int ret = 0;
+  assert(!pthread_mutex_lock(&s->lock)); waits++;
+  pthread_cleanup_push(stopped_waiter, &s->lock);
+  while (!s->count && !ret) {
+    ret = ticks == UINT32_MAX ? pthread_cond_wait(&s->cond, &s->lock) :
+                               pthread_cond_timedwait(&s->cond, &s->lock, &deadline);
+  }
+  if (s->count) { s->count--; ret = 0; }
+  assert(!pthread_mutex_unlock(&s->lock));
+  pthread_cleanup_pop(0);
+  assert(!pthread_mutex_lock(&gate_lock));
+  pthread_cleanup_push(stopped_waiter, &gate_lock);
+  if (gate_closed) {
+    gated++;
+    while (gate_closed) assert(!pthread_cond_wait(&gate_cond, &gate_lock));
+  }
+  assert(!pthread_mutex_unlock(&gate_lock));
+  pthread_cleanup_pop(0);
+  return -ret;
+}
+static int nxsem_wait_uninterruptible(sem_t *s) {
+  return nxsem_tickwait_uninterruptible(s, UINT32_MAX);
+}
+static int nxsem_destroy(sem_t *s) {
+  assert(!pthread_cond_destroy(&s->cond));
+  assert(!pthread_mutex_destroy(&s->lock)); semaphores--; return 0;
+}
+'''
+    fixture += source
+    fixture += task
+    fixture += r'''
+struct job { void *event; uint32_t bits, ticks, result; int clear, all; pthread_t thread; };
+static void *worker(void *arg) {
+  struct job *j = arg;
+  j->result = esp32s31_wifi_event_wait(j->event, j->bits, j->clear, j->all, j->ticks);
+  return NULL;
+}
+static void await_count(atomic_int *count, int target) {
+  for (int i = 0; atomic_load(count) < target; i++) {
+    assert(i < 5000); struct timespec delay = {0, 1000000}; nanosleep(&delay, NULL);
+  }
+}
+static void start(struct job *j) { assert(!pthread_create(&j->thread, NULL, worker, j)); }
+static void join(struct job *j, uint32_t result) {
+  assert(!pthread_join(j->thread, NULL)); assert(j->result == result);
+}
+static void gate(bool closed) {
+  assert(!pthread_mutex_lock(&gate_lock)); gate_closed = closed;
+  if (!closed) assert(!pthread_cond_broadcast(&gate_cond));
+  assert(!pthread_mutex_unlock(&gate_lock));
+}
+int main(void) {
+  alarm(25);
+  fail_alloc = true; assert(esp32s31_wifi_event_create() == NULL); fail_alloc = false;
+  void *e = esp32s31_wifi_event_create();
+  assert(esp32s31_wifi_event_set(e, 0) == 0);
+  assert(esp32s31_wifi_event_set(e, 0x81) == 0x81);
+  assert(esp32s31_wifi_event_wait(e, 3, 1, 1, 0) == 0x81);
+  assert(esp32s31_wifi_event_wait(e, 3, 1, 1, 2) == 0x81);
+  assert(esp32s31_wifi_event_wait(e, 1, 1, 0, 0) == 0x81);
+  assert(esp32s31_wifi_event_clear(e, 0x80) == 0x80);
+  fail_sem = true; assert(esp32s31_wifi_event_wait(e, 1, 0, 0, 10) == 0); fail_sem = false;
+  esp32s31_wifi_event_delete(e); assert(!allocations && !semaphores);
+  for (int round = 0; round < 50; round++) {
+    e = esp32s31_wifi_event_create();
+    assert(esp32s31_wifi_event_set(e, 0x80) == 0x80);
+    int base = waits;
+    struct job a = {.event=e, .bits=3, .ticks=UINT32_MAX, .clear=1, .all=1};
+    struct job b = {.event=e, .bits=2, .ticks=UINT32_MAX};
+    start(&a); start(&b); await_count(&waits, base + 2);
+    assert(esp32s31_wifi_event_set(e, 1) == 0x81);
+    assert(esp32s31_wifi_event_set(e, 2) == 0x80);
+    join(&a, 0x83); join(&b, 0x83);
+    esp32s31_wifi_event_delete(e);
+    assert(!allocations && !semaphores);
+  }
+  /* Set result must survive deletion while the unblocked waiter is delayed. */
+  e = esp32s31_wifi_event_create();
+  int base = waits, held = gated;
+  struct job a = {.event=e, .bits=1, .ticks=UINT32_MAX, .clear=1};
+  gate(true); start(&a); await_count(&waits, base + 1);
+  esp32s31_wifi_event_set(e, 0x81); await_count(&gated, held + 1);
+  esp32s31_wifi_event_delete(e); assert(allocations == 1);
+  gate(false); join(&a, 0x81); assert(!allocations && !semaphores);
+  /* A timeout racing with set still sees the latched full snapshot. */
+  e = esp32s31_wifi_event_create(); base = waits; held = gated;
+  a = (struct job){.event=e, .bits=3, .ticks=2, .clear=1, .all=1};
+  gate(true); start(&a); await_count(&gated, held + 1);
+  assert(esp32s31_wifi_event_set(e, 0x83) == 0x80);
+  gate(false); join(&a, 0x83); esp32s31_wifi_event_delete(e);
+  /* Delete pending and timed-out-but-not-resumed waiters. */
+  for (int finite = 0; finite < 2; finite++) {
+    e = esp32s31_wifi_event_create(); base = waits; held = gated;
+    a = (struct job){.event=e, .bits=1, .ticks=finite ? 2 : UINT32_MAX};
+    struct job b = {.event=e, .bits=2, .ticks=UINT32_MAX};
+    gate(true); start(&a); start(&b); await_count(&waits, base + 2);
+    if (finite) await_count(&gated, held + 1);
+    esp32s31_wifi_event_delete(e); await_count(&gated, held + 2);
+    assert(allocations == 1);
+    gate(false); join(&a, 0); join(&b, 0); assert(!allocations && !semaphores);
+  }
+  for (int phase = 0; phase < 4; phase++) {
+    e = esp32s31_wifi_event_create(); base = waits; held = gated;
+    a = (struct job){.event=e, .bits=1, .ticks=phase == 2 ? 2 : UINT32_MAX};
+    struct job b = {.event=e, .bits=2, .ticks=UINT32_MAX};
+    gate(phase != 0); start(&a); start(&b); await_count(&waits, base + 2);
+    if (phase == 1) esp32s31_wifi_event_set(e, 1);
+    if (phase == 3) esp32s31_wifi_event_delete(e);
+    if (phase != 0) await_count(&gated, held + (phase == 3 ? 2 : 1));
+    assert(!pthread_cancel(a.thread));
+    void *result;
+    assert(!pthread_join(a.thread, &result) && result == PTHREAD_CANCELED);
+    assert(allocations == 1 && semaphores == 1);
+    if (phase != 3) esp32s31_wifi_event_set(e, 2);
+    gate(false); join(&b, phase == 3 ? 0 : phase == 1 ? 3 : 2);
+    if (phase != 3) esp32s31_wifi_event_delete(e);
+    assert(!allocations && !semaphores && g_event_waiters == NULL);
+    esp32s31_wifi_event_task_delete(this_task());
+  }
+  assert(task_releases == 4);
+  puts("S31_WIFI_EVENT=PASS snapshots/partial-timeout/multiwait/clear/delete/lifetime/oom/task-stop-hook");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='s31-wifi-event-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-pthread',
+                        '-fsanitize=address,undefined', '-fno-sanitize-recover=all',
+                        str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+        subprocess.run([str(path / 'test')], check=True, timeout=30)
+
+
+if __name__ == '__main__':
+    main()

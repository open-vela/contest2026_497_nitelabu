index 00000000000..edfd454baea
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_tlb.h
@@ -0,0 +1,50 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_tlb.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#ifndef __ARCH_RISCV_SRC_ESP32S31_ESP32S31_TLB_H
+#define __ARCH_RISCV_SRC_ESP32S31_ESP32S31_TLB_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+/* The mapping-side entry points are the common riscv_tlb_shootdown_range()
+ * and riscv_tlb_shootdown_all() declared in riscv_mmu.h.  Only the two hooks
+ * below are chip specific.
+ */
+
+#ifdef CONFIG_ESP32S31_SMP_TLB_SHOOTDOWN
+
+/* Service any inbound shootdown request for this hart.  Must be callable
+ * with interrupts disabled (IPI handler and local wait-spin paths).
+ */
+
+void esp32s31_tlb_shootdown_process(void);
+
+/* Register /dev/tlbshoot so smoke tests can read send/ack/timeout counts. */
+
+int esp32s31_tlb_register_stats_device(void);
+
+#else
+
+static inline void esp32s31_tlb_shootdown_process(void)
+{
+}
+
+static inline int esp32s31_tlb_register_stats_device(void)
+{
+  return 0;
+}
+
+#endif /* CONFIG_ESP32S31_SMP_TLB_SHOOTDOWN */
+
+#endif /* __ARCH_RISCV_SRC_ESP32S31_ESP32S31_TLB_H */
diff --git a/arch/risc-v/src/esp32s31/esp32s31_wifi_event.c b/arch/risc-v/src/esp32s31/esp32s31_wifi_event.c
new file mode 100644
index 00000000000..d4d2e0c538d
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_wifi_event.c
@@ -0,0 +1,332 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_wifi_event.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/kmalloc.h>
+#include <nuttx/queue.h>
+#include <nuttx/sched.h>
+#include <nuttx/semaphore.h>
+#include <nuttx/spinlock.h>
+
+#include "esp32s31_wifi_event.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* FreeRTOS reserves the high byte for event-group control flags. */
+
+#define WIFI_EVENT_BITS UINT32_C(0x00ffffff)
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct wifi_event_wait_s
+{
+  sq_entry_t entry;
+  struct wifi_event_wait_s *next_active;
+  struct wifi_event_s *event;
+  struct tcb_s *tcb;
+  sem_t sem;
+  uint32_t bits;
+  uint32_t result;
+  bool clear;
+  bool all;
+  bool notified;
+};
+
+struct wifi_event_s
+{
+  sq_queue_t waiters;
+  uint32_t bits;
+  unsigned int refs;
+  bool deleted;
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+/* One lock covers event state and the task-exit registry.  No path nests an
+ * event lock with a registry lock in the opposite order.  Registered nodes
+ * remain valid until normal return or the pre-stack-release cleanup hook.
+ */
+
+static spinlock_t g_event_lock = SP_UNLOCKED;
+static struct wifi_event_wait_s *g_event_waiters;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static bool wifi_event_match(uint32_t value, uint32_t bits, bool all)
+{
+  return all ? (value & bits) == bits : (value & bits) != 0;
+}
+
+static void wifi_event_release_waiter(struct wifi_event_wait_s *wait)
+{
+  struct wifi_event_wait_s **link;
+  struct wifi_event_s *event = wait->event;
+
+  for (link = &g_event_waiters; *link != wait;
+       link = &(*link)->next_active)
+    {
+      DEBUGASSERT(*link != NULL);
+    }
+
+  *link = wait->next_active;
+  if (!wait->notified)
+    {
+      sq_rem(&wait->entry, &event->waiters);
+    }
+
+  nxsem_destroy(&wait->sem);
+  if (--event->refs == 0)
+    {
+      kmm_delayfree(event);
+    }
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void *esp32s31_wifi_event_create(void)
+{
+  struct wifi_event_s *event = kmm_zalloc(sizeof(*event));
+
+  DEBUGASSERT(!up_interrupt_context());
+  if (event != NULL)
+    {
+      sq_init(&event->waiters);
+      event->refs = 1;
+    }
+
+  return event;
+}
+
+/* As with FreeRTOS, the owner must prevent new API calls after deletion.
+ * Blocked waiters hold references until they have finished using the lock.
+ * Deleting an event wakes them with zero, without freeing their live object.
+ */
+
+void esp32s31_wifi_event_delete(void *handle)
+{
+  struct wifi_event_s *event = handle;
+  struct wifi_event_wait_s *wait;
+  irqstate_t flags;
+
+  DEBUGASSERT(event != NULL && !up_interrupt_context());
+  flags = spin_lock_irqsave_nopreempt(&g_event_lock);
+  DEBUGASSERT(!event->deleted);
+  event->deleted = true;
+  while ((wait = (struct wifi_event_wait_s *)
+          sq_remfirst(&event->waiters)) != NULL)
+    {
+      wait->result = 0;
+      wait->notified = true;
+      nxsem_post(&wait->sem);
+    }
+
+  if (--event->refs == 0)
+    {
+      kmm_delayfree(event);
+    }
+
+  spin_unlock_irqrestore_nopreempt(&g_event_lock, flags);
+}
+
+uint32_t esp32s31_wifi_event_set(void *handle, uint32_t bits)
+{
+  struct wifi_event_s *event = handle;
+  struct wifi_event_wait_s *wait;
+  sq_entry_t *next;
+  irqstate_t flags;
+  uint32_t clear = 0;
+  uint32_t result;
+
+  DEBUGASSERT(event != NULL && !up_interrupt_context());
+  DEBUGASSERT((bits & ~WIFI_EVENT_BITS) == 0);
+  flags = spin_lock_irqsave_nopreempt(&g_event_lock);
+  DEBUGASSERT(!event->deleted);
+  event->bits |= bits;
+  for (wait = (struct wifi_event_wait_s *)sq_peek(&event->waiters);
+       wait != NULL; wait = (struct wifi_event_wait_s *)next)
+    {
+      next = sq_next(&wait->entry);
+      if (wifi_event_match(event->bits, wait->bits, wait->all))
+        {
+          /* All matching waiters see the same pre-clear snapshot. */
+
+          sq_rem(&wait->entry, &event->waiters);
+          wait->result = event->bits;
+          wait->notified = true;
+          if (wait->clear)
+            {
+              clear |= wait->bits;
+            }
+
+          nxsem_post(&wait->sem);
+        }
+    }
+
+  event->bits &= ~clear;
+  result = event->bits;
+  spin_unlock_irqrestore_nopreempt(&g_event_lock, flags);
+  return result;
+}
+
+uint32_t esp32s31_wifi_event_clear(void *handle, uint32_t bits)
+{
+  struct wifi_event_s *event = handle;
+  irqstate_t flags;
+  uint32_t result;
+
+  DEBUGASSERT(event != NULL && !up_interrupt_context());
+  DEBUGASSERT((bits & ~WIFI_EVENT_BITS) == 0);
+  flags = spin_lock_irqsave(&g_event_lock);
+  DEBUGASSERT(!event->deleted);
+  result = event->bits;
+  event->bits &= ~bits;
+  spin_unlock_irqrestore(&g_event_lock, flags);
+  return result;
+}
+
+uint32_t esp32s31_wifi_event_wait(void *handle, uint32_t bits, int clear,
+                                int all, uint32_t ticks)
+{
+  struct wifi_event_s *event = handle;
+  struct wifi_event_wait_s wait;
+  irqstate_t flags;
+  uint32_t result;
+  int ret;
+
+  DEBUGASSERT(event != NULL && !up_interrupt_context());
+  DEBUGASSERT(bits != 0 && (bits & ~WIFI_EVENT_BITS) == 0);
+  flags = spin_lock_irqsave(&g_event_lock);
+  DEBUGASSERT(!event->deleted);
+  result = event->bits;
+  if (wifi_event_match(result, bits, all != 0))
+    {
+      if (clear)
+        {
+          event->bits &= ~bits;
+        }
+
+      spin_unlock_irqrestore(&g_event_lock, flags);
+      return result;
+    }
+
+  if (ticks == 0)
+    {
+      spin_unlock_irqrestore(&g_event_lock, flags);
+      return result;
+    }
+
+  ret = nxsem_init(&wait.sem, 0, 0);
+  if (ret < 0)
+    {
+      spin_unlock_irqrestore(&g_event_lock, flags);
+      return result;
+    }
+
+  wait.bits = bits;
+  wait.clear = clear != 0;
+  wait.all = all != 0;
+  wait.result = 0;
+  wait.notified = false;
+  wait.event = event;
+  wait.tcb = this_task();
+  wait.next_active = g_event_waiters;
+  g_event_waiters = &wait;
+  event->refs++;
+  sq_addlast(&wait.entry, &event->waiters);
+  spin_unlock_irqrestore(&g_event_lock, flags);
+
+  if (ticks == UINT32_MAX)
+    {
+      nxsem_wait_uninterruptible(&wait.sem);
+    }
+  else
+    {
+      nxsem_tickwait_uninterruptible(&wait.sem, ticks);
+    }
+
+  flags = spin_lock_irqsave(&g_event_lock);
+  if (wait.notified)
+    {
+      result = wait.result;
+    }
+  else
+    {
+      /* Recheck under the lock: a timeout can race with setting bits. */
+
+      result = event->bits;
+      if (clear && wifi_event_match(result, bits, all != 0))
+        {
+          event->bits &= ~bits;
+        }
+    }
+
+  wifi_event_release_waiter(&wait);
+  spin_unlock_irqrestore(&g_event_lock, flags);
+
+  return result;
+}
+
+/* Called for a non-running task, after semaphore recovery and before stack
+ * release.  It also handles a waiter already notified but not yet resumed.
+ * Never post its semaphore here: the scheduler has removed the dead task.
+ */
+
+void esp32s31_wifi_event_task_delete(struct tcb_s *tcb)
+{
+  struct wifi_event_wait_s *wait;
+  struct wifi_event_wait_s *next;
+  irqstate_t flags;
+
+  flags = spin_lock_irqsave(&g_event_lock);
+  for (wait = g_event_waiters; wait != NULL; wait = next)
+    {
+      next = wait->next_active;
+      if (wait->tcb == tcb)
+        {
+          wifi_event_release_waiter(wait);
+        }
+    }
+
+  spin_unlock_irqrestore(&g_event_lock, flags);
+}
+
+#ifdef CONFIG_ESP32S31_WIFI_EVENT_TEST
+unsigned int esp32s31_wifi_event_waiter_count(void)
+{
+  struct wifi_event_wait_s *wait;
+  irqstate_t flags;
+  unsigned int count = 0;
+
+  flags = spin_lock_irqsave(&g_event_lock);
+  for (wait = g_event_waiters; wait != NULL; wait = wait->next_active)
+    {
+      count++;
+    }
+
+  spin_unlock_irqrestore(&g_event_lock, flags);
+  return count;
+}
+#endif

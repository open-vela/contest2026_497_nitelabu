+  assert(esp_rmtinitialize(config) == NULL);
+  assert(live == 0 && configs == 2 && installs == 1);
+  install_result = 0;
+  struct rmt_dev_lowerhalf_s *dev = (void *)esp_rmtinitialize(config);
+  assert(dev && live == 1 && configs == 3 && installs == 2);

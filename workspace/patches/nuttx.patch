new file mode 100644
index 00000000000..7b9041427ca
--- /dev/null
+++ b/tools/test_mtd_partition_bounds.py
@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the actual MTD partition methods with a host-side mock parent.
+
+No Flash is accessed.  Pass --revision HEAD to reproduce the old boundary
+failure before committing a fix.  The C fixture uses a 32-bit signed offset
+to cover the embedded target's arithmetic as well as large size_t counts.
+"""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def definition(source, name):
+    match = re.search(
+        r"static\s+(?:bool|int|ssize_t)\s+" + name +
+        r"\([^;]*?\)\s*\{", source)
+    if match is None:
+        raise ValueError(f"Missing definition: {name}")
+    end = match.end()
+    depth = 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[match.start():end]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    path = "drivers/mtd/mtd_partition.c"
+    if args.revision:
+        source = subprocess.check_output(
+            ["git", "show", f"{args.revision}:{path}"], cwd=root, text=True)
+    else:
+        source = (root / path).read_text()
+
+    helpers = (["part_rangecheck"] if "part_rangecheck" in source else
+               ["part_blockcheck", "part_bytecheck"])
+    methods = ["part_read", "part_write", "part_bread", "part_bwrite",
+               "part_erase"]
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <errno.h>
+#define off_t int32_t
+#define ssize_t intptr_t
+#define FAR
+#define DEBUGASSERT assert
+#define ferr(...) ((void)0)
+struct mtd_dev_s {
+  ssize_t (*read)(struct mtd_dev_s *, off_t, size_t, uint8_t *);
+  ssize_t (*write)(struct mtd_dev_s *, off_t, size_t, const uint8_t *);
+  ssize_t (*bread)(struct mtd_dev_s *, off_t, size_t, uint8_t *);
+  ssize_t (*bwrite)(struct mtd_dev_s *, off_t, size_t, const uint8_t *);
+  int (*erase)(struct mtd_dev_s *, off_t, size_t);
+};
+struct mtd_partition_s {
+  struct mtd_dev_s child;
+  struct mtd_dev_s *parent;
+  off_t firstblock;
+  uint16_t blkpererase;
+  struct { uint32_t blocksize, erasesize, neraseblocks; } geo;
+};
+static int calls;
+static off_t parent_offset;
+static ssize_t mock_read(struct mtd_dev_s *d, off_t o, size_t n, uint8_t *b)
+{ (void)d; (void)b; calls++; parent_offset = o; return n; }
+static ssize_t mock_write(struct mtd_dev_s *d, off_t o, size_t n,
+                          const uint8_t *b)
+{ return mock_read(d, o, n, (uint8_t *)b); }
+static int mock_erase(struct mtd_dev_s *d, off_t o, size_t n)
+{ return mock_read(d, o, n, NULL); }
+'''
+    fixture += "\n".join(definition(source, name)
+                         for name in helpers + methods)
+    fixture += r'''
+static ssize_t request(int method, struct mtd_dev_s *d, off_t o, size_t n)
+{
+  uint8_t byte = 0;
+  switch (method) {
+    case 0: return part_read(d, o, n, &byte);
+    case 1: return part_write(d, o, n, &byte);
+    case 2: return part_bread(d, o, n, &byte);
+    case 3: return part_bwrite(d, o, n, &byte);
+    default: return part_erase(d, o, n);
+  }
+}
+int main(void)
+{
+  struct mtd_dev_s parent = {mock_read, mock_write, mock_read,
+                             mock_write, mock_erase};
+  struct mtd_partition_s part = {
+    .parent = &parent, .firstblock = 16, .blkpererase = 8,
+    .geo = {512, 4096, 4}
+  };
+  for (int method = 0; method < 5; method++) {
+    off_t limit = method < 2 ? 16384 : method < 4 ? 32 : 4;
+    off_t base = method < 2 ? 8192 : method < 4 ? 16 : 2;
+    struct { off_t offset; size_t count; bool valid; } cases[] = {
+      {0, 1, true}, {limit - 1, 1, true}, {limit, 1, false},
+      {limit - 1, 2, false}, {-1, 1, false}, {0, SIZE_MAX, false},
+      {1, UINT32_MAX, false}, {INT32_MAX, 2, false},
+      {0, 0, true}, {limit, 0, true}, {limit + 1, 0, false}
+    };
+    for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+      calls = 0;
+      ssize_t ret = request(method, &part.child, cases[i].offset,
+                             cases[i].count);
+      bool ok = cases[i].valid ?
+        ret == (ssize_t)cases[i].count && calls == 1 &&
+        parent_offset == base + cases[i].offset :
+        ret == -ENXIO && calls == 0;
+      if (!ok) {
+        fprintf(stderr, "FAIL method=%d case=%u ret=%ld parent_calls=%d\n",
+                method, i, (long)ret, calls);
+        return 1;
+      }
+    }
+  }
+  puts("PASS: 55 MTD byte/block/erase boundary and parent-forwarding checks");
+  return 0;
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="mtd-bounds-") as tmp:
+        binary = str(Path(tmp) / "test")
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-Wno-error=sign-compare",
+                        "-fsanitize=undefined", "-x", "c", "-", "-o", binary],
+                       input=fixture, text=True, check=True)
+        return subprocess.run([binary]).returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

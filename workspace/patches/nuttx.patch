+    ${ESP_ROM_LD_DIR}/${CHIP_SERIES}.rom.ld
+    ${ESP_ROM_LD_DIR}/${CHIP_SERIES}.rom.libc.ld
+    # ESP32-S31 exposes a hardware-FP ROM ABI and NuttX is built with
+    # -march=rv32imafc/-mabi=ilp32f.  ESP-IDF therefore selects rom.rvfp.ld;

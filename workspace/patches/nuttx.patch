+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise actual Wi-Fi adapter and mq send core with a full queue fixture.
+
+No real scheduler/ISR timing: the wait mock counts every attempt to block.
+"""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+
+    def source(name):
+        return (subprocess.check_output(
+            ['git', 'show', f'{args.revision}:{name}'], cwd=root, text=True)
+            if args.revision else (root / name).read_text())
+
+    fixture = r'''
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <time.h>
+#define FAR
+#define POLLIN 1
+#define wlerr(...) ((void)0)
+#define OSI_FUNCS_TIME_BLOCKING UINT32_MAX
+typedef long sclock_t;
+typedef int irqstate_t;
+struct mqueue_inode_s { int nmsgs, maxmsgs; };
+struct inode { void *i_private; };
+struct file { struct inode *f_inode; int f_oflags; };
+struct mqueue_msg_s { char mail[16]; unsigned priority; size_t msglen; };
+struct mq_adpt { struct file mq; size_t msgsize; };
+static struct mqueue_msg_s message;
+static int locked, isr, waits, frees, adds, notices, polls, oom;
+static sclock_t waited_ticks;
+static bool waited_absolute;
+static irqstate_t enter_critical_section(void)
+{ assert(!locked); locked = 1; return 7; }
+static void leave_critical_section(irqstate_t f)
+{ assert(locked && f == 7); locked = 0; }
+static bool up_interrupt_context(void) { return isr; }
+static struct mqueue_msg_s *nxmq_alloc_msg(size_t size)
+{ assert(!locked && size <= sizeof(message.mail)); return oom ? NULL : &message; }
+static void nxmq_free_msg(struct mqueue_msg_s *msg)
+{ assert(!locked && msg == &message); frees++; }
+static int nxmq_wait_send(struct mqueue_inode_s *q,
+                         const struct timespec *time, sclock_t ticks)
+{ assert(locked && q->nmsgs == q->maxmsgs); waits++;
+  waited_ticks = ticks; waited_absolute = time != NULL; return -ETIMEDOUT; }
+static void nxmq_add_queue(struct mqueue_inode_s *q,
+                          struct mqueue_msg_s *msg, unsigned prio)
+{ assert(locked && q->nmsgs < q->maxmsgs && msg == &message);
+  assert(prio == 0 && msg->msglen == 4 && !memcmp(msg->mail, "test", 4)); adds++; }
+static void nxmq_pollnotify(struct mqueue_inode_s *q, int events)
+{ assert(locked && q->nmsgs == 1 && events == POLLIN); polls++; }
+static void nxmq_notify_send(struct mqueue_inode_s *q)
+{ assert(locked && q->nmsgs > 0); notices++; }
+static int nuttx_err_to_freertos(int ret) { return ret == 0; }
+static void esp_update_time(struct timespec *ts, uint32_t ticks)
+{ ts->tv_sec += ticks; }
+'''
+    # API names also occur with parentheses in documentation comments.
+    core = re.sub(r'/\*.*?\*/', '', source('sched/mqueue/mq_send.c'), flags=re.S)
+    for name in ('file_mq_timedsend_internal', 'file_mq_send',
+                 'file_mq_ticksend', 'file_mq_timedsend'):

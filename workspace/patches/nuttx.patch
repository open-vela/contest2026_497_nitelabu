@@ -0,0 +1,201 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise actual TX start/finish/ISR/write code under bounded event schedules.
+
+The mocked scheduler checks lock ordering and cancellation/completion races;
+it is not a substitute for multicore hardware or waveform validation.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main(source=None, run_fixture=None):
+    root = Path(__file__).resolve().parent.parent
+    if source is None:
+        source = (root / 'arch/risc-v/src/common/espressif/esp_rmt.c').read_text()
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#define IRAM_ATTR
+#define DEBUGASSERT assert
+#define OK 0
+#define BIT(c) (1u << (c))
+#define MIN(a,b) ((a) < (b) ? (a) : (b))
+#define RMT_IS_TX_CHANNEL(c) ((c) == 0)
+#define RMT_MEM_ITEM_NUM 48
+#define SOC_RMT_CHANNELS_PER_GROUP 4
+#define SOC_RMT_SUPPORT_TX_LOOP_COUNT 1
+#define CONFIG_SPIRAM_USE_MALLOC 1
+#define ESP_INTR_FLAG_IRAM 1
+#define rmterr(...) ((void)0)
+#define RMT_LL_EVENT_TX_DONE(c) BIT(c)
+#define RMT_LL_EVENT_TX_ERROR(c) BIT((c) + 4)
+#define RMT_LL_EVENT_TX_THRES(c) BIT((c) + 8)
+#define RMT_LL_EVENT_TX_LOOP_END(c) BIT((c) + 12)
+typedef int irqstate_t;
+typedef int rmt_channel_t;
+typedef int rmt_idle_level_t;
+typedef struct { unsigned level0, duration0; } rmt_item32_t;
+typedef struct {
+  int tx_lock, tx_state_lock, tx_sem, tx_result;
+  int intr_alloc_flags;
+  bool tx_active, wait_done;
+  const rmt_item32_t *tx_data;
+  const void *sample_cur;
+  size_t tx_len_rem, tx_offset, tx_sub_len;
+} rmt_obj_t;
+static rmt_obj_t object, *p_rmt_obj[] = {&object};
+static struct { int rmt_spinlock; struct { void *regs; } hal; } g_rmtdev_common;
+static uint32_t pending, enabled;
+static int hardware_active, starts, stops, posts, waits, writes, scenario;
+static int lock_error, early_irq, lock_depth;
+static bool loop;
+static bool internal = true;
+static bool esp_ptr_internal(const void *p) { (void)p; return internal; }
+static rmt_item32_t memory[48];
+static void rmt_tx_interrupt(rmt_channel_t channel);
+static int spin_lock_irqsave(int *lock)
+{
+  assert(!*lock);
+  if (lock == &object.tx_state_lock) assert(!g_rmtdev_common.rmt_spinlock);
+  *lock = 1; lock_depth++; return 0;
+}
+static void spin_unlock_irqrestore(int *lock, int flags)
+{
+  (void)flags; assert(*lock); *lock = 0; lock_depth--;
+  if (lock == &object.tx_state_lock && early_irq && object.tx_active) {
+    early_irq = 0; pending |= RMT_LL_EVENT_TX_DONE(0); rmt_tx_interrupt(0);
+  }
+}
+static int nxmutex_lock(int *m)
+{ assert(!lock_depth && !*m); if (lock_error) return lock_error;
+  *m = 1; return 0; }
+static int nxmutex_unlock(int *m)
+{ assert(!lock_depth && *m && !object.tx_active && !hardware_active);
+  *m = 0; return 0; }
+static int nxsem_post(int *s)
+{ assert(s == &object.tx_sem && object.tx_state_lock && !object.tx_active);
+  assert(!hardware_active && !pending && !enabled && !object.tx_data);
+  (*s)++; posts++; return 0; }
+static int nxsem_trywait(int *s)
+{ if (*s) { (*s)--; return 0; } return -EAGAIN; }
+static int rmt_ll_tx_get_mem_blocks(void *r, int c)
+{ (void)r; (void)c; return 1; }
+static int rmt_ll_tx_get_idle_level(void *r, int c)
+{ (void)r; (void)c; return 0; }
+static bool rmt_ll_tx_is_loop_enabled(void *r, int c)
+{ (void)r; (void)c; return loop; }
+static void rmt_ll_tx_enable_loop(void *r, int c, bool on)
+{ (void)r; (void)c; assert(g_rmtdev_common.rmt_spinlock); loop = on; }
+static void rmt_ll_tx_set_limit(void *r, int c, int n)
+{ (void)r; (void)c; assert(g_rmtdev_common.rmt_spinlock && n == 24); }
+static void rmt_ll_enable_interrupt(void *r, uint32_t mask, bool on)
+{ (void)r; assert(g_rmtdev_common.rmt_spinlock);
+  if (on) enabled |= mask; else enabled &= ~mask; }
+static void rmt_ll_clear_interrupt_status(void *r, uint32_t mask)
+{ (void)r; assert(g_rmtdev_common.rmt_spinlock); pending &= ~mask; }
+static void rmt_ll_tx_stop(void *r, int c)
+{ (void)r; (void)c; assert(g_rmtdev_common.rmt_spinlock);
+  hardware_active = 0; stops++; }
+static void rmt_ll_tx_reset_pointer(void *r, int c)
+{ (void)r; (void)c; assert(g_rmtdev_common.rmt_spinlock); }
+static void rmt_ll_tx_start(void *r, int c)
+{ (void)r; (void)c; assert(object.tx_state_lock && object.tx_lock);
+  assert(object.tx_active && g_rmtdev_common.rmt_spinlock);
+  hardware_active = 1; starts++; }
+static void rmt_ll_tx_reset_loop_count(void *r, int c) { (void)r; (void)c; }
+static void rmt_ll_tx_enable_loop_count(void *r, int c, bool on)
+{ (void)r; (void)c; (void)on; }
+static volatile void *rmt_ll_get_interrupt_status_reg(void *r)
+{ static uint32_t snapshot; (void)r;
+  assert(object.tx_state_lock && g_rmtdev_common.rmt_spinlock);
+  snapshot = pending & enabled; return &snapshot; }
+static void rmt_fill_memory(int c, const rmt_item32_t *p, int n, int offset)
+{ (void)c; assert(object.tx_state_lock && p && n > 0 && offset + n <= 48);
+  for (int i = 0; i < n; i++) { memory[offset + i] = p[i]; }
+  writes++; }
+static int nxsem_wait_uninterruptible(int *s);
+'''
+    for name in ('rmt_tx_start', 'rmt_set_tx_loop_mode',
+                 'rmt_set_tx_thr_intr_en', 'rmt_tx_event_mask',
+                 'rmt_tx_finish_nolock',
+                 'rmt_tx_interrupt', 'rmt_write_items'):
+        fixture += definition(source, name) + '\n'
+    fixture += r'''
+static int nxsem_wait_uninterruptible(int *s)
+{
+  assert(!lock_depth && object.tx_lock); waits++;
+  if (scenario == 1) return -ECANCELED;
+  if (scenario == 5) {
+    assert(object.tx_len_rem == 49);
+    for (int i = 0; i < 3; i++) {
+      pending |= RMT_LL_EVENT_TX_THRES(0); rmt_tx_interrupt(0);
+    }
+    assert(object.tx_len_rem == 0 && object.tx_data != NULL);
+    assert(memory[0].duration0 == 97 && memory[1].duration0 == 0);
+  }
+  if (*s == 0) {
+    pending |= scenario == 4 ? RMT_LL_EVENT_TX_LOOP_END(0) :
+                              RMT_LL_EVENT_TX_DONE(0);
+    if (scenario == 2) pending |= RMT_LL_EVENT_TX_ERROR(0);
+    if (scenario == 6) pending |= RMT_LL_EVENT_TX_THRES(0);
+    rmt_tx_interrupt(0);
+  }
+  if (scenario == 3) return -ECANCELED; /* completion/cancel collision */
+  return nxsem_trywait(s);
+}
+int main(void)
+{
+  rmt_item32_t frame[97];
+  for (int i = 0; i < 97; i++) frame[i] = (rmt_item32_t){0, i + 1};
+  lock_error = -EINTR;
+  assert(rmt_write_items(0, frame, 1, true) == -EINTR && starts == 0);
+  lock_error = 0;
+  assert(rmt_write_items(0, frame, 1, false) == -EINVAL && starts == 0);
+  internal = false; object.intr_alloc_flags = ESP_INTR_FLAG_IRAM;
+  assert(rmt_write_items(0, frame, 1, true) == -EINVAL && starts == 0);
+  internal = true;
+  for (scenario = 0; scenario <= 7; scenario++) {
+    int count = scenario == 5 || scenario == 6 ? 97 : 1;
+    int expected = scenario == 1 || scenario == 3 ? -ECANCELED :
+                   scenario == 2 ? -EIO : 0;
+    loop = scenario == 4; early_irq = scenario == 7;
+    posts = writes = 0;
+    assert(rmt_write_items(0, frame, count, true) == expected);
+    assert(!object.tx_data && !object.tx_active && !object.tx_sem);
+    assert(!object.tx_lock && !lock_depth && !enabled && !pending);
+    assert(posts == (scenario == 1 ? 0 : 1));
+    int old_writes = writes;
+    /* A stale interrupt after completion cannot refill or post again. */
+    pending = RMT_LL_EVENT_TX_THRES(0) | RMT_LL_EVENT_TX_DONE(0);
+    enabled = pending; rmt_tx_interrupt(0);
+    assert(writes == old_writes && !object.tx_sem && !pending && !enabled);
+  }
+  p_rmt_obj[0] = NULL;

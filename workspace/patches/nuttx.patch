+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the actual IRQ routing helper with CPU-local CLIC models.
+
+This checks routing/configuration consistency, not remote enable/disable or
+hardware interrupt delivery.  --revision permits a pre-fix negative control.
+"""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    relative = "arch/risc-v/src/common/espressif/esp_irq.c"
+    if args.revision:
+        source = subprocess.check_output(
+            ["git", "show", f"{args.revision}:{relative}"],
+            cwd=root, text=True)
+    else:
+        source = (root / relative).read_text()
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+typedef int irq_priority_t;
+typedef int irq_trigger_t;
+#define BIT(n) (UINT32_C(1) << (n))
+#define PRO_CPU_NUM 0
+#define ESP_IRQ_TRIGGER_EDGE 1
+#define INTR_TYPE_EDGE 1
+#define INTR_TYPE_LEVEL 0
+static int cpu;
+static unsigned step;
+static int expected_input, expected_priority, expected_type;
+#define this_cpu() cpu
+static void disable(uint32_t mask)
+{
+  assert(step++ == 0 && mask == BIT(expected_input));
+}
+static void set_priority(int input, int value)
+{
+  assert(step++ == 1 && input == expected_input);
+  assert(value == expected_priority);
+}
+static void trigger(int input, int value)
+{
+  assert(step++ == 2 && input == expected_input);
+  assert(value == expected_type);
+}
+#define esprv_int_disable disable
+#define esprv_intc_int_disable disable
+#define esprv_int_set_priority set_priority
+#define esprv_intc_int_set_priority set_priority
+#define esprv_int_set_type trigger
+#define esprv_intc_int_set_type trigger
+static void esp_rom_route_intr_matrix(int target, int source, int input)
+{
+  assert(step++ == 3 && source == 120 && input == expected_input);
+#ifdef CONFIG_ARCH_CHIP_ESP32S31
+  assert(target == cpu);
+#else
+  assert(target == PRO_CPU_NUM);
+#endif
+}
+'''
+    fixture += definition(source, "esp_route_intr")
+    fixture += r'''
+int main(void)
+{
+  for (cpu = 0; cpu < 2; cpu++) {
+    for (expected_input = 0; expected_input < 32; expected_input++) {
+      for (expected_priority = 1; expected_priority < 8;
+           expected_priority++) {
+        for (expected_type = 0; expected_type < 2; expected_type++) {
+          step = 0;
+          esp_route_intr(120, expected_input, expected_priority,
+                         expected_type);
+          assert(step == 4);
+        }
+      }
+    }
+  }
+  puts("ESP_IRQ_ROUTE=PASS CPU0/CPU1; 32 inputs; level/edge; priorities 1..7");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-irq-route-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        for flags in ([], ["-DCONFIG_ARCH_CHIP_ESP32S31"],
+                      ["-DCONFIG_ARCH_CHIP_ESP32S31",
+                       "-DCONFIG_ARCH_USE_S_MODE"]):
+            subprocess.run(
+                ["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                 "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                 *flags, str(path / "test.c"), "-o", str(path / "test")],
+                check=True)
+            subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

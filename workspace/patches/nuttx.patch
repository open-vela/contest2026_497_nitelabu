+ESP32S31_MBEDTLS_SRCS += $(MBEDTLS_BUILTIN_DIR)/aria.c
+ESP32S31_MBEDTLS_SRCS += $(MBEDTLS_BUILTIN_DIR)/bignum_core.c
+ESP32S31_MBEDTLS_SRCS += $(MBEDTLS_BUILTIN_DIR)/bignum.c
+ESP32S31_MBEDTLS_SRCS += $(MBEDTLS_BUILTIN_DIR)/ccm.c

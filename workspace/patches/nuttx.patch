index 00000000000..2eb57ab3dcc
--- /dev/null
+++ b/tools/espressif/esp32s31_event_smoke.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Reset S31 event-test firmware and verify both CPU directions.
+
+Requires demo-rmt-event kernel and matching AppFS. Does not flash, associate
+with an AP, or write user storage. Leaves WLAN disabled after each boot.
+"""
+import argparse
+import re
+import time
+
+import serial
+
+import esp32s31_nuttx_smoke as transport
+import esp32s31_production_smoke as production
+
+
+def validate(output):
+    text = output.decode(errors='replace')
+    production.require(not any(marker in output for marker in
+                               transport.BOOT_FAILURE_MARKERS), 'fatal boot marker')
+    production.require('EVENT_TEST=FAIL' not in text and
+                       'EVENT_TEST cleanup failed' not in text,
+                       'event diagnostic failure')
+    for marker in ('NuttShell (NSH)', 'CPU1 SMP online',
+                   'AppFS MTD boundary checks: PASS',
+                   'Wi-Fi station netdev ready', 'EVENT_TEST=PASS cases=8 ret=0'):
+        production.require(marker in text, 'missing marker: ' + marker)
+    cases = re.findall(r'EVENT_TEST parent=(\d+) worker=(\d+) mode=(\d+) ret=(-?\d+)', text)
+    expected = [(str(cpu), str(1 - cpu), str(mode), '0')
+                for cpu in range(2) for mode in range(4)]
+    production.require(cases == expected, f'event cases differ: {cases!r}')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--port', required=True)
+    parser.add_argument('--boots', type=int, default=3)
+    args = parser.parse_args()
+    if not 1 <= args.boots <= 20:
+        parser.error('--boots must be between 1 and 20')
+    with serial.Serial(args.port, 115200, timeout=0.05,
+                       write_timeout=1, exclusive=True) as port:
+        for attempt in range(1, args.boots + 1):
+            started = time.monotonic()
+            transport.hard_reset(port)
+            output = transport.collect_until_prompt(port, 30.0)
+            print(output.decode(errors='replace'), flush=True)
+            validate(output)
+            production.require('ifdown wlan0...OK' in
+                               production.command(port, 'ifdown wlan0'),
+                               'radio cleanup failed')
+            print(f'EVENT_BOARD_ROUND={attempt} PASS cases=8 '
+                  f'seconds={time.monotonic()-started:.3f}', flush=True)
+    print(f'EVENT_BOARD=PASS boots={args.boots} cases={args.boots * 8}', flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/espressif/esp32s31_i2c_smoke.py b/tools/espressif/esp32s31_i2c_smoke.py
new file mode 100644
index 00000000000..d04b22b7733
--- /dev/null
+++ b/tools/espressif/esp32s31_i2c_smoke.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded ES8311 ID/control-bus checks for the S31 Function-CoreBoard-1.
+
+Only reads codec ID registers and resets the I2C controller. No audio setup,
+amplifier enable, bus scan or flash write. Optional NACK recovery assumes
+the unmodified board: CE is strapped low (0x18), not high (0x19).
+"""
+
+import argparse
+import re
+
+import serial
+
+import esp32s31_production_smoke as production
+
+
+def read_id(port, frequency, register, expected, reads):
+    # NSH permits seven arguments. Defaults are bus 0 and width 8; -n keeps
+    # pointer-write and read descriptors in one atomic transfer request.
+    command = (f"i2c get -n -a18 -r{register:02x} "
+               f"-f{frequency} {reads:x}")
+    output = production.command(port, command)
+    values = re.findall(r"READ Bus: 0 Addr: 18 Subaddr: " +
+                        f"{register:02x}" + r" Value: ([0-9a-fA-F]+)", output)
+    production.require(len(values) == reads and
+                       all(int(value, 16) == expected for value in values),
+                       "codec ID count/value mismatch")
+    production.require(not any(text in output.lower() for text in
+                               ("failed", "error", "nsh:")),
+                       "unexpected I2C/NSH error")
+    print(f"CODEC_ID=PASS frequency={frequency} register={register:#x} "
+          f"reads={reads}", flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--port", required=True)
+    parser.add_argument("--no-boot", action="store_true",
+                        help="keep the current Wi-Fi/HTTP demo running")
+    parser.add_argument("--batches", type=int, default=1)
+    parser.add_argument("--reads", type=int, default=16)
+    parser.add_argument("--nack-recovery", action="store_true")
+    args = parser.parse_args()
+    if not 1 <= args.batches <= 20 or not 1 <= args.reads <= 128:
+        parser.error("batches must be 1..20; reads must be 1..128")
+
+    with serial.Serial(args.port, 115200, timeout=0.05, write_timeout=1,
+                       exclusive=True) as port:
+        if args.no_boot:
+            production.command(port, "uname -a")
+        else:
+            production.boot(port, "I2C_BOOT")
+        production.command(port, "free")
+        for batch in range(args.batches):
+            for frequency in (100000, 400000, 100000):
+                reset = production.command(port, "i2c reset")
+                production.require("Reset command sent successfully" in reset,
+                                   "I2C controller recovery failed")
+                for register, expected in ((0xfd, 0x83), (0xfe, 0x11)):
+                    read_id(port, frequency, register, expected, args.reads)
+            print(f"I2C_BATCH={batch + 1} PASS reads={6 * args.reads} "
+                  "resets=3", flush=True)
+
+        if args.nack_recovery:
+            for frequency in (100000, 400000, 100000, 400000):
+                output = production.command(
+                    port, f"i2c get -n -a19 -rfd -w8 -f{frequency}")
+                production.require("Transfer failed: 5" in output,
+                                   "expected NACK/EIO from unpopulated 0x19")
+                production.require("timed out" not in output.lower() and
+                                   "nsh:" not in output.lower(),
+                                   "NACK was not reported promptly")
+                # No reset in between: the failed transfer must clean up.
+                read_id(port, frequency, 0xfd, 0x83, 1)
+                print(f"I2C_NACK_RECOVERY=PASS frequency={frequency}",
+                      flush=True)
+
+        production.command(port, "free")
+        production.command(port, "sleep 2")
+        production.command(port, "cat /dev/s31stat")
+        print(f"S31_I2C_SMOKE=PASS reads={args.batches * args.reads * 6} "
+              f"resets={args.batches * 3} audio=untested", flush=True)
+
+
+if __name__ == "__main__":
+    main()

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Reject incomplete or wrong-CPU event-test transcripts without serial I/O."""
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / 'espressif'))
+import esp32s31_event_smoke as smoke
+
+markers = ('NuttShell (NSH)', 'CPU1 SMP online',
+           'AppFS MTD boundary checks: PASS', 'Wi-Fi station netdev ready',
+           'EVENT_TEST=PASS cases=8 ret=0')
+cases = [f'EVENT_TEST parent={cpu} worker={1-cpu} mode={mode} ret=0'
+         for cpu in range(2) for mode in range(4)]
+text = '\n'.join((*markers, *cases))
+smoke.validate(text.encode())
+invalid = [text.replace(marker, '', 1) for marker in markers]
+invalid += [text.replace(cases[0], '', 1), text + '\n' + cases[0],
+            text.replace('parent=0 worker=1', 'parent=0 worker=0', 1),
+            text.replace('mode=3 ret=0', 'mode=3 ret=-5', 1),
+            '\n'.join((*markers, *reversed(cases))),
+            text + '\nEVENT_TEST=FAIL', text + '\nEVENT_TEST cleanup failed']
+for sample in invalid:
+    try:
+        smoke.validate(sample.encode())
+    except RuntimeError:
+        continue
+    raise AssertionError('Invalid event transcript accepted: ' + sample)
+try:
+    smoke.validate(text.encode() + smoke.transport.BOOT_FAILURE_MARKERS[0])
+except RuntimeError:
+    pass
+else:
+    raise AssertionError('Fatal boot marker accepted')
+print('EVENT_TRANSCRIPT=PASS markers/count/order/cpus/results/fatal/cleanup')

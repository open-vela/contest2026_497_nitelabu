diff --git a/arch/risc-v/src/esp32s31/hal_backports/bootloader_random_esp32s31.c b/arch/risc-v/src/esp32s31/hal_backports/bootloader_random_esp32s31.c
new file mode 100644
index 00000000000..50602758b7e
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/hal_backports/bootloader_random_esp32s31.c
@@ -0,0 +1,46 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Backported from esp-hal-3rdparty sync/master.c.  This is kept local until
+ * the NuttX release branch contains the ESP32-S31 RNG LL header.
+ */
+
+#include <stdbool.h>
+
+#include "bootloader_random.h"
+#include "soc/trng_struct.h"
+#include "soc/lp_peri_clkrst_struct.h"
+
+/* Added to trng_struct.h on sync/master.c after release/master.c. */
+
+extern trng_dev_t LP_TRNG;
+
+static inline void esp32s31_rng_enable_bus_clock(bool enable)
+{
+  LP_PERI_CLKRST.rng_ctrl.lp_rng_clk_en = enable;
+}
+
+static inline void esp32s31_rng_reset(void)
+{
+  LP_PERI_CLKRST.rng_ctrl.lp_rng_rst_en = 1;
+  LP_PERI_CLKRST.rng_ctrl.lp_rng_rst_en = 0;
+}
+
+void bootloader_random_enable(void)
+{
+  esp32s31_rng_enable_bus_clock(true);
+  esp32s31_rng_reset();
+  LP_TRNG.date.clk_en = true;
+  LP_TRNG.conf.sample_enable = true;
+  LP_TRNG.conf.noise_crc_en = true;
+}
+
+void bootloader_random_disable(void)
+{
+  LP_TRNG.conf.sample_enable = false;
+  LP_TRNG.conf.noise_crc_en = false;
+  LP_TRNG.date.clk_en = false;
+  esp32s31_rng_enable_bus_clock(false);
+}
diff --git a/arch/risc-v/src/esp32s31/hal_backports/esp_gpio_reserve.c b/arch/risc-v/src/esp32s31/hal_backports/esp_gpio_reserve.c
new file mode 100644
index 00000000000..7761afa8cfd
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/hal_backports/esp_gpio_reserve.c
@@ -0,0 +1,60 @@
+/*
+ * SPDX-FileCopyrightText: 2023-2024 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <nuttx/irq.h>
+#include <nuttx/spinlock.h>
+
+#include "soc/soc_caps.h"
+#include "esp_types.h"
+#include "esp_bit_defs.h"
+#include "esp_private/esp_gpio_reserve.h"
+
+/* RV32 has no lock-free 64-bit atomics, and the Espressif toolchain does not
+ * ship libatomic.  Protect the 62-bit GPIO reservation mask with a NuttX
+ * spinlock so this remains SMP-safe without pulling __atomic_*_8 helpers into
+ * the kernel image.
+ */
+
+static spinlock_t s_reserved_pin_lock = SP_UNLOCKED;
+static uint64_t s_reserved_pin_mask = ~(SOC_GPIO_VALID_GPIO_MASK);
+
+uint64_t esp_gpio_reserve(uint64_t gpio_mask)
+{
+  irqstate_t flags;
+  uint64_t old_mask;
+
+  flags = spin_lock_irqsave(&s_reserved_pin_lock);
+  old_mask = s_reserved_pin_mask;
+  s_reserved_pin_mask |= gpio_mask;
+  spin_unlock_irqrestore(&s_reserved_pin_lock, flags);
+
+  return old_mask;
+}
+
+uint64_t esp_gpio_revoke(uint64_t gpio_mask)
+{
+  irqstate_t flags;
+  uint64_t old_mask;
+
+  flags = spin_lock_irqsave(&s_reserved_pin_lock);
+  old_mask = s_reserved_pin_mask;
+  s_reserved_pin_mask &= ~gpio_mask;
+  spin_unlock_irqrestore(&s_reserved_pin_lock, flags);
+
+  return old_mask;
+}
+
+bool esp_gpio_is_reserved(uint64_t gpio_mask)
+{
+  irqstate_t flags;
+  bool reserved;
+
+  flags = spin_lock_irqsave(&s_reserved_pin_lock);
+  reserved = (s_reserved_pin_mask & gpio_mask) != 0;
+  spin_unlock_irqrestore(&s_reserved_pin_lock, flags);
+
+  return reserved;
+}
diff --git a/arch/risc-v/src/esp32s31/hal_backports/esp_sleep_pd_config_stub.c b/arch/risc-v/src/esp32s31/hal_backports/esp_sleep_pd_config_stub.c

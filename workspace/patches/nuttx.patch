+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""The TX ISR must finish hardware/state cleanup before waking another hart."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "arch/risc-v/src/common/espressif/esp_rmt.c"
+    source = (subprocess.check_output(["git", "show", f"{args.revision}:{filename}"],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    if 'static void IRAM_ATTR rmt_tx_interrupt' in source:
+        from test_esp_rmt_tx_lifecycle import main as lifecycle
+        lifecycle(source)
+        return
+    body = source.split("  /* Tx end interrupt */", 1)[1].split(
+        "  /* Tx thres interrupt */", 1)[0]
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#define RMT_LL_EVENT_TX_DONE(ch) (1u << (ch))
+typedef struct {
+  int tx_sem;
+  void *tx_data;
+  unsigned tx_len_rem, tx_offset, tx_sub_len;
+  void *sample_cur;
+} rmt_obj_t;
+typedef struct { void *regs; } rmt_hal_context_t;
+static struct { rmt_hal_context_t hal; } g_rmtdev_common;
+static rmt_obj_t objects[4], *p_rmt_obj[4];
+static uint32_t pending, reset;
+static unsigned posts;
+static uint32_t rmt_ll_get_tx_end_interrupt_status(void *dev)
+{
+  assert(dev);
+  return pending;
+}
+static void rmt_ll_tx_reset_pointer(void *dev, unsigned channel)
+{
+  assert(dev && channel < 4);
+  reset |= 1u << channel;
+}
+static void rmt_ll_clear_interrupt_status(void *dev, unsigned mask)
+{
+  assert(dev);
+  pending &= ~mask;
+}
+static void nxsem_post(int *sem)
+{
+  unsigned ch;
+  for (ch = 0; ch < 4; ch++) { if (sem == &objects[ch].tx_sem) { break; } }
+  assert(ch < 4 && (reset & (1u << ch)) && !(pending & (1u << ch)));
+  rmt_obj_t *obj = &objects[ch];
+  assert(!obj->tx_data && !obj->tx_len_rem && !obj->tx_offset &&
+         !obj->tx_sub_len && !obj->sample_cur);
+  /* Model the woken writer immediately preparing its next request. */
+  obj->tx_len_rem = 7;
+  posts++;
+}
+static void run(rmt_hal_context_t *hal)
+{
+  uint32_t status;
+  uint8_t channel;
+'''
+    fixture += body + '}\n'
+    fixture += r'''
+int main(void)
+{
+  g_rmtdev_common.hal.regs = &objects;
+  for (unsigned ch = 0; ch < 4; ch++) {
+    objects[ch] = (rmt_obj_t){0, &objects, 1, 2, 3, &objects};
+    p_rmt_obj[ch] = ch == 2 ? NULL : &objects[ch];
+  }
+  pending = 0xd;
+  run(&g_rmtdev_common.hal);
+  assert(posts == 2 && !pending && reset == 9);
+  assert(objects[0].tx_len_rem == 7 && objects[3].tx_len_rem == 7);
+  puts("ESP_RMT_COMPLETION=PASS cleanup/ack before cross-hart wake");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="esp-rmt-completion-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        str(path / "test.c"), "-o", str(path / "test")],
+                       check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

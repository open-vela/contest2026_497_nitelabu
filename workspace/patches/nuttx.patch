+
+/* Interfaces provided by newer NuttX Espressif IRQ code and consumed by the
+ * locked HAL platform adapter.  The S31 compatibility implementation maps
+ * them onto this openvela tree's IRQ allocator.
+ */
+
+struct intr_adapter_to_nuttx
+{
+  intr_handler_t handler;
+  FAR void *arg;
+};
+
+int esp_setup_irq_with_flags_intrstatus(int source, int flags,
+                                        uint32_t intrstatusreg,
+                                        uint32_t intrstatusmask,
+                                        xcpt_t handler, FAR void *arg);
+int esp_get_cpuint(int cpu, int irq);
+intr_handle_t esp_get_handle(int cpu, int irq);
+
+int esp32s31_hal_nxtask_init(FAR struct tcb_s *tcb, FAR const char *name,
+                             int priority, FAR void *stack_addr,
+                             int stack_size, main_t entry,
+                             FAR char * const argv[],
+                             FAR char * const envp[], FAR void *unused);
+
+#define ESP32S31_NXTASK_INIT_NATIVE(tcb, name, entry, actions, attr, argv, \
+                                    envp)                              \
+  (nxtask_init)(tcb, name, entry, actions, attr, argv, envp)
+#define ESP32S31_NXTASK_INIT_INVALID(...) (-EINVAL)
+#define ESP32S31_NXTASK_INIT_COMPAT(tcb, name, priority, stack_addr, \
+                                    stack_size, entry, argv, envp, unused) \
+  esp32s31_hal_nxtask_init(tcb, name, priority, stack_addr, stack_size, \
+                           entry, argv, envp, unused)
+#define ESP32S31_NXTASK_INIT_SELECT(_1, _2, _3, _4, _5, _6, _7, _8, _9, \
+                                    selected, ...) selected
+#define nxtask_init(...)                                                \
+  ESP32S31_NXTASK_INIT_SELECT(__VA_ARGS__, ESP32S31_NXTASK_INIT_COMPAT, \
+                              ESP32S31_NXTASK_INIT_INVALID,             \
+                              ESP32S31_NXTASK_INIT_NATIVE)(__VA_ARGS__)
+
+#endif /* __ASSEMBLY__ */

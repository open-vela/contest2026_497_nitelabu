+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check IRQ matrix disconnect encoding with the actual NuttX helper.
+
+The S31 S-mode HAL maps logical inputs to hardware inputs with a +16 offset;
+disconnect must bypass that translation.  Other targets retain the ROM API.
+This host register model does not replace a CLIC hardware regression.
+"""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    root = Path(__file__).resolve().parent.parent
+    source = (root / "arch/risc-v/src/common/espressif/esp_irq.c").read_text()
+    for name in ("esp_cpuint_initialize", "esp_teardown_irq"):
+        assert "esp_cpuint_unmap(source);" in definition(source, name)
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#define ESP_NSOURCES 169
+#define ETS_INVALID_INUM 0
+#define NO_CPUINT ETS_INVALID_INUM
+#define PRO_CPU_NUM 0
+static uint32_t matrix[ESP_NSOURCES];
+static uint32_t matrix1[ESP_NSOURCES];
+static unsigned routes;
+#define DR_REG_INTERRUPT_CORE0_BASE ((uintptr_t)matrix)
+#define DR_REG_INTERRUPT_CORE1_BASE ((uintptr_t)matrix1)
+#define REG_SET_BITS(r, b, m) \
+  (*(uint32_t *)(r) = (*(uint32_t *)(r) & ~(uint32_t)(m)) | (b))
+static void esp_rom_route_intr_matrix(int cpu, unsigned source, unsigned input)
+{
+  assert(cpu == PRO_CPU_NUM && source < ESP_NSOURCES);
+  routes++;
+#if defined(CONFIG_ARCH_CHIP_ESP32S31) && defined(CONFIG_ARCH_USE_S_MODE)
+  input += 16; /* Locked HAL interrupt_clic.c logical-to-CLIC translation. */
+#endif
+  REG_SET_BITS(DR_REG_INTERRUPT_CORE0_BASE + 4 * source, input, 0x3f);
+}
+'''
+    fixture += definition(source, "esp_cpuint_unmap")
+    fixture += r'''
+int main(void)
+{
+  for (unsigned source = 0; source < ESP_NSOURCES; source++) {
+    matrix[source] = UINT32_C(0xa55a0300) | (source & 0x3f);
+    matrix1[source] = UINT32_C(0x5aa50300) | (source & 0x3f);
+  }
+  for (unsigned source = 0; source < ESP_NSOURCES; source++) {
+    esp_cpuint_unmap(source);
+    assert(matrix[source] == UINT32_C(0xa55a0300));
+#if defined(CONFIG_ARCH_CHIP_ESP32S31) && defined(CONFIG_ARCH_USE_S_MODE)
+    assert(matrix1[source] == UINT32_C(0x5aa50300));
+#else
+    assert(matrix1[source] == (UINT32_C(0x5aa50300) | (source & 0x3f)));
+#endif
+    for (unsigned next = source + 1; next < ESP_NSOURCES; next++) {
+      assert(matrix[next] == (UINT32_C(0xa55a0300) | (next & 0x3f)));
+      assert(matrix1[next] == (UINT32_C(0x5aa50300) | (next & 0x3f)));
+    }
+  }
+#if defined(CONFIG_ARCH_CHIP_ESP32S31) && defined(CONFIG_ARCH_USE_S_MODE)
+  assert(routes == 0);
+  esp_rom_route_intr_matrix(0, 33, 0);
+  assert((matrix[33] & 0x3f) == 16); /* Real input 0 is not disabled. */
+  esp_cpuint_unmap(33);
+  assert((matrix[33] & 0x3f) == 0 && routes == 1);
+#else
+  assert(routes == ESP_NSOURCES);
+#endif
+  puts("ESP_IRQ_UNMAP=PASS 169 sources; register fields/neighbours preserved");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-irq-unmap-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        for flags in ([], ["-DCONFIG_ARCH_USE_S_MODE"],
+                      ["-DCONFIG_ARCH_CHIP_ESP32S31"],
+                      ["-DCONFIG_ARCH_CHIP_ESP32S31", "-DCONFIG_ARCH_USE_S_MODE"]):
+            subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                            "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                            *flags, str(path / "test.c"), "-o", str(path / "test")],
+                           check=True)
+            subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

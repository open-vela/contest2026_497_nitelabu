new file mode 100644
index 00000000000..7c78c998559
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/hal_backports/include/esp32s31_phy_timer.h
@@ -0,0 +1,20 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/hal_backports/include/esp32s31_phy_timer.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#ifndef __ARCH_RISCV_SRC_ESP32S31_HAL_BACKPORTS_INCLUDE_ESP32S31_PHY_TIMER_H
+#define __ARCH_RISCV_SRC_ESP32S31_HAL_BACKPORTS_INCLUDE_ESP32S31_PHY_TIMER_H
+
+/* Apply only to the locked PHY PLL tracking source.  This is not a general
+ * replacement for the IDF timer API: the PHY owns one task-dispatch periodic
+ * timer, serialized by its modem lock, without light-sleep event skipping.
+ */

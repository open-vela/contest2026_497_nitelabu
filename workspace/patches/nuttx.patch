+/****************************************************************************
+ * Name: esp_i2c_transfer_buffered
+ *
+ * Description:
+ *   Keep descriptors and payloads in the shared kernel mapping while the
+ *   caller sleeps.  An interrupt can run on another hart or after switching
+ *   to a different user address environment.  User virtual addresses cannot
+ *   be dereferenced by that interrupt, even with a device spinlock held.
+ *
+ ****************************************************************************/
+
+#if defined(CONFIG_ARCH_CHIP_ESP32S31) && defined(CONFIG_ARCH_ADDRENV)
+static int esp_i2c_transfer_buffered(struct i2c_master_s *dev,
+                                    struct i2c_msg_s *msgs, int count)
+{
+  struct i2c_msg_s *copy;
+  uint8_t **original;
+  uint8_t *buffer;
+  uint8_t *data;
+  size_t size = 0;
+  int ret;
+  int i;
+
+  /* The lower half's message index is eight bits. */
+
+  if (msgs == NULL || count <= 0 || count > UINT8_MAX + 1)
+    {
+      return -EINVAL;
+    }
+
+  copy = kmm_malloc(count * (sizeof(*copy) + sizeof(*original)));
+  if (copy == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  memcpy(copy, msgs, count * sizeof(*copy));
+  original = (uint8_t **)(copy + count);
+  for (i = 0; i < count; i++)
+    {
+      if (copy[i].length < 0 || copy[i].frequency == 0 ||
+          (copy[i].length > 0 && copy[i].buffer == NULL))
+        {
+          ret = -EINVAL;
+          goto out;
+        }
+
+      if ((size_t)copy[i].length > SIZE_MAX - size)
+        {
+          ret = -EOVERFLOW;
+          goto out;
+        }
+
+      size += copy[i].length;
+      original[i] = copy[i].buffer;
+    }
+
+  data = kmm_zalloc(size > 0 ? size : 1);
+  if (data == NULL)
+    {
+      ret = -ENOMEM;
+      goto out;
+    }
+
+  buffer = data;
+  for (i = 0; i < count; i++)
+    {
+      copy[i].buffer = buffer;
+      if ((copy[i].flags & I2C_M_READ) == 0 && copy[i].length > 0)
+        {
+          memcpy(buffer, original[i], copy[i].length);
+        }
+
+      buffer += copy[i].length;
+    }
+
+  ret = esp_i2c_transfer(dev, copy, count);
+  if (ret == OK)
+    {
+      /* The issuing task's address environment is active again here. */
+
+      for (i = 0; i < count; i++)
+        {
+          if ((copy[i].flags & I2C_M_READ) != 0 && copy[i].length > 0)
+            {
+              memcpy(original[i], copy[i].buffer, copy[i].length);
+            }
+        }
+    }
+
+  kmm_free(data);
+out:
+  kmm_free(copy);
+  return ret;
+}
+#endif
+

diff --git a/arch/risc-v/src/esp32s31/esp32s31_wifi_os_compat.c b/arch/risc-v/src/esp32s31/esp32s31_wifi_os_compat.c
new file mode 100644
index 00000000000..6d8c8aea2ed
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_wifi_os_compat.c
@@ -0,0 +1,142 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_wifi_os_compat.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <spawn.h>
+#include <stdint.h>
+
+#include <nuttx/irq.h>
+#include <nuttx/sched.h>
+
+#include "esp_intr_alloc.h"
+#include "platform/os.h"
+
+#include "esp32s31_wifi_os_compat.h"
+
+/* The current common IRQ implementation keeps its maps private.  Mirror only
+ * the wireless allocations made through this compatibility entry point.
+ */
+
+static int16_t g_wifi_cpuint[NR_IRQS];
+static esp_os_intr_handle_t g_wifi_handle[NR_IRQS];
+static bool g_wifi_maps_initialized;
+
+static void esp32s31_wifi_maps_initialize(void)
+{
+  int irq;
+
+  if (!g_wifi_maps_initialized)
+    {
+      for (irq = 0; irq < NR_IRQS; irq++)
+        {
+          g_wifi_cpuint[irq] = -1;
+          g_wifi_handle[irq].irq = irq;
+          g_wifi_handle[irq].intr_handle = NULL;
+        }
+
+      g_wifi_maps_initialized = true;
+    }
+}
+
+int esp_setup_irq_with_flags_intrstatus(int source, int flags,
+                                        uint32_t intrstatusreg,
+                                        uint32_t intrstatusmask,
+                                        xcpt_t handler, FAR void *arg)
+{
+  irq_priority_t priority = ESP_IRQ_PRIORITY_DEFAULT;
+  int type = ESP_IRQ_TRIGGER_LEVEL;
+  int cpuint;
+  int irq;
+  int level;
+  int ret;
+
+  /* The S31 Wi-Fi path uses a dedicated interrupt.  Status-register and
+   * shared-vector filtering are therefore not required by this allocator.
+   */
+
+  UNUSED(intrstatusreg);
+  UNUSED(intrstatusmask);
+
+  for (level = 1; level <= 7; level++)
+    {
+      if ((flags & (1 << level)) != 0)
+        {
+          priority = (irq_priority_t)level;
+          break;
+        }
+    }
+
+  if ((flags & ESP_INTR_FLAG_EDGE) != 0)
+    {
+      type = ESP_IRQ_TRIGGER_EDGE;
+    }
+
+  if ((flags & ESP_INTR_FLAG_IRAM) != 0)
+    {
+      type |= ESP_IRQ_IRAM;
+    }
+
+  cpuint = esp_setup_irq(source, priority, type);
+  if (cpuint < 0)
+    {
+      return cpuint;
+    }
+
+  irq = ESP_SOURCE2IRQ(source);
+  ret = irq_attach(irq, handler, arg);
+  if (ret < 0)
+    {
+      esp_teardown_irq(source, cpuint);
+      return ret;
+    }
+
+  esp32s31_wifi_maps_initialize();
+  g_wifi_cpuint[irq] = cpuint;
+  return cpuint;
+}
+
+int esp_get_cpuint(int cpu, int irq)
+{
+  UNUSED(cpu);
+  esp32s31_wifi_maps_initialize();
+  return irq >= 0 && irq < NR_IRQS ? g_wifi_cpuint[irq] : -EINVAL;
+}
+
+intr_handle_t esp_get_handle(int cpu, int irq)
+{
+  UNUSED(cpu);
+  esp32s31_wifi_maps_initialize();
+
+  if (irq < 0 || irq >= NR_IRQS || g_wifi_cpuint[irq] < 0)
+    {
+      return NULL;
+    }
+
+  return (intr_handle_t)&g_wifi_handle[irq];
+}
+
+int esp32s31_hal_nxtask_init(FAR struct tcb_s *tcb, FAR const char *name,
+                             int priority, FAR void *stack_addr,
+                             int stack_size, main_t entry,
+                             FAR char * const argv[],
+                             FAR char * const envp[], FAR void *unused)
+{
+  posix_spawnattr_t attr;
+  int ret;
+
+  UNUSED(unused);
+
+  posix_spawnattr_init(&attr);
+  posix_spawnattr_setstacksize(&attr, (size_t)stack_size);
+  posix_spawnattr_setstackaddr(&attr, stack_addr);
+  posix_spawnattr_setpriority(&attr, priority);
+
+  ret = (nxtask_init)(tcb, name, entry, NULL, &attr, argv, envp);
+  posix_spawnattr_destroy(&attr);
+  return ret;
+}
diff --git a/arch/risc-v/src/esp32s31/esp32s31_wifi_task.c b/arch/risc-v/src/esp32s31/esp32s31_wifi_task.c
new file mode 100644
index 00000000000..4b7eefcb92c
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_wifi_task.c
@@ -0,0 +1,158 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_wifi_task.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <assert.h>
+
+#include <nuttx/kmalloc.h>
+#include <nuttx/sched.h>
+#include <nuttx/semaphore.h>
+#include <nuttx/spinlock.h>
+
+#include "esp32s31_wifi_task.h"
+#include "esp32s31_wifi_event.h"
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+/* In this kernel-build ABI pthread keys belong to an application, and its
+ * TLS is user accessible.  Vendor IPC semaphores must instead remain in
+ * kernel memory, with one instance per calling thread.  Do not store kernel
+ * destructors or semaphore pointers in application-owned TLS.
+ */
+
+struct esp32s31_wifi_task_s
+{
+  struct esp32s31_wifi_task_s *next;
+  struct tcb_s *tcb;
+  sem_t sem;
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static struct esp32s31_wifi_task_s *g_wifi_tasks;
+static spinlock_t g_wifi_tasks_lock = SP_UNLOCKED;
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+void __real_up_release_stack(struct tcb_s *tcb, int ttype);
+void __wrap_up_release_stack(struct tcb_s *tcb, int ttype);
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static struct esp32s31_wifi_task_s *wifi_task_find(struct tcb_s *tcb)
+{
+  struct esp32s31_wifi_task_s *entry;
+
+  for (entry = g_wifi_tasks; entry != NULL; entry = entry->next)
+    {
+      if (entry->tcb == tcb)
+        {
+          return entry;
+        }
+    }
+
+  return NULL;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void *esp32s31_wifi_thread_semphr_get(void)
+{
+  struct tcb_s *tcb = this_task();
+  struct esp32s31_wifi_task_s *entry;
+  struct esp32s31_wifi_task_s *allocated;
+  irqstate_t flags;
+
+  DEBUGASSERT(!up_interrupt_context());
+  flags = spin_lock_irqsave(&g_wifi_tasks_lock);
+  entry = wifi_task_find(tcb);
+  spin_unlock_irqrestore(&g_wifi_tasks_lock, flags);
+  if (entry != NULL)
+    {
+      return &entry->sem;
+    }
+
+  allocated = kmm_zalloc(sizeof(*allocated));
+  if (allocated == NULL)
+    {
+      return NULL;
+    }
+
+  if (nxsem_init(&allocated->sem, 0, 0) < 0)
+    {
+      kmm_free(allocated);
+      return NULL;
+    }
+
+  allocated->tcb = tcb;
+  flags = spin_lock_irqsave(&g_wifi_tasks_lock);
+  entry = wifi_task_find(tcb);
+  if (entry == NULL)
+    {
+      allocated->next = g_wifi_tasks;
+      g_wifi_tasks = allocated;
+      entry = allocated;
+    }
+
+  spin_unlock_irqrestore(&g_wifi_tasks_lock, flags);
+  if (entry != allocated)
+    {
+      nxsem_destroy(&allocated->sem);
+      kmm_free(allocated);
+    }
+
+  return &entry->sem;
+}
+
+/* This target-local link wrapper runs for normal exit, cancellation and
+ * failed task setup, before the stack/TCB can be reused.  Unlike a PID
+ * cache, it cannot leave an old semaphore attached to a new thread.
+ * The release path may run with interrupts disabled: use delayed freeing.
+ */
+
+void __wrap_up_release_stack(struct tcb_s *tcb, int ttype)
+{
+  struct esp32s31_wifi_task_s **link;
+  struct esp32s31_wifi_task_s *entry = NULL;
+  irqstate_t flags;
+
+  esp32s31_wifi_event_task_delete(tcb);
+
+  flags = spin_lock_irqsave(&g_wifi_tasks_lock);
+  for (link = &g_wifi_tasks; *link != NULL; link = &(*link)->next)
+    {
+      if ((*link)->tcb == tcb)
+        {
+          entry = *link;
+          *link = entry->next;
+          break;
+        }
+    }
+
+  spin_unlock_irqrestore(&g_wifi_tasks_lock, flags);
+  if (entry != NULL)
+    {
+      nxsem_destroy(&entry->sem);
+      kmm_delayfree(entry);
+    }
+
+  __real_up_release_stack(tcb, ttype);
+}

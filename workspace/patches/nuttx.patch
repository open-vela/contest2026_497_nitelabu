index 00000000000..2b62f18cd1e
--- /dev/null
+++ b/tools/test_esp32s31_fpu_context.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the actual FPU assembly's save/restore decisions on the host.
+
+The small interpreter models integer control flow and register-array copies,
+not RISC-V floating-point execution.  Real builds and board tests are still
+required.  --revision HEAD is a regression negative before the S31 fix.
+"""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import unittest
+
+
+MASK = 0x6000
+INITIAL, CLEAN, DIRTY = 0x2000, 0x4000, 0x6000
+SOURCE = ""
+
+
+def program(name, s31, lazy):
+    match = re.search(r"^" + name + r":\n(.*?\n1:\n\s+ret)",
+                      SOURCE, re.MULTILINE | re.DOTALL)
+    if not match:
+        raise AssertionError(f"Cannot extract actual assembly: {name}")
+    command = ["cpp", "-P", "-DMSTATUS_FS=0x6000",
+               "-DMSTATUS_FS_INIT=0x2000", "-DMSTATUS_FS_CLEAN=0x4000",
+               "-DMSTATUS_FS_DIRTY=0x6000"]
+    if s31:
+        command.append("-DCONFIG_ARCH_CHIP_ESP32S31=1")
+    if lazy:
+        command.append("-DCONFIG_ARCH_LAZYFPU=1")
+    return subprocess.check_output(command + ["-"], input=match[1],
+                                   text=True).splitlines()
+
+
+def execute(code, status, hardware, frame):
+    registers = {}
+
+    def immediate(text):
+        return (~int(text[1:], 0) if text.startswith("~") else int(text, 0)) & 0xffffffff
+
+    for line in code:
+        words = re.split(r"[\s,]+", line.strip())
+        op, operands = words[0], words[1:]
+        if not op or op == "1:":
+            continue
+        if op == "ret":
+            break
+        if op == "li":
+            registers[operands[0]] = immediate(operands[1])
+        elif op == "REGLOAD":
+            assert operands[1] == "REG_INT_CTX(a0)"
+            registers[operands[0]] = status
+        elif op == "REGSTORE":
+            assert operands[1] == "REG_INT_CTX(a0)"
+            status = registers[operands[0]]
+        elif op in ("and", "or"):
+            dst, left, right = operands
+            registers[dst] = (registers[left] & registers[right] if op == "and"
+                              else registers[left] | registers[right])
+        elif op in ("bne", "blt", "ble"):
+            left, right, target = operands
+            assert target == "1f"
+            # Branch operands in these functions are positive FS masks.
+            a, b = registers[left], registers[right]
+            if {"bne": a != b, "blt": a < b, "ble": a <= b}[op]:
+                break
+        elif op == "riscv_savefpu":
+            assert operands == ["a1"]
+            frame[:] = hardware
+        elif op == "riscv_loadfpu":
+            assert operands == ["a1"]
+            hardware[:] = frame
+        else:
+            raise AssertionError(f"Unmodeled assembly instruction: {line}")
+    return status
+
+
+class ContextTests(unittest.TestCase):
+    def test_eager_clean_fresh_frame(self):
+        hardware = list(range(32)) + [0x08]
+        frame = [0xc8] * 33  # Reserved FRM=6, as observed on the board.
+        status = execute(program("riscv_savefpu", True, False),
+                         CLEAN | 0x40120, hardware, frame)
+        self.assertEqual(frame, hardware)
+        self.assertEqual(status, CLEAN | 0x40120)  # Preserve privilege/IRQ bits.
+
+    def test_eager_unused_policy_unchanged(self):
+        hardware = [0xc8] * 33
+        for state in (0, INITIAL):
+            frame = [0] * 33
+            execute(program("riscv_savefpu", True, False),
+                    state, hardware, frame)
+            self.assertEqual(frame, [0] * 33)
+            execute(program("riscv_restorefpu", True, False),
+                    state, hardware, frame)
+            self.assertEqual(hardware, [0xc8] * 33)
+
+    def test_eager_relocated_frames(self):
+        save = program("riscv_savefpu", True, False)
+        restore = program("riscv_restorefpu", True, False)
+        for state in (CLEAN, DIRTY):
+            for iteration in range(8):
+                expected = [iteration * 32 + i for i in range(32)] + [0x08]
+                hardware = expected.copy()
+                frame = [0xe0] * 33
+                status = execute(save, state, hardware, frame)
+                hardware[:] = [0x40] * 33  # Another task uses the FPU.
+                execute(restore, status, hardware, frame)
+                self.assertEqual(hardware, expected)
+
+    def test_other_chip_and_lazy_decisions_unchanged(self):
+        for s31, lazy in ((False, False), (False, True), (True, True)):
+            save = program("riscv_savefpu", s31, lazy)
+            restore = program("riscv_restorefpu", s31, lazy)
+            for state in (0, INITIAL, CLEAN, DIRTY):
+                hardware, frame = [1] * 33, [2] * 33
+                execute(save, state, hardware, frame)
+                self.assertEqual(frame, [1 if state == DIRTY else 2] * 33)
+                hardware, frame = [1] * 33, [2] * 33
+                execute(restore, state, hardware, frame)
+                self.assertEqual(hardware, [2 if state > INITIAL else 1] * 33)
+
+
+def main():
+    global SOURCE
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "arch/risc-v/src/common/riscv_fpu.S"
+    SOURCE = (subprocess.check_output(["git", "show", f"{args.revision}:{filename}"],
+                                     cwd=root, text=True) if args.revision
+              else (root / filename).read_text())
+    suite = unittest.defaultTestLoader.loadTestsFromTestCase(ContextTests)
+    if not unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful():
+        raise SystemExit(1)
+    print("S31_FPU_CONTEXT_CONTROL=PASS clean-fresh/unused-policy/relocated/lazy-isolation")
+
+
+if __name__ == "__main__":
+    main()

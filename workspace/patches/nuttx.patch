@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise actual HR timer worker/stop code with host queue/lock mocks.
+
+--revision HEAD reproduces the old recursive-lock failure before committing.
+Hardware ISR timing and SMP stress still require a board regression.
+"""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def definition(source, name):
+    match = re.search(r"^[^\n;]*\b" + name + r"\([^;]*?\)\s*\{",
+                      source, re.MULTILINE)
+    if match is None:
+        raise ValueError(name)
+    end = match.end()
+    depth = 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[match.start():end]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "arch/risc-v/src/common/espressif/esp_hr_timer.c"
+    source = (subprocess.check_output(
+        ["git", "show", f"{args.revision}:{filename}"], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <setjmp.h>
+#include <stdio.h>
+#define IRAM_ATTR
+#define DEBUGASSERT assert
+#define VERIFY(x) assert((x) == 0)
+#define HR_TIMER_REPEAT 1
+#define SYSTIMER_ALARM_ESPTIMER 2
+#define container_of(p,t,m) ((t *)((char *)(p) - offsetof(t,m)))
+typedef int irqstate_t;
+struct list_node { struct list_node *prev, *next; };
+static void list_init(struct list_node *h) { h->prev = h->next = h; }
+static bool list_is_empty(struct list_node *h) { return h->next == h; }
+static void list_delete(struct list_node *n)
+{ n->prev->next = n->next; n->next->prev = n->prev; list_init(n); }
+static void list_add(struct list_node *h, struct list_node *n)
+{ n->next = h->next; n->prev = h; h->next->prev = n; h->next = n; }
+enum esp_hr_timer_state_e { HR_TIMER_IDLE, HR_TIMER_READY,
+                           HR_TIMER_TIMEOUT, HR_TIMER_DELETE };
+struct esp_hr_timer_s {
+  uint64_t timeout, alarm; void (*callback)(void *); void *arg;
+  uint16_t flags; enum esp_hr_timer_state_e state; struct list_node list;
+};
+struct esp_hr_timer_context_s {
+  int toutsem, lock, hal; struct list_node runlist, toutlist;
+};
+static struct esp_hr_timer_context_s g_hr_timer_context;
+static int locked, waits, callbacks, rearms, frees, action;
+static jmp_buf done;
+static int spin_lock_irqsave(int *lock)
+{ (void)lock; assert(!locked); locked = 1; return 0; }
+static void spin_unlock_irqrestore(int *lock, int flags)
+{ (void)lock; (void)flags; assert(locked); locked = 0; }
+static int nxsem_wait_uninterruptible(int *sem)
+{ (void)sem; assert(!locked); if (waits++) longjmp(done, 1); return 0; }
+static void kmm_free(void *p) { (void)p; assert(!locked); frees++; }
+static void systimer_hal_set_alarm_target(int *h, int id, uint64_t alarm)
+{ (void)h; (void)id; (void)alarm; assert(locked); }
+static void esp_hr_timer_start_nolock(struct esp_hr_timer_s *t,
+                                    uint64_t timeout, bool repeat)
+{ (void)timeout; assert(locked && repeat); t->state = HR_TIMER_READY; rearms++; }
+static void esp_hr_timer_start(struct esp_hr_timer_s *t,
+                              uint64_t timeout, bool repeat)
+{ int f = spin_lock_irqsave(&g_hr_timer_context.lock);
+  esp_hr_timer_start_nolock(t, timeout, repeat);
+  spin_unlock_irqrestore(&g_hr_timer_context.lock, f); }
+'''
+    fixture += definition(source, "esp_hr_timer_thread")
+    fixture += definition(source, "esp_hr_timer_stop_nolock")
+    fixture += r'''
+static void callback(void *arg)
+{
+  struct esp_hr_timer_s *t = arg;
+  assert(!locked); callbacks++;
+  if (action == 1) { t->state = HR_TIMER_DELETE;
+    list_add(&g_hr_timer_context.toutlist, &t->list); }
+  if (action == 2) t->state = HR_TIMER_READY;
+}
+static void prepare(struct esp_hr_timer_s *t)
+{
+  list_init(&g_hr_timer_context.runlist);
+  list_init(&g_hr_timer_context.toutlist);
+  list_init(&t->list);
+  locked = waits = callbacks = rearms = frees = 0;
+  t->flags = HR_TIMER_REPEAT; t->state = HR_TIMER_TIMEOUT;
+  t->callback = callback; t->arg = t;
+  list_add(&g_hr_timer_context.toutlist, &t->list);
+}
+int main(void)
+{
+  struct esp_hr_timer_s timer = {0};
+  for (action = 0; action < 3; action++) {
+    prepare(&timer);
+    if (!setjmp(done)) esp_hr_timer_thread(0, NULL);
+    assert(callbacks == 1 && rearms == (action == 0));
+    assert(frees == (action == 1) && !locked);
+    assert(list_is_empty(&g_hr_timer_context.toutlist));
+  }
+  prepare(&timer);
+  locked = 1;
+  esp_hr_timer_stop_nolock(&timer);
+  assert(callbacks == 0 && timer.state == HR_TIMER_IDLE && !timer.flags);
+  assert(list_is_empty(&g_hr_timer_context.toutlist));
+  locked = 0;
+  puts("ESP_HR_TIMER_LIFECYCLE=PASS periodic/delete/restart/cancel");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="esp-hr-timer-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-Wno-unused-function", "-Wno-unused-parameter",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        str(path / "test.c"), "-o", str(path / "test")],
+                       check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

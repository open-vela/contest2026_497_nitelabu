+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Model S31 I2C recovery completion, timeout and transfer/reset exclusion."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    root = Path(__file__).resolve().parent.parent
+    source = (root / "arch/risc-v/src/common/espressif/esp_i2c.c").read_text()
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#define CONFIG_ARCH_CHIP_ESP32S31 1
+#define DEBUGASSERT assert
+#define OK 0
+#define I2CSTATE_IDLE 0
+#define I2C_SCL_CYC_NUM_DEF 9
+typedef int irqstate_t;
+struct i2c_master_s;
+struct context { void *dev; };
+struct esp_i2c_priv_s {
+  struct context *ctx;
+  int refs, lock, i2cstate, msgid, bytes;
+  bool ready_read;
+  int slock, sem_isr;
+};
+static int locked, critical, lock_error, busy;
+static unsigned delays, started, disabled, updates, resets;
+static int nxmutex_lock(int *lock)
+{
+  (void)lock;
+  assert(!locked && !critical);
+  if (lock_error) { return lock_error; }
+  locked = 1;
+  return 0;
+}
+static void nxmutex_unlock(int *lock)
+{
+  (void)lock;
+  assert(locked && !critical);
+  locked = 0;
+}
+static irqstate_t spin_lock_irqsave(int *lock)
+{
+  (void)lock;
+  assert(locked && !critical);
+  critical = 1;
+  return 42;
+}
+static void spin_unlock_irqrestore(int *lock, irqstate_t state)
+{
+  (void)lock;
+  assert(critical && state == 42);
+  critical = 0;
+}
+static void nxsem_reset(int *sem, int value)
+{
+  assert(locked && critical && value == 0);
+  *sem = value;
+}
+static void esp_i2c_intr_disable(struct esp_i2c_priv_s *priv)
+{
+  assert(priv && locked && critical);
+}
+static void esp_i2c_reset_fsmc(struct esp_i2c_priv_s *priv)
+{
+  assert(priv && locked && critical);
+  resets++;
+}
+static void i2c_ll_master_clr_bus(void *dev, unsigned pulses, bool enable)
+{
+  assert(dev && locked && !critical);
+  if (enable) { assert(pulses == 9); started++; }
+  else { assert(pulses == 0); disabled++; }
+}
+static bool i2c_ll_master_is_bus_clear_done(void *dev)
+{
+  assert(dev && locked && !critical);
+  return busy-- > 0; /* Locked HAL returns true while recovery is busy. */
+}
+static void up_udelay(unsigned delay)
+{
+  assert(delay == 10 && locked && !critical);
+  delays++;
+}
+static void i2c_ll_update(void *dev)
+{
+  assert(dev && locked && !critical);
+  updates++;
+}
+'''
+    for name in ("esp_i2c_clear_bus", "esp_i2c_reset"):
+        fixture += definition(source, name)
+    fixture += r'''
+int main(void)
+{
+  struct context ctx = { &ctx };
+  struct esp_i2c_priv_s priv = { &ctx, 1, 0, 3, 2, 15, true, 0, 1 };
+  busy = 2;
+  assert(esp_i2c_reset((struct i2c_master_s *)&priv) == 0);
+  assert(delays == 2 && started == 1 && disabled == 0 && updates == 1);
+  assert(!priv.i2cstate && !priv.msgid && !priv.bytes && !priv.ready_read);
+  assert(priv.sem_isr == 0);
+  assert(!locked && !critical && resets == 1);
+  delays = 0;
+  busy = 2000;
+  assert(esp_i2c_reset((struct i2c_master_s *)&priv) == -ETIMEDOUT);
+  assert(delays == 1000 && disabled == 1 && updates == 2 && resets == 2);
+  assert(!locked && !critical);
+  lock_error = -EINTR;
+  assert(esp_i2c_reset((struct i2c_master_s *)&priv) == -EINTR);
+  assert(resets == 2 && started == 2 && !locked && !critical);
+  puts("S31_I2C_RESET=PASS completion/timeout/lock-failure; no masked polling");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-i2c-reset-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        str(path / "test.c"), "-o", str(path / "test")],

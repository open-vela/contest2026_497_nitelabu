+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise both arp_out queue-handoff blocks when ARP queueing fails."""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'net/arp/arp_out.c'
+    source = (subprocess.check_output(['git', 'show', f'{args.revision}:{filename}'],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    blocks = re.findall(r'#ifdef CONFIG_NET_ARP_SEND_QUEUE\n(.*?)#(?:else|endif)',
+                        source, re.S)
+    assert len(blocks) == 2 and all('arp_queue_iob(' in block for block in blocks)
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+struct iob_s { int id; };
+struct net_driver_s { struct iob_s *d_iob; void *d_buf; unsigned d_len; };
+static struct iob_s item, *queued;
+static int queue_result, freed, attempts;
+static int arp_queue_iob(struct net_driver_s *dev, unsigned ipaddr, struct iob_s *iob)
+{
+  assert(ipaddr == 1 && iob == &item && iob == dev->d_iob);
+  attempts++;
+  if (queue_result == 0) queued = iob;
+  return queue_result;
+}
+static void netdev_iob_clear(struct net_driver_s *dev)
+{ dev->d_iob = NULL; dev->d_buf = NULL; dev->d_len = 0; }
+static void netdev_iob_release(struct net_driver_s *dev)
+{
+  assert(dev->d_iob == &item && queued == NULL && freed == 0);
+  freed++;
+  dev->d_iob = NULL;
+  dev->d_buf = NULL;
+  /* Actual netdev_iob_release does not clear d_len. */
+}
+'''
+    for index, block in enumerate(blocks):
+        fixture += (f'static void handoff{index}(struct net_driver_s *dev)\n'
+                    '{\n  unsigned ipaddr = 1;\n' + block + '}\n')
+    fixture += r'''
+int main(void)
+{
+  void (*paths[])(struct net_driver_s *) = {handoff0, handoff1};
+  const int results[] = {0, -ENOMEM, -ENOENT};
+  for (unsigned p = 0; p < 2; p++)
+    for (unsigned r = 0; r < 3; r++)
+      {
+        struct net_driver_s dev = {&item, &item, 40};
+        queued = NULL;
+        freed = attempts = 0;
+        queue_result = results[r];
+        paths[p](&dev);
+        assert(attempts == 1 && !dev.d_iob && !dev.d_buf && dev.d_len == 0);
+        assert(queue_result == 0 ? queued == &item && freed == 0
+                                 : queued == NULL && freed == 1);
+      }
+  puts("ARP_QUEUE_OWNERSHIP=PASS initial/in-progress success/ENOMEM/ENOENT");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='arp-queue-ownership-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',

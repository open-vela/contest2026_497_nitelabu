new file mode 100644
index 00000000000..030b1755562
--- /dev/null
+++ b/boards/risc-v/esp32s31/common/Makefile
@@ -0,0 +1,17 @@
+############################################################################
+# boards/risc-v/esp32s31/common/Makefile
+#
+# SPDX-License-Identifier: Apache-2.0
+############################################################################
+
+include $(TOPDIR)/Make.defs
+
+# The configured board source directory is linked here as board/.  Keep the
+# S31 board source selection in that board-specific Make.defs, consistent
+# with the existing Espressif common-board build layout in this tree.
+
+include board/Make.defs
+
+DEPPATH += --dep-path board

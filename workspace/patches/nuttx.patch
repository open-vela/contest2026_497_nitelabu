+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check actual procfs heap registration, null handles and reader lifetimes."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'fs/procfs/fs_procfsmeminfo.c'
+    source = (subprocess.check_output(
+        ['git', 'show', f'{args.revision}:{filename}'], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define FAR
+typedef unsigned irqstate_t;
+struct mm_heap_s { int unused; };
+typedef void (*mm_mallinfo_handler_t)(void);
+typedef void (*mm_memdump_handler_t)(void);
+struct procfs_meminfo_entry_s {
+  const char *name;
+  struct mm_heap_s *heap;
+  mm_mallinfo_handler_t mallinfo;
+  mm_memdump_handler_t memdump;
+  struct procfs_meminfo_entry_s *next;
+  unsigned refs;
+  bool backtrace;
+};
+static struct procfs_meminfo_entry_s *g_procfs_meminfo;
+static unsigned g_procfs_meminfo_lock, allocated, freed;
+static bool out_of_memory;
+static irqstate_t spin_lock_irqsave(unsigned *lock)
+{ assert(!*lock); *lock = 1; return 0; }
+static void spin_unlock_irqrestore(unsigned *lock, irqstate_t flags)
+{ (void)flags; assert(*lock); *lock = 0; }
+static void *kmm_zalloc(size_t size)
+{
+  assert(!g_procfs_meminfo_lock);
+  if (out_of_memory) return NULL;
+  allocated++; return calloc(1, size);
+}
+static void kmm_delayfree(void *entry)
+{ assert(g_procfs_meminfo_lock && entry); freed++; free(entry); }
+static void handler(void) {}
+'''
+    for name in ('meminfo_release_entry_locked', 'procfs_register_meminfo',
+                 'procfs_unregister_meminfo'):
+        if name != 'procfs_unregister_meminfo':
+            fixture += '\nFAR struct procfs_meminfo_entry_s *\n'
+        fixture += definition(source, name)
+    fixture += r'''
+int main(void)
+{
+  struct mm_heap_s heap = {0};
+  struct procfs_meminfo_entry_s *one, *two;
+  irqstate_t flags;
+  for (unsigned i = 0; i < 100; i++) {
+    assert(procfs_register_meminfo(NULL, &heap, NULL, NULL) == NULL);
+    procfs_unregister_meminfo(NULL);
+  }
+  assert(!allocated && !freed && !g_procfs_meminfo);
+  out_of_memory = true;
+  assert(procfs_register_meminfo("Kmem", &heap, NULL, NULL) == NULL);
+  procfs_unregister_meminfo(NULL);
+  assert(!allocated && !freed && !g_procfs_meminfo);
+  out_of_memory = false;
+  one = procfs_register_meminfo("Kmem", &heap, handler, handler);
+  two = procfs_register_meminfo("Pool", &heap, NULL, NULL);
+  assert(one && two && allocated == 2 && one->refs == 1);
+  assert(one->heap == &heap && one->mallinfo == handler);
+  assert(one->memdump == handler && g_procfs_meminfo == two);
+  assert(two->next == one);
+#ifdef CONFIG_MM_RECORD_STACK_DEFAULT
+  assert(one->backtrace);
+#else
+  assert(!one->backtrace);
+#endif
+  /* Existing reader retains its reference after unregister. */
+  flags = spin_lock_irqsave(&g_procfs_meminfo_lock);
+  one->refs++;
+  spin_unlock_irqrestore(&g_procfs_meminfo_lock, flags);
+  procfs_unregister_meminfo(one);
+  assert(one->refs == 1 && !freed && two->next == one);
+  procfs_unregister_meminfo(two);
+  assert(freed == 1 && g_procfs_meminfo == one);
+  flags = spin_lock_irqsave(&g_procfs_meminfo_lock);
+  assert(meminfo_release_entry_locked(one) == NULL);
+  spin_unlock_irqrestore(&g_procfs_meminfo_lock, flags);
+  assert(freed == 2 && !g_procfs_meminfo && !g_procfs_meminfo_lock);
+  puts("PROCFS_MEMINFO_LIFECYCLE=PASS unnamed/oom/named/readers/backtrace");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='procfs-meminfo-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        for macros in ([], ['-DCONFIG_MM_RECORD_STACK'],
+                       ['-DCONFIG_MM_RECORD_STACK',
+                        '-DCONFIG_MM_RECORD_STACK_DEFAULT']):
+            subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                            '-fsanitize=undefined', '-fno-sanitize-recover=all',
+                            *macros, str(path / 'test.c'), '-o',
+                            str(path / 'test')], check=True)
+            subprocess.run([str(path / 'test')], check=True)
+
+
+if __name__ == '__main__':
+    main()

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check BOOT input polarity, error handling and IRQ attach/detach policy."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    board = root / "boards/risc-v/esp32s31/esp32s31-core-function-board"
+    source = (board / "src/esp32s31_buttons.c").read_text()
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "board.h"
+#define INPUT 1
+#define PULLUP 2
+#define CHANGE 3
+#define ESP_PIN2IRQ(p) (186 + (p))
+typedef int (*xcpt_t)(int, void *, void *);
+static int config_error, attach_error, enables, disables, attaches, detaches;
+static bool level;
+static int esp_configgpio(int pin, int flags) {
+  assert(pin == 61 && flags == (INPUT | PULLUP));
+  return config_error;
+}
+static bool esp_gpioread(int pin) { assert(pin == 61); return level; }
+static void esp_gpioirqdisable(int irq) {
+  assert(irq == ESP_PIN2IRQ(61)); disables++;
+}
+static void esp_gpioirqenable(int irq, int type) {
+  assert(irq == ESP_PIN2IRQ(61) && type == CHANGE); enables++;
+}
+static int handler(int irq, void *context, void *arg) { return 0; }
+static int irq_attach(int irq, xcpt_t callback, void *arg) {
+  assert(irq == ESP_PIN2IRQ(61) && callback == handler && arg == (void *)1);
+  attaches++;
+  return attach_error;
+}
+static int irq_detach(int irq) {
+  assert(irq == ESP_PIN2IRQ(61)); detaches++; return 0;
+}
+'''
+    for name in ("board_button_initialize", "board_buttons", "board_button_irq"):
+        fixture += definition(source, name)
+    fixture += r'''
+int main(void) {
+  assert(board_button_initialize() == 1);
+  config_error = -EINVAL;
+  assert(board_button_initialize() == 0);
+  level = true; assert(board_buttons() == 0);
+  level = false; assert(board_buttons() == BUTTON_BOOT_BIT);
+  assert(board_button_irq(-1, handler, (void *)1) == -EINVAL);
+  assert(board_button_irq(1, handler, (void *)1) == -EINVAL);
+  assert(disables == 0 && attaches == 0);
+  attach_error = -ENOMEM;
+  assert(board_button_irq(0, handler, (void *)1) == -ENOMEM);
+  assert(enables == 0 && disables == 1 && attaches == 1);
+  attach_error = 0;
+  assert(board_button_irq(0, handler, (void *)1) == 0);
+  assert(enables == 1 && disables == 2 && attaches == 2);
+  assert(board_button_irq(0, NULL, NULL) == 0);
+  assert(enables == 1 && disables == 3 && detaches == 1);
+  puts("S31_BUTTONS=PASS input-only/polarity/invalid-id/attach-failure/detach");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-buttons-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-Wno-unused-parameter", "-fsanitize=undefined",
+                        "-fno-sanitize-recover=all", "-I", str(board / "include"),
+                        str(path / "test.c"), "-o", str(path / "test")], check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

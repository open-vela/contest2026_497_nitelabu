index 00000000000..181c1a0f8a2
--- /dev/null
+++ b/tools/test_esp32s31_wifi_heap_callbacks.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check Wi-Fi/coexistence allocator callback pairing in the actual tables.
+
+Kernel allocations must not be released through the ioctl caller's task heap.
+This host check preprocesses the table conditions; it is not a hardware
+deinitialization or allocator test. --revision selects an explicit baseline.
+"""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import unittest
+
+
+SOURCES = {}
+
+
+def table(filename, name, s31, kernel):
+    match = re.search(name + r"\s*=\s*(\{.*?\n\});", SOURCES[filename],
+                      re.DOTALL)
+    if not match:
+        raise AssertionError(f"Missing actual adapter table: {name}")
+    command = ["cpp", "-P"]
+    if s31:
+        command += ["-DCONFIG_ARCH_CHIP_ESP32S31=1",
+                    "-DCONFIG_IDF_TARGET_ESP32S31=1"]
+    if kernel:
+        command += ["-DCONFIG_BUILD_KERNEL=1"]
+    expanded = subprocess.check_output(command + ["-"], input=match[1],
+                                       text=True)
+    return dict(re.findall(r"\.(\w+)\s*=\s*(\w+)\s*,", expanded))
+
+
+class HeapCallbackTests(unittest.TestCase):
+    def test_s31_kernel_spin_lock_delete(self):
+        coex = SOURCES["esp_coex_adapter.c"]
+        create = re.search(
+            r"void \*esp_coex_common_spin_lock_create_wrapper\(void\)"
+            r"\s*\{(.*?)\n\}", coex, re.DOTALL)
+        self.assertIsNotNone(create)
+        self.assertIn("kmm_malloc(tmp)", create[1])
+        callbacks = table("esp_wifi_adapter.c", "g_wifi_osi_funcs", True, True)
+        self.assertEqual(callbacks["_spin_lock_create"],
+                         "esp_coex_common_spin_lock_create_wrapper")
+        self.assertEqual(callbacks["_spin_lock_delete"], "kmm_free")
+
+    def test_s31_kernel_coexistence_free(self):
+        source = SOURCES["esp_coex_adapter.c"]
+        self.assertRegex(source,
+                         r"esp_coex_common_malloc_internal_wrapper\(size_t size\)"
+                         r"\s*\{\s*return kmm_malloc\(size\);")
+        callbacks = table("esp_coex_adapter.c", "g_coex_adapter_funcs", True, True)
+        self.assertEqual(callbacks["_malloc_internal"],
+                         "esp_coex_common_malloc_internal_wrapper")
+        self.assertEqual(callbacks["_free"], "kmm_free")
+
+    def test_existing_wifi_kernel_pair(self):
+        callbacks = table("esp_wifi_adapter.c", "g_wifi_osi_funcs", True, True)
+        self.assertEqual(callbacks["_malloc"], "kmm_malloc")
+        self.assertEqual(callbacks["_free"], "kmm_free")
+
+    def test_other_profiles_unchanged(self):
+        for s31, kernel in ((False, False), (False, True), (True, False)):
+            with self.subTest(s31=s31, kernel=kernel):
+                wifi = table("esp_wifi_adapter.c", "g_wifi_osi_funcs", s31, kernel)
+                coex = table("esp_coex_adapter.c", "g_coex_adapter_funcs", s31, kernel)
+                self.assertEqual(wifi["_spin_lock_delete"], "free")
+                self.assertEqual(coex["_free"], "free")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    for filename in ("esp_wifi_adapter.c", "esp_coex_adapter.c"):
+        path = "arch/risc-v/src/esp32c6/" + filename
+        SOURCES[filename] = (
+            subprocess.check_output(["git", "show", f"{args.revision}:{path}"],
+                                    cwd=root, text=True) if args.revision
+            else (root / path).read_text())
+    suite = unittest.defaultTestLoader.loadTestsFromTestCase(HeapCallbackTests)
+    if not unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful():
+        raise SystemExit(1)
+    print("S31_WIFI_HEAP_CALLBACKS=PASS kernel-pairs/other-profile-isolation")
+
+
+if __name__ == "__main__":
+    main()

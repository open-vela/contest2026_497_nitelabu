+  assert(priv->sem_isr == 0);
+  waits++;
+  priv->error = transfer_error;
+  if (wait_result) { priv->sem_isr = 1; } /* Late completion at timeout. */
+  return wait_result;
+}
+static void esp_i2c_intr_disable(struct esp_i2c_priv_s *priv)
+{
+  assert(priv && mutex && spin);
+  stops++;
+}
+static void nxsem_reset(int *sem, int value)
+{
+  assert(mutex && spin && stops && resets && value == 0);

+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    name = "arch/risc-v/src/common/espressif/esp_gpio.c"
+    source = (subprocess.check_output(["git", "show", f"{args.revision}:{name}"],
+                                     cwd=root, text=True) if args.revision
+              else (root / name).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#define ESP_FIRST_GPIOIRQ 186
+#define CONFIG_ESPRESSIF_GPIO_IRQ 1
+#define OK 0
+static int g_gpio_hal;
+static uint32_t pending[2];
+static uint64_t cleared, delivered;
+static unsigned count;
+#define this_cpu() 0
+#define gpio_hal_get_intr_status(h,c,s) (*(s) = pending[0])
+#define gpio_hal_get_intr_status_high(h,c,s) (*(s) = pending[1])
+static void clear_pin(int *hal, unsigned pin) {
+  assert(hal == &g_gpio_hal && pin < SOC_GPIO_PIN_COUNT);
+  assert(!(cleared & (UINT64_C(1) << pin)));
+  cleared |= UINT64_C(1) << pin;
+}
+#define gpio_hal_clear_intr_status_bit(h,p) clear_pin(h,p)
+static void irq_dispatch(int irq, void *regs) {
+  unsigned pin = irq - ESP_FIRST_GPIOIRQ;
+  assert(regs == (void *)0x1234 && pin < SOC_GPIO_PIN_COUNT);
+  assert(cleared & (UINT64_C(1) << pin));
+  assert(!(delivered & (UINT64_C(1) << pin)));
+  delivered |= UINT64_C(1) << pin;
+  count++;
+}
+'''
+    fixture += definition(source, "gpio_dispatch")
+    fixture += definition(source, "gpio_interrupt")
+    fixture += r'''
+static void check(uint64_t mask) {
+  pending[0] = (uint32_t)mask;
+  pending[1] = (uint32_t)(mask >> 32);
+  cleared = delivered = count = 0;
+  assert(gpio_interrupt(0, (void *)0x1234, NULL) == 0);
+  assert(delivered == mask && cleared == mask);
+  assert(count == __builtin_popcountll(mask));
+}
+int main(void) {
+  check(0);
+  for (unsigned bit = 0; bit < SOC_GPIO_PIN_COUNT; bit++) {
+    check(UINT64_C(1) << bit);
+    for (unsigned other = bit + 1; other < SOC_GPIO_PIN_COUNT; other++) {
+      check((UINT64_C(1) << bit) | (UINT64_C(1) << other));
+    }
+  }
+  check((UINT64_C(1) << SOC_GPIO_PIN_COUNT) - 1);
+  puts("GPIO_IRQ_BANKS=PASS empty/single/all-pairs/all-pins");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="esp-gpio-banks-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        for pins in (22, 31, 32, 62):
+            subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                            "-Wno-unused-parameter", "-Wno-unused-variable",
+                            "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                            f"-DSOC_GPIO_PIN_COUNT={pins}", str(path / "test.c"),
+                            "-o", str(path / "test")], check=True)
+            subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

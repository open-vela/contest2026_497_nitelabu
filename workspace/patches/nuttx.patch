+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""An empty peripheral status must not advance the I2C state machine."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    relative = "arch/risc-v/src/common/espressif/esp_i2c.c"
+    source = (subprocess.check_output(
+        ["git", "show", f"{args.revision}:{relative}"], cwd=root, text=True)
+        if args.revision else (root / relative).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#define OK 0
+#define CONFIG_ARCH_CHIP_ESP32S31 1
+#define I2C_LL_MASTER_EVENT_INTR 0x5a8
+typedef int irqstate_t;
+struct context { void *dev; };
+struct esp_i2c_priv_s { struct context *ctx; int slock; };
+static int locked;
+static irqstate_t spin_lock_irqsave(int *lock)
+{
+  assert(lock && !locked);
+  locked = 1;
+  return 42;
+}
+static void spin_unlock_irqrestore(int *lock, irqstate_t flags)
+{
+  assert(lock && locked && flags == 42);
+  locked = 0;
+}
+static uint32_t status;
+static unsigned clears, events;
+static void i2c_ll_enable_intr_mask(void *dev, uint32_t mask)
+{
+  assert(dev && locked && mask == I2C_LL_MASTER_EVENT_INTR);
+}
+static void i2c_ll_get_intr_mask(void *dev, uint32_t *value)
+{
+  assert(dev && locked);
+  *value = status;
+}
+static void i2c_ll_clear_intr_mask(void *dev, uint32_t value)
+{
+  assert(dev && locked && value == status && value != 0);
+  clears++;
+}
+static void esp_i2c_process(struct esp_i2c_priv_s *priv, uint32_t value)
+{
+  assert(priv->ctx && locked && value == status && value != 0);
+  events++;
+}
+'''
+    fixture += definition(source, "esp_i2c_intr_enable")
+    fixture += definition(source, "esp_i2c_irq")
+    fixture += r'''
+int main(void)
+{
+  struct context ctx = { &ctx };
+  struct esp_i2c_priv_s priv = { &ctx, 0 };
+  locked = 1;
+  status = 0x100; /* A newly latched timeout must survive command rearming. */
+  esp_i2c_intr_enable(&priv);
+  assert(clears == 0 && status == 0x100);
+  locked = 0;
+  status = 0;
+  assert(esp_i2c_irq(0, NULL, &priv) == 0);
+  assert(clears == 0 && events == 0);
+  assert(!locked);
+  for (unsigned bit = 0; bit < 14; bit++) {
+    status = UINT32_C(1) << bit;
+    assert(esp_i2c_irq(0, NULL, &priv) == 0);
+    assert(clears == bit + 1 && events == bit + 1);
+    status = 0;
+    assert(esp_i2c_irq(0, NULL, &priv) == 0);
+    assert(clears == bit + 1 && events == bit + 1);
+  }
+  puts("ESP_I2C_SPURIOUS_IRQ=PASS no event means no state transition");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="esp-i2c-irq-") as directory:

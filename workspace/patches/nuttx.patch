+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Run two actual RMT writers with pthread-backed mutexes and completion.
+
+Registers and interrupts remain mocked. An alarm bounds deadlocks; this is
+host concurrency evidence, not a hardware SMP or waveform certification.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+from test_esp_rmt_tx_lifecycle import main as lifecycle
+
+
+def run_fixture(fixture):
+    fixture = fixture.split('static int nxsem_wait_uninterruptible(int *s)\n{')[0]
+    fixture = '#define _POSIX_C_SOURCE 200809L\n' + fixture
+    fixture = fixture.replace('#include <stdio.h>', '''#include <stdio.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <time.h>
+#include <unistd.h>
+static pthread_mutex_t writer_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t state_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t register_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t completion_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t completion = PTHREAD_COND_INITIALIZER;
+static atomic_int contenders;
+static _Thread_local int lock_depth;''')
+    fixture = fixture.replace('lock_error, early_irq, lock_depth;',
+                              'lock_error, early_irq;')
+    replacements = {
+        'spin_lock_irqsave': r'''static int spin_lock_irqsave(int *lock)
+{
+  pthread_mutex_t *host = lock == &object.tx_state_lock ?
+                        &state_lock : &register_lock;
+  assert(pthread_mutex_lock(host) == 0);
+  assert(!*lock); *lock = 1; lock_depth++; return 0;
+}''',
+        'spin_unlock_irqrestore': r'''static void spin_unlock_irqrestore(int *lock, int flags)
+{
+  (void)flags; assert(*lock); *lock = 0; lock_depth--;
+  assert(pthread_mutex_unlock(lock == &object.tx_state_lock ?
+                             &state_lock : &register_lock) == 0);
+}''',
+        'nxmutex_lock': r'''static int nxmutex_lock(int *m)
+{
+  assert(!lock_depth);
+  atomic_fetch_add(&contenders, 1);
+  assert(pthread_mutex_lock(&writer_lock) == 0);
+  assert(!*m); *m = 1; return 0;
+}''',
+        'nxmutex_unlock': r'''static int nxmutex_unlock(int *m)
+{
+  assert(!lock_depth && *m && !object.tx_active && !hardware_active);
+  *m = 0; assert(pthread_mutex_unlock(&writer_lock) == 0); return 0;
+}''',
+        'nxsem_post': r'''static int nxsem_post(int *s)
+{
+  assert(s == &object.tx_sem && object.tx_state_lock && !object.tx_active);
+  assert(!hardware_active && !pending && !enabled && !object.tx_data);
+  assert(pthread_mutex_lock(&completion_lock) == 0);
+  (*s)++; posts++;
+  assert(pthread_cond_signal(&completion) == 0);
+  assert(pthread_mutex_unlock(&completion_lock) == 0); return 0;
+}''',
+        'nxsem_trywait': r'''static int nxsem_trywait(int *s)
+{
+  int ret = -EAGAIN;
+  assert(pthread_mutex_lock(&completion_lock) == 0);
+  if (*s) { (*s)--; ret = 0; }
+  assert(pthread_mutex_unlock(&completion_lock) == 0); return ret;
+}''',
+    }
+    for name, replacement in replacements.items():
+        fixture = fixture.replace(definition(fixture, name), replacement)
+    fixture += r'''
+static int nxsem_wait_uninterruptible(int *s)
+{
+  assert(!lock_depth && object.tx_lock);
+  assert(pthread_mutex_lock(&completion_lock) == 0);
+  waits++;
+  while (!*s) assert(pthread_cond_wait(&completion, &completion_lock) == 0);
+  (*s)--;
+  assert(pthread_mutex_unlock(&completion_lock) == 0); return 0;
+}
+struct request { rmt_item32_t frame[97]; int result; };
+static void *writer(void *arg)
+{
+  struct request *req = arg;
+  req->result = rmt_write_items(0, req->frame, 97, true);
+  return NULL;
+}
+static void pause_briefly(void)
+{ const struct timespec delay = {0, 1000000}; nanosleep(&delay, NULL); }
+static void wait_started(int target)
+{
+  for (;;) {
+    int flags = spin_lock_irqsave(&object.tx_state_lock);
+    bool reached = starts == target;
+    spin_unlock_irqrestore(&object.tx_state_lock, flags);
+    if (reached) return;
+    pause_briefly();
+  }
+}
+static void inject(uint32_t event)
+{
+  int s = spin_lock_irqsave(&object.tx_state_lock);
+  int r = spin_lock_irqsave(&g_rmtdev_common.rmt_spinlock);
+  pending |= event;
+  spin_unlock_irqrestore(&g_rmtdev_common.rmt_spinlock, r);
+  spin_unlock_irqrestore(&object.tx_state_lock, s);
+  rmt_tx_interrupt(0);
+}
+int main(void)
+{
+  alarm(10);
+  for (int round = 0; round < 50; round++) {
+    struct request first = {0}, second = {0};
+    pthread_t a, b;
+    for (int i = 0; i < 97; i++) {
+      first.frame[i].duration0 = i + 1;
+      second.frame[i].duration0 = i + 1001;
+    }
+    int prior = starts;
+    atomic_store(&contenders, 0);
+    assert(pthread_create(&a, NULL, writer, &first) == 0);
+    wait_started(prior + 1);
+    assert(pthread_create(&b, NULL, writer, &second) == 0);
+    while (atomic_load(&contenders) != 2) pause_briefly();
+    int flags = spin_lock_irqsave(&object.tx_state_lock);
+    assert(starts == prior + 1 && memory[0].duration0 == 1);
+    spin_unlock_irqrestore(&object.tx_state_lock, flags);
+    inject(RMT_LL_EVENT_TX_THRES(0));
+    flags = spin_lock_irqsave(&object.tx_state_lock);
+    assert(memory[0].duration0 == 49 && starts == prior + 1);
+    spin_unlock_irqrestore(&object.tx_state_lock, flags);
+    inject(RMT_LL_EVENT_TX_DONE(0));
+    assert(pthread_join(a, NULL) == 0 && first.result == 0);
+    wait_started(prior + 2);
+    flags = spin_lock_irqsave(&object.tx_state_lock);
+    assert(memory[0].duration0 == 1001 && object.tx_active);
+    spin_unlock_irqrestore(&object.tx_state_lock, flags);
+    inject(RMT_LL_EVENT_TX_ERROR(0) | RMT_LL_EVENT_TX_DONE(0));
+    assert(pthread_join(b, NULL) == 0 && second.result == -EIO);
+    assert(!object.tx_sem && !object.tx_active && !object.tx_data);
+    assert(posts == 2 * (round + 1));
+  }
+  alarm(0);
+  puts("ESP_RMT_TX_CONCURRENCY=PASS 50 rounds/100 writers/ordered completion/error");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='esp-rmt-tx-threads-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-unused-variable', '-Wno-unused-function', '-pthread',
+                        '-fsanitize=address,undefined', '-fno-sanitize-recover=all',
+                        str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+        subprocess.run([str(path / 'test')], check=True, timeout=15)
+
+
+if __name__ == '__main__':
+    lifecycle(run_fixture=run_fixture)

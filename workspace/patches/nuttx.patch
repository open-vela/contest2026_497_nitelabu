+typedef struct {
+  struct { unsigned mem_size_chn, tx_conti_mode_chn, idle_out_lv_chn; } chnconf0[4];
+  struct { struct { unsigned mem_size_chm, div_cnt_chm; } conf0; } chmconf[4];
+  struct { unsigned rx_lim_chm; } chm_rx_lim[4];
+  struct { uint32_t val; } chnstatus[4], chmstatus[4], int_st;
+} rmt_dev_t;
+'''
+    fixture = '#include <assert.h>\n#include <stdio.h>\n'
+    fixture += f'#include "{header}"\n'
+    fixture += r'''
+int main(void)
+{
+  rmt_dev_t dev = {0};
+  uint32_t (*getters[])(rmt_dev_t *) = {
+    rmt_ll_get_tx_end_interrupt_status, rmt_ll_get_tx_err_interrupt_status,
+    rmt_ll_get_tx_thres_interrupt_status, rmt_ll_get_tx_loop_interrupt_status,
+    rmt_ll_get_rx_end_interrupt_status, rmt_ll_get_rx_err_interrupt_status,
+    rmt_ll_get_rx_thres_interrupt_status
+  };
+  for (unsigned bit = 0; bit < 32; bit++) {
+    dev.int_st.val = UINT32_C(1) << bit;
+    for (unsigned group = 0; group < 7; group++) {
+      assert(getters[group](&dev) ==
+             (bit / 4 == group ? UINT32_C(1) << (bit % 4) : 0));
+    }
+  }
+  for (unsigned mask = 0; mask < 16; mask++) {
+    for (unsigned group = 0; group < 7; group++) {
+      dev.int_st.val = mask << (group * 4);
+      assert(getters[group](&dev) == mask);
+    }
+  }
+  for (unsigned ch = 0; ch < 4; ch++) {
+    dev.chnconf0[ch].mem_size_chn = ch + 1;
+    dev.chmconf[ch].conf0.mem_size_chm = 4 - ch;
+    dev.chnconf0[ch].tx_conti_mode_chn = ch & 1;
+    dev.chnconf0[ch].idle_out_lv_chn = ch & 1;
+    dev.chm_rx_lim[ch].rx_lim_chm = 24 + ch;
+    dev.chnstatus[ch].val = 0x11220000 + ch;
+    dev.chmstatus[ch].val = 0x33440000 + ch;
+    assert(rmt_ll_tx_get_mem_blocks(&dev, ch) == ch + 1);
+    assert(rmt_ll_rx_get_mem_blocks(&dev, ch) == 4 - ch);
+    assert(rmt_ll_tx_is_loop_enabled(&dev, ch) == (ch & 1));
+    assert(rmt_ll_tx_get_idle_level(&dev, ch) == (ch & 1));
+    assert(rmt_ll_rx_get_limit(&dev, ch) == 24 + ch);
+    assert(rmt_ll_tx_get_status_word(&dev, ch) == 0x11220000 + ch);
+    assert(rmt_ll_rx_get_status_word(&dev, ch) == 0x33440000 + ch);
+    for (unsigned div = 1; div <= 256; div++) {
+      dev.chmconf[ch].conf0.div_cnt_chm = div & 255;
+      assert(rmt_ll_rx_get_channel_clock_div(&dev, ch) == div);
+    }
+  }
+  puts("S31_RMT_COMPAT=PASS all status bits/channel masks; four channels/dividers");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="s31-rmt-compat-") as directory:
+        path = Path(directory)
+        (path / "hal").mkdir()
+        (path / "hal/rmt_ll.h").write_text(types)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",

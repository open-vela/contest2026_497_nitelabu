+#if defined(CONFIG_ARCH_ADDRENV) && defined(CONFIG_BUILD_KERNEL)
+      FAR struct addrenv_s *oldenv;
+      int restore;
+
+      /* exec_module initializes the child with its address environment
+       * selected, but file actions still run on the parent's TCB.  Open
+       * resolves the parent's TLS (umask) and relative paths, so select
+       * that parent's mappings while applying the copied file actions.
+       * The destination descriptor table remains the child's kernel table.
+       */
+
+      ret = addrenv_select(rtcb->group->tg_addrenv_own, &oldenv);
+      if (ret >= 0)
+        {
+          ret = spawn_file_actions(tcb, actions);
+        }
+
+      restore = addrenv_restore(oldenv);
+      if (ret >= 0)
+        {
+          ret = restore;
+        }
+#else
       ret = spawn_file_actions(tcb, actions);
+#endif
     }
 #endif
 

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check S31 SDK configuration against IDF's static TX buffer selection."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'arch/risc-v/src/esp32s31/include/sdkconfig.h'
+    source = (subprocess.check_output(
+        ['git', 'show', f'{args.revision}:{filename}'], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    with tempfile.TemporaryDirectory(prefix='s31-wifi-tx-budget-') as directory:
+        path = Path(directory)
+        (path / 'nuttx').mkdir()
+        (path / 'sdkconfig.h').write_text(source)
+        for kind in (0, 1):
+            for static_count in (1, 16, 64):
+                (path / 'nuttx/config.h').write_text(
+                    '#define CONFIG_ESPRESSIF_WIFI 1\n'
+                    '#define CONFIG_ESPRESSIF_FLASH_FREQ_80M 1\n'
+                    f'#define CONFIG_ESPRESSIF_WIFI_TX_BUFFER_TYPE {kind}\n'
+                    f'#define CONFIG_ESPRESSIF_WIFI_STATIC_TX_BUFFER_NUM {static_count}\n'
+                    '#define CONFIG_ESPRESSIF_WIFI_DYNAMIC_TX_BUFFER_NUM 32\n')
+                fixture = '#include "sdkconfig.h"\n'
+                if kind == 0:
+                    fixture += ('_Static_assert(CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM == '
+                                f'{static_count}, "static TX budget");\n')
+                else:
+                    fixture += ('#ifdef CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM\n'
+                                '#error Dynamic TX must not request a static TX pool\n'
+                                '#endif\n')
+                fixture += ('_Static_assert(CONFIG_ESP_WIFI_TX_BUFFER_TYPE == '
+                            f'{kind}, "TX mode");\n'
+                            '_Static_assert(CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM == 32, '
+                            '"dynamic TX budget unchanged");\n')
+                (path / 'test.c').write_text(fixture)
+                subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                                '-I', directory, '-fsyntax-only', str(path / 'test.c')],
+                               check=True)
+    print('S31_WIFI_TX_BUDGET=PASS static/dynamic with 1/16/64 configured buffers')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/test_esp32s31_wireless_make.py b/tools/test_esp32s31_wireless_make.py

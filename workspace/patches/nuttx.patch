+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Test the actual Espressif scan-result ioctl with host mocks.
+
+Models WAPI's status-then-collect protocol, including empty scans.  Does not
+model the radio, asynchronous event races, or user address validation.
+"""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = "arch/risc-v/src/common/espressif/esp_wifi_utils.c"
+    source = (subprocess.check_output(
+        ["git", "show", f"{args.revision}:{filename}"], cwd=root, text=True)
+        if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <errno.h>
+#include <string.h>
+#define OK 0
+#define SCAN_TIME_SEC 5
+#define SEC2TICK(x) (x)
+typedef int irqstate_t;
+enum { ESP_SCAN_DISABLED, ESP_SCAN_RUN, ESP_SCAN_DONE };
+struct iwreq {
+  union { struct { void *pointer; unsigned short length, flags; } data; } u;
+};
+struct wifi_scan_result {
+  int scan_status, scan_signal;
+  uint8_t *scan_result;
+  unsigned int scan_result_size;
+};
+static struct wifi_scan_result g_scan_priv;
+static unsigned frees, waits;
+static int locked;
+static bool complete_on_wait = true;
+static irqstate_t enter_critical_section(void)
+{ assert(!locked); locked = 1; return 0; }
+static void leave_critical_section(irqstate_t state)
+{ (void)state; assert(locked); locked = 0; }
+static int nxsem_tickwait(int *sem, int ticks)
+{ (void)sem; assert(!locked && ticks == SCAN_TIME_SEC); waits++;
+  if (!complete_on_wait) return -ETIMEDOUT;
+  g_scan_priv.scan_status = ESP_SCAN_DONE; return 0; }
+static void kmm_free(void *buffer)
+{ assert(buffer == g_scan_priv.scan_result); frees++; }
+'''
+    fixture += definition(source, "esp_wifi_get_scan_results")
+    fixture += r'''
+int main(void)
+{
+  uint8_t result[] = { 1, 2, 3, 4 }, buffer[8];
+  struct iwreq request = {0};
+  for (unsigned size = 0; size <= sizeof(result); size += sizeof(result)) {
+    for (int running = 0; running < 2; running++) {
+      frees = waits = 0;
+      g_scan_priv = (struct wifi_scan_result) {
+        .scan_status = running ? ESP_SCAN_RUN : ESP_SCAN_DONE,
+        .scan_result = result, .scan_result_size = size
+      };
+      for (int probe = 0; probe < 3; probe++) {
+        request.u.data.pointer = probe == 1 ? NULL : buffer;
+        request.u.data.length = probe == 1 ? sizeof(buffer) : 0;
+        assert(esp_wifi_get_scan_results(&request) == (size ? -E2BIG : 0));
+        assert(request.u.data.length == size);
+        assert(g_scan_priv.scan_status == ESP_SCAN_DONE && frees == 0);
+        assert(g_scan_priv.scan_result == result);
+      }
+      assert(waits == (unsigned)running);
+      if (size) {
+        request.u.data.pointer = buffer; request.u.data.length = size - 1;
+        assert(esp_wifi_get_scan_results(&request) == -E2BIG);
+        assert(request.u.data.length == size && frees == 0);
+        assert(g_scan_priv.scan_status == ESP_SCAN_DONE);
+      }
+      memset(buffer, 0, sizeof(buffer));
+      request.u.data.pointer = buffer; request.u.data.length = sizeof(buffer);
+      assert(esp_wifi_get_scan_results(&request) == 0);
+      assert(request.u.data.length == size && frees == 1);
+      assert(memcmp(buffer, result, size) == 0);
+      assert(g_scan_priv.scan_status == ESP_SCAN_DISABLED);
+      assert(g_scan_priv.scan_result == NULL && g_scan_priv.scan_result_size == 0);
+      assert(esp_wifi_get_scan_results(&request) == -EINVAL);
+      assert(request.u.data.length == 0 && frees == 1);
+    }
+  }
+  /* Slow scan: preserve its buffer/state through bounded timeout and retry. */
+  complete_on_wait = false;
+  frees = waits = 0;
+  g_scan_priv = (struct wifi_scan_result) {
+    .scan_status = ESP_SCAN_RUN, .scan_result = result,
+    .scan_result_size = sizeof(result)
+  };
+  for (int retry = 0; retry < 2; retry++) {
+    request.u.data.pointer = buffer; request.u.data.length = 0;
+    assert(esp_wifi_get_scan_results(&request) == -EAGAIN);
+    assert(request.u.data.length == 0 && frees == 0 && !locked);
+    assert(g_scan_priv.scan_status == ESP_SCAN_RUN);
+    assert(g_scan_priv.scan_result == result);
+  }
+  assert(waits == 2);
+  g_scan_priv.scan_status = ESP_SCAN_DONE;
+  assert(esp_wifi_get_scan_results(&request) == -E2BIG);
+  assert(waits == 2 && frees == 0);
+  request.u.data.pointer = buffer; request.u.data.length = sizeof(buffer);
+  assert(esp_wifi_get_scan_results(&request) == 0 && frees == 1);
+  assert(request.u.data.length == sizeof(result));
+  assert(memcmp(buffer, result, sizeof(result)) == 0);
+  for (int state = ESP_SCAN_DISABLED; state <= ESP_SCAN_DONE; state++) {
+    g_scan_priv.scan_status = state;
+    assert(esp_wifi_get_scan_results(NULL) == -EINVAL);
+  }
+  puts("ESP_WIFI_SCAN_RESULTS=PASS empty/nonempty/status/retry/collect/null/timeout");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="esp-wifi-scan-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        str(path / "test.c"), "-o", str(path / "test")],
+                       check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

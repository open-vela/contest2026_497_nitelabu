+# Keep the SoC address-window definitions in sync with the configured MMU page
+# size.  ESP-IDF's soc component exports the same definition transitively.
+
+target_compile_definitions(arch PRIVATE SOC_MMU_PAGE_SIZE=CONFIG_MMU_PAGE_SIZE)
+
+# Pre-include the S31 ROM compatibility wrapper.  Some ROM headers include
+# ets_sys.h with a relative quoted include, so include-path shadowing alone is
+# insufficient to avoid its legacy OK enumerator colliding with NuttX.
+
+target_compile_options(
+  arch
+  PRIVATE
+    "$<$<COMPILE_LANGUAGE:C>:-include${NUTTX_CHIP_ABS_DIR}/include/esp32s31/rom/ets_sys.h>"

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Regression for stale application inclusion across S31 config switches."""
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / "espressif"))
+from esp32s31_prepare_appfs import prepare
+
+
+class AppfsManifestTests(unittest.TestCase):
+    def test_selects_only_current_apps_and_preserves_stale_source(self):
+        with tempfile.TemporaryDirectory(prefix="s31-appfs-") as root:
+            root = Path(root)
+            source = root / "bin"
+            source.mkdir()
+            (source / "init").write_bytes(b"current")
+            (source / "oldtest").write_bytes(b"stale")
+            manifest = root / "targets"
+            manifest.write_text("ELF_init\n")
+            output = root / "romfs"
+            prepare(source, output, 1024, False, manifest)
+            self.assertEqual({p.name for p in output.iterdir()},
+                             {"init", "init.sha256"})
+            self.assertEqual((source / "oldtest").read_bytes(), b"stale")
+
+    def test_missing_or_invalid_target_does_not_replace_existing_output(self):
+        with tempfile.TemporaryDirectory(prefix="s31-appfs-") as root:
+            root = Path(root)
+            source = root / "bin"
+            source.mkdir()
+            output = root / "romfs"
+            output.mkdir()
+            (output / "preserve").write_bytes(b"existing")
+            manifest = root / "targets"
+            for entry in ("ELF_missing\n", "ELF_../outside\n", "wrong\n", ""):
+                with self.subTest(entry=entry):
+                    manifest.write_text(entry)
+                    with self.assertRaises(ValueError):
+                        prepare(source, output, 1024, False, manifest)
+                    self.assertEqual((output / "preserve").read_bytes(), b"existing")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)

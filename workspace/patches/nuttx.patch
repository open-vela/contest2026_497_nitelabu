@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Check S31 Make/CMake wireless manifests and deferred include expansion.
+
+Runs a standalone GNU Make fixture, without invoking the firmware build or
+dependency recipes. Optionally check source availability in a locked HAL.
+"""
+
+import argparse
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--hal', type=Path)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    chip = root / 'arch/risc-v/src/esp32s31'
+    cmake = (chip / 'esp32s31_wireless.cmake').read_text()
+    variables = {
+        'ESP_HAL_3RDPARTY_REPO': 'chip/esp-hal-3rdparty',
+        'CHIP_SERIES': 'esp32s31',
+        'ESP_MBEDTLS_COMPONENT_REPO':
+            'chip/esp-hal-3rdparty/components/mbedtls',
+        'MBEDTLS_DIR': 'chip/esp-hal-3rdparty/components/mbedtls/mbedtls',
+        'MBEDTLS_BUILTIN_DIR':
+            'chip/esp-hal-3rdparty/components/mbedtls/mbedtls/'
+            'tf-psa-crypto/drivers/builtin/src',
+        'WPA_SUPPLICANT_DIR': 'chip/esp-hal-3rdparty/components/wpa_supplicant',
+        'NUTTX_DIR': '/fixture',
+    }
+
+    def expand(text):
+        return re.sub(r'\$\{(\w+)\}',
+                      lambda match: variables[match[1]], text)
+
+    names = ('ESP32S31_MBEDTLS_SRCS', 'ESP32S31_WPA_SRCS',
+             'ESP32S31_WIFI_PHY_SRCS', 'ESP32S31_CRYPTO_INCLUDES',
+             'ESP32S31_WIFI_INCLUDES', 'CHIP_CSRCS', 'INCLUDES', 'CFLAGS',
+             'EXTRA_LIBS', 'EXTRA_LIBPATHS')
+    fixture = '''TOPDIR := /fixture
+ESP_HAL_3RDPARTY_REPO := esp-hal-3rdparty
+CHIP_SERIES := esp32s31
+INCDIR_PREFIX := -I
+DEFINE_PREFIX := -D
+CFLAGS := -I/application/mbedtls3 -O2
+INCLUDES = -I$(ARCH_SRCDIR)/generic
+include ''' + str(chip / 'esp32s31_wireless.mk') + '''
+ARCH_SRCDIR = $(TOPDIR)/arch/risc-v/src
+'''
+    fixture += '\n'.join('$(info ' + name + '=$(' + name + '))'
+                         for name in names)
+    fixture += '\n.PHONY: all\nall: ; @:\n'
+    with tempfile.TemporaryDirectory(prefix='s31-wireless-make-') as directory:
+        path = Path(directory) / 'Makefile'
+        path.write_text(fixture)
+        output = subprocess.check_output(
+            ['make', '--no-print-directory', '-f', str(path), 'all'],
+            text=True)
+    actual = dict(line.split('=', 1) for line in output.splitlines()
+                  if '=' in line)
+    for name in names[:3]:
+        expected = expand(re.search(
+            r'set\(' + name + r'\s+([\s\S]*?)\)', cmake)[1]).split()
+        assert actual[name].split() == expected, name
+
+    expected_includes = {False: [], True: []}
+    for before, paths in re.findall(
+            r'target_include_directories\(\s+arch\s+(BEFORE\s+)?'
+            r'PRIVATE\s+([\s\S]*?)\)', cmake):
+        expected_includes[bool(before)].extend(expand(paths).split())
+    assert actual['ESP32S31_CRYPTO_INCLUDES'].split() == expected_includes[True]
+    assert actual['ESP32S31_WIFI_INCLUDES'].split() == expected_includes[False]
+    prefix = '-I/fixture/arch/risc-v/src/'
+    crypto = [prefix + path for path in expected_includes[True]]
+    flags = shlex.split(actual['CFLAGS'])
+    assert flags[:len(crypto)] == crypto
+    assert flags.index('-I/application/mbedtls3') >= len(crypto)
+    includes = actual['INCLUDES'].split()
+    assert includes[:len(crypto)] == crypto
+    assert '-I/fixture/arch/risc-v/src/generic' in includes
+    assert all(path.startswith(prefix) for path in includes)
+    assert '-include/fixture/arch/risc-v/src/chip/hal_backports/include/' \
+           'esp32s31_wifi_os_compat.h' in flags
+    definitions = []
+    for block in re.findall(
+            r'target_compile_definitions\(\s+arch\s+(?:PUBLIC|PRIVATE)'
+            r'\s+([\s\S]*?)\)', cmake):
+        definitions.extend('-D' + item for item in block.split())
+    assert [flag for flag in flags if flag.startswith('-D')] == definitions
+    sources = actual['CHIP_CSRCS'].split()
+    assert len(sources) == len(set(sources)), 'duplicate source path'
+    assert actual['EXTRA_LIBS'].split() == [
+        '-lphy', '-lcoexist', '-lmesh', '-lespnow', '-lcore', '-lnet80211', '-lpp']
+    assert all(path.startswith('-L/fixture/arch/risc-v/src/chip/')
+               for path in actual['EXTRA_LIBPATHS'].split())
+    if args.hal:
+        for source in sources:
+            if source.startswith('chip/esp-hal-3rdparty/'):
+                path = args.hal / source.removeprefix('chip/esp-hal-3rdparty/')
+                assert path.is_file(), path
+    print(f'ESP32S31_WIRELESS_MAKE=PASS sources={len(sources)} '
+          'manifests/late-paths/crypto-header-precedence/definitions/libraries')
+
+
+if __name__ == '__main__':
+    main()

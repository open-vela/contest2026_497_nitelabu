+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Exercise the actual RMT write wrapper's input and errno contract."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from test_esp_hr_timer_lifecycle import definition
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--revision')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    filename = 'arch/risc-v/src/common/espressif/esp_rmt.c'
+    source = (subprocess.check_output(['git', 'show', f'{args.revision}:{filename}'],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    fixture = r'''
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <time.h>
+#define DEBUGASSERT assert
+#define rmterr(...) ((void)0)
+#define RMT_MODE_TX 1
+typedef int rmt_mode_t;
+typedef uint32_t rmt_item32_t;
+struct rmt_dev_s;
+struct rmt_dev_lowerhalf_s { int mode, minor; };
+static unsigned calls;
+static int result;
+static const uint32_t *expected;
+static bool oom;
+static int live;
+static void *kmm_malloc(size_t size)
+{ if (oom) return NULL; live++; return malloc(size); }
+static void kmm_free(void *p) { assert(live == 1); live--; free(p); }
+static int rmt_write_items(int channel, const rmt_item32_t *data,
+                           int count, bool wait)
+{
+  assert(channel == 2 && data != expected && count == 2 && wait && live == 1);
+  assert(memcmp(data, expected, count * sizeof(*data)) == 0);
+  calls++;
+  return result;
+}
+'''
+    fixture += definition(source, 'esp_rmt_write')
+    fixture += r'''
+int main(void)
+{
+  struct rmt_dev_lowerhalf_s lower = {RMT_MODE_TX, 2};
+  struct rmt_dev_s *dev = (struct rmt_dev_s *)&lower;
+  uint32_t data[2] = {1, 2};
+  expected = data;
+  assert(esp_rmt_write(dev, (char *)data, sizeof(data)) == sizeof(data));
+  assert(calls == 1);
+  const int errors[] = {-EIO, -ENOMEM, -EINTR, -ETIMEDOUT};
+  for (unsigned i = 0; i < sizeof(errors) / sizeof(errors[0]); i++)
+    {
+      result = errors[i];
+      assert(esp_rmt_write(dev, (char *)data, sizeof(data)) == result);
+    }
+  assert(calls == 5);
+  oom = true;
+  assert(esp_rmt_write(dev, (char *)data, sizeof(data)) == -ENOMEM);
+  oom = false;
+  assert(calls == 5 && live == 0);
+  assert(esp_rmt_write(dev, NULL, 0) == 0);
+  assert(esp_rmt_write(dev, NULL, 4) == -EINVAL);
+  assert(esp_rmt_write(dev, (char *)data, 5) == -EINVAL);
+  assert(esp_rmt_write(dev, (char *)data, (size_t)SSIZE_MAX + 1) == -EINVAL);
+  assert(esp_rmt_write(dev, (char *)data,
+                      ((size_t)INT_MAX + 1) * sizeof(uint32_t)) == -EINVAL);
+  lower.mode = 0;
+  assert(esp_rmt_write(dev, (char *)data, sizeof(data)) == -EINVAL);
+  assert(calls == 5);
+  puts("ESP_RMT_WRITE=PASS bytes/errno/zero/null/length-alignment/overflow/mode");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='esp-rmt-write-') as directory:
+        path = Path(directory)
+        (path / 'test.c').write_text(fixture)
+        subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-unused-variable', '-fsanitize=undefined',
+                        '-fno-sanitize-recover=all', str(path / 'test.c'),
+                        '-o', str(path / 'test')], check=True)
+        subprocess.run([str(path / 'test')], check=True)
+
+
+if __name__ == '__main__':
+    main()

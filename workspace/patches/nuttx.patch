+    filename = 'net/arp/arp_table.c'
+    source = (subprocess.check_output(['git', 'show', f'{args.revision}:{filename}'],
+                                      cwd=root, text=True)
+              if args.revision else (root / filename).read_text())
+    fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define FAR
+#define LPWORK 0
+#define OK 0
+#define ARP_INPROGRESS_TICK 100
+typedef unsigned in_addr_t;
+typedef int irqstate_t;
+static int g_arp_queue_lock;
+struct ether_addr { unsigned char bytes[6]; };
+static const struct ether_addr g_zero_ethaddr;
+struct iob_s { int id; };
+struct iob_queue_s { struct iob_s *qh_head, *qh_tail; };
+struct arp_entry_s { struct ether_addr at_ethaddr; struct iob_queue_s at_queue; int at_work; };
+struct net_driver_s { int unused; };
+static struct arp_entry_s entry;
+static struct net_driver_s device;
+static struct iob_s old_item, new_item;
+static bool locked, missing, available = true, reenqueue;
+static int queue_result, freed, scheduled;
+static irqstate_t spin_lock_irqsave_nopreempt(int *lock)
+{ assert(lock == &g_arp_queue_lock && !locked); locked = true; return 17; }
+static void spin_unlock_irqrestore_nopreempt(int *lock, irqstate_t flags)
+{ assert(lock == &g_arp_queue_lock && locked && flags == 17); locked = false; }
+static struct arp_entry_s *arp_lookup(in_addr_t ip, struct net_driver_s *dev)
+{ assert(ip == 1 && dev == &device); return missing ? NULL : &entry; }
+static int iob_tryadd_queue(struct iob_s *iob, struct iob_queue_s *queue)
+{
+  assert(locked && queue == &entry.at_queue);
+  if (queue_result < 0) return queue_result;
+  assert(!queue->qh_head);
+  queue->qh_head = queue->qh_tail = iob;
+  return 0;
+}
+static bool work_available(int *work) { assert(work == &entry.at_work); return available; }
+static int work_queue(int id, int *work, void (*fn)(void *), void *arg, int delay)
+{
+  assert(id == LPWORK && work == &entry.at_work && fn && arg == &entry);
+  assert(!locked && delay == ARP_INPROGRESS_TICK);
+  scheduled++;
+  return 0;
+}
+static int arp_queue_iob(struct net_driver_s *, in_addr_t, struct iob_s *);
+static void iob_free_queue(struct iob_queue_s *queue)
+{
+  assert(!locked && queue != &entry.at_queue);
+  assert(queue->qh_head == &old_item && queue->qh_tail == &old_item);
+  assert(entry.at_queue.qh_head == NULL && entry.at_queue.qh_tail == NULL);
+  if (reenqueue)
+    {
+      assert(arp_queue_iob(&device, 1, &new_item) == 0);
+    }
+  freed++;
+  queue->qh_head = queue->qh_tail = NULL;
+}
+'''
+    fixture += definition(source, 'arp_unreach_work')
+    fixture += '\n' + definition(source, 'arp_queue_iob')
+    fixture += r'''
+int main(void)
+{
+  assert(arp_queue_iob(&device, 1, &old_item) == 0);
+  assert(scheduled == 1 && !locked && entry.at_queue.qh_head == &old_item);
+  reenqueue = true;
+  arp_unreach_work(&entry);
+  assert(freed == 1 && !locked && scheduled == 2);
+  assert(entry.at_queue.qh_head == &new_item && entry.at_queue.qh_tail == &new_item);
+  entry.at_queue = (struct iob_queue_s){0};
+  queue_result = -ENOMEM;
+  assert(arp_queue_iob(&device, 1, &old_item) == -ENOMEM);
+  assert(!locked && scheduled == 2 && !entry.at_queue.qh_head);
+  queue_result = 0;
+  missing = true;
+  assert(arp_queue_iob(&device, 1, &old_item) == -ENOENT);
+  missing = false;
+  entry.at_ethaddr.bytes[0] = 1;
+  assert(arp_queue_iob(&device, 1, &old_item) == -ENOENT);
+  entry.at_ethaddr = g_zero_ethaddr;
+  available = false;
+  assert(arp_queue_iob(&device, 1, &old_item) == 0);
+  assert(!locked && scheduled == 2);
+  puts("ARP_QUEUE_EXPIRY=PASS shared-lock/detach/free-outside-lock/requeue/errors");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='arp-queue-expiry-') as directory:

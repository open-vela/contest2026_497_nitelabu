@@ -0,0 +1,245 @@
+# ##############################################################################
+# arch/risc-v/src/esp32s31/CMakeLists.txt
+#
+# SPDX-License-Identifier: Apache-2.0
+# ##############################################################################
+
+include(${CMAKE_CURRENT_SOURCE_DIR}/esp32s31_espressif.cmake)
+
+if(CONFIG_ESPRESSIF_SIMPLE_BOOT)
+  # Current openvela CMake only emits its generic hex output.  Produce the
+  # Espressif ROM image as a separate S31 target, then add the digest required
+  # by the S31 ROM.  The resulting image is flashed at 0x2000 (see Config.mk).
+
+  find_package(Python3 REQUIRED COMPONENTS Interpreter)
+  find_program(ESP32S31_ESPTOOL NAMES esptool esptool.py REQUIRED)
+
+  if(CONFIG_ESPRESSIF_FLASH_16M)
+    set(ESP32S31_FLASH_SIZE 16MB)
+  elseif(CONFIG_ESPRESSIF_FLASH_8M)
+    set(ESP32S31_FLASH_SIZE 8MB)
+  elseif(CONFIG_ESPRESSIF_FLASH_4M)
+    set(ESP32S31_FLASH_SIZE 4MB)
+  else()
+    set(ESP32S31_FLASH_SIZE 2MB)
+  endif()
+
+  if(CONFIG_ESPRESSIF_FLASH_MODE_QIO)
+    set(ESP32S31_FLASH_MODE qio)
+  elseif(CONFIG_ESPRESSIF_FLASH_MODE_QOUT)
+    set(ESP32S31_FLASH_MODE qout)
+  elseif(CONFIG_ESPRESSIF_FLASH_MODE_DOUT)
+    set(ESP32S31_FLASH_MODE dout)
+  else()
+    set(ESP32S31_FLASH_MODE dio)
+  endif()
+
+  if(CONFIG_ESPRESSIF_FLASH_FREQ_80M)
+    set(ESP32S31_FLASH_FREQ 80m)
+  elseif(CONFIG_ESPRESSIF_FLASH_FREQ_48M)
+    set(ESP32S31_FLASH_FREQ 48m)
+  elseif(CONFIG_ESPRESSIF_FLASH_FREQ_40M)
+    set(ESP32S31_FLASH_FREQ 40m)
+  elseif(CONFIG_ESPRESSIF_FLASH_FREQ_26M)
+    set(ESP32S31_FLASH_FREQ 26m)
+  else()
+    set(ESP32S31_FLASH_FREQ 20m)
+  endif()
+
+  set(ESP32S31_SIMPLE_BOOT_IMAGE ${CMAKE_BINARY_DIR}/nuttx.bin)
+  set(ESP32S31_SIMPLE_BOOT_DIGEST
+      ${NUTTX_DIR}/tools/espressif/esp32s31_simple_boot_digest.py)
+  add_custom_command(
+    OUTPUT ${ESP32S31_SIMPLE_BOOT_IMAGE}
+    COMMAND
+      ${ESP32S31_ESPTOOL} --chip esp32s31 elf2image --ram-only-header
+      --flash-size ${ESP32S31_FLASH_SIZE} --flash-mode ${ESP32S31_FLASH_MODE}
+      --flash-freq ${ESP32S31_FLASH_FREQ} -o ${ESP32S31_SIMPLE_BOOT_IMAGE}
+      $<TARGET_FILE:nuttx>
+    COMMAND ${Python3_EXECUTABLE} ${ESP32S31_SIMPLE_BOOT_DIGEST}
+            ${ESP32S31_SIMPLE_BOOT_IMAGE}
+    DEPENDS nuttx ${ESP32S31_SIMPLE_BOOT_DIGEST}
+    COMMENT "Generating ESP32-S31 simple-boot image for offset 0x2000"
+    VERBATIM)
+  add_custom_target(esp32s31_simple_boot_image
+                    DEPENDS ${ESP32S31_SIMPLE_BOOT_IMAGE})
+  add_custom_target(nuttx_post_build
+                    DEPENDS esp32s31_simple_boot_image)
+endif()
+
+target_compile_definitions(arch PRIVATE _RETARGETABLE_LOCKING)
+target_sources(arch PRIVATE esp_chip_rev.c)
+
+if(CONFIG_ESP32S31_KORVO_RGB565)
+  target_sources(arch PRIVATE esp32s31_lcd.c
+    ${ESP_HAL_3RDPARTY_REPO}/components/esp_hal_lcd/lcd_hal.c
+    ${ESP_HAL_3RDPARTY_REPO}/components/esp_hal_lcd/${CHIP_SERIES}/lcd_periph.c)
+endif()
+
+if(CONFIG_ESP32S31_USBDEV)
+  target_sources(arch PRIVATE esp32s31_usbdev.c)
+endif()
+
+if(CONFIG_ESP32S31_USBHOST)
+  target_sources(arch PRIVATE esp32s31_usbhost.c)
+endif()
+
+if(CONFIG_ESP32S31_USBHOST_HCD_SKELETON)
+  target_sources(arch PRIVATE esp32s31_usbhost_hcd_skeleton.c)
+endif()
+
+if(CONFIG_ESP32S31_SDMMC)
+  target_sources(arch PRIVATE esp32s31_sdmmc.c esp32s31_sdmmc_os.c)
+  target_include_directories(arch PRIVATE
+    ${ESP_HAL_3RDPARTY_REPO}/components/upper_hal_sdmmc/legacy/include
+    ${ESP_HAL_3RDPARTY_REPO}/components/upper_hal_sdmmc/include
+    ${ESP_HAL_3RDPARTY_REPO}/components/esp_hal_sd/include
+    ${CMAKE_CURRENT_SOURCE_DIR}/../../../../../../s31-reference/tmp/esp-idf-clean/components/sdmmc/include)
+endif()
+
+
+if(CONFIG_ESP32S31_SDMMC_IDF_HOST)
+  set(S31_SD_ROOT ${ESP_HAL_3RDPARTY_REPO}/components)
+  set(S31_SD_SOURCES
+    ${S31_SD_ROOT}/upper_hal_sdmmc/src/sd_host_sdmmc.c
+    ${S31_SD_ROOT}/upper_hal_sdmmc/src/sd_trans_sdmmc.c
+    ${S31_SD_ROOT}/upper_hal_sdmmc/legacy/src/sdmmc_host.c
+    ${S31_SD_ROOT}/upper_hal_sdmmc/legacy/src/sdmmc_transaction.c
+    ${S31_SD_ROOT}/upper_hal_sd_intf/sd_host.c
+    ${S31_SD_ROOT}/esp_hal_sd/sdmmc_hal.c
+    ${S31_SD_ROOT}/esp_hal_sd/${CHIP_SERIES}/sdmmc_periph.c)
+  target_sources(arch PRIVATE ${S31_SD_SOURCES})
+  target_include_directories(arch PRIVATE
+    ${S31_SD_ROOT}/upper_hal_sd_intf/include
+    ${S31_SD_ROOT}/esp_hal_sd/${CHIP_SERIES}/include)
+  set_source_files_properties(${S31_SD_SOURCES} TARGET_DIRECTORY arch PROPERTIES
+    COMPILE_OPTIONS "-include;${CMAKE_CURRENT_SOURCE_DIR}/include/esp32s31_sdmmc_idf_compat.h;-Wall;-Werror")
+endif()
+
+if(CONFIG_ESP32S31_CAMERA_DVP)
+  set(ESP32S31_CAM_ROOT ${ESP_HAL_3RDPARTY_REPO}/components/upper_hal_cam)
+  # The locked GCC toolchain requires the post-20191213 Zifencei spelling for
+  # the common RISC-V FPU context assembly.  Keep this correction local to the
+  # build-only camera profile until the shared toolchain configuration is
+  # audited separately.
+  target_compile_options(arch PRIVATE -march=rv32imafc_zicsr_zifencei)
+  target_sources(arch PRIVATE
+    esp32s31_camera_dvp.c
+    ${ESP32S31_CAM_ROOT}/esp_cam_ctlr.c
+    ${ESP32S31_CAM_ROOT}/dvp_share_ctrl.c
+    ${ESP32S31_CAM_ROOT}/dvp/src/esp_cam_ctlr_dvp_cam.c
+    ${ESP32S31_CAM_ROOT}/dvp/src/esp_cam_ctlr_dvp_gdma.c
+    ${ESP_HAL_3RDPARTY_REPO}/components/esp_hal_cam/cam_hal.c
+    ${ESP_HAL_3RDPARTY_REPO}/components/esp_hal_cam/${CHIP_SERIES}/cam_periph.c
+    ${ESP_HAL_3RDPARTY_REPO}/components/hal/color_hal.c)
+  target_include_directories(arch PRIVATE
+    ${ESP32S31_CAM_ROOT}/include
+    ${ESP32S31_CAM_ROOT}/interface
+    ${ESP32S31_CAM_ROOT}/dvp/include
+    ${ESP32S31_CAM_ROOT}/dvp/private_include
+    ${ESP_HAL_3RDPARTY_REPO}/components/hal/include)
+endif()
+
+if(CONFIG_ESP32S31_BLE)
+  include(${CMAKE_CURRENT_SOURCE_DIR}/esp32s31_bluetooth.cmake)
+endif()
+
+if(CONFIG_ESP32S31_I2S)
+  if(CONFIG_ESP32S31_I2S_DUPLEX)
+    target_sources(arch PRIVATE esp32s31_i2s_duplex.c)
+  else()
+    target_sources(arch PRIVATE esp32s31_i2s.c)
+  endif()
+  target_sources(arch PRIVATE
+    ${ESP_HAL_3RDPARTY_REPO}/components/esp_hal_i2s/i2s_hal.c)
+endif()
+
+if(CONFIG_ESP32S31_XTS_PWM)
+  target_sources(arch PRIVATE esp32s31_pwm.c)
+endif()
+
+if(CONFIG_ESP32S31_XTS_ADC)
+  target_sources(arch PRIVATE esp32s31_adc.c)
+endif()
+
+if(CONFIG_BUILD_FLAT AND CONFIG_ESPRESSIF_SPIRAM_USER_HEAP
+   AND CONFIG_MM_REGIONS GREATER 1)
+  target_sources(arch PRIVATE esp32s31_heap.c)
+  target_link_options(nuttx PRIVATE -Wl,--wrap=heap_caps_add_region_with_caps)
+endif()
+
+if(CONFIG_ESP32S31_CRYPTO_AES_CBC)
+  target_sources(arch PRIVATE esp32s31_crypto.c
+    ${ESP_HAL_3RDPARTY_REPO}/components/esp_security/src/esp_crypto_lock.c)
+endif()
+
+if(CONFIG_ESP32S31_CRYPTO_ECC_POINT_MULT)
+  target_sources(arch PRIVATE esp32s31_ecc.c)
+endif()
+
+if(CONFIG_ESP32S31_CRYPTO_ECDSA_VERIFY)
+  target_sources(arch PRIVATE esp32s31_ecdsa.c)
+endif()
+
+if(CONFIG_ESP32S31_CRYPTO_SHA)
+  target_sources(arch PRIVATE esp32s31_sha.c)
+endif()
+
+if(CONFIG_RTC_DRIVER AND CONFIG_RTC_PERIODIC)
+  target_sources(arch PRIVATE esp32s31_rtc_periodic.c)
+endif()
+
+if(CONFIG_ARCH_RISCV_INTXCPT_EXTENSIONS)
+  target_sources(arch PRIVATE esp32s31_intctx.c)
+endif()
+
+if(CONFIG_ESPRESSIF_WIFI)
+  include(${CMAKE_CURRENT_SOURCE_DIR}/esp32s31_wireless.cmake)
+
+  # The NuttX Wi-Fi OS adapter is shared by the RV32 Espressif targets.  S31
+  # uses ABI v9; target-specific fields are selected in the adapter with
+  # CONFIG_IDF_TARGET_ESP32S31.
+  target_sources(arch PRIVATE ../esp32c6/esp_coex_adapter.c
+                              ../esp32c6/esp_wifi_adapter.c)
+  if(CONFIG_BUILD_KERNEL)
+    target_sources(arch PRIVATE esp32s31_wifi_event.c)
+  endif()
+endif()
+
+if(CONFIG_ARCH_USE_S_MODE)
+  target_sources(arch PRIVATE esp32s31_supervisor.S esp32s31_monstat.c
+                              esp32s31_flash_guard.c)
+endif()
+
+if(CONFIG_ESP32S31_SMP)
+  target_sources(arch PRIVATE esp32s31_cpu1_boot.S esp32s31_cpu1_boot.c)
+endif()
+
+if(CONFIG_ESP32S31_SMP)
+  target_sources(arch PRIVATE esp32s31_smp.c)
+endif()
+
+if(CONFIG_ESP32S31_SMP_TLB_SHOOTDOWN)
+  target_sources(arch PRIVATE esp32s31_tlb.c)
+endif()
+
+if(CONFIG_BUILD_KERNEL)
+  target_sources(arch PRIVATE esp32s31_mm_init.c esp32s31_pgalloc.c
+                              esp32s31_smode_libc.c)
+  target_link_options(nuttx PRIVATE
+                      -Wl,-u,esp32s31_smode_libc_keep)
+endif()
+
+if(CONFIG_ESP32S31_RWDT)
+  target_sources(arch PRIVATE esp32s31_wdt.c)
+endif()
+
+# Flash instructions and read-only data use the same unified cache virtual
+# address window.  The linker script intentionally overlays a NOLOAD rodata
+# cursor on .flash.text.
+
+target_link_options(nuttx PRIVATE -Wl,--no-check-sections)
+
+if(CONFIG_ESP32S31_WDT_ROM_DELAY)
+  target_sources(arch PRIVATE esp32s31_wdt_delay.c)
+endif()
diff --git a/arch/risc-v/src/esp32s31/Kconfig b/arch/risc-v/src/esp32s31/Kconfig
new file mode 100644
index 00000000000..b19a34b4df9
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/Kconfig
@@ -0,0 +1,366 @@
+#
+# For a description of the syntax of this configuration file,
+# see the file kconfig-language.txt in the NuttX tools repository.
+#
+
+if ARCH_CHIP_ESP32S31
+
+comment "ESP32-S31 Configuration Options"
+
+config ESP32S31_WIFI_RX_STATS
+	bool "Wi-Fi receive queue diagnostic statistics"
+	default n
+	depends on ESPRESSIF_WIFI
+	select NET_STATISTICS
+	select ARCH_HAVE_NETDEV_STATISTICS
+	select NETDEV_STATISTICS
+	---help---
+		Collect delivered receive packets and receive queue allocation drops
+		for throughput diagnostics, together with queued TX packets and TX
+		completion callbacks.
+		No periodic packet logging is enabled.
+
+config ESP32S31_PIE
+	bool "CPU1 PIE SIMD context support"
+	depends on ESP32S31_SMP && ARCH_USE_S_MODE && RISCV_PERCPU_SCRATCH
+	default n
+	help
+		Preserve the complete PIE register bank across exceptions and task
+		switches. Applications using PIE must pin their threads to CPU1;
+		CPU0 has no PIE hardware. Adds 228 bytes to every context frame
+		and uses an aligned 240-byte temporary stack area during transfers.
+
+source "arch/risc-v/src/common/espressif/Kconfig"
+
+config ESP32S31_SPIFLASH_PSRAM_STACK
+	bool "Run Flash MTD operations on an internal stack"
+	depends on BUILD_FLAT && ESPRESSIF_SPIRAM_USER_HEAP
+	depends on ESPRESSIF_MTD && SCHED_LPWORK
+	default y
+	help
+		Forward calls from external-memory stacks to LPWORK before disabling
+		the external cache. LPWORK must use its internal SRAM BSS stack.
+		Calls already using internal SRAM execute directly.
+
+config ESP32S31_FLASH_DIRECT_WORKER
+	bool "Wake the internal-stack Flash worker directly"
+	depends on ESP32S31_SPIFLASH_PSRAM_STACK
+	default n
+	help
+		Use a dedicated 4 KiB internal-SRAM stack and semaphore wakeup for
+		Flash requests from PSRAM stacks. Avoids the next-tick scheduling
+		delay of LPWORK for each small MTD operation. Existing SPI cache
+		guards and request cancellation protection remain in effect.
+
+config ESP32S31_USBDEV
+	bool "S31 UTMI USB device controller (full-speed PIO)"
+	depends on USBDEV && BUILD_FLAT && !SMP && !ESPRESSIF_SPIRAM_USER_HEAP
+	default n
+	help
+		Initial awake device-mode endpoint engine for the dedicated HS PHY.
+		Uses full-speed packets and PIO. The board Type-A connector sources
+		VBUS; a verified isolated device connection is required for testing.
+
+config ESP32S31_USBHOST
+	bool "S31 OTG host register initialization (experimental)"
+	depends on USBHOST && !ESP32S31_USBDEV && !SMP
+	default n
+	help
+		Prepare the S31 OTG core for host mode, select the integrated
+		HS UTMI PHY clock and request Type-A VBUS. This option is an
+		experimental hardware boundary; enabling it alone is not USB
+		enumeration or
+		xTS pass evidence. Keep it disabled in the normal image.
+
+config ESP32S31_USBHOST_HCD_SKELETON
+	bool "S31 USB Host synchronous PIO HCD candidate"
+	depends on ESP32S31_USBHOST
+	default n
+	help
+		Compile S31 endpoint management and synchronous control/bulk PIO
+		transfers using the DWC2 channel state engine. Periodic/asynchronous
+		scheduling remain ENOSYS. A polling root port and common enumeration
+		worker are available; actual device transfers are unverified. This
+		option must remain disabled for production or
+		xTS images.
+
+config ESP32S31_OTG_ENDPOINT_NUM
+	int "Additional USB device endpoints"
+	depends on ESP32S31_USBDEV
+	range 1 3
+	default 3
+
+config ESP32S31_SDMMC
+	bool "S31 SDMMC slot 0 to NuttX MMCSD bridge (experimental)"
+	depends on !SMP
+	select MMCSD
+	select MMCSD_SDIO
+	select SDIO_BLOCKSETUP
+	select ARCH_HAVE_SDIO
+	default n
+	help
+		Expose the Function-CoreBoard-1 external slot 0 (GPIO20-25) through
+		the NuttX sdio_dev_s/MMCSD upper half using the locked ESP-IDF SDMMC
+		command ABI. This is an isolated candidate: HAL dependencies, DMA/IRQ
+		completion and external-card read/write evidence remain outstanding.
+		Keep disabled in normal profiles.
+
+config ESP32S31_SDMMC_IDF_HOST
+	bool "Link the real locked SDMMC controller and transaction engine"
+	depends on ESP32S31_SDMMC
+	default n
+	help
+		Use strong SD host references and NuttX synchronization. Experimental:
+		external card, interrupt and DMA validation are still required.
+
+config ESP32S31_BLE
+	bool "S31 BLE controller with NuttX OSAL and VHCI"
+	depends on (BUILD_FLAT && !SMP && !ESPRESSIF_WIFI) || (BUILD_KERNEL && ESP32S31_SMP)
+	depends on !ESPRESSIF_SPIRAM_USER_HEAP && RTC_DRIVER
+	select DRIVERS_BLUETOOTH
+	select UART_BTH4
+	default n
+	help
+		Awake BLE-only controller, exposed through /dev/ttyHCI0.
+		Kernel builds dispatch controller operations on a CPU0 kernel task.
+		All controller memory and task stacks must remain in internal SRAM.
+		Kernel Wi-Fi builds use the pinned software coexistence adapter.
+
+config ESP32S31_I2S
+	bool "S31 I2S0 with dedicated AHB DMA channel 0"
+	depends on (BUILD_FLAT && !SMP && !ESPRESSIF_WIFI) || (BUILD_KERNEL && AUDIO_PROCESS_OWNERSHIP)
+	select I2S
+	default n
+	help
+		Initial half-duplex I2S0 driver for the board audio profile.
+		AHB DMA channel pair 0 is reserved exclusively for this driver.
+		Other AHB DMA users must not be enabled in this profile.
+
+config ESP32S31_I2S_DUPLEX
+	bool "S31 isolated 48 kHz full-duplex I2S stream engine"
+	depends on ESP32S31_I2S && !AUDIO_MULTI_SESSION && !AUDIO_EXCLUDE_STOP
+	default n
+	help
+		Use separate continuous RX/TX DMA rings for the board nxlooper
+		profile. RX owns the shared clocks and TX is a slave. Only 48 kHz,
+		16-bit, two-slot PCM is supported. This replaces the half-duplex
+		transport only when explicitly selected.
+
+config ESP32S31_I2S_DUPLEX_WORKER_PRIORITY
+	int "S31 continuous I2S DMA worker priority"
+	depends on ESP32S31_I2S_DUPLEX
+	range 1 255
+	default 240
+	help
+		The worker must replenish the DMA ring before it wraps. Media
+		profiles may raise this above their graph/codec task priorities.
+
+config ESP32S31_I2S_CAPTURE_16K_MONO
+	bool "Use continuous native 16 kHz mono capture"
+	depends on ESP32S31_I2S_DUPLEX && ES8311_SHARED_DUPLEX
+	depends on !ESP32S31_I2S_DUPLEX_44K
+	default n
+	help
+		Select the physical ES8311 left ADC slot in hardware for the
+		original 16 kHz mono capture case. No resampling or CPU slot
+		discarding is used. Playback is not exposed by this profile.
+
+config ESP32S31_I2S_DUPLEX_44K
+	bool "Use fixed 44.1 kHz continuous audio for original capture test"
+	depends on ESP32S31_I2S_DUPLEX && ES8311_SHARED_DUPLEX
+	default n
+	help
+		Use 11.2896 MHz MCLK, 44.1 kHz stereo slots and explicit Philips
+		left alignment for the original audio capture/playback case.
+		The default nxlooper profile remains fixed at 48 kHz.
+
+config ESP32S31_WDT_ROM_DELAY
+	bool "Use calibrated ROM busy delays for the watchdog candidate"
+	depends on ESP32S31_RWDT && !ALARM_ARCH && !TIMER_ARCH
+	default n
+	help
+		Replace the generic uncalibrated loop delays only in this opt-in
+		watchdog profile. Check one 500 ms delay during board startup.
+
+config ESP32S31_RWDT
+	bool "S31 RTC watchdog with fatal high-priority interrupt"
+	depends on BUILD_FLAT && !ARCH_USE_S_MODE
+	select WATCHDOG
+	select ARCH_RV_HAVE_CLIC
+	select ARCH_HAVE_IRQPRIO
+	select ARCH_HAVE_HIPRI_INTERRUPT
+	select ARCH_HIPRI_INTERRUPT
+	help
+		Use the LP RTC watchdog, with a priority-7 fatal interrupt followed
+		by a hardware RTC-system reset. Normal critical sections mask
+		priorities 1..6; capture callbacks use priority 1. This initial
+		integration is limited to the single-core M-mode FLAT profile.
+
+config ESP32S31_CRYPTO_AES_CBC
+	bool "Hardware AES-CBC cryptodev backend"
+	depends on CRYPTO_CRYPTODEV
+	select CRYPTO_CRYPTODEV_HARDWARE
+	help
+		Use the S31 AES engine in PIO mode for 128/256-bit CBC sessions.
+		AES-192, chained sessions and persistent key IDs are unsupported.
+		Other algorithms may continue to use the existing software backend.
+
+config ESP32S31_CRYPTO_AES_MODES
+	bool "Hardware AES-CTR and AES-XTS cryptodev modes"
+	depends on ESP32S31_CRYPTO_AES_CBC
+	help
+		Reuse the PIO AES engine for full-block CTR and XTS requests,
+		including streaming updates. AES-192 remains unsupported by the
+		hardware. XTS uses two volatile AES keys, not Flash encryption keys.
+
+config ESP32S31_CRYPTO_SHA
+	bool "Hardware SHA1/SHA256/SHA512 cryptodev backend"
+	depends on ESP32S31_CRYPTO_AES_CBC
+	help
+		Use aligned PIO blocks and saved per-session hardware digest state
+		for the original SHA streaming API. Share peripheral ownership with
+		AES. MD5 and keyed HMAC continue using their existing backends.
+
+config ESP32S31_CRYPTO_HMAC
+	bool "SHA-accelerated HMAC-SHA1/SHA256 cryptodev backend"
+	depends on ESP32S31_CRYPTO_SHA
+	help
+		Compute inner and outer HMAC digests with the SHA engine and
+		ordinary volatile keys up to 64 bytes. Longer keys and HMAC-MD5
+		remain with the software backend. This does not use the separate
+		eFuse-keyed HMAC peripheral or provision any permanent keys.
+
+config ESP32S31_CRYPTO_ECDSA_VERIFY
+	bool "Hardware ECDSA P256 verification"
+	depends on ESP32S31_CRYPTO_AES_CBC
+	help
+		Use the ECDSA/ECC peripheral to verify P256 signatures using normal
+		public coordinates and a caller-provided digest. Key generation and
+		signing stay in software. No eFuse keys are selected or programmed.
+
+config ESP32S31_CRYPTO_ECC_POINT_MULT
+	bool "Hardware ECC P256 point multiplication"
+	depends on ESP32S31_CRYPTO_AES_CBC
+	select CRYPTO_ECC_P256_POINT_MULT
+	help
+		Accelerate volatile-key generation and signing point multiplication
+		with the ECC engine. Scalar arithmetic stays in the existing ECC
+		library. Enable hardware constant-time mode and verify input points.
+
+config ESPRESSIF_DONT_USE_ROM_LIBC
+	bool "Don't use ROM libc functions"
+	default n
+	help
+		Use NuttX libc instead of ROM newlib functions.  This prevents
+		cross-heap allocation when external RAM is part of a NuttX heap.
+
+menuconfig ESPRESSIF_SPIRAM
+	bool "External SPI RAM (SPIRAM)"
+	default n
+	help
+		Enable ESP32-S31 external PSRAM support through the locked ESP HAL.
+
+if ESPRESSIF_SPIRAM
+
+config ESPRESSIF_SPIRAM_BOOT_INIT
+	bool "Initialize SPIRAM during early boot"
+	default y
+
+config ESPRESSIF_SPIRAM_IGNORE_NOTFOUND
+	bool "Ignore SPIRAM not found"
+	depends on !ESPRESSIF_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
+	default n
+
+config ESPRESSIF_SPIRAM_MEMTEST
+	bool "Run SPIRAM memory test at boot"
+	default n
+
+config ESPRESSIF_SPIRAM_USE_8LINE_MODE
+	bool "Use x8 line mode"
+	default n
+
+config ESPRESSIF_SPIRAM_ECC
+	bool "Enable SPIRAM ECC"
+	default n
+
+choice ESPRESSIF_SPIRAM_SPEED
+	prompt "SPIRAM speed"
+	default ESPRESSIF_SPIRAM_SPEED_80M
+
+config ESPRESSIF_SPIRAM_SPEED_20M
+	bool "20 MHz"
+
+config ESPRESSIF_SPIRAM_SPEED_80M
+	bool "80 MHz"
+
+config ESPRESSIF_SPIRAM_SPEED_200M
+	bool "200 MHz"
+
+config ESPRESSIF_SPIRAM_SPEED_250M
+	bool "250 MHz"
+
+endchoice
+
+config ESPRESSIF_SPIRAM_SPEED
+	int
+	default 20 if ESPRESSIF_SPIRAM_SPEED_20M
+	default 80 if ESPRESSIF_SPIRAM_SPEED_80M
+	default 200 if ESPRESSIF_SPIRAM_SPEED_200M
+	default 250 if ESPRESSIF_SPIRAM_SPEED_250M
+
+config ESPRESSIF_SPIRAM_USER_HEAP
+	bool "Add SPIRAM to user heap"
+	default y
+	select ESPRESSIF_DONT_USE_ROM_LIBC
+
+config ESPRESSIF_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
+	bool "Allow .bss segment placement in external memory"
+	default n
+
+endif # ESPRESSIF_SPIRAM
+
+config ESP32S31_SMP
+	bool "Enable the ESP32-S31 two-core NuttX SMP port"
+	depends on SMP
+	depends on SMP_NCPUS = 2
+	depends on ARCH_USE_S_MODE
+	depends on ESPRESSIF_SIMPLE_BOOT
+	depends on BUILD_KERNEL
+	help
+		Start CPU1 through the ESP32-S31 per-hart M-mode monitor, release it
+		from nx_smp_start(), and use the S31 cross-core interrupt sources for
+		NuttX reschedule and SMP-call delivery.  Production enables this with
+		CONFIG_SMP_DEFAULT_CPUSET covering both harts.
+
+config ESP32S31_SMP_TLB_SHOOTDOWN
+	bool "Cross-core TLB shootdown for address environments"
+	default y
+	depends on ESP32S31_SMP
+	depends on ARCH_ADDRENV
+	select ARCH_RV_TLB_SHOOTDOWN
+	help
+		After a mapping, unmapping, permission change, or address-environment
+		destroy, invalidate remote-hart TLB entries with a generation/ack
+		mailbox delivered over the existing SMP IPI.  Required so heap grow,
+		pthread stacks, and App exit stay coherent when the same Sv32 addrenv
+		is active on more than one CPU.
+
+config ESP32S31_SMP_TLB_SHOOTDOWN_TIMEOUT_US
+	int "TLB shootdown acknowledgement timeout (microseconds)"
+	depends on ESP32S31_SMP_TLB_SHOOTDOWN
+	range 1000 5000000
+	default 500000
+
+config ESP32S31_CPU1_BOOT_TIMEOUT_US
+	int "CPU1 bring-up handshake timeout (microseconds)"
+	depends on ESP32S31_SMP
+	range 1000 5000000
+	default 500000
+
+config ESP32S31_CPU1_BOOT_STACKSIZE
+	int "CPU1 bring-up stack size"
+	depends on ESP32S31_SMP
+	range 256 4096
+	default 1024
+
+endif # ARCH_CHIP_ESP32S31
diff --git a/arch/risc-v/src/esp32s31/Make.defs b/arch/risc-v/src/esp32s31/Make.defs
new file mode 100644
index 00000000000..ffe0284d36b
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/Make.defs
@@ -0,0 +1,165 @@
+############################################################################
+# arch/risc-v/src/esp32s31/Make.defs
+#
+# SPDX-License-Identifier: Apache-2.0
+############################################################################
+
+ESP_HAL_3RDPARTY_VERSION = 290edc31b50decca660c1a11ce3506fd9b2e1e27
+ESP_HAL_3RDPARTY_URL = https://github.com/78/esp-hal-3rdparty.git
+
+include common/Make.defs
+include common/espressif/Make.defs
+
+CHIP_CSRCS += esp_chip_rev.c
+
+ifeq ($(CONFIG_ESP32S31_KORVO_RGB565),y)
+CHIP_CSRCS += esp32s31_lcd.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_hal_lcd$(DELIM)lcd_hal.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_hal_lcd$(DELIM)$(CHIP_SERIES)$(DELIM)lcd_periph.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_USBDEV),y)
+CHIP_CSRCS += esp32s31_usbdev.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_USBHOST),y)
+CHIP_CSRCS += esp32s31_usbhost.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_USBHOST_HCD_SKELETON),y)
+CHIP_CSRCS += esp32s31_usbhost_hcd_skeleton.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_CAMERA_DVP),y)
+ESP32S31_CAM_ROOT = chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)upper_hal_cam
+CHIP_CSRCS += esp32s31_camera_dvp.c
+CHIP_CSRCS += $(ESP32S31_CAM_ROOT)$(DELIM)esp_cam_ctlr.c
+CHIP_CSRCS += $(ESP32S31_CAM_ROOT)$(DELIM)dvp_share_ctrl.c
+CHIP_CSRCS += $(ESP32S31_CAM_ROOT)$(DELIM)dvp$(DELIM)src$(DELIM)esp_cam_ctlr_dvp_cam.c
+CHIP_CSRCS += $(ESP32S31_CAM_ROOT)$(DELIM)dvp$(DELIM)src$(DELIM)esp_cam_ctlr_dvp_gdma.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_hal_cam$(DELIM)cam_hal.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_hal_cam$(DELIM)$(CHIP_SERIES)$(DELIM)cam_periph.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)hal$(DELIM)color_hal.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_SDMMC),y)
+CHIP_CSRCS += esp32s31_sdmmc.c esp32s31_sdmmc_os.c
+CFLAGS += -I$(TOPDIR)/arch/risc-v/src/esp32s31/esp-hal-3rdparty/components/upper_hal_sdmmc/legacy/include
+CFLAGS += -I$(TOPDIR)/arch/risc-v/src/esp32s31/esp-hal-3rdparty/components/upper_hal_sdmmc/include
+CFLAGS += -I$(TOPDIR)/arch/risc-v/src/esp32s31/esp-hal-3rdparty/components/esp_hal_sd/include
+CFLAGS += -I$(TOPDIR)/../../s31-reference/tmp/esp-idf-clean/components/sdmmc/include
+endif
+
+
+ifeq ($(CONFIG_ESP32S31_SDMMC_IDF_HOST),y)
+ESP32S31_SD_ROOT = chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components
+CHIP_CSRCS += $(ESP32S31_SD_ROOT)$(DELIM)upper_hal_sdmmc$(DELIM)src$(DELIM)sd_host_sdmmc.c
+CHIP_CSRCS += $(ESP32S31_SD_ROOT)$(DELIM)upper_hal_sdmmc$(DELIM)src$(DELIM)sd_trans_sdmmc.c
+CHIP_CSRCS += $(ESP32S31_SD_ROOT)$(DELIM)upper_hal_sdmmc$(DELIM)legacy$(DELIM)src$(DELIM)sdmmc_host.c
+CHIP_CSRCS += $(ESP32S31_SD_ROOT)$(DELIM)upper_hal_sdmmc$(DELIM)legacy$(DELIM)src$(DELIM)sdmmc_transaction.c
+CHIP_CSRCS += $(ESP32S31_SD_ROOT)$(DELIM)upper_hal_sd_intf$(DELIM)sd_host.c
+CHIP_CSRCS += $(ESP32S31_SD_ROOT)$(DELIM)esp_hal_sd$(DELIM)sdmmc_hal.c
+CHIP_CSRCS += $(ESP32S31_SD_ROOT)$(DELIM)esp_hal_sd$(DELIM)$(CHIP_SERIES)$(DELIM)sdmmc_periph.c
+CFLAGS += -I$(TOPDIR)/arch/risc-v/src/esp32s31/esp-hal-3rdparty/components/upper_hal_sd_intf/include
+CFLAGS += -I$(TOPDIR)/arch/risc-v/src/esp32s31/esp-hal-3rdparty/components/esp_hal_sd/$(CHIP_SERIES)/include
+CFLAGS += -include $(TOPDIR)/arch/risc-v/src/esp32s31/include/esp32s31_sdmmc_idf_compat.h
+endif
+
+ifeq ($(CONFIG_ESP32S31_I2S),y)
+ifeq ($(CONFIG_ESP32S31_I2S_DUPLEX),y)
+CHIP_CSRCS += esp32s31_i2s_duplex.c
+else
+CHIP_CSRCS += esp32s31_i2s.c
+endif
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_hal_i2s$(DELIM)i2s_hal.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_XTS_PWM),y)
+CHIP_CSRCS += esp32s31_pwm.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_XTS_ADC),y)
+CHIP_CSRCS += esp32s31_adc.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_RWDT),y)
+CHIP_CSRCS += esp32s31_wdt.c
+endif
+
+ifeq ($(CONFIG_BUILD_FLAT)$(CONFIG_ESPRESSIF_SPIRAM_USER_HEAP),yy)
+ifneq ($(CONFIG_MM_REGIONS),1)
+CHIP_CSRCS += esp32s31_heap.c
+LDFLAGS += --wrap=heap_caps_add_region_with_caps
+endif
+endif
+
+ifeq ($(CONFIG_ESP32S31_CRYPTO_AES_CBC),y)
+CHIP_CSRCS += esp32s31_crypto.c
+CHIP_CSRCS += chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_security$(DELIM)src$(DELIM)esp_crypto_lock.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_CRYPTO_ECC_POINT_MULT),y)
+CHIP_CSRCS += esp32s31_ecc.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_CRYPTO_ECDSA_VERIFY),y)
+CHIP_CSRCS += esp32s31_ecdsa.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_CRYPTO_SHA),y)
+CHIP_CSRCS += esp32s31_sha.c
+endif
+
+ifeq ($(CONFIG_ESPRESSIF_WIFI),y)
+CHIP_CSRCS += esp32s31_phy_timer.c
+LDFLAGS += --wrap=esp_timer_get_time
+endif
+
+ifeq ($(CONFIG_RTC_DRIVER)$(CONFIG_RTC_PERIODIC),yy)
+CHIP_CSRCS += esp32s31_rtc_periodic.c
+endif
+
+ifeq ($(CONFIG_ESPRESSIF_WIFI)$(CONFIG_BUILD_KERNEL),yy)
+CHIP_CSRCS += esp32s31_wifi_task.c
+CHIP_CSRCS += esp32s31_wifi_event.c
+LDFLAGS += --wrap=up_release_stack
+endif
+
+ifeq ($(CONFIG_ARCH_RISCV_INTXCPT_EXTENSIONS),y)
+CHIP_CSRCS += esp32s31_intctx.c
+endif
+
+ifeq ($(CONFIG_ARCH_USE_S_MODE),y)
+CHIP_ASRCS += esp32s31_supervisor.S
+CHIP_CSRCS += esp32s31_monstat.c esp32s31_flash_guard.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_SMP),y)
+CHIP_ASRCS += esp32s31_cpu1_boot_asm.S
+CHIP_CSRCS += esp32s31_cpu1_boot.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_SMP),y)
+CHIP_CSRCS += esp32s31_smp.c
+endif
+
+ifeq ($(CONFIG_ESP32S31_SMP_TLB_SHOOTDOWN),y)
+CHIP_CSRCS += esp32s31_tlb.c
+endif
+
+ifeq ($(CONFIG_BUILD_KERNEL),y)
+CHIP_CSRCS += esp32s31_mm_init.c esp32s31_pgalloc.c esp32s31_smode_libc.c
+LDFLAGS += -u esp32s31_smode_libc_keep
+endif
+
+# ESP32-S31 maps instruction and read-only flash through the same virtual
+# cache window.  The linker script deliberately overlays a NOLOAD rodata
+# cursor on .flash.text, matching the CMake link option in CMakeLists.txt.
+
+LDFLAGS += --no-check-sections
+
+CFLAGS += ${DEFINE_PREFIX}_RETARGETABLE_LOCKING
+
+ifeq ($(CONFIG_ESP32S31_WDT_ROM_DELAY),y)
+CHIP_CSRCS += esp32s31_wdt_delay.c
+endif
diff --git a/arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.S b/arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.S
new file mode 100644
index 00000000000..af77f1b548d
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.S
@@ -0,0 +1,195 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.S
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <arch/irq.h>
+
+#include "esp32s31_cpu1_boot.h"
+
+/****************************************************************************
+ * Public Symbols
+ ****************************************************************************/
+
+  .global esp32s31_cpu1_boot_entry
+  .type   esp32s31_cpu1_boot_entry, function
+
+  .extern g_esp32s31_cpu1_boot_state
+  .extern g_esp32s31_cpu1_hartid
+  .extern esp32s31_start_smode
+  .extern esp32s31_prepare_hart_smode
+  .extern esp32s31_cpu1_smp_entry
+  .extern g_esp32s31_cpu1_smp_release
+  .extern g_idle_topstack
+
+  .global esp32s31_cpu1_smode_entry
+  .type   esp32s31_cpu1_smode_entry, function
+
+  .global esp32s31_cpu1_supervisor_trap
+  .type   esp32s31_cpu1_supervisor_trap, function
+
+/****************************************************************************
+ * CPU1 bring-up stack
+ *
+ * Used only until esp32s31_cpu1_smp_entry switches to the idle task stack.
+ ****************************************************************************/
+
+  .section .bss.esp32s31_cpu1_boot_stack, "aw", @nobits
+  .balign 16
+.Lcpu1_boot_stack:
+  .space CONFIG_ESP32S31_CPU1_BOOT_STACKSIZE
+.Lcpu1_boot_stack_top:
+
+/****************************************************************************
+ * CPU1 entry point
+ ****************************************************************************/
+
+  .section .iram1, "ax", @progbits
+  .balign 0x40
+
+esp32s31_cpu1_boot_entry:
+  .option push
+  .option norelax
+
+  /* Establish all ABI state before using C-visible shared storage. */
+
+  la      gp, __global_pointer$
+  la      sp, .Lcpu1_boot_stack_top
+
+  /* Keep this hart out of NuttX interrupt delivery until it reaches S-mode.
+   * A local trap sink records any unexpected exception without touching CPU0.
+   */
+
+  csrc    mstatus, MSTATUS_MIE
+  csrw    mie, zero
+  la      t0, .Lcpu1_boot_trap
+  ori     t0, t0, 3
+  csrw    mtvec, t0
+
+  csrr    t0, mhartid
+  la      t1, g_esp32s31_cpu1_hartid
+  sw      t0, 0(t1)
+  li      t1, 1
+  bne     t0, t1, .Lcpu1_bad_hart
+
+  /* esp32s31_start_smode installs CPU1's private machine monitor state and
+   * enters the supplied address with mstatus.MPP=S.
+   *
+   * The ROM PMA setup is private to this hart and leaves cached PSRAM RX.
+   * Install the same writable PSRAM aperture as CPU0 before U-mode work can
+   * be scheduled here.  The helper preserves no caller-saved registers, so
+   * load the supervisor entry after it returns.
+   */
+
+  call    esp32s31_prepare_hart_smode
+#ifdef CONFIG_ESP32S31_PIE
+  /* PIE is CPU1-only. Enable in M-mode before entering the S-mode kernel. */
+
+  li      t0, 1
+  csrw    0x7f2, t0
+#endif
+  la      a0, esp32s31_cpu1_smode_entry
+  j       esp32s31_start_smode
+
+.Lcpu1_bad_hart:
+  la      t0, g_esp32s31_cpu1_boot_state
+  li      t1, ESP32S31_CPU1_BOOT_BAD_HART
+  sw      t1, 0(t0)
+  fence   rw, rw
+  j       .Lcpu1_fault_park
+
+  .balign 0x40
+.Lcpu1_boot_trap:
+  la      t0, g_esp32s31_cpu1_boot_state
+  li      t1, ESP32S31_CPU1_BOOT_MMODE_FAULT
+  sw      t1, 0(t0)
+  fence   rw, rw
+
+.Lcpu1_fault_park:
+  j       .Lcpu1_fault_park
+
+  .option pop
+  .size esp32s31_cpu1_boot_entry, .-esp32s31_cpu1_boot_entry
+
+/****************************************************************************
+ * CPU1 S-mode entry and trap sink
+ ****************************************************************************/
+
+  .balign 0x40
+esp32s31_cpu1_smode_entry:
+  /* The trap shim below distinguishes "per-CPU area installed" from "still
+   * bringing up" by reading sscratch, so give it a defined starting value
+   * before anything can trap.
+   */
+
+  csrw    sscratch, zero
+
+  /* Service 9 returns one only for an S-mode ecall handled by the machine
+   * monitor.  Reaching this point and completing that round trip proves both
+   * sides of the CPU1 privilege transition before publishing READY.
+   */
+
+  li      a0, 9
+  ecall
+  li      t0, 1
+  bne     a0, t0, .Lcpu1_smode_fault
+
+  csrc    sstatus, SSTATUS_SIE
+  la      t0, g_esp32s31_cpu1_boot_state
+  li      t1, ESP32S31_CPU1_SMP_READY
+  sw      t1, 0(t0)
+  fence   rw, rw
+
+.Lcpu1_smp_wait:
+  la      t0, g_esp32s31_cpu1_smp_release
+  lw      t1, 0(t0)
+  beqz    t1, .Lcpu1_smp_wait
+  fence   rw, rw
+
+  /* CPU1 owns the upper reserved idle stack.  nx_start has initialized its
+   * TCB and stack metadata before up_cpu_start releases this loop. */
+
+  la      t0, g_idle_topstack
+  lw      sp, 0(t0)
+  andi    sp, sp, -16
+  call    esp32s31_cpu1_smp_entry
+  j       .Lcpu1_smode_fault
+
+  .size esp32s31_cpu1_smode_entry, .-esp32s31_cpu1_smode_entry
+
+  .balign 0x40
+esp32s31_cpu1_supervisor_trap:
+  /* Use the complete NuttX trap machinery only after sscratch has acquired
+   * CPU1's per-CPU area.  SIE is clear before that point, but a synchronous
+   * exception must still fail cleanly instead of recursively faulting in
+   * _interrupt_handler while dereferencing an empty sscratch.
+   *
+   * The machine monitor forwards every CPU1 trap here, interrupts included,
+   * with the interrupted context still live in the integer registers.  Swap
+   * the probe through sscratch itself rather than loading a flag into a
+   * temporary: a plain "la/lw t0" would hand the resumed task a corrupted
+   * t0 on every trap it takes.
+   */
+
+  csrrw   t0, sscratch, t0
+  beqz    t0, .Lcpu1_trap_unready
+  csrrw   t0, sscratch, t0
+  j       _vector_table
+
+.Lcpu1_trap_unready:
+  csrrw   t0, sscratch, t0
+
+.Lcpu1_smode_fault:
+  la      t0, g_esp32s31_cpu1_boot_state
+  li      t1, ESP32S31_CPU1_BOOT_SMODE_FAULT
+  sw      t1, 0(t0)
+  fence   rw, rw
+
+.Lcpu1_smode_fault_park:
+  j       .Lcpu1_smode_fault_park
+
+  .size esp32s31_cpu1_supervisor_trap, \
+        .-esp32s31_cpu1_supervisor_trap
diff --git a/arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.c b/arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.c
new file mode 100644
index 00000000000..5f79f9c1538
--- /dev/null
+++ b/arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.c
@@ -0,0 +1,110 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32s31/esp32s31_cpu1_boot.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <stdint.h>
+
+#include "esp_attr.h"
+#include "esp_cpu.h"
+#include "esp_rom_sys.h"
+#include "hal/cpu_utility_ll.h"
+#include "rom/ets_sys.h"
+
+#include "esp32s31_cpu1_boot.h"
+
+/****************************************************************************
+ * Public Data
+ ****************************************************************************/
+
+volatile uint32_t g_esp32s31_cpu1_boot_state;
+volatile uint32_t g_esp32s31_cpu1_hartid;
+volatile uint32_t g_esp32s31_cpu1_smp_release;
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+extern void esp32s31_cpu1_boot_entry(void);
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: esp32s31_cpu1_boot
+ *
+ * Description:
+ *   Release CPU1 and wait, with a bound, for it to reach its S-mode entry.
+ *   CPU1 parks there until up_cpu_start() sets g_esp32s31_cpu1_smp_release.
+ *
+ * Input Parameters:
+ *   hartid - If non-NULL, receives the mhartid CPU1 reported.
+ *   state  - If non-NULL, receives the last published bring-up state, which
+ *            tells a failed boot apart from a hart that never started.
+ *
+ * Returned Value:
+ *   Zero on success, -ETIMEDOUT if CPU1 never left STARTING, -EIO if it
+ *   stopped in a fault state.
+ *
+ ****************************************************************************/
+
+int IRAM_ATTR esp32s31_cpu1_boot(uint32_t *hartid, uint32_t *state)
+{
+  uint32_t timeout;
+
+  g_esp32s31_cpu1_hartid = UINT32_MAX;
+  g_esp32s31_cpu1_boot_state = ESP32S31_CPU1_BOOT_STARTING;
+  g_esp32s31_cpu1_smp_release = 0;
+  __asm__ volatile ("fence rw, rw" ::: "memory");
+
+  /* Follow the S31 IDF startup ordering.  CPU1 initially waits in ROM for
+   * ets_set_appcpu_boot_addr() after its stall, clock and reset gates have
+   * been released.
+   */
+
+  esp_cpu_unstall(1);
+  cpu_utility_ll_enable_clock_and_reset_app_cpu();
+  cpu_utility_ll_enable_clock_and_reset_app_cpu_int_matrix();
+  ets_set_appcpu_boot_addr((uint32_t)esp32s31_cpu1_boot_entry);
+
+  for (timeout = CONFIG_ESP32S31_CPU1_BOOT_TIMEOUT_US;
+       timeout > 0 &&
+       g_esp32s31_cpu1_boot_state == ESP32S31_CPU1_BOOT_STARTING;
+       timeout--)
+    {
+      esp_rom_delay_us(1);
+    }
+
+  __asm__ volatile ("fence rw, rw" ::: "memory");
+
+  if (hartid != NULL)
+    {
+      *hartid = g_esp32s31_cpu1_hartid;
+    }
+
+  if (state != NULL)
+    {
+      *state = g_esp32s31_cpu1_boot_state;
+    }
+
+  if (g_esp32s31_cpu1_boot_state == ESP32S31_CPU1_SMP_READY)
+    {
+      return 0;
+    }
+
+  if (g_esp32s31_cpu1_boot_state == ESP32S31_CPU1_BOOT_STARTING)
+    {
+      return -ETIMEDOUT;
+    }
+
+  return -EIO;
+}

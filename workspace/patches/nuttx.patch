+/* Temporary per-hart diagnostic. The monitor masks input 1 before entering
+ * S-mode, so its timestamp cannot be replaced by another input-1 delivery
+ * while this callback consumes it. No logging or allocation in the ISR.
+ */
+
+extern volatile uint32_t g_esp32s31_machine_monlat[2][16];
+
+static void IRAM_ATTR s31_wifi_latency_update(unsigned int cpu, uint32_t now)
+{
+  volatile uint32_t *stats = g_esp32s31_machine_monlat[cpu];
+  uint32_t start = stats[0];
+  uint32_t elapsed;
+
+  if (start == 0)
+    {
+      return;
+    }
+
+  stats[0] = 0;
+  elapsed = now - start;
+  stats[1] = elapsed;
+  if (elapsed > stats[2])
+    {
+      stats[2] = elapsed;
+    }
+
+  stats[3]++;
+  stats[7] += elapsed;
+  stats[4] += elapsed > CONFIG_ESPRESSIF_CPU_FREQ_MHZ * 32u;
+  stats[5] += elapsed > CONFIG_ESPRESSIF_CPU_FREQ_MHZ * 100u;
+  stats[6] += elapsed > CONFIG_ESPRESSIF_CPU_FREQ_MHZ * 1000u;
+  if (stats[8])
+    {
+      stats[12]++;
+      if (elapsed > stats[10])
+        {
+          stats[10] = elapsed;
+        }
+    }
+  else
+    {
+      stats[11]++;
+      if (elapsed > stats[9])
+        {
+          stats[9] = elapsed;
+        }
+    }
+}
+#endif

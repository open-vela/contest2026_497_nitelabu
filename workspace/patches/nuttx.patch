+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <errno.h>
+#define OK 0
+#define ledinfo(...) ((void)0)
+#define ledwarn(...) ((void)0)
+#define lederr(...) ((void)0)
+typedef uint32_t rmt_item32_t;
+struct rgbw_led_s { uint32_t val; };
+struct esp_ws2812_dev_s { uint8_t *buf; size_t buflen, open_count; };
+struct ws2812_dev_s { void *private; int lock, nleds; bool has_white; };
+struct inode { void *i_private; };
+struct file { struct inode *f_inode; };
+static int locked, fail_alloc, fail_lock, live, mapped;
+static int nxmutex_lock(int *lock)
+{
+  assert(lock && !locked);
+  if (fail_lock) { return -EINTR; }
+  locked = 1;
+  return 0;
+}
+static void nxmutex_unlock(int *lock)
+{
+  assert(lock && locked);
+  locked = 0;
+}
+static void *kmm_zalloc(size_t size)
+{
+  assert(locked && size == 100);
+  if (fail_alloc) { return NULL; }
+  live++;
+  return calloc(1, size);
+}
+static void kmm_free(void *ptr)
+{
+  assert(locked && ptr && live == 1);
+  live--;
+  free(ptr);
+}
+static int map_leds_to_words(struct esp_ws2812_dev_s *priv,
+                             struct rgbw_led_s *led, int count,
+                             uint32_t *buffer, bool white)
+{
+  assert(locked && priv->buf && led->val == 0 && count == 1 && !white);
+  assert(buffer == (uint32_t *)priv->buf);
+  mapped++;
+  return 24;
+}
+'''
+    for name in ("esp_open", "esp_close"):
+        fixture += definition(source, name)
+    fixture += r'''
+int main(void)
+{
+  struct esp_ws2812_dev_s priv = {0};
+  struct ws2812_dev_s dev = {&priv, 0, 1, false};
+  struct inode inode = {&dev};
+  struct file first = {&inode}, second = {&inode};
+  fail_lock = 1;
+  assert(esp_open(&first) == -EINTR && !live);
+  fail_lock = 0;
+  fail_alloc = 1;
+  assert(esp_open(&first) == -ENOMEM && !live && !priv.open_count);
+  fail_alloc = 0;
+  for (int cycle = 0; cycle < 3; cycle++) {
+    assert(esp_open(&first) == 0 && priv.open_count == 1);
+    uint8_t *buffer = priv.buf;
+    assert(esp_open(&second) == 0 && priv.open_count == 2);
+    assert(priv.buf == buffer && live == 1);
+    assert(esp_close(&first) == 0 && priv.open_count == 1);
+    assert(priv.buf == buffer && live == 1);
+    assert(esp_close(&second) == 0 && !priv.open_count && !priv.buf && !live);
+    assert(!priv.buflen && !locked);
+  }
+  assert(mapped == 3);
+  assert(esp_close(&first) == -EINVAL);
+  priv.open_count = SIZE_MAX;
+  assert(esp_open(&first) == -EOVERFLOW && !live && !locked);
+  puts("ESP_WS2812_LIFECYCLE=PASS multi-open/last-close/reopen/failures");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix="esp-ws2812-life-") as directory:
+        path = Path(directory)
+        (path / "test.c").write_text(fixture)
+        subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                        "-fsanitize=undefined", "-fno-sanitize-recover=all",
+                        str(path / "test.c"), "-o", str(path / "test")],
+                       check=True)
+        subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    main()

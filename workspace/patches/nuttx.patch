+    fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#define IRAM_ATTR
+static int object, item, result, calls;
+static int32_t xqueue_send_adapter(void *q, void *i, uint32_t ticks, int prio)
+{
+  assert(q == &object && i == &item && ticks == 0 && prio == 0);
+  calls++;
+  return result;
+}
+static int nxsem_trywait(void *sem)
+{ assert(sem == &object); calls++; return result ? 0 : -11; }
+static int nuttx_err_to_freertos(int ret) { return ret == 0; }
+static int esp_coex_common_semphr_give_wrapper(void *sem)
+{ assert(sem == &object); calls++; return result; }
+'''
+    for file, names in (
+        ('esp_wifi_adapter.c', ('queue_send_from_isr_wrapper',)),
+        ('esp_coex_adapter.c', ('esp_coex_semphr_take_from_isr_wrapper',
+                                'esp_coex_semphr_give_from_isr_wrapper')),
+    ):
+        filename = 'arch/risc-v/src/esp32c6/' + file
+        source = (subprocess.check_output(
+            ['git', 'show', f'{args.revision}:{filename}'], cwd=root, text=True)
+            if args.revision else (root / filename).read_text())
+        for name in names:
+            fixture += definition(source, name)
+    fixture += r'''
+static void check(int *flag)
+{
+  int before = flag ? *flag : 0;
+  int count = calls;
+  assert(queue_send_from_isr_wrapper(&object, &item, flag) == result);
+  assert(!flag || *flag == before);
+  assert(esp_coex_semphr_take_from_isr_wrapper(&object, flag) == result);
+  assert(!flag || *flag == before);
+  assert(esp_coex_semphr_give_from_isr_wrapper(&object, flag) == result);

+static int esp_wifi_lock(bool lock)
+{ assert(locked == !lock); locked = lock; return 0; }
+static int esp_wifi_set_config(int iface, int *config)
+{ assert(locked && iface == WIFI_IF_STA && config == &g_sta_wifi_cfg);
+  configs++; return scenario == 1 ? EINVAL : 0; }
+static int esp_wifi_connect(void)
+{ assert(locked); connects++; return scenario == 2 ? EIO : 0; }
+static int esp_wifi_to_errno(int error) { return -error; }
+static void task_delay_wrapper(int ticks)

+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Test the real DHCP probe without importing serial or using a network."""
+
+import ast
+from pathlib import Path
+import re
+import types
+from typing import Optional
+
+
+def main():
+    source = Path(__file__).resolve().parent / "espressif/esp32s31_nuttx_smoke.py"
+    tree = ast.parse(source.read_text())
+    funcs = [node for node in tree.body if isinstance(node, ast.FunctionDef)
+             and node.name in ("wlan_ipv4", "obtain_dhcp")]
+    calls = []
+    replies = []
+    sleeps = []
+
+    def command(port, text, timeout=3.0):
+        assert port is None
+        calls.append((text, timeout))
+        assert text in ("renew wlan0", "ifconfig wlan0",
+                        "ifconfig wlan0 0.0.0.0 gw 192.0.2.1"), text
+        return replies.pop(0)
+
+    scope = {"serial": types.SimpleNamespace(Serial=object),
+             "Optional": Optional, "re": re,
+             "time": types.SimpleNamespace(sleep=sleeps.append),
+             "run_command": command}
+    exec(compile(ast.Module(body=funcs, type_ignores=[]), str(source), "exec"),
+         scope)
+    probe = scope["obtain_dhcp"]
+    leased = "wlan0 at RUNNING\n inet addr:192.0.2.20 DRaddr:192.0.2.1\n"
+    empty = "wlan0 at RUNNING\n inet addr:0.0.0.0\n"
+
+    for reply in ("ERROR: request failed\n", "ERROR: request rejected\n",
+                  "nsh: renew: command not found\n"):
+        calls.clear()
+        replies[:] = [leased, "nsh> ", reply, leased]
+        assert probe(None, 1)[2] is None
+        assert calls == [("ifconfig wlan0", 3.0),
+                         ("ifconfig wlan0 0.0.0.0 gw 192.0.2.1", 8.0),
+                         ("renew wlan0", 45.0), ("ifconfig wlan0", 3.0)]
+
+    replies[:] = [empty, "nsh> ", empty]
+    assert probe(None, 1)[2] is None
+    replies[:] = [empty, "nsh> ", leased]
+    assert probe(None, 1)[2] == "192.0.2.20"
+    replies[:] = [empty, "ERROR: failed\n", leased, "nsh> ", leased]
+    sleeps.clear()
+    assert probe(None, 2)[2] == "192.0.2.20"
+    assert sleeps == [2.0] and not replies
+    replies[:] = [leased.replace("192.0.2.1", "0.0.0.0")]
+    try:
+        probe(None, 1)
+    except RuntimeError:
+        pass
+    else:
+        raise AssertionError("implicit DHCP reset allowed")
+    calls.clear()
+    try:
+        probe(None, 0)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("zero attempts accepted")
+    assert not calls
+    print("DHCP_PROBE=PASS single-client/stale-IP/errors/retry/zero-address")
+
+
+if __name__ == "__main__":
+    main()

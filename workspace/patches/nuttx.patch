+static int mutex, spin, wait_result, transfer_error, lock_result;
+static unsigned starts, waits, stops, resets, drains;
+static int nxmutex_lock(int *lock)
+{
+  assert(lock && !mutex && !spin);
+  if (lock_result) { return lock_result; }
+  mutex = 1;
+  return 0;
+}
+static void nxmutex_unlock(int *lock)
+{
+  assert(lock && mutex && !spin);
+  mutex = 0;
+}
+static irqstate_t spin_lock_irqsave(int *lock)
+{
+  assert(lock && mutex && !spin);
+  spin = 1;
+  return 42;
+}
+static void spin_unlock_irqrestore(int *lock, irqstate_t flags)
+{
+  assert(lock && mutex && spin && flags == 42);
+  spin = 0;
+}
+static void esp_i2c_reset_fsmc(struct esp_i2c_priv_s *priv)
+{
+  assert(priv && mutex && spin);
+  resets++;
+}
+static void esp_i2c_reset_fifo(struct esp_i2c_priv_s *priv)
+{
+  assert(priv && mutex && spin);
+}
+static void esp_i2c_init_clock(struct esp_i2c_priv_s *priv, unsigned frequency)
